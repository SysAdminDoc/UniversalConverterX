schemaVersion = 1
name = "Pkl Sample - Fast H.264"
folder = "Video/Pkl Samples"
description = "Deterministic offline compiler smoke fixture."
inputExtensions = List("mkv", "mp4")
outputFileNameTemplate = "{dir}/{stem}_pkl"
