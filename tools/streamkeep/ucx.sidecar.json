{
  "schemaVersion": 2,
  "engineVersion": "1.0.0",
  "minHostVersion": "2.34.0",
  "maxHostVersion": null,
  "capabilities": [
    "ndjson",
    "tool:ffmpeg",
    "tool:yt-dlp",
    "tool:deno"
  ],
  "architectures": [
    "win-x64"
  ],
  "migration": {
    "strategy": "reinstall",
    "fromSchemaVersions": [
      1
    ],
    "notes": "Reinstall the sidecar when the UCX manifest schema changes."
  },
  "engine": "streamkeep",
  "tools": [
    {
      "id": "ffmpeg",
      "executable": "ffmpeg",
      "display": "FFmpeg",
      "managed": true
    },
    {
      "id": "yt-dlp",
      "executable": "yt-dlp",
      "display": "yt-dlp",
      "managed": true
    },
    {
      "id": "deno",
      "executable": "deno",
      "display": "Deno JavaScript runtime",
      "managed": true,
      "required": false
    }
  ]
}
