{
  "engine": "discburn",
  "tools": [
    {
      "id": "ffmpeg",
      "executable": "ffmpeg",
      "display": "FFmpeg",
      "managed": true,
      "whenArgContainsAny": ["image-dvd", "burn-dvd", "author-bluray", "image-bluray", "burn-bluray"]
    },
    {
      "id": "dvdauthor",
      "executable": "dvdauthor",
      "display": "dvdauthor",
      "managed": false,
      "whenArgContainsAny": ["image-dvd", "burn-dvd"]
    },
    {
      "id": "tsmuxer",
      "executable": "tsMuxeR",
      "display": "tsMuxeR 2.7.0",
      "managed": false,
      "whenArgContainsAny": ["author-bluray", "image-bluray", "burn-bluray"]
    }
  ]
}
