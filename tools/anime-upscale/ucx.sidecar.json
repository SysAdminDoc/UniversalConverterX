{
  "schemaVersion": 2,
  "engineVersion": "4.0.1",
  "minHostVersion": "2.34.0",
  "maxHostVersion": null,
  "capabilities": [
    "ndjson",
    "models",
    "gpu:vulkan",
    "tool:ffmpeg",
    "tool:ffprobe",
    "tool:mpv"
  ],
  "architectures": [
    "win-x64"
  ],
  "migration": {
    "strategy": "reinstall",
    "fromSchemaVersions": [
      1
    ],
    "notes": "Reinstall the sidecar when the UCX manifest schema changes."
  },
  "engine": "anime-upscale",
  "tools": [
    {
      "id": "ffmpeg",
      "executable": "ffmpeg",
      "display": "FFmpeg",
      "managed": true,
      "whenArgContains": "video"
    },
    {
      "id": "ffprobe",
      "executable": "ffprobe",
      "display": "FFprobe",
      "managed": true,
      "whenArgContains": "video"
    },
    {
      "id": "mpv",
      "executable": "mpv",
      "display": "mpv (Anime4K GLSL export)",
      "managed": false,
      "whenArgContainsAny": [
        "anime4k",
        "shader-status"
      ]
    }
  ],
  "models": true,
  "gpu": "vulkan"
}
