{
  "schemaVersion": 2,
  "engineVersion": "1.0.0",
  "minHostVersion": "2.34.0",
  "maxHostVersion": null,
  "capabilities": [
    "ndjson",
    "tool:tesseract",
    "tool:ghostscript"
  ],
  "architectures": [
    "win-x64"
  ],
  "migration": {
    "strategy": "reinstall",
