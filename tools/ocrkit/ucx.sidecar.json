      1
    ],
    "notes": "Reinstall the sidecar when the UCX manifest schema changes."
  },
  "engine": "ocrkit",
  "tools": [
    {
      "id": "tesseract",
      "executable": "tesseract",
      "display": "Tesseract OCR",
      "managed": false
    },
    {
      "id": "ghostscript",
      "executable": "gswin64c",
      "display": "Ghostscript",
      "managed": false
    }
  ]
}
