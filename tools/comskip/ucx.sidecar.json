{
  "schemaVersion": 2,
  "engineVersion": "1.0.0",
  "minHostVersion": "2.34.0",
  "maxHostVersion": null,
  "capabilities": [
    "ndjson",
    "tool:comskip",
    "tool:ffmpeg"
  ],
  "architectures": [
    "win-x64"
  ],
  "migration": {
    "strategy": "reinstall",
    "fromSchemaVersions": [
      1
    ],
    "notes": "Reinstall the sidecar when the UCX manifest schema changes."
  },
  "engine": "comskip",
  "tools": [
    {
      "id": "comskip",
      "executable": "comskip",
      "display": "Comskip",
      "managed": false
    },
    {
      "id": "ffmpeg",
      "executable": "ffmpeg",
      "display": "FFmpeg",
      "managed": true,
      "whenArgContainsAny": [
        "--export-clean"
      ]
    }
  ]
}
