<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UniversalConverterX.Core</RootNamespace>
    <AssemblyName>UniversalConverterX.Core</AssemblyName>
    
    <!-- Assembly Info -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>UniversalConverterX</Company>
    <Product>UniversalConverter X</Product>
    <Description>Core library for UniversalConverter X file format conversion</Description>
    <Copyright>Copyright © 2026 SysAdminDoc</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UniversalConverterX.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Security\ImageMagick\policy.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="..\..\tools\ffmpeg\bundle.json"
                      LogicalName="UniversalConverterX.Core.Tools.ffmpeg.bundle.json" />
    <Content Include="..\..\community-presets\**\*.*">
      <Link>community-presets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- The SDK auto-includes all *.cs under the project. No explicit Compile entries required. -->

  <!-- Cross-namespace global usings — Core's Interfaces and Models reference each other,
       and most files omit explicit usings. Surface both namespaces project-wide. -->
  <ItemGroup>
    <Using Include="UniversalConverterX.Core.Models" />
    <Using Include="UniversalConverterX.Core.Interfaces" />
    <Using Include="UniversalConverterX.Core.Configuration" />
    <Using Include="UniversalConverterX.Core.Detection" />
    <Using Include="UniversalConverterX.Core.Converters" />
    <Using Include="UniversalConverterX.Core.Services" />
  </ItemGroup>

</Project>
