<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UniversalConverterX.Core</RootNamespace>
    <AssemblyName>UniversalConverterX.Core</AssemblyName>
    
    <!-- Assembly Info -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>UniversalConverterX</Company>
    <Product>UniversalConverter X</Product>
    <Description>Core library for UniversalConverter X file format conversion</Description>
    <Copyright>Copyright © 2026 Maven Imaging</Copyright>
    <Version>2.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

  <!-- The SDK auto-includes all *.cs under the project. No explicit Compile entries required. -->

  <!-- Cross-namespace global usings — Core's Interfaces and Models reference each other,
       and most files omit explicit usings. Surface both namespaces project-wide. -->
  <ItemGroup>
    <Using Include="UniversalConverterX.Core.Models" />
    <Using Include="UniversalConverterX.Core.Interfaces" />
    <Using Include="UniversalConverterX.Core.Configuration" />
    <Using Include="UniversalConverterX.Core.Detection" />
    <Using Include="UniversalConverterX.Core.Converters" />
    <Using Include="UniversalConverterX.Core.Services" />
  </ItemGroup>

</Project>
