<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ffmpeg</AssemblyName>
    <RootNamespace>UniversalConverterX.FfmpegProxy</RootNamespace>
    <Company>UniversalConverterX</Company>
    <Product>UniversalConverter X FFmpeg Command Proxy</Product>
    <Description>Local named-pipe bridge for reviewing FFmpeg argument vectors before dispatch.</Description>
  </PropertyGroup>

</Project>
