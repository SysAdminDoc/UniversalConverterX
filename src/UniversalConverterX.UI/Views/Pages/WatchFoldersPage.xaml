<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.WatchFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ProfileRowTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="14"
                    Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch IsOn="{Binding IsEnabled, Mode=OneWay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center"
                                  Toggled="ProfileToggled"
                                  Tag="{Binding Id}"/>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Path}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="filter:"/>
                            <Run Text="{Binding Filter}"/>
                            <Run Text=" |"/>
                            <Run Text="action:"/>
                            <Run Text="{Binding Action}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Edit profile" ToolTipService.ToolTip="Edit profile"
                            Click="EditProfile_Click"
                            Tag="{Binding Id}">
                        <FontIcon Glyph="&#xE70F;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove profile" ToolTipService.ToolTip="Remove profile"
                            Click="RemoveProfile_Click"
                            Tag="{Binding Id}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource AccentRedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EventRowTemplate">
            <Border Background="{StaticResource SurfaceLightBrush}"
                    CornerRadius="10" Padding="10,6"
                    Margin="0,0,0,4">
                <TextBlock Text="{Binding Display}"
                           Style="{StaticResource MutedTextStyle}"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Watch Folders"
                           Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Drop a file into any watched folder to auto-convert or auto-compress it. Profiles persist across launches."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="New Watch"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="NewWatch_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xED25;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock Text="No watch profiles yet"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Click New Watch to point UCX at a folder. New files dropped there will be processed automatically."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420"/>
                </StackPanel>
                <ScrollViewer x:Name="ProfilesScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProfilesList"
                                  ItemTemplate="{StaticResource ProfileRowTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Recent activity"
                           Style="{StaticResource LabelTextStyle}"
                           FontWeight="SemiBold"/>
                <StackPanel x:Name="RecentEmptyState"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Width="58" Height="58" CornerRadius="16"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE823;" FontSize="24"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <TextBlock Text="No activity yet"
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="EventScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="EventList"
                                  ItemTemplate="{StaticResource EventRowTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
