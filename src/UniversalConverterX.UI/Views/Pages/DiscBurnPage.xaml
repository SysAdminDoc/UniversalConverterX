<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.DiscBurnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="DiscBurnPage_Item_001" Text="DISC BURNER" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock x:Uid="DiscBurnPage_Item_002" Text="Create or burn data CD/DVD, DVD-Video, and single-title Blu-ray media."
                           Style="{StaticResource TitleTextStyle}" TextWrapping="Wrap" MaxWidth="820"/>
            </StackPanel>
            <Button x:Uid="DiscBurnPage_RefreshDrivesButton" Grid.Column="1" Content="Refresh drives"
                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="DiscBurnRefreshDrivesButton"
                    Click="RefreshDrives_Click"/>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0" Style="{StaticResource CardStyle}"
                    CornerRadius="22" Padding="18" AllowDrop="True"
                    DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="10" Padding="12,10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="16"
                                      Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Top"/>
                            <TextBlock x:Uid="DiscBurnPage_Item_003"
                                       Text="Data images use Windows IMAPI2 only. DVD-Video also requires FFmpeg and dvdauthor. Blu-ray uses managed FFmpeg and the pinned Apache-2.0 tsMuxeR 2.7.0 runtime; its BDMV folder remains inspectable."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12">
                        <Border Width="116" Height="116" CornerRadius="28"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xE958;" FontSize="48"
                                      Foreground="{StaticResource AccentGreenBrush}"/>
                        </Border>
                        <TextBlock x:Uid="DiscBurnPage_EmptyTitle" x:Name="EmptyTitle"
                                   Text="Choose a folder for the disc" Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="DiscBurnPage_EmptyHint" x:Name="EmptyHint"
                                   Text="Its files and subfolders will become the data-disc contents."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="480"/>
                        <Button x:Uid="DiscBurnPage_ChooseSourceButton" Content="Choose source…"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="DiscBurnChooseSourceButton"
                                Click="ChooseSource_Click"/>
                    </StackPanel>

                    <ListView x:Name="SourceList" Grid.Row="1" Visibility="Collapsed"
                              Background="Transparent" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="14"
                                                Background="{StaticResource SurfaceLightBrush}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                                      Foreground="{StaticResource AccentGreenBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LabelTextStyle}"/>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="0,0,4,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="DiscBurnPage_Item_006" Text="Disc setup" Style="{StaticResource PanelTitleTextStyle}"/>
                            <ComboBox x:Uid="DiscBurnPage_ModeCombo" x:Name="ModeCombo" Header="Content type"
                                      SelectedIndex="0" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="DiscBurnModeCombo"
                                      SelectionChanged="Mode_Changed">
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_008" Content="Data files and folders" Tag="data"/>
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_009" Content="DVD-Video titles" Tag="dvd"/>
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_010" Content="Blu-ray single title" Tag="bluray"/>
                            </ComboBox>
                            <ComboBox x:Uid="DiscBurnPage_ActionCombo" x:Name="ActionCombo" Header="Action"
                                      SelectedIndex="0" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="DiscBurnActionCombo"
                                      SelectionChanged="Action_Changed">
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_011" Content="Create ISO image" Tag="image"/>
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_012" Content="Burn physical disc" Tag="burn"/>
                            </ComboBox>
                            <ComboBox x:Uid="DiscBurnPage_MediaCombo" x:Name="MediaCombo" Header="Data media"
                                      SelectedIndex="1" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="DiscBurnMediaCombo">
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_014" Content="CD" Tag="cd"/>
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_015" Content="DVD" Tag="dvd"/>
                            </ComboBox>
                            <ComboBox x:Uid="DiscBurnPage_StandardCombo" x:Name="StandardCombo" Header="DVD-Video standard"
                                      SelectedIndex="0" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                      AutomationProperties.AutomationId="DiscBurnStandardCombo">
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_017" Content="NTSC (720×480, 29.97 fps)" Tag="ntsc"/>
                                <ComboBoxItem x:Uid="DiscBurnPage_Item_018" Content="PAL (720×576, 25 fps)" Tag="pal"/>
                            </ComboBox>
                            <TextBox x:Uid="DiscBurnPage_LabelBox" x:Name="LabelBox" Header="Volume label"
                                     Text="UNIVERSAL_X" MaxLength="32"
                                     AutomationProperties.AutomationId="DiscBurnLabelBox"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="DiscBurnPage_Item_020" Text="Destination" Style="{StaticResource PanelTitleTextStyle}"/>
                            <TextBox x:Uid="DiscBurnPage_OutputBox" x:Name="OutputBox" Header="ISO image"
                                     IsReadOnly="True" PlaceholderText="Choose an output ISO…"
                                     AutomationProperties.AutomationId="DiscBurnOutputBox"/>
                            <Button x:Uid="DiscBurnPage_ChooseOutputButton" x:Name="ChooseOutputButton"
                                    Content="Choose output…" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="DiscBurnChooseOutputButton"
                                    Click="ChooseOutput_Click"/>
                            <ComboBox x:Uid="DiscBurnPage_DriveCombo" x:Name="DriveCombo" Header="Optical recorder"
                                      HorizontalAlignment="Stretch" Visibility="Collapsed"
                                      PlaceholderText="No compatible recorder found"
                                      AutomationProperties.AutomationId="DiscBurnDriveCombo"/>
                        </StackPanel>
                    </Border>

                    <Button x:Uid="DiscBurnPage_StartButton" x:Name="StartButton" Content="Create ISO"
                            HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False" AutomationProperties.AutomationId="DiscBurnStartButton"
                            Click="Start_Click"/>
                    <Button x:Uid="DiscBurnPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                            HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False" AutomationProperties.AutomationId="DiscBurnCancelButton"
                            Click="Cancel_Click"/>
                    <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,12">
            <TextBlock x:Uid="DiscBurnPage_StatusText" x:Name="StatusText"
                       Text="Choose a source folder and an ISO destination."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
