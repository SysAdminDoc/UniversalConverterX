<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.OcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="OcrFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A1;" FontSize="24"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   LineHeight="16"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="12"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Button x:Uid="OcrPage_Item_001" Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="OcrPage_Item_002" Text="OCR"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="OcrPage_Item_003" Text="Extract searchable text and structured OCR output from images or scans."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="OcrPage_OcrPageButton01" Content="Add images"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"
                    AutomationProperties.AutomationId="OcrPageButton01"/>
                <Button x:Uid="OcrPage_RecognizeButton" x:Name="RecognizeButton"
                        Content="Recognise"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Recognize_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RecognizeButton"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Uid="OcrPage_LangCombo" x:Name="LangCombo"
                          Header="Language pack"
                          IsEditable="True"
                          PlaceholderText="eng (or click Reload)"
                    AutomationProperties.AutomationId="LangCombo"/>
                <ComboBox x:Uid="OcrPage_FormatCombo" Grid.Column="1"
                          x:Name="FormatCombo"
                          Header="Output format"
                          SelectedIndex="0"
                    AutomationProperties.AutomationId="FormatCombo">
                    <ComboBoxItem x:Uid="OcrPage_Item_008" Content="TXT (plain text)" Tag="txt"/>
                    <ComboBoxItem x:Uid="OcrPage_Item_009" Content="hOCR (HTML + bbox)" Tag="hocr"/>
                    <ComboBoxItem x:Uid="OcrPage_Item_010" Content="Searchable PDF" Tag="pdf"/>
                    <ComboBoxItem x:Uid="OcrPage_Item_011" Content="TSV (per-word coords)" Tag="tsv"/>
                    <ComboBoxItem x:Uid="OcrPage_Item_012" Content="ALTO XML" Tag="alto"/>
                </ComboBox>
                <NumberBox x:Uid="OcrPage_PsmBox" Grid.Column="2"
                           x:Name="PsmBox"
                           Header="Page segmentation mode"
                           Value="3"
                           Minimum="0" Maximum="13"
                           SmallChange="1" LargeChange="1"
                           SpinButtonPlacementMode="Inline"
                    AutomationProperties.AutomationId="PsmBox"/>
                <Button x:Uid="OcrPage_OcrPageButton02" Grid.Column="3"
                        Content="Reload langs"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="ReloadLangs_Click"
                    AutomationProperties.AutomationId="OcrPageButton02"/>

                <TextBox x:Uid="OcrPage_OutputDirBox" Grid.Row="1" Grid.ColumnSpan="3"
                         x:Name="OutputDirBox"
                         Header="Output directory"
                         IsReadOnly="True"
                         PlaceholderText="(same as source)"
                    AutomationProperties.AutomationId="OutputDirBox"/>
                <Button x:Uid="OcrPage_OcrPageButton03" Grid.Row="1" Grid.Column="3"
                        Content="Browse..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="BrowseOutputDir_Click"
                    AutomationProperties.AutomationId="OcrPageButton03"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <Border Width="88" Height="88" CornerRadius="12"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE8A1;" FontSize="40"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Uid="OcrPage_Item_017" Text="Add images"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="OcrPage_Item_018" Text="PNG, JPG, TIFF, BMP, WebP. Pick a language and output format, then Recognise."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420"/>
                </StackPanel>
                <ScrollViewer x:Name="FilesScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FilesList"
                                  ItemTemplate="{StaticResource OcrFileTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressBar x:Uid="OcrPage_WorkProgress" AutomationProperties.Name="Progress"
                     Grid.Row="3"
                     x:Name="WorkProgress"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"/>

        <TextBlock x:Uid="OcrPage_StatusText" Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Click Reload langs to populate the language picker."/>
    </Grid>
</Page>
