<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.OcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:UniversalConverterX.UI.Views.Pages"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="OcrFileTemplate" x:DataType="p:OcrFileItem">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12"
                    Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A1;" FontSize="22"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Path}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind StatusText, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{x:Bind}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="OCR (Text Recognition)"
                           Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Extract text from images and scans via Tesseract. Output as plain TXT, hOCR (HTML with bounding boxes), searchable PDF, TSV (per-word coords), or ALTO XML."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Add images"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"/>
                <Button x:Name="RecognizeButton"
                        Content="Recognise"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Recognize_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="20" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="LangCombo"
                          Header="Language pack"
                          IsEditable="True"
                          PlaceholderText="eng (or click Reload)"/>
                <ComboBox Grid.Column="1"
                          x:Name="FormatCombo"
                          Header="Output format"
                          SelectedIndex="0">
                    <ComboBoxItem Content="TXT (plain text)" Tag="txt"/>
                    <ComboBoxItem Content="hOCR (HTML + bbox)" Tag="hocr"/>
                    <ComboBoxItem Content="Searchable PDF" Tag="pdf"/>
                    <ComboBoxItem Content="TSV (per-word coords)" Tag="tsv"/>
                    <ComboBoxItem Content="ALTO XML" Tag="alto"/>
                </ComboBox>
                <NumberBox Grid.Column="2"
                           x:Name="PsmBox"
                           Header="Page segmentation mode"
                           Value="3"
                           Minimum="0" Maximum="13"
                           SmallChange="1" LargeChange="1"
                           SpinButtonPlacementMode="Inline"/>
                <Button Grid.Column="3"
                        Content="Reload langs"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="ReloadLangs_Click"/>

                <TextBox Grid.Row="1" Grid.ColumnSpan="3"
                         x:Name="OutputDirBox"
                         Header="Output directory"
                         IsReadOnly="True"
                         PlaceholderText="(same as source)"/>
                <Button Grid.Row="1" Grid.Column="3"
                        Content="Browse..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="BrowseOutputDir_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE8A1;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock Text="Add images"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="PNG, JPG, TIFF, BMP, WebP. Pick a language and output format, then Recognise."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420"/>
                </StackPanel>
                <ScrollViewer x:Name="FilesScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FilesList"
                                  ItemTemplate="{StaticResource OcrFileTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressBar AutomationProperties.Name="Progress"
                     Grid.Row="3"
                     x:Name="WorkProgress"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"/>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Click Reload langs to populate the language picker."/>
    </Grid>
</Page>
