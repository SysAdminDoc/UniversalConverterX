<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ImageEnhancerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="UpQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE799;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button x:Uid="ImageEnhancerPage_Item_001" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove" ToolTipService.ToolTip="Remove" Click="RemoveQueued_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="ImageEnhancerPage_Item_002" AutomationProperties.Name="Progress" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                     Height="6" CornerRadius="3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UpFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="ImageEnhancerPage_Item_003" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                            Click="OpenFinishedFolder_Click" Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="ImageEnhancerPage_Item_004" Text="Image Enhancer"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="ImageEnhancerPage_Item_005" Text="Real-ESRGAN ncnn-vulkan super-resolution up to 4×. Photo, anime, and general models available."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="ImageEnhancerPage_ImageEnhancerPageButton01" Content="Browse Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="ImageEnhancerPageButton01"/>
                <Button x:Uid="ImageEnhancerPage_RunButton" x:Name="RunButton"
                        Content="Upscale"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" CornerRadius="12" Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="ImageEnhancerPage_ImageEnhancerPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="ImageEnhancerPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE799;" FontSize="48"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ImageEnhancerPage_Item_009" Text="Drop images here"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="ImageEnhancerPage_Item_010" Text="Each file will be upscaled by the selected factor and saved alongside the source."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="420"/>
                                <Button x:Uid="ImageEnhancerPage_ImageEnhancerPageButton02" Content="Browse Files" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click" HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="ImageEnhancerPageButton02"/>
                            </StackPanel>
                            <ListView x:Name="FileList" Visibility="Collapsed"
                                      Background="Transparent" SelectionMode="None"
                                      ItemTemplate="{StaticResource UpQueueTemplate}"/>
                        </Grid>
                    </PivotItem>
                    <PivotItem x:Uid="ImageEnhancerPage_ImageEnhancerPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="ImageEnhancerPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ImageEnhancerPage_Item_013" Text="No upscaled images yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList" Visibility="Collapsed"
                                      Background="Transparent" SelectionMode="None"
                                      ItemTemplate="{StaticResource UpFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ImageEnhancerPage_Item_014" Text="Model" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="ImageEnhancerPage_ModelCombo" x:Name="ModelCombo" Header="Model"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Discovering..."
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="ModelCombo"/>
                        <TextBlock x:Name="ModelHintText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Button x:Uid="ImageEnhancerPage_ImageEnhancerPageButton03" Content="Refresh Models" Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshModels_Click" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ImageEnhancerPageButton03"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="ImageEnhancerPage_Item_017" Text="Scale" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="ImageEnhancerPage_ScaleCombo" x:Name="ScaleCombo" Header="Factor" SelectedIndex="2"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="ScaleCombo">
                            <ComboBoxItem x:Uid="ImageEnhancerPage_Item_019" Content="2× upscale" Tag="2"/>
                            <ComboBoxItem x:Uid="ImageEnhancerPage_Item_020" Content="3× upscale" Tag="3"/>
                            <ComboBoxItem x:Uid="ImageEnhancerPage_Item_021" Content="4× upscale" Tag="4"/>
                        </ComboBox>
                        <ComboBox x:Uid="ImageEnhancerPage_FormatCombo" x:Name="FormatCombo" Header="Output format" SelectedIndex="0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem x:Uid="ImageEnhancerPage_Item_023" Content="PNG (lossless)" Tag="png"/>
                            <ComboBoxItem x:Uid="ImageEnhancerPage_Item_024" Content="JPEG"           Tag="jpg"/>
                            <ComboBoxItem x:Uid="ImageEnhancerPage_Item_025" Content="WebP"           Tag="webp"/>
                        </ComboBox>
                        <CheckBox x:Uid="ImageEnhancerPage_TtaCheck" x:Name="TtaCheck"
                                  Content="TTA (slower, slight quality bump)"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="TtaCheck"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="ImageEnhancerPage_Item_027" Text="Queue Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="ImageEnhancerPage_QueueSummaryText" x:Name="QueueSummaryText" Text="0 queued / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="CurrentSetupText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="ImageEnhancerPage_ClearButton" Grid.Column="1" x:Name="ClearButton" Content="Clear Queue"
                    Style="{StaticResource GhostButtonStyle}" Click="Clear_Click"
                    Margin="0,0,12,0" IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="ImageEnhancerPage_CancelButton" Grid.Column="2" x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click" IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
