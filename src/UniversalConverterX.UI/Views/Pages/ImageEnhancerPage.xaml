<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ImageEnhancerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Image Enhancer" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Planned image upscaling, denoise, sharpening, and restoration."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>

            <!-- Dev status banner -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xEB9F;" FontSize="22"
                                  Foreground="{StaticResource AccentCyanBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{StaticResource AccentOrangeBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="PLANNED" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource TextInverseBrush}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="Engine: Real-ESRGAN" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource AccentCyanBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Image Enhancer is not available yet."
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="Required before enabling: standalone image pipeline, preview, batch export, cancellation, and failure recovery."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Input area -->
            <Border Style="{StaticResource CardStyle}"
                    MinHeight="160"
                    AllowDrop="False"
                    Opacity="0.72"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="18"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEB9F;" FontSize="32"
                                  Foreground="{StaticResource AccentCyanBrush}"/>
                    </Border>
                    <TextBlock x:Name="DropZoneLabel"
                               Text="Input is disabled until this workflow is ready."
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"/>
                    <Button Content="Browse Files"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            HorizontalAlignment="Center"
                            Click="Browse_Click"/>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Grid ColumnSpacing="16" IsHitTestVisible="False" Opacity="0.72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Upscale" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Scale Factor" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="2x" IsSelected="True"/>
                                <ComboBoxItem Content="4x"/>
                                <ComboBoxItem Content="8x"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="AI Model" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Real-ESRGAN (general)" IsSelected="True"/>
                                <ComboBoxItem Content="Real-ESRGAN (anime/illustration)"/>
                                <ComboBoxItem Content="Real-ESRGAN (face focus)"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch Header="Face enhancement (GFPGAN)"
                                      OffContent="Off" OnContent="On"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Output Format" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="PNG (lossless)" IsSelected="True"/>
                                <ComboBoxItem Content="JPEG"/>
                                <ComboBoxItem Content="WebP"/>
                                <ComboBoxItem Content="Preserve source format"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch Header="Preserve original format"
                                      IsOn="True"
                                      OffContent="Off" OnContent="On"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="JPEG Quality" Style="{StaticResource MutedTextStyle}"/>
                            <Slider Minimum="60" Maximum="100" Value="92"
                                    TickFrequency="5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preview only. Controls are disabled until the workflow is wired."
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Enhance Images"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
