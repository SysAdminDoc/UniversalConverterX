<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.DvdRipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="DvdRipPage_Item_001" Text="DVD Rip" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="DvdRipPage_Item_002" Text="Convert titles from an unprotected VIDEO_TS folder to MP4 or MKV."
                           Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap"
                           MaxWidth="820"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="DvdRipPage_DvdRipOpenButton" Content="Open VIDEO_TS…" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="DvdRipOpenButton"
                        Click="Open_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Titles -->
            <Border x:Name="DropZone" Grid.Column="0" Style="{StaticResource CardStyle}"
                    CornerRadius="12" Padding="18" AllowDrop="True"
                    DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- DRM notice -->
                    <Border Grid.Row="0" CornerRadius="10" Padding="12,10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="16"
                                      Foreground="{StaticResource AccentGreenBrush}"
                                      VerticalAlignment="Top"/>
                            <TextBlock x:Uid="DvdRipPage_Item_004" Text="Home and other non-commercial discs only. Commercial CSS-encrypted DVDs are not decrypted and cannot be ripped. Mount an ISO in Windows Explorer first, then point at its VIDEO_TS folder."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12">
                        <Border Width="72" Height="72" CornerRadius="18"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xE958;" FontSize="30"
                                      Foreground="{StaticResource AccentGreenBrush}"/>
                        </Border>
                        <TextBlock x:Uid="DvdRipPage_Item_005" Text="Drop a VIDEO_TS folder"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="DvdRipPage_Item_006" Text="Or the parent folder / mounted disc drive that contains it."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="440"/>
                        <Button x:Uid="DvdRipPage_DvdRipOpenEmptyButton" Content="Open VIDEO_TS…" Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="DvdRipOpenEmptyButton"
                                HorizontalAlignment="Center" Click="Open_Click"/>
                    </StackPanel>

                    <ListView x:Name="TitleList" Grid.Row="1" Visibility="Collapsed"
                              Background="Transparent" SelectionMode="Single"
                              SelectionChanged="Title_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="10"
                                                Background="{StaticResource SurfaceLightBrush}">
                                            <FontIcon Glyph="&#xE714;" FontSize="18"
                                                      Foreground="{StaticResource AccentGreenBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding TitleLabel}" Style="{StaticResource LabelTextStyle}"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                                   VerticalAlignment="Center" FontFamily="Consolas"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Controls -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="0,0,4,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="DvdRipPage_Item_008" Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                            <ComboBox x:Uid="DvdRipPage_ModeCombo" x:Name="ModeCombo" Header="Format" HorizontalAlignment="Stretch"
                                      SelectedIndex="0"
                                      AutomationProperties.AutomationId="DvdRipModeCombo"
                                      SelectionChanged="Mode_Changed">
                                <ComboBoxItem x:Uid="DvdRipPage_Item_010" Content="H.264 MP4 (compatible)" Tag="h264"/>
                                <ComboBoxItem x:Uid="DvdRipPage_Item_011" Content="H.265 MP4 (smaller)" Tag="h265"/>
                                <ComboBoxItem x:Uid="DvdRipPage_Item_012" Content="Stream copy → MKV (fastest, keeps MPEG-2)" Tag="copy"/>
                            </ComboBox>
                            <NumberBox x:Uid="DvdRipPage_CrfBox" x:Name="CrfBox" Header="Quality (CRF, lower = better)"
                                       Value="20" Minimum="0" Maximum="51" SpinButtonPlacementMode="Inline"
                                       AutomationProperties.AutomationId="DvdRipCrfBox"/>
                            <TextBox x:Uid="DvdRipPage_OutputBox" x:Name="OutputBox" Header="Destination file" IsReadOnly="True"
                                     PlaceholderText="Choose an output file…"
                                     AutomationProperties.AutomationId="DvdRipOutputBox"/>
                            <Button x:Uid="DvdRipPage_DvdRipChooseOutputButton" Content="Choose output…" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="DvdRipChooseOutputButton"
                                    Click="ChooseOutput_Click"/>
                        </StackPanel>
                    </Border>

                    <Button x:Uid="DvdRipPage_RipButton" x:Name="RipButton" Content="Rip title" HorizontalAlignment="Stretch"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                            AutomationProperties.AutomationId="DvdRipRipButton"
                            Click="Rip_Click"/>
                    <Button x:Uid="DvdRipPage_CancelButton" x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Stretch"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            AutomationProperties.AutomationId="DvdRipCancelButton"
                            Click="Cancel_Click"/>
                    <ProgressBar x:Name="RipProgress" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,12">
            <TextBlock x:Uid="DvdRipPage_StatusText" x:Name="StatusText" Text="Open a VIDEO_TS folder to scan its titles."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
