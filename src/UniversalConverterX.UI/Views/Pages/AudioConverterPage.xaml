<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.AudioConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="AudioConversionQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xEC4F;" FontSize="20"
                                  Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            AutomationProperties.AutomationId="AudioConverterRemoveButton"
                            ToolTipService.ToolTip="Remove from queue"
                            Tag="{Binding}" Click="Remove_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                    </Button>
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar AutomationProperties.Name="Conversion progress"
                                     Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}" MinWidth="84"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="AUDIO CONVERTER" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Text="Convert audio locally with codec-aware VBR quality and advanced encoder controls."
                           Style="{StaticResource TitleTextStyle}" TextWrapping="Wrap"
                           MaxWidth="760" LineHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Add Files" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="AudioConverterAddFilesButton"
                        Click="Browse_Click"/>
                <Button Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="AudioConverterAddFolderButton"
                        Click="BrowseFolder_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0" Style="{StaticResource CardStyle}"
                    CornerRadius="22" Padding="18" AllowDrop="True"
                    DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Grid MinHeight="480">
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12">
                        <Border Width="116" Height="116" CornerRadius="28"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xEC4F;" FontSize="48"
                                      Foreground="{StaticResource AccentGreenBrush}"/>
                        </Border>
                        <TextBlock Text="Drop audio files to convert"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="MP3, WAV, FLAC, AAC, OGG, Opus, M4A, APE, WavPack, DSD, WMA, AC-3 and more."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="460"/>
                        <Button Content="Browse Files" Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="AudioConverterBrowseButton"
                                HorizontalAlignment="Center" Click="Browse_Click"/>
                    </StackPanel>
                    <ListView x:Name="FileList" Visibility="Collapsed"
                              Background="Transparent" SelectionMode="None"
                              ItemTemplate="{StaticResource AudioConversionQueueTemplate}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="0,0,4,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Output Format" Style="{StaticResource PanelTitleTextStyle}"/>
                            <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="AudioConverterFormatCombo"
                                      SelectionChanged="Format_Changed">
                                <ComboBoxItem Content="MP3 (libmp3lame)" Tag="mp3" IsSelected="True"/>
                                <ComboBoxItem Content="AAC / M4A (native)" Tag="aac"/>
                                <ComboBoxItem Content="AAC / M4A (libfdk_aac)" Tag="fdk-aac"/>
                                <ComboBoxItem Content="Opus" Tag="opus"/>
                                <ComboBoxItem Content="Ogg Vorbis" Tag="vorbis"/>
                                <ComboBoxItem Content="FLAC (lossless)" Tag="flac"/>
                                <ComboBoxItem Content="WAV (PCM)" Tag="wav"/>
                                <ComboBoxItem Content="ALAC / M4A (lossless)" Tag="alac"/>
                                <ComboBoxItem Content="WavPack (lossless)" Tag="wavpack"/>
                                <ComboBoxItem Content="AC-3" Tag="ac3"/>
                                <ComboBoxItem Content="E-AC-3" Tag="eac3"/>
                                <ComboBoxItem Content="WMA" Tag="wma"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border x:Name="QualityCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Quality" Style="{StaticResource PanelTitleTextStyle}"/>
                            <ToggleSwitch x:Name="VbrToggle" Header="Variable bitrate (VBR)"
                                          IsOn="True" AutomationProperties.AutomationId="AudioConverterVbrToggle"
                                          Toggled="Vbr_Toggled"/>
                            <StackPanel x:Name="VbrPanel" Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="VBR quality" Style="{StaticResource LabelTextStyle}"/>
                                    <TextBlock x:Name="VbrQualityValue" Grid.Column="1" Text="2 — high quality"
                                               Style="{StaticResource MutedTextStyle}"/>
                                </Grid>
                                <Slider x:Name="VbrQualitySlider" Minimum="0" Maximum="9" Value="2"
                                        StepFrequency="1" SnapsTo="StepValues"
                                        AutomationProperties.Name="VBR quality, zero is highest"
                                        AutomationProperties.AutomationId="AudioConverterVbrQualitySlider"
                                        ValueChanged="VbrQuality_ValueChanged"/>
                                <Grid>
                                    <TextBlock Text="0 · highest" Style="{StaticResource MutedTextStyle}"/>
                                    <TextBlock Text="9 · smallest" Style="{StaticResource MutedTextStyle}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="BitratePanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="Fixed bitrate" Style="{StaticResource LabelTextStyle}"/>
                                <ComboBox x:Name="BitrateCombo" HorizontalAlignment="Stretch"
                                          AutomationProperties.AutomationId="AudioConverterBitrateCombo"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="64 kbps" Tag="64k"/>
                                    <ComboBoxItem Content="96 kbps" Tag="96k"/>
                                    <ComboBoxItem Content="128 kbps" Tag="128k"/>
                                    <ComboBoxItem Content="160 kbps" Tag="160k"/>
                                    <ComboBoxItem Content="192 kbps" Tag="192k" IsSelected="True"/>
                                    <ComboBoxItem Content="256 kbps" Tag="256k"/>
                                    <ComboBoxItem Content="320 kbps" Tag="320k"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander Header="Advanced audio" AutomationProperties.AutomationId="AudioConverterAdvancedExpander">
                        <StackPanel Spacing="12" Padding="0,12,0,0">
                            <ComboBox x:Name="SampleRateCombo" Header="Sample rate"
                                      AutomationProperties.AutomationId="AudioConverterSampleRateCombo"
                                      SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Auto (preserve)" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="44.1 kHz" Tag="44100"/>
                                <ComboBoxItem Content="48 kHz" Tag="48000"/>
                                <ComboBoxItem Content="96 kHz" Tag="96000"/>
                            </ComboBox>
                            <ComboBox x:Name="ChannelsCombo" Header="Channels"
                                      AutomationProperties.AutomationId="AudioConverterChannelsCombo"
                                      SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Auto (preserve)" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="Mono" Tag="1"/>
                                <ComboBoxItem Content="Stereo" Tag="2"/>
                                <ComboBoxItem Content="5.1" Tag="6"/>
                                <ComboBoxItem Content="7.1" Tag="8"/>
                            </ComboBox>

                            <StackPanel x:Name="OpusPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock Text="Opus" Style="{StaticResource PanelTitleTextStyle}"/>
                                <ComboBox x:Name="OpusApplicationCombo" Header="Application"
                                          AutomationProperties.AutomationId="AudioConverterOpusApplicationCombo"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Audio / music" Tag="audio" IsSelected="True"/>
                                    <ComboBoxItem Content="Voice / podcast" Tag="voip"/>
                                    <ComboBoxItem Content="Low delay" Tag="lowdelay"/>
                                </ComboBox>
                                <ComboBox x:Name="OpusFrameCombo" Header="Frame duration"
                                          AutomationProperties.AutomationId="AudioConverterOpusFrameCombo"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="5 ms" Tag="5"/>
                                    <ComboBoxItem Content="10 ms" Tag="10"/>
                                    <ComboBoxItem Content="20 ms (default)" Tag="20" IsSelected="True"/>
                                    <ComboBoxItem Content="40 ms" Tag="40"/>
                                    <ComboBoxItem Content="60 ms" Tag="60"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="FdkPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock Text="FDK-AAC" Style="{StaticResource PanelTitleTextStyle}"/>
                                <NumberBox x:Name="FdkCutoffBox" Header="Low-pass cutoff (Hz)"
                                           Minimum="0" Maximum="24000" Value="20000" SpinButtonPlacementMode="Compact"
                                           AutomationProperties.AutomationId="AudioConverterFdkCutoffBox"
                                           ValueChanged="NumberSetting_Changed"/>
                                <ToggleSwitch x:Name="FdkAfterburnerToggle" Header="Afterburner quality pass"
                                              IsOn="True" AutomationProperties.AutomationId="AudioConverterFdkAfterburnerToggle"
                                              Toggled="Vbr_Toggled"/>
                                <ComboBox x:Name="FdkProfileCombo" Header="Profile"
                                          AutomationProperties.AutomationId="AudioConverterFdkProfileCombo"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="AAC-LC" Tag="aac_low" IsSelected="True"/>
                                    <ComboBoxItem Content="HE-AAC v1" Tag="aac_he"/>
                                    <ComboBoxItem Content="HE-AAC v2" Tag="aac_he_v2"/>
                                    <ComboBoxItem Content="AAC-LD" Tag="aac_ld"/>
                                    <ComboBoxItem Content="AAC-ELD" Tag="aac_eld"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="VorbisPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock Text="Vorbis" Style="{StaticResource PanelTitleTextStyle}"/>
                                <ToggleSwitch x:Name="VorbisManagedToggle"
                                              Header="Managed bitrate bounds (streaming compatibility)"
                                              AutomationProperties.AutomationId="AudioConverterVorbisManagedToggle"
                                              Toggled="VorbisManaged_Toggled"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Output Folder" Style="{StaticResource PanelTitleTextStyle}"/>
                            <TextBox x:Name="OutputDirectoryBox" IsReadOnly="True"
                                     PlaceholderText="Add a file to choose a default"
                                     AutomationProperties.AutomationId="AudioConverterOutputDirectoryBox"/>
                            <Button Content="Browse Output Folder" Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="AudioConverterBrowseOutputButton"
                                    Click="BrowseOutput_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InfoBannerStyle}">
                        <TextBlock Text="Originals are never modified. Existing outputs receive a numbered name instead of being overwritten."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" x:Name="ClearButton" Content="Clear Queue"
                    Style="{StaticResource GhostButtonStyle}" Margin="0,0,12,0"
                    AutomationProperties.AutomationId="AudioConverterClearButton"
                    Click="Clear_Click" IsEnabled="False"/>
            <Button Grid.Column="2" Content="Open Output" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,12,0" AutomationProperties.AutomationId="AudioConverterOpenOutputButton"
                    Click="OpenOutput_Click"/>
            <Button Grid.Column="3" x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}" Margin="0,0,12,0"
                    AutomationProperties.AutomationId="AudioConverterCancelButton"
                    Click="Cancel_Click" IsEnabled="False"/>
            <Button Grid.Column="4" x:Name="RunButton" Content="Convert All"
                    Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.AutomationId="AudioConverterRunButton"
                    Click="Run_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Page>
