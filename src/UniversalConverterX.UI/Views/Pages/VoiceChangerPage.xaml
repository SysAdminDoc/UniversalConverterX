<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VoiceChangerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Voice Changer" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Transform narration tone, pitch, and timbre while preserving speech timing and intelligibility."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>

            <!-- Dev status banner -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentOrangeBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xED28;" FontSize="22"
                                  Foreground="{StaticResource AccentOrangeBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="FUTURE" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource AccentOrangeBrush}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="Model choice open" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Voice Changer is planned for a future release."
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="What's needed: voice conversion model selection, real-time preview, and quality/naturalness tradeoff controls."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Input area -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    MinHeight="160"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="18"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xED28;" FontSize="32"
                                  Foreground="{StaticResource AccentOrangeBrush}"/>
                    </Border>
                    <TextBlock x:Name="DropZoneLabel"
                               Text="Drop audio or video files here or click Browse"
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="BrowseButton" Content="Browse Files"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="Browse_Click"/>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Voice Style" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Target Style" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Neutral / Cleaned" IsSelected="True"/>
                                <ComboBoxItem Content="Lower / Deeper"/>
                                <ComboBoxItem Content="Higher / Lighter"/>
                                <ComboBoxItem Content="Robotic"/>
                                <ComboBoxItem Content="Whisper"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Pitch Shift (semitones)" Style="{StaticResource MutedTextStyle}"/>
                            <Slider Minimum="-12" Maximum="12" Value="0" TickFrequency="1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Quality" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Preservation Strength" Style="{StaticResource MutedTextStyle}"/>
                            <Slider Minimum="0" Maximum="100" Value="75" TickFrequency="10"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Output Format" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="WAV (lossless)" IsSelected="True"/>
                                <ComboBoxItem Content="MP3 (320kbps)"/>
                                <ComboBoxItem Content="Muxed back into video"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Voice Changer is planned for a future release."
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Transform Voice"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
