<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.SpeechToTextPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SttQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE720;" FontSize="20"
                                  Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding SettingsSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SttFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}"
                                  FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Open file"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFile_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFile}"/>
                    <Button Grid.Column="3"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFile}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Speech to Text" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Transcribe audio and video into editable transcript files using local Whisper inference."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Add Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"/>
                <Button Content="Add Folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main area -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Drop zone / queue -->
            <Border x:Name="DropZone"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem Header="Queue">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE720;" FontSize="48"
                                              Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                                <TextBlock Text="Drop audio or video files"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="MP3, WAV, FLAC, M4A, MP4, MKV, and more."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource SttQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem Header="Finished">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock Text="No finished transcriptions yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Completed transcripts appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource SttFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <!-- Settings panel -->
            <StackPanel Grid.Column="1" Spacing="14">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Model" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="ModelCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="tiny (fastest)" Tag="tiny"/>
                            <ComboBoxItem Content="base (fast, good)" Tag="base" IsSelected="True"/>
                            <ComboBoxItem Content="small (balanced)" Tag="small"/>
                            <ComboBoxItem Content="medium (accurate)" Tag="medium"/>
                            <ComboBoxItem Content="large-v3 (best)" Tag="large-v3"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Language" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="LanguageCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Auto-detect" Tag="auto" IsSelected="True"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="French" Tag="fr"/>
                            <ComboBoxItem Content="German" Tag="de"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Chinese" Tag="zh"/>
                            <ComboBoxItem Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem Content="Italian" Tag="it"/>
                            <ComboBoxItem Content="Russian" Tag="ru"/>
                            <ComboBoxItem Content="Korean" Tag="ko"/>
                            <ComboBoxItem Content="Arabic" Tag="ar"/>
                            <ComboBoxItem Content="Hindi" Tag="hi"/>
                            <ComboBoxItem Content="Dutch" Tag="nl"/>
                            <ComboBoxItem Content="Polish" Tag="pl"/>
                            <ComboBoxItem Content="Turkish" Tag="tr"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output Format" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="FormatCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="SubRip (.srt)" Tag="srt" IsSelected="True"/>
                            <ComboBoxItem Content="Plain text (.txt)" Tag="txt"/>
                            <ComboBoxItem Content="WebVTT (.vtt)" Tag="vtt"/>
                            <ComboBoxItem Content="JSON (raw)" Tag="json"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Options" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ToggleSwitch x:Name="WordTimestampsToggle"
                                      Header="Word-level timestamps"
                                      OffContent="Off"
                                      OnContent="On"
                                      Toggled="Settings_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output Folder" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Name="OutputFolderBox"
                                 PlaceholderText="Same as source file"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"/>
                        <Button Content="Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="BrowseOutputFolder_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel"
                           Grid.Column="0"
                           Text="Add audio or video files to transcribe."
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Clear All"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ClearAll_Click"/>
                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="Cancel_Click"/>
                <Button x:Name="TranscribeButton"
                        Grid.Column="3"
                        Content="Transcribe"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="Transcribe_Click"/>
            </Grid>
        </Border>

    </Grid>
</Page>
