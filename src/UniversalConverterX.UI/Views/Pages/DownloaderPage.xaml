<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.DownloaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="DownloadQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="142"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="3" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE896;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding OptionSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Border>

                    <Button x:Uid="DownloaderPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveQueued_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="DownloaderPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112" TextAlignment="Right"/>
                    </Grid>

                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="2"
                               Text="{Binding LogPreview}"
                               Style="{StaticResource CodeTextStyle}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DownloadFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="DownloaderPage_Item_003" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Uid="DownloaderPage_Item_004" Text="Downloader" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock x:Uid="DownloaderPage_Item_005" Text="Queue video and audio downloads from supported URLs, then review completed results."
                       Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                        Background="{StaticResource SurfaceLightBrush}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="19"
                              Foreground="{StaticResource AccentBlueBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Uid="DownloaderPage_RuntimeHealthTitleText" x:Name="RuntimeHealthTitleText"
                               Text="Checking downloader runtimes..."
                               Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Uid="DownloaderPage_RuntimeHealthDetailText" x:Name="RuntimeHealthDetailText"
                               Text="Verifying yt-dlp, Deno, and the local sidecar."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Uid="DownloaderPage_RuntimeToolsButton" x:Name="RuntimeToolsButton" Grid.Column="2"
                        Content="Install / update runtimes"
                        AutomationProperties.AutomationId="DownloaderRuntimeToolsButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RuntimeTools_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Uid="DownloaderPage_UrlBox" x:Name="UrlBox" Grid.Row="0" Grid.Column="0"
                         AutomationProperties.AutomationId="DownloaderUrlBox"
                         PlaceholderText="Paste one or more URLs, one per line"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="44"
                         MaxHeight="96"
                         TextChanged="UrlBox_TextChanged"/>
                <Button x:Uid="DownloaderPage_PasteButton" x:Name="PasteButton" Grid.Row="0" Grid.Column="1" Content="Paste"
                        AutomationProperties.AutomationId="DownloaderPasteButton"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Paste_Click"/>
                <Button x:Uid="DownloaderPage_AddUrlButton" x:Name="AddUrlButton" Grid.Row="0" Grid.Column="2" Content="Add to Queue"
                        AutomationProperties.AutomationId="DownloaderAddUrlButton"
                        Style="{StaticResource PrimaryButtonStyle}" Click="AddUrl_Click" IsEnabled="False"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16">
                    <ComboBox x:Uid="DownloaderPage_QualityCombo" x:Name="QualityCombo" Header="Quality" Width="180" SelectedIndex="0"
                              AutomationProperties.AutomationId="DownloaderQualityCombo">
                        <ComboBoxItem x:Uid="DownloaderPage_Item_013" Content="Highest available (video + audio)" Tag="best"/>
                        <ComboBoxItem x:Uid="DownloaderPage_Item_014" Content="1080p" Tag="1080"/>
                        <ComboBoxItem x:Uid="DownloaderPage_Item_015" Content="720p" Tag="720"/>
                        <ComboBoxItem x:Uid="DownloaderPage_Item_016" Content="480p" Tag="480"/>
                    </ComboBox>
                    <ComboBox x:Uid="DownloaderPage_OutputFormatCombo" x:Name="OutputFormatCombo" Header="Container" Width="140" SelectedIndex="0"
                              AutomationProperties.AutomationId="DownloaderOutputFormatCombo">
                        <ComboBoxItem x:Uid="DownloaderPage_Item_018" Content="MP4" Tag="mp4"/>
                        <ComboBoxItem x:Uid="DownloaderPage_Item_019" Content="MKV" Tag="mkv"/>
                        <ComboBoxItem x:Uid="DownloaderPage_Item_020" Content="WebM" Tag="webm"/>
                    </ComboBox>
                    <CheckBox x:Uid="DownloaderPage_AudioOnlyCheck" x:Name="AudioOnlyCheck" Content="Audio only (MP3)"
                              AutomationProperties.AutomationId="DownloaderAudioOnlyCheck"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                    <CheckBox x:Uid="DownloaderPage_SubtitlesCheck" x:Name="SubtitlesCheck" Content="Embed subtitles"
                              AutomationProperties.AutomationId="DownloaderSubtitlesCheck"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                    <CheckBox x:Uid="DownloaderPage_SponsorBlockCheck" x:Name="SponsorBlockCheck"
                              Content="Skip sponsor segments (SponsorBlock)"
                              AutomationProperties.AutomationId="DownloaderSponsorBlockCheck"
                              ToolTipService.ToolTip="Removes sponsor / self-promo / interaction segments from the final download. Uses yt-dlp's SponsorBlock postprocessor — pulls segment data from api.sponsor.ajay.app on demand."
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource InfoBannerStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="16"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Top"/>
                        <TextBlock x:Uid="DownloaderPage_Item_024" Text="Downloads run through the local sidecar queue. Review site terms before downloading protected or private media."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <FontIcon Grid.Row="0" Grid.Column="0"
                          Glyph="&#xE72E;" FontSize="18"
                          Foreground="{StaticResource AccentBlueBrush}"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="DownloaderPage_Item_025" Text="Cookie Authentication"
                               Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Uid="DownloaderPage_CookieStatusText" x:Name="CookieStatusText"
                               Text="Checking cookie store..."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ComboBox x:Name="BrowserCombo"
                          Grid.Row="0" Grid.Column="2"
                          AutomationProperties.AutomationId="DownloaderBrowserCombo"
                          Width="150"
                          VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem x:Uid="DownloaderPage_Item_027" Content="Chrome" Tag="chrome"/>
                    <ComboBoxItem x:Uid="DownloaderPage_Item_028" Content="Firefox" Tag="firefox"/>
                    <ComboBoxItem x:Uid="DownloaderPage_Item_029" Content="Edge" Tag="edge"/>
                    <ComboBoxItem x:Uid="DownloaderPage_Item_030" Content="Brave" Tag="brave"/>
                    <ComboBoxItem x:Uid="DownloaderPage_Item_031" Content="Chromium" Tag="chromium"/>
                    <ComboBoxItem x:Uid="DownloaderPage_Item_032" Content="Vivaldi" Tag="vivaldi"/>
                    <ComboBoxItem x:Uid="DownloaderPage_Item_033" Content="Opera" Tag="opera"/>
                    <ComboBoxItem x:Uid="DownloaderPage_Item_034" Content="LibreWolf" Tag="librewolf"/>
                </ComboBox>
                <Button x:Uid="DownloaderPage_CookieImportBrowserButton" x:Name="CookieImportBrowserButton"
                        Grid.Row="0" Grid.Column="3"
                        AutomationProperties.AutomationId="DownloaderImportCookiesButton"
                        Content="Import"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTipService.ToolTip="Extract cookies from the selected browser into UCX's encrypted cookie store"
                        Click="ImportCookiesFromBrowser_Click"/>
                <Button x:Uid="DownloaderPage_CookieImportFileButton" x:Name="CookieImportFileButton"
                        Grid.Row="0" Grid.Column="4"
                        AutomationProperties.AutomationId="DownloaderImportCookiesFromFileButton"
                        Content="From file..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTipService.ToolTip="Import cookies from a Netscape cookies.txt file you exported manually"
                        Click="ImportCookiesFromFile_Click"/>
                <Button x:Uid="DownloaderPage_CookieClearButton" x:Name="CookieClearButton"
                        Grid.Row="0" Grid.Column="5"
                        AutomationProperties.AutomationId="DownloaderClearCookiesButton"
                        Content="Clear"
                        Style="{StaticResource GhostButtonStyle}"
                        IsEnabled="False"
                        Click="ClearCookies_Click"/>
                <TextBlock x:Name="CookieMessageText"
                           Grid.Row="1" Grid.ColumnSpan="6"
                           Style="{StaticResource MutedTextStyle}"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Uid="DownloaderPage_Item_038" Text="Activity" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Name="QueueSummaryText"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Button x:Uid="DownloaderPage_DownloaderPageButton01" Grid.Column="1" Content="Open Output Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenOutput_Click"
                        AutomationProperties.AutomationId="DownloaderPageButton01"/>
                </Grid>

                <Pivot x:Name="QueuePivot" Grid.Row="1" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="DownloaderPage_DownloaderPagePivotItem01" Header="Downloading"
                        AutomationProperties.AutomationId="DownloaderPagePivotItem01">
                        <Grid MinHeight="330" Padding="0,8,0,0">
                            <StackPanel x:Name="QueueEmpty"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE896;" FontSize="48"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="DownloaderPage_Item_041" Text="Paste a URL above and add it to the queue"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="DownloaderPage_Item_042" Text="Multiple pasted URLs are split automatically."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListView x:Name="QueueList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource DownloadQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="DownloaderPage_DownloaderPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="DownloaderPagePivotItem02">
                        <Grid MinHeight="330" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="DownloaderPage_Item_044" Text="No finished downloads yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="DownloaderPage_Item_045" Text="Saved, failed, and cancelled downloads appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource DownloadFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="DownloaderPage_ClearQueueButton" x:Name="ClearQueueButton" Grid.Column="1" Content="Clear Queue"
                    AutomationProperties.AutomationId="DownloaderClearQueueButton"
                    Style="{StaticResource GhostButtonStyle}" Click="ClearQueue_Click"
                    Margin="0,0,12,0" IsEnabled="False"/>
            <Button x:Uid="DownloaderPage_DownloadButton" x:Name="DownloadButton" Grid.Column="2" Content="Download All"
                    AutomationProperties.AutomationId="DownloaderDownloadButton"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Download_Click"
                    Margin="0,0,12,0" IsEnabled="False"/>
            <Button x:Uid="DownloaderPage_CancelButton" x:Name="CancelButton" Grid.Column="3" Content="Cancel"
                    AutomationProperties.AutomationId="DownloaderCancelButton"
                    Style="{StaticResource DangerButtonStyle}" Click="Cancel_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Page>
