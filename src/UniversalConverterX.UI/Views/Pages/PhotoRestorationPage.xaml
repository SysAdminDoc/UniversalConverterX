<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.PhotoRestorationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Old Photo Restoration" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Planned repair for scratches, fading, stains, and soft detail in legacy images."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>

            <!-- Dev status banner -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE91B;" FontSize="22"
                                  Foreground="{StaticResource AccentCyanBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="FUTURE" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource AccentOrangeBrush}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="Photo-specific presets needed" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Old Photo Restoration is not available yet."
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="Required before enabling: restoration models, before/after preview, export path, cancellation, and failure recovery."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Input area -->
            <Border Style="{StaticResource CardStyle}"
                    MinHeight="160"
                    AllowDrop="False"
                    Opacity="0.72"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="18"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE91B;" FontSize="32"
                                  Foreground="{StaticResource AccentCyanBrush}"/>
                    </Border>
                    <TextBlock x:Name="DropZoneLabel"
                               Text="Input is disabled until this workflow is ready."
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="BrowseButton" Content="Browse Files"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            HorizontalAlignment="Center"
                            Click="Browse_Click"/>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Grid ColumnSpacing="16" IsHitTestVisible="False" Opacity="0.72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Restoration" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Repair Type" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All repairs (recommended)" IsSelected="True"/>
                                <ComboBoxItem Content="Scratches and tears only"/>
                                <ComboBoxItem Content="Fading and color loss only"/>
                                <ComboBoxItem Content="Stains and spots only"/>
                                <ComboBoxItem Content="Sharpness and detail only"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Restoration Strength" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Conservative (preserves grain)"/>
                                <ComboBoxItem Content="Balanced" IsSelected="True"/>
                                <ComboBoxItem Content="Aggressive (maximum repair)"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch Header="Face enhancement (GFPGAN)" OffContent="Off" OnContent="On" IsOn="True"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Format" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="PNG (lossless)" IsSelected="True"/>
                                <ComboBoxItem Content="JPEG (high quality)"/>
                                <ComboBoxItem Content="TIFF (archival)"/>
                                <ComboBoxItem Content="WebP"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Resolution" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Original resolution" IsSelected="True"/>
                                <ComboBoxItem Content="2× upscale"/>
                                <ComboBoxItem Content="4× upscale"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch Header="Colorize (DeOldify)" OffContent="Off" OnContent="On"/>
                        <ToggleSwitch Header="Save comparison side-by-side" OffContent="Off" OnContent="On"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preview only. Controls are disabled until the workflow is wired."
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Restore Photos"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
