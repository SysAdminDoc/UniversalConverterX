<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.PhotoRestorationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="PrQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE77B;" FontSize="20"
                                  Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button x:Uid="PhotoRestorationPage_Item_001" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove" ToolTipService.ToolTip="Remove" Click="RemoveQueued_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="PhotoRestorationPage_Item_002" AutomationProperties.Name="Progress" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                     Height="6" CornerRadius="3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PrFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="PhotoRestorationPage_Item_003" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                            Click="OpenFinishedFolder_Click" Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Uid="PhotoRestorationPage_Item_004" Text="Photo Restoration" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="PhotoRestorationPage_Item_005" Text="GFPGAN v1.4 blind face restoration. Sharpens degraded portraits, repairs old scans, smooths compression artifacts."
                           Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="PhotoRestorationPage_PhotoRestorationPageButton01" Content="Browse Files" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click"
                    AutomationProperties.AutomationId="PhotoRestorationPageButton01"/>
                <Button x:Uid="PhotoRestorationPage_RunButton" x:Name="RunButton" Content="Restore"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" CornerRadius="12" Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="PhotoRestorationPage_PhotoRestorationPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="PhotoRestorationPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="48"
                                              Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                                <TextBlock x:Uid="PhotoRestorationPage_DropZoneLabel" x:Name="DropZoneLabel" Text="Drop portrait photos here"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="PhotoRestorationPage_Item_010" Text="Each photo is restored face-by-face and saved alongside the source."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="420"/>
                                <Button x:Uid="PhotoRestorationPage_PhotoRestorationPageButton02" Content="Browse Files" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click" HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="PhotoRestorationPageButton02"/>
                            </StackPanel>
                            <ListView x:Name="FileList" Visibility="Collapsed"
                                      Background="Transparent" SelectionMode="None"
                                      ItemTemplate="{StaticResource PrQueueTemplate}"/>
                        </Grid>
                    </PivotItem>
                    <PivotItem x:Uid="PhotoRestorationPage_PhotoRestorationPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="PhotoRestorationPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="PhotoRestorationPage_Item_013" Text="No restorations yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList" Visibility="Collapsed"
                                      Background="Transparent" SelectionMode="None"
                                      ItemTemplate="{StaticResource PrFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="PhotoRestorationPage_Item_014" Text="Model" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="PhotoRestorationPage_ModelCombo" x:Name="ModelCombo" Header="GFPGAN model"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Discovering..."
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="ModelCombo"/>
                        <TextBlock x:Name="ModelHintText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Button x:Uid="PhotoRestorationPage_PhotoRestorationPageButton03" Content="Refresh Models" Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshModels_Click" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PhotoRestorationPageButton03"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="PhotoRestorationPage_Item_017" Text="Settings" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="PhotoRestorationPage_UpscaleCombo" x:Name="UpscaleCombo" Header="Upscale" SelectedIndex="1"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="UpscaleCombo">
                            <ComboBoxItem x:Uid="PhotoRestorationPage_Item_019" Content="1× (no enlarge)" Tag="1"/>
                            <ComboBoxItem x:Uid="PhotoRestorationPage_Item_020" Content="2× (recommended)" Tag="2"/>
                            <ComboBoxItem x:Uid="PhotoRestorationPage_Item_021" Content="3×" Tag="3"/>
                            <ComboBoxItem x:Uid="PhotoRestorationPage_Item_022" Content="4×" Tag="4"/>
                        </ComboBox>
                        <Slider x:Uid="PhotoRestorationPage_WeightSlider" x:Name="WeightSlider" Header="Restoration strength"
                                Minimum="0" Maximum="100" Value="50"
                                StepFrequency="5"
                                ValueChanged="Weight_Changed"
                            AutomationProperties.AutomationId="WeightSlider"/>
                        <TextBlock x:Uid="PhotoRestorationPage_WeightLabel" x:Name="WeightLabel"
                                   Text="0.50 (balanced)"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Right"/>
                        <CheckBox x:Uid="PhotoRestorationPage_OnlyCenterCheck" x:Name="OnlyCenterCheck"
                                  Content="Only restore the largest face"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="OnlyCenterCheck"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="PhotoRestorationPage_Item_026" Text="Queue Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="PhotoRestorationPage_QueueSummaryText" x:Name="QueueSummaryText" Text="0 queued / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="CurrentSetupText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="PhotoRestorationPage_ClearButton" Grid.Column="1" x:Name="ClearButton" Content="Clear Queue"
                    Style="{StaticResource GhostButtonStyle}" Click="Clear_Click"
                    Margin="0,0,12,0" IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="PhotoRestorationPage_CancelButton" Grid.Column="2" x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click" IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
