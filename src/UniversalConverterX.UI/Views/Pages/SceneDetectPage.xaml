<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.SceneDetectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:UniversalConverterX.UI.Views.Pages"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SceneRowTemplate" x:DataType="p:SceneRow">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="10" Padding="10,8"
                    Margin="0,0,0,4">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind IndexLabel}"
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind StartTc}"
                               Grid.Column="1"
                               Style="{StaticResource LabelTextStyle}"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind EndTc}"
                               Grid.Column="2"
                               Style="{StaticResource LabelTextStyle}"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind DurationLabel}"
                               Grid.Column="3"
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Uid="SceneDetectPage_Item_001" Text="Scene Detection"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="SceneDetectPage_Item_002" Text="Find scene cuts and export timecodes for editing workflows."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="SceneDetectPage_SceneDetectPageButton01" Content="Open Video"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenFile_Click"
                    AutomationProperties.AutomationId="SceneDetectPageButton01"/>
                <Button x:Uid="SceneDetectPage_DetectButton" x:Name="DetectButton"
                        Content="Detect"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Detect_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="DetectButton"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="14" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Uid="SceneDetectPage_DetectorCombo" x:Name="DetectorCombo"
                          Header="Detector"
                          SelectedIndex="0"
                    AutomationProperties.AutomationId="DetectorCombo">
                    <ComboBoxItem x:Uid="SceneDetectPage_Item_006" Content="Content (HSV + edge)" Tag="content"/>
                    <ComboBoxItem x:Uid="SceneDetectPage_Item_007" Content="Threshold (raw pixel diff -- catches fades)" Tag="threshold"/>
                </ComboBox>
                <NumberBox x:Uid="SceneDetectPage_ThresholdBox" Grid.Column="1"
                           Header="Threshold (lower = more cuts)"
                           x:Name="ThresholdBox"
                           Value="27"
                           Minimum="1" Maximum="100"
                           SmallChange="1" LargeChange="5"
                           SpinButtonPlacementMode="Inline"
                    AutomationProperties.AutomationId="ThresholdBox"/>
                <NumberBox x:Uid="SceneDetectPage_MinLenBox" Grid.Column="2"
                           Header="Min scene length (frames)"
                           x:Name="MinLenBox"
                           Value="15"
                           Minimum="1" Maximum="600"
                           SmallChange="1" LargeChange="5"
                           SpinButtonPlacementMode="Inline"
                    AutomationProperties.AutomationId="MinLenBox"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Uid="SceneDetectPage_DetectProgress" AutomationProperties.Name="Progress" x:Name="DetectProgress"
                         Minimum="0" Maximum="100"
                         IsIndeterminate="False"
                         VerticalAlignment="Center"/>
            <Button x:Uid="SceneDetectPage_ExportCsvButton" Grid.Column="1"
                    x:Name="ExportCsvButton"
                    Content="Export CSV"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ExportCsv_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ExportCsvButton"/>
            <Button x:Uid="SceneDetectPage_ExportEdlButton" Grid.Column="2"
                    x:Name="ExportEdlButton"
                    Content="Export EDL"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ExportEdl_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ExportEdlButton"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE71D;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Uid="SceneDetectPage_Item_013" Text="No scenes yet"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="SceneDetectPage_Item_014" Text="Open a video, tweak the threshold if needed, and click Detect."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="ScenesScroll"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScenesList"
                                  ItemTemplate="{StaticResource SceneRowTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Uid="SceneDetectPage_StatusText" Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Open a video to begin."/>
    </Grid>
</Page>
