<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.SlideshowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SlideQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE786;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PlanSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from slideshow"
                            AutomationProperties.AutomationId="SlideshowRemoveButton"
                            ToolTipService.ToolTip="Remove from slideshow"
                            Click="RemoveSlide_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar AutomationProperties.Name="Progress"
                                     Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="92" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="SLIDESHOW MAKER"
                           Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Text="Turn image sets into polished videos with motion, transitions, text, and music."
                           Style="{StaticResource TitleTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="820" LineHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Add Images"
                        AutomationProperties.AutomationId="SlideshowAddImagesButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseImages_Click"/>
                <Button Content="Add Folder"
                        AutomationProperties.AutomationId="SlideshowAddFolderButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <Grid MinHeight="430" Padding="0,8,0,0">
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <Border Width="116" Height="116" CornerRadius="28"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xE786;" FontSize="48"
                                      Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="Drop images or folders"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="JPG, PNG, WebP, BMP, TIFF, AVIF, HEIC, and HEIF files are sorted naturally by filename."
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="480"
                                   TextAlignment="Center"/>
                        <Button Content="Browse Images"
                                AutomationProperties.AutomationId="SlideshowBrowseImagesButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BrowseImages_Click"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ListView x:Name="SlideList"
                              Visibility="Collapsed"
                              Background="Transparent"
                              SelectionMode="None"
                              ItemTemplate="{StaticResource SlideQueueTemplate}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Motion" Style="{StaticResource PanelTitleTextStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="DurationBox"
                                       AutomationProperties.AutomationId="SlideshowDurationBox"
                                       Header="Seconds per slide"
                                       Minimum="0.5" Maximum="30" Value="3"
                                       SmallChange="0.5" LargeChange="1"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="Settings_Number_Changed"/>
                            <NumberBox x:Name="FpsBox"
                                       Grid.Column="1"
                                       AutomationProperties.AutomationId="SlideshowFpsBox"
                                       Header="Frame rate"
                                       Minimum="12" Maximum="60" Value="30"
                                       SmallChange="1" LargeChange="5"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="Settings_Number_Changed"/>
                        </Grid>
                        <ComboBox x:Name="TransitionCombo"
                                  AutomationProperties.AutomationId="SlideshowTransitionCombo"
                                  Header="Transition"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Fade" Tag="fade" IsSelected="True"/>
                            <ComboBoxItem Content="Wipe left" Tag="wipe"/>
                            <ComboBoxItem Content="Zoom blend" Tag="zoom"/>
                            <ComboBoxItem Content="Cut" Tag="cut"/>
                        </ComboBox>
                        <ComboBox x:Name="MotionCombo"
                                  AutomationProperties.AutomationId="SlideshowMotionCombo"
                                  Header="Slide motion"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Ken Burns push" Tag="kenburns" IsSelected="True"/>
                            <ComboBoxItem Content="Zoom in" Tag="zoom-in"/>
                            <ComboBoxItem Content="Zoom out" Tag="zoom-out"/>
                            <ComboBoxItem Content="None" Tag="none"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ResolutionCombo"
                                      AutomationProperties.AutomationId="SlideshowResolutionCombo"
                                      Header="Resolution"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="Settings_Changed">
                                <ComboBoxItem Content="1080p (1920x1080)" Tag="1920x1080" IsSelected="True"/>
                                <ComboBoxItem Content="4K (3840x2160)" Tag="3840x2160"/>
                                <ComboBoxItem Content="Square (1080x1080)" Tag="1080x1080"/>
                                <ComboBoxItem Content="Vertical (1080x1920)" Tag="1080x1920"/>
                            </ComboBox>
                            <ComboBox x:Name="FormatCombo"
                                      Grid.Column="1"
                                      AutomationProperties.AutomationId="SlideshowFormatCombo"
                                      Header="Format"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="Settings_Changed">
                                <ComboBoxItem Content="MP4 (H.264)" Tag="mp4" IsSelected="True"/>
                                <ComboBoxItem Content="MOV (H.264)" Tag="mov"/>
                                <ComboBoxItem Content="WebM (VP9)" Tag="webm"/>
                            </ComboBox>
                        </Grid>
                        <ComboBox x:Name="FitCombo"
                                  AutomationProperties.AutomationId="SlideshowFitCombo"
                                  Header="Image fit"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="Cover frame" Tag="cover" IsSelected="True"/>
                            <ComboBoxItem Content="Contain with bars" Tag="contain"/>
                        </ComboBox>
                        <TextBox x:Name="OutputDirectoryBox"
                                 AutomationProperties.AutomationId="SlideshowOutputDirBox"
                                 Header="Save to"
                                 PlaceholderText="Same folder as first image"
                                 IsReadOnly="True"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Browse"
                                    AutomationProperties.AutomationId="SlideshowBrowseOutputButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"/>
                            <Button Grid.Column="1" Content="Same as images"
                                    AutomationProperties.AutomationId="SlideshowSameAsImagesButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsImages_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Text and Music" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Name="OverlayTextBox"
                                 AutomationProperties.AutomationId="SlideshowOverlayTextBox"
                                 Header="Overlay text"
                                 PlaceholderText="Optional title or caption"
                                 TextChanged="Settings_Text_Changed"/>
                        <TextBox x:Name="MusicPathBox"
                                 AutomationProperties.AutomationId="SlideshowMusicPathBox"
                                 Header="Background music"
                                 PlaceholderText="Optional audio file"
                                 IsReadOnly="True"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Browse Music"
                                    AutomationProperties.AutomationId="SlideshowBrowseMusicButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseMusic_Click"/>
                            <Button Grid.Column="1" Content="Clear Music"
                                    AutomationProperties.AutomationId="SlideshowClearMusicButton"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="ClearMusic_Click"/>
                        </Grid>
                        <Slider x:Name="MusicVolumeSlider"
                                AutomationProperties.AutomationId="SlideshowMusicVolumeSlider"
                                Header="Music volume"
                                Minimum="0" Maximum="100" Value="65"
                                StepFrequency="5" SnapsTo="StepValues"
                                ValueChanged="Settings_Slider_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Clear Slides"
                    x:Name="ClearButton"
                    AutomationProperties.AutomationId="SlideshowClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click" Margin="0,0,12,0" IsEnabled="False"/>
            <Button Grid.Column="2" Content="Open Output"
                    AutomationProperties.AutomationId="SlideshowOpenOutputButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click" Margin="0,0,12,0"/>
            <Button Grid.Column="3" Content="Create Video"
                    x:Name="CreateButton"
                    AutomationProperties.AutomationId="SlideshowCreateButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Create_Click" IsEnabled="False"/>
        </Grid>

        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="560">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="ProgressTitle" Text="Creating slideshow..."
                               Style="{StaticResource TitleTextStyle}"/>
                    <ProgressBar AutomationProperties.Name="Progress"
                                 x:Name="ProgressBar" Height="8" CornerRadius="4"
                                 Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressStage" Style="{StaticResource SubtitleTextStyle}"/>
                    <TextBlock x:Name="ProgressEta" Style="{StaticResource MutedTextStyle}"/>
                    <ScrollViewer Height="96" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceLightBrush}" Padding="8" CornerRadius="4">
                        <TextBlock x:Name="ProgressLog" Style="{StaticResource CodeTextStyle}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Name="CancelButton" Content="Cancel"
                                AutomationProperties.AutomationId="SlideshowCancelButton"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
