<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:UniversalConverterX.UI.Services"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="HistoryRowTemplate" x:DataType="svc:HistoryRecord">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14"
                    Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="18"
                              Foreground="{StaticResource AccentGreenBrush}"
                              Visibility="{x:Bind SuccessIconVisibility}"
                              VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE711;" FontSize="18"
                              Foreground="{StaticResource AccentRedBrush}"
                              Visibility="{x:Bind ErrorVisibility}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Display}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind SourcePath}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   Visibility="{x:Bind ErrorVisibility}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="error:"/>
                            <Run Text="{x:Bind ErrorDetails}" Foreground="{StaticResource AccentRedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Open"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTipService.ToolTip="Reveal output in Explorer"
                            Click="Reveal_Click"
                            Tag="{x:Bind OutputPath}"/>
                    <Button Grid.Column="3"
                            Content="Re-run"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTipService.ToolTip="Re-run with the same parameters"
                            Click="Rerun_Click"
                            Tag="{x:Bind Id}"/>
                    <Button Grid.Column="4"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Forget this entry" ToolTipService.ToolTip="Forget this entry"
                            Click="Delete_Click"
                            Tag="{x:Bind Id}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Conversion History"
                           Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Persistent SQLite log of every job. Search, re-run, or forget any entry."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Refresh_Click"/>
                <Button Content="Clear history"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="Clear_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="Total jobs" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="StatTotal" Text="0" Style="{StaticResource TitleTextStyle}" FontSize="22"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="Succeeded" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="StatOk" Text="0" Style="{StaticResource TitleTextStyle}"
                               FontSize="22" Foreground="{StaticResource AccentGreenBrush}"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="Failed" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="StatFail" Text="0" Style="{StaticResource TitleTextStyle}"
                               FontSize="22" Foreground="{StaticResource AccentRedBrush}"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="Space saved" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="StatSaved" Text="0 B" Style="{StaticResource TitleTextStyle}"
                               FontSize="22" Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>
                </Border>
            </Grid>
        </Border>

        <AutoSuggestBox Grid.Row="2"
                        x:Name="SearchBox"
                        PlaceholderText="Filter by engine, action, file path, preset..."
                        QueryIcon="Find"
                        TextChanged="Search_TextChanged"/>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE81C;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock Text="No history yet"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Run a conversion or compression and it will appear here."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList"
                                  ItemTemplate="{StaticResource HistoryRowTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"/>
    </Grid>
</Page>
