<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:UniversalConverterX.UI.Services"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="HistoryRowTemplate" x:DataType="svc:HistoryRecord">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="20"
                              Foreground="{StaticResource AccentGreenBrush}"
                              Visibility="{x:Bind SuccessIconVisibility}"
                              VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE711;" FontSize="20"
                              Foreground="{StaticResource AccentRedBrush}"
                              Visibility="{x:Bind ErrorVisibility}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Display}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind SourcePath}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   Visibility="{x:Bind ErrorVisibility}"
                                   TextTrimming="CharacterEllipsis">
                            <Run x:Uid="HistoryPage_Item_001" Text="error:"/>
                            <Run Text="{x:Bind ErrorDetails}" Foreground="{StaticResource AccentRedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Uid="HistoryPage_Item_002" Grid.Column="2"
                            Content="Open"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTipService.ToolTip="Reveal output in Explorer"
                            Click="Reveal_Click"
                            Tag="{x:Bind OutputPath}"/>
                    <Button x:Uid="HistoryPage_Item_003" Grid.Column="3"
                            Content="Re-run"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTipService.ToolTip="Re-run with the same parameters"
                            Click="Rerun_Click"
                            Tag="{x:Bind Id}"/>
                    <Button x:Uid="HistoryPage_Item_004" Grid.Column="4"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Forget this entry" ToolTipService.ToolTip="Forget this entry"
                            Click="Delete_Click"
                            Tag="{x:Bind Id}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="HistoryPage_Item_005" Text="CONVERSION HISTORY"
                           Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock x:Uid="HistoryPage_Item_006" Text="Persistent SQLite log of every job. Search, re-run, or forget any entry."
                           Style="{StaticResource TitleTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720" LineHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="HistoryPage_HistoryPageButton03" Content="Export report"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Export_Click"
                        AutomationProperties.AutomationId="HistoryPageButton03"/>
                <Button x:Uid="HistoryPage_HistoryPageButton01" Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Refresh_Click"
                    AutomationProperties.AutomationId="HistoryPageButton01"/>
                <Button x:Uid="HistoryPage_HistoryPageButton02" Content="Clear history"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="Clear_Click"
                    AutomationProperties.AutomationId="HistoryPageButton02"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
            <Grid ColumnSpacing="16" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="HistoryPage_Item_010" Text="Total jobs" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                    <TextBlock x:Uid="HistoryPage_StatTotal" x:Name="StatTotal" Text="0" Style="{StaticResource TitleTextStyle}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="HistoryPage_Item_012" Text="Succeeded" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                    <TextBlock x:Uid="HistoryPage_StatOk" x:Name="StatOk" Text="0" Style="{StaticResource TitleTextStyle}"
                               FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="HistoryPage_Item_014" Text="Failed" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                    <TextBlock x:Uid="HistoryPage_StatFail" x:Name="StatFail" Text="0" Style="{StaticResource TitleTextStyle}"
                               FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricTileStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="HistoryPage_Item_016" Text="Space saved" Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                    <TextBlock x:Uid="HistoryPage_StatSaved" x:Name="StatSaved" Text="0 B" Style="{StaticResource TitleTextStyle}"
                               FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>
                </Border>
            </Grid>
        </Border>

        <AutoSuggestBox x:Uid="HistoryPage_SearchBox" Grid.Row="2"
                        x:Name="SearchBox"
                        PlaceholderText="Filter by engine, action, file path, preset..."
                        QueryIcon="Find"
                        Padding="12,8"
                        TextChanged="Search_TextChanged"
            AutomationProperties.AutomationId="SearchBox"/>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <Border Width="88" Height="88" CornerRadius="22"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE81C;" FontSize="40"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Uid="HistoryPage_Item_019" Text="No history yet"
                               Style="{StaticResource TitleTextStyle}"
                               HorizontalAlignment="Center" FontSize="18"/>
                    <TextBlock x:Uid="HistoryPage_Item_020" Text="Run a conversion or compression and it will appear here."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="280"/>
                </StackPanel>
                <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList"
                                  ItemTemplate="{StaticResource HistoryRowTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"/>
    </Grid>
</Page>
