<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.UniversalConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:UniversalConverterX.UI.Views.Pages"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="MatchCardTemplate" x:DataType="p:UniversalMatchItem">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="16"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="12"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Subtitle}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxLines="2"/>
                        <Border Style="{StaticResource StatusPillStyle}"
                                HorizontalAlignment="Left"
                                Padding="8,3">
                            <TextBlock Text="{x:Bind MatchSummary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreenBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Spacing="4">
                        <Button Content="Run preset"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RunPreset_Click"
                                Tag="{x:Bind Name}"/>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Universal Convert"
                       Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="Drop files once and see every compatible preset before running a sidecar."
                       Style="{StaticResource SubtitleTextStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="32"
                AllowDrop="True"
                Drop="DropZone_Drop"
                DragOver="DropZone_DragOver">
            <Grid ColumnSpacing="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="12" MaxWidth="520">
                    <Border Width="88" Height="88" CornerRadius="24"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7C5;" FontSize="38"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DropHint"
                               Text="Drop files here, or pick them"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="UCX checks preset inputs locally, filters incompatible tools, and keeps your original files untouched."
                               Style="{StaticResource MutedTextStyle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="Pick files"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Pick_Click"
                            HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SelectedFilesText"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                    <Border Style="{StaticResource QuietSurfaceStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="SAFE MATCHING" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Text="No conversion starts until you choose a preset."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource QuietSurfaceStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="BATCH AWARE" Style="{StaticResource MetricLabelTextStyle}"/>
                            <TextBlock Text="Mixed selections show partial and full-coverage matches."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14"
                Visibility="{x:Bind FilterVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="Filter matches..."
                                QueryIcon="Find"
                                TextChanged="Search_TextChanged"/>
                <Button Grid.Column="1"
                        Content="Clear"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Clear_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel x:Name="NoMatchesState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="520">
                <Border Width="86" Height="86" CornerRadius="22"
                        Background="{StaticResource SurfaceLightBrush}">
                    <FontIcon Glyph="&#xE946;" FontSize="38"
                              Foreground="{StaticResource AccentOrangeBrush}"/>
                </Border>
                <TextBlock Text="No compatible presets found"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Try another file type, install a matching sidecar, or add a custom *.preset.xml in your UCX presets folder."
                           Style="{StaticResource MutedTextStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer x:Name="MatchScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MatchList"
                              ItemTemplate="{StaticResource MatchCardTemplate}"/>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Drop files above to see matching presets."/>
    </Grid>
</Page>
