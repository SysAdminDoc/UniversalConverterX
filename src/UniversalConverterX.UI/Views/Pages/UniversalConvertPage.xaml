<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.UniversalConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:UniversalConverterX.UI.Views.Pages"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="MatchCardTemplate" x:DataType="p:UniversalMatchItem">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="16"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="12"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Subtitle}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxLines="2"/>
                        <TextBlock Text="{x:Bind MatchSummary}"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Spacing="4">
                        <Button Content="Convert..."
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RunPreset_Click"
                                Tag="{x:Bind Name}"/>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   TextAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Universal Convert"
                       Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="Drop any file (or click 'Pick files') and UCX shows every conversion preset that accepts it. The fastest way to answer 'what can I do with this file?'."
                       Style="{StaticResource SubtitleTextStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="32"
                AllowDrop="True"
                Drop="DropZone_Drop"
                DragOver="DropZone_DragOver">
            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE7C5;" FontSize="36"
                          Foreground="{StaticResource AccentBlueBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropHint"
                           Text="Drop files here, or pick them"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextStyle}"/>
                <Button Content="Pick files..."
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Pick_Click"
                        HorizontalAlignment="Center"/>
                <TextBlock x:Name="SelectedFilesText"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14"
                Visibility="{x:Bind FilterVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="Filter matches..."
                                QueryIcon="Find"
                                TextChanged="Search_TextChanged"/>
                <Button Grid.Column="1"
                        Content="Clear"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Clear_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MatchList"
                          ItemTemplate="{StaticResource MatchCardTemplate}"/>
        </ScrollViewer>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Drop files above to see matching presets."/>
    </Grid>
</Page>
