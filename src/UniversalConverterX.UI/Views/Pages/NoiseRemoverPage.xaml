<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.NoiseRemoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Noise Remover" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Clean voice and camera audio with configurable denoise strength. Remove background hum, wind, and room noise."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>

            <!-- Dev status banner -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE767;" FontSize="22"
                                  Foreground="{StaticResource AccentOrangeBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{StaticResource AccentOrangeBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="PLANNED" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource TextInverseBrush}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="Engine: RNNoise / Demucs" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource AccentOrangeBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Noise Remover is not available yet."
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="Required before enabling: audio model selection, preview, export path, cancellation, and failure recovery."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Input area -->
            <Border Style="{StaticResource CardStyle}"
                    MinHeight="160"
                    AllowDrop="False"
                    Opacity="0.72"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="18"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE767;" FontSize="32"
                                  Foreground="{StaticResource AccentOrangeBrush}"/>
                    </Border>
                    <TextBlock x:Name="DropZoneLabel"
                               Text="Input is disabled until this workflow is ready."
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="BrowseButton" Content="Browse Files"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            HorizontalAlignment="Center"
                            Click="Browse_Click"/>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Grid ColumnSpacing="16" IsHitTestVisible="False" Opacity="0.72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Denoising" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Noise Type" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Voice + Ambient (recommended)" IsSelected="True"/>
                                <ComboBoxItem Content="Voice only"/>
                                <ComboBoxItem Content="Ambient/background only"/>
                                <ComboBoxItem Content="Wind/rumble"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Denoise Strength" Style="{StaticResource MutedTextStyle}"/>
                            <Slider Minimum="0" Maximum="100" Value="50" TickFrequency="10"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="AI Model" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="RNNoise (fast, voice-focused)" IsSelected="True"/>
                                <ComboBoxItem Content="Demucs (high quality)"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Output Mode" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Muxed video (audio replaced)" IsSelected="True"/>
                                <ComboBoxItem Content="Audio file only"/>
                                <ComboBoxItem Content="Both"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Audio Format" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="AAC (default)" IsSelected="True"/>
                                <ComboBoxItem Content="WAV (lossless)"/>
                                <ComboBoxItem Content="FLAC (lossless)"/>
                                <ComboBoxItem Content="MP3"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch Header="Preview before export" OffContent="Off" OnContent="On"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preview only. Controls are disabled until the workflow is wired."
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Remove Noise"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
