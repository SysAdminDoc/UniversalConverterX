<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.NoiseRemoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="NrQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE767;" FontSize="20"
                                  Foreground="{StaticResource AccentOrangeBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PlanSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button x:Uid="NoiseRemoverPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveQueued_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="NoiseRemoverPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NrFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="NoiseRemoverPage_Item_003" Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock x:Uid="NoiseRemoverPage_Item_004" Text="Noise Remover"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="NoiseRemoverPage_Item_005" Text="RNNoise broadband speech denoiser via FFmpeg arnndn. Cleans hum, hiss, fan and HVAC noise from voice tracks."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="NoiseRemoverPage_NoiseRemoverPageButton01" Content="Browse Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="NoiseRemoverPageButton01"/>
                <Button x:Uid="NoiseRemoverPage_RunButton" x:Name="RunButton"
                        Content="Denoise"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="NoiseRemoverPage_NoiseRemoverPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="NoiseRemoverPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE767;" FontSize="48"
                                              Foreground="{StaticResource AccentOrangeBrush}"/>
                                </Border>
                                <TextBlock x:Uid="NoiseRemoverPage_Item_009" Text="Drop audio or video files here"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="NoiseRemoverPage_Item_010" Text="Each file gets its audio track denoised in place. Video tracks are passed through unchanged."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="420"/>
                                <Button x:Uid="NoiseRemoverPage_NoiseRemoverPageButton02" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="NoiseRemoverPageButton02"/>
                            </StackPanel>
                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource NrQueueTemplate}"/>
                        </Grid>
                    </PivotItem>
                    <PivotItem x:Uid="NoiseRemoverPage_NoiseRemoverPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="NoiseRemoverPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="NoiseRemoverPage_Item_013" Text="No denoised tracks yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource NrFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="NoiseRemoverPage_Item_014" Text="Model" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="NoiseRemoverPage_ModelCombo" x:Name="ModelCombo"
                                  Header="Active model"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Discovering..."
                                  SelectionChanged="Settings_Combo_Changed"
                            AutomationProperties.AutomationId="ModelCombo"/>
                        <TextBlock x:Name="ModelHintText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <Button x:Uid="NoiseRemoverPage_NoiseRemoverPageButton03" Content="Refresh Models"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshModels_Click"
                                HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="NoiseRemoverPageButton03"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="NoiseRemoverPage_Item_017" Text="Output Mode" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="NoiseRemoverPage_ModeCombo" x:Name="ModeCombo"
                                  Header="Mode"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Combo_Changed"
                            AutomationProperties.AutomationId="ModeCombo">
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_019" Content="Pass video, replace audio" Tag="muxed"/>
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_020" Content="Audio file only" Tag="audio"/>
                        </ComboBox>
                        <ComboBox x:Uid="NoiseRemoverPage_AudioFormatCombo" x:Name="AudioFormatCombo"
                                  Header="Audio container"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Combo_Changed"
                            AutomationProperties.AutomationId="AudioFormatCombo">
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_022" Content="WAV"  Tag=".wav"/>
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_023" Content="FLAC" Tag=".flac"/>
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_024" Content="AAC (.m4a)" Tag=".m4a"/>
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_025" Content="MP3"  Tag=".mp3"/>
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_026" Content="Opus" Tag=".opus"/>
                            <ComboBoxItem x:Uid="NoiseRemoverPage_Item_027" Content="OGG"  Tag=".ogg"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="NoiseRemoverPage_Item_028" Text="Queue Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="NoiseRemoverPage_QueueSummaryText" x:Name="QueueSummaryText"
                                   Text="0 queued / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="CurrentSetupText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="NoiseRemoverPage_ClearButton" Grid.Column="1"
                    Content="Clear Queue"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="NoiseRemoverPage_CancelButton" Grid.Column="2"
                    Content="Cancel"
                    x:Name="CancelButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
