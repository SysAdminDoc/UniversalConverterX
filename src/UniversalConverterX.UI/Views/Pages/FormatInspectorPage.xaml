<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.FormatInspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="InspectorFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="112"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE946;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10"
                            Padding="10,5"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6"
                                     CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DetailText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="128"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Format Inspector" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Probe codecs, streams, signatures, size, duration, and conversion readiness before sending files into a queue."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Add Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFiles_Click"
                    AutomationProperties.AutomationId="FormatInspectorPageButton01"/>
                <Button Content="Add Folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="FormatInspectorPageButton02"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Grid MinHeight="470">
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <Border Width="116" Height="116" CornerRadius="28"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xE946;" FontSize="48"
                                      Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="Drop files to inspect"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="UCX checks signatures locally and uses FFprobe for audio/video stream details when available."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="460"/>
                        <Button Content="Browse Files"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BrowseFiles_Click"
                                HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="FormatInspectorPageButton03"/>
                    </StackPanel>

                    <ListView x:Name="FileList"
                              Visibility="Collapsed"
                              Background="Transparent"
                              SelectionMode="Single"
                              SelectionChanged="FileList_SelectionChanged"
                              ItemTemplate="{StaticResource InspectorFileTemplate}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Trust Check"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Name="ToolStatusText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid MinHeight="354">
                        <StackPanel x:Name="ReportEmpty"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <Border Width="116" Height="116" CornerRadius="28"
                                    Background="{StaticResource SurfaceLightBrush}">
                                <FontIcon Glyph="&#xE9D9;" FontSize="48"
                                          Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock Text="Select a file to view the report"
                                       Style="{StaticResource SubtitleTextStyle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Reports include detected type, codec streams, tags, conversion targets, and local processing notes."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"/>
                        </StackPanel>

                        <StackPanel x:Name="ReportPanel"
                                    Visibility="Collapsed"
                                    Spacing="12">
                            <TextBlock x:Name="ReportTitle"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ReportSummary"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                            <ScrollViewer Height="248"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="{StaticResource SurfaceLightBrush}"
                                          Padding="10"
                                          CornerRadius="8">
                                <TextBlock x:Name="ReportDetails"
                                           Style="{StaticResource CodeTextStyle}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1"
                    Content="Open Folder"
                    x:Name="OpenFolderButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenFolder_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="OpenFolderButton"/>
            <Button Grid.Column="2"
                    Content="Clear List"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button Grid.Column="3"
                    Content="Inspect All"
                    x:Name="InspectButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Inspect_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="InspectButton"/>
        </Grid>
    </Grid>
</Page>
