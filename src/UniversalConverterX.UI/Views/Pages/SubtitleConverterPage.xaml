<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.SubtitleConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:UniversalConverterX.UI.Views.Pages"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SubFileTemplate" x:DataType="p:SubFileItem">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12"
                    Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE93B;" FontSize="22"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Path}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind StatusText, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{x:Bind}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Subtitle Converter"
                           Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Convert SRT, WebVTT, ASS, SSA, MicroDVD, and TMP. Optional millisecond shift and framerate retiming for files captured at the wrong fps. Backed by pysubs2."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Add files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"/>
                <Button x:Name="ConvertButton"
                        Content="Convert"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Convert_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="20" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="FormatCombo"
                          Header="Target format"
                          SelectedIndex="0">
                    <ComboBoxItem Content="SRT (SubRip)" Tag="srt"/>
                    <ComboBoxItem Content="WebVTT (.vtt)" Tag="vtt"/>
                    <ComboBoxItem Content="ASS (Aegisub)" Tag="ass"/>
                    <ComboBoxItem Content="SSA" Tag="ssa"/>
                    <ComboBoxItem Content="MicroDVD (.sub)" Tag="microdvd"/>
                    <ComboBoxItem Content="TMP" Tag="tmp"/>
                    <ComboBoxItem Content="JSON" Tag="json"/>
                </ComboBox>
                <TextBox Grid.Column="1"
                         x:Name="OutputDirBox"
                         Header="Output directory"
                         IsReadOnly="True"
                         PlaceholderText="(same as source)"/>
                <Button Grid.Column="2"
                        Content="Browse..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="BrowseOutputDir_Click"/>
                <ComboBox Grid.Column="3"
                          x:Name="EncodingCombo"
                          Header="Source encoding"
                          SelectedIndex="0">
                    <ComboBoxItem Content="utf-8" Tag="utf-8"/>
                    <ComboBoxItem Content="utf-8-sig" Tag="utf-8-sig"/>
                    <ComboBoxItem Content="cp1252 (Western EU)" Tag="cp1252"/>
                    <ComboBoxItem Content="cp1251 (Cyrillic)" Tag="cp1251"/>
                    <ComboBoxItem Content="cp932 (Shift-JIS)" Tag="cp932"/>
                    <ComboBoxItem Content="gbk" Tag="gbk"/>
                </ComboBox>

                <NumberBox Grid.Row="1"
                           x:Name="ShiftMsBox"
                           Header="Shift (ms)"
                           Value="0"
                           Minimum="-3600000" Maximum="3600000"
                           SmallChange="100" LargeChange="1000"
                           SpinButtonPlacementMode="Inline"/>
                <NumberBox Grid.Row="1" Grid.Column="1"
                           x:Name="FpsInBox"
                           Header="Source FPS (optional)"
                           PlaceholderText="(skip)"
                           Value="NaN"
                           Minimum="1" Maximum="120"
                           SmallChange="0.001" LargeChange="1"
                           SpinButtonPlacementMode="Inline"/>
                <NumberBox Grid.Row="1" Grid.Column="2"
                           x:Name="FpsOutBox"
                           Header="Target FPS (optional)"
                           PlaceholderText="(skip)"
                           Value="NaN"
                           Minimum="1" Maximum="120"
                           SmallChange="0.001" LargeChange="1"
                           SpinButtonPlacementMode="Inline"/>
                <ComboBox Grid.Row="1" Grid.Column="3"
                          x:Name="OutEncodingCombo"
                          Header="Output encoding"
                          SelectedIndex="0">
                    <ComboBoxItem Content="utf-8" Tag="utf-8"/>
                    <ComboBoxItem Content="utf-8-sig (BOM)" Tag="utf-8-sig"/>
                    <ComboBoxItem Content="cp1252" Tag="cp1252"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE93B;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock Text="Add subtitle files"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="SRT, VTT, ASS, SSA, SUB, TMP. Pick a target format and run."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="FilesScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FilesList"
                                  ItemTemplate="{StaticResource SubFileTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressBar AutomationProperties.Name="Progress"
                     Grid.Row="3"
                     x:Name="WorkProgress"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"/>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Add subtitles to begin."/>
    </Grid>
</Page>
