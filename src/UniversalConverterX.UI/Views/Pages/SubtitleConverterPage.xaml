<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.SubtitleConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SubFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE93B;" FontSize="24"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   LineHeight="16"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="11"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Button x:Uid="SubtitleConverterPage_Item_001" Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="SubtitleConverterPage_Item_002" Text="SUBTITLE CONVERTER"
                           Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock x:Uid="SubtitleConverterPage_Item_003" Text="Convert SRT, WebVTT, ASS, SSA, MicroDVD, and TMP, decode broadcast Scenarist SCC, and extract embedded captions from video files. Optional millisecond shift and framerate retiming. Backed by pysubs2 and FFmpeg."
                           Style="{StaticResource TitleTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720" LineHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="SubtitleConverterPage_SubtitleConverterPageButton01" Content="Add files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"
                    AutomationProperties.AutomationId="SubtitleConverterPageButton01"/>
                <Button x:Uid="SubtitleConverterPage_ConvertButton" x:Name="ConvertButton"
                        Content="Convert"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Convert_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="ConvertButton"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Uid="SubtitleConverterPage_FormatCombo" x:Name="FormatCombo"
                          Header="Target format"
                          SelectedIndex="0"
                    AutomationProperties.AutomationId="FormatCombo">
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_007" Content="SRT (SubRip)" Tag="srt"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_008" Content="WebVTT (.vtt)" Tag="vtt"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_009" Content="ASS (Aegisub)" Tag="ass"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_010" Content="SSA" Tag="ssa"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_011" Content="MicroDVD (.sub)" Tag="microdvd"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_012" Content="TMP" Tag="tmp"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_013" Content="JSON" Tag="json"/>
                </ComboBox>
                <TextBox x:Uid="SubtitleConverterPage_OutputDirBox" Grid.Column="1"
                         x:Name="OutputDirBox"
                         Header="Output directory"
                         IsReadOnly="True"
                         PlaceholderText="(same as source)"
                    AutomationProperties.AutomationId="OutputDirBox"/>
                <Button x:Uid="SubtitleConverterPage_SubtitleConverterPageButton02" Grid.Column="2"
                        Content="Browse..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="BrowseOutputDir_Click"
                    AutomationProperties.AutomationId="SubtitleConverterPageButton02"/>
                <ComboBox x:Uid="SubtitleConverterPage_EncodingCombo" Grid.Column="3"
                          x:Name="EncodingCombo"
                          Header="Source encoding"
                          SelectedIndex="0"
                    AutomationProperties.AutomationId="EncodingCombo">
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_017" Content="utf-8" Tag="utf-8"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_018" Content="utf-8-sig" Tag="utf-8-sig"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_019" Content="cp1252 (Western EU)" Tag="cp1252"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_020" Content="cp1251 (Cyrillic)" Tag="cp1251"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_021" Content="cp932 (Shift-JIS)" Tag="cp932"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_022" Content="gbk" Tag="gbk"/>
                </ComboBox>

                <NumberBox x:Uid="SubtitleConverterPage_ShiftMsBox" Grid.Row="1"
                           x:Name="ShiftMsBox"
                           Header="Shift (ms)"
                           Value="0"
                           Minimum="-3600000" Maximum="3600000"
                           SmallChange="100" LargeChange="1000"
                           SpinButtonPlacementMode="Inline"
                    AutomationProperties.AutomationId="ShiftMsBox"/>
                <NumberBox x:Uid="SubtitleConverterPage_FpsInBox" Grid.Row="1" Grid.Column="1"
                           x:Name="FpsInBox"
                           Header="Source FPS (optional)"
                           PlaceholderText="(skip)"
                           Value="NaN"
                           Minimum="1" Maximum="120"
                           SmallChange="0.001" LargeChange="1"
                           SpinButtonPlacementMode="Inline"
                    AutomationProperties.AutomationId="FpsInBox"/>
                <NumberBox x:Uid="SubtitleConverterPage_FpsOutBox" Grid.Row="1" Grid.Column="2"
                           x:Name="FpsOutBox"
                           Header="Target FPS (optional)"
                           PlaceholderText="(skip)"
                           Value="NaN"
                           Minimum="1" Maximum="120"
                           SmallChange="0.001" LargeChange="1"
                           SpinButtonPlacementMode="Inline"
                    AutomationProperties.AutomationId="FpsOutBox"/>
                <ComboBox x:Uid="SubtitleConverterPage_OutEncodingCombo" Grid.Row="1" Grid.Column="3"
                          x:Name="OutEncodingCombo"
                          Header="Output encoding"
                          SelectedIndex="0"
                    AutomationProperties.AutomationId="OutEncodingCombo">
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_027" Content="utf-8" Tag="utf-8"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_028" Content="utf-8-sig (BOM)" Tag="utf-8-sig"/>
                    <ComboBoxItem x:Uid="SubtitleConverterPage_Item_029" Content="cp1252" Tag="cp1252"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE93B;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Uid="SubtitleConverterPage_Item_030" Text="Add subtitle files"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="SubtitleConverterPage_Item_031" Text="SRT, VTT, ASS, SSA, SUB, TMP, SCC, or a video file. Pick a target format and run."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="FilesScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FilesList"
                                  ItemTemplate="{StaticResource SubFileTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressBar x:Uid="SubtitleConverterPage_WorkProgress" AutomationProperties.Name="Progress"
                     Grid.Row="3"
                     x:Name="WorkProgress"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"/>

        <TextBlock x:Uid="SubtitleConverterPage_StatusText" Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Add subtitles to begin."/>
    </Grid>
</Page>
