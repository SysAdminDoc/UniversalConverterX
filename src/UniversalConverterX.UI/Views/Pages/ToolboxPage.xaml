<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ToolboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ToolboxTileTemplate">
            <Button Width="216" Height="172" Padding="14" Margin="0,0,10,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                    CornerRadius="12"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Click="Tile_Click"
                    AutomationProperties.Name="{Binding Title}"
                    ToolTipService.ToolTip="{Binding ToolTipText}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceLightBrush}" CornerRadius="12"
                                Width="40" Height="40">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <TextBlock x:Uid="ToolboxPage_Item_001" Grid.Column="2" Text="AI"
                                   Style="{StaticResource SubtleTextStyle}" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   Visibility="{Binding ShowAi}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" LineHeight="17"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7"
                                 Fill="{Binding StatusBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusBadge}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Style="{StaticResource PageStackLayoutStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="ToolboxPage_Item_002" Text="Toolbox" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="ToolboxPage_Item_003" Text="Specialized tools for finishing, repairing, extracting, and preparing media."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           MaxWidth="720" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_011" Text="Image" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="ImageGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_012" Text="Video" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="VideoGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_013" Text="AI Tools" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="AiGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_014" Text="Audio" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="AudioGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_015" Text="Documents" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="DocumentGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_016" Text="Disc" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="DiscGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_017" Text="Other" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="OtherGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel x:Name="PluginSection" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Uid="ToolboxPage_Item_018" Text="Trusted Plugins" Style="{StaticResource SectionHeaderTextStyle}"/>
                <ItemsRepeater x:Name="PluginGrid"
                               ItemTemplate="{StaticResource ToolboxTileTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                            MinItemWidth="216"
                                            MinItemHeight="172"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
