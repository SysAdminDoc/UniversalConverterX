<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ToolboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ToolboxTileTemplate">
            <Border Width="200" Height="124" Padding="14" Margin="0,0,12,12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceLightBrush}" CornerRadius="8"
                                Width="36" Height="36">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceLightBrush}" CornerRadius="8"
                                Padding="6,2" Visibility="{Binding ShowAi}">
                            <TextBlock Text="AI" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding StatusBadge}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{Binding StatusBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Padding="32" Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="Toolbox" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="29 specialized tools — image, video, audio, AI, disc, and more."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Image" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <GridView x:Name="ImageGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Video" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <GridView x:Name="VideoGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="AI Tools" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <GridView x:Name="AiGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Audio" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <GridView x:Name="AudioGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Disc" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <GridView x:Name="DiscGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Other" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <GridView x:Name="OtherGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
