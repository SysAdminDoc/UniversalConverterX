<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ToolboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ToolboxTileTemplate">
            <Border Width="216" Height="124" Padding="14" Margin="0,0,10,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                    CornerRadius="12"
                    AutomationProperties.Name="{Binding Title}"
                    ToolTipService.ToolTip="{Binding Description}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceLightBrush}" CornerRadius="12"
                                Width="40" Height="40">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceLightBrush}" CornerRadius="10"
                                Padding="8,3" Visibility="{Binding ShowAi}">
                            <TextBlock x:Uid="ToolboxPage_Item_001" Text="AI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" LineHeight="17"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7"
                                 Fill="{Binding StatusBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusBadge}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Style="{StaticResource PageStackLayoutStyle}">
            <Border Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="0">
                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock x:Uid="ToolboxPage_Item_002" Text="Toolbox" Style="{StaticResource PageTitleTextStyle}"/>
                        <TextBlock x:Uid="ToolboxPage_Item_003" Text="Specialized tools for finishing, repairing, extracting, and preparing media."
                                   Style="{StaticResource PageDescriptionTextStyle}"
                                   TextWrapping="Wrap"
                                   MaxWidth="720"/>
                        <TextBlock x:Uid="ToolboxPage_Item_004" Text="Ready tools open directly. Planned tools stay disabled and explain what is missing."
                                   Style="{StaticResource SubtitleTextStyle}" FontSize="13"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"
                                   MaxWidth="760"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="12"
                            Padding="16"
                            Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="ToolboxPage_Item_005" Text="Status key" Style="{StaticResource PanelTitleTextStyle}"/>
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="ToolboxPage_Item_006" Text="Ready opens a runnable workflow" Style="{StaticResource MutedTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentOrangeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="ToolboxPage_Item_007" Text="Planned has a defined implementation path" Style="{StaticResource MutedTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentYellowBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="ToolboxPage_Item_008" Text="Future still needs scope decisions" Style="{StaticResource MutedTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
                                    <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="8" Padding="6,2">
                                        <TextBlock x:Uid="ToolboxPage_Item_009" Text="AI" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBlueBrush}"/>
                                    </Border>
                                    <TextBlock x:Uid="ToolboxPage_Item_010" Text="Model-backed tool" Style="{StaticResource MutedTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_011" Text="Image" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="ImageGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_012" Text="Video" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="VideoGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_013" Text="AI Tools" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="AiGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_014" Text="Audio" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="AudioGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_015" Text="Documents" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="DocumentGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_016" Text="Disc" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="DiscGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="ToolboxPage_Item_017" Text="Other" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="OtherGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>

            <StackPanel x:Name="PluginSection" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Uid="ToolboxPage_Item_018" Text="Trusted Plugins" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="PluginGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="Tile_Click" ItemTemplate="{StaticResource ToolboxTileTemplate}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
