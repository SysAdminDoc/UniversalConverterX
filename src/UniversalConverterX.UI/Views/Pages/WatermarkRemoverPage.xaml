<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.WatermarkRemoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="WmrQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE71B;" FontSize="20"
                                  Foreground="{StaticResource AccentOrangeBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding ModeSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Border>
                    <Button x:Uid="WatermarkRemoverPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="WatermarkRemoverPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="92" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WmrFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="WatermarkRemoverPage_Item_003" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="WatermarkRemoverPage_Item_004" Text="Watermark &amp; Subtitle Remover" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="WatermarkRemoverPage_Item_005" Text="Detect and inpaint logos, captions, static overlays, and subtitle text using AI reconstruction."
                           Style="{StaticResource PageDescriptionTextStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="WatermarkRemoverPage_WatermarkRemoverPageButton01" Content="Add Files" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="WatermarkRemoverPageButton01"/>
                <Button x:Uid="WatermarkRemoverPage_WatermarkRemoverPageButton02" Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="WatermarkRemoverPageButton02"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Drop zone + queue -->
            <Border x:Name="DropZone" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="WatermarkRemoverPage_WatermarkRemoverPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="WatermarkRemoverPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE71B;" FontSize="48"
                                              Foreground="{StaticResource AccentOrangeBrush}"/>
                                </Border>
                                <TextBlock x:Uid="WatermarkRemoverPage_Item_009" Text="Drop video or image files"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="WatermarkRemoverPage_Item_010" Text="MP4, MOV, MKV, WebM, PNG, JPG, WEBP, and more."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Uid="WatermarkRemoverPage_WatermarkRemoverPageButton03" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="WatermarkRemoverPageButton03"/>
                            </StackPanel>
                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource WmrQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="WatermarkRemoverPage_WatermarkRemoverPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="WatermarkRemoverPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="WatermarkRemoverPage_Item_013" Text="No finished jobs yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="WatermarkRemoverPage_Item_014" Text="Completed, failed, and cancelled jobs appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource WmrFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <!-- Settings panel -->
            <StackPanel Grid.Column="1" Spacing="14">

                <!-- Inpainting mode -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WatermarkRemoverPage_Item_015" Text="Inpainting Algorithm" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ModeCombo">
                            <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_016" Content="STTN (temporal, default)" Tag="sttn" IsSelected="True"/>
                            <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_017" Content="LaMa (single-frame, fast)" Tag="lama"/>
                            <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_018" Content="ProPainter (high quality)" Tag="propainter"/>
                            <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_019" Content="Auto (TBE + LaMa routing)" Tag="auto"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Device -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WatermarkRemoverPage_Item_020" Text="Compute Device" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="DeviceCombo">
                            <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_021" Content="CPU" Tag="cpu" IsSelected="True"/>
                            <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_022" Content="DirectML (AMD / Intel)" Tag="directml"/>
                            <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_023" Content="CUDA GPU 0" Tag="cuda:0"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Detection options -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WatermarkRemoverPage_Item_024" Text="Detection" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="WatermarkRemoverPage_Item_025" Text="OCR Language" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Name="LangCombo" HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="LangCombo">
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_026" Content="English" Tag="en" IsSelected="True"/>
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_027" Content="Chinese (Simplified)" Tag="ch"/>
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_028" Content="Japanese" Tag="ja"/>
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_029" Content="Korean" Tag="ko"/>
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_030" Content="French" Tag="fr"/>
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_031" Content="German" Tag="de"/>
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_032" Content="Spanish" Tag="es"/>
                                <ComboBoxItem x:Uid="WatermarkRemoverPage_Item_033" Content="Russian" Tag="ru"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="WatermarkRemoverPage_Item_034" Text="Region (optional): x1,y1,x2,y2" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox x:Uid="WatermarkRemoverPage_AreaBox" x:Name="AreaBox"
                                     PlaceholderText="e.g. 0,900,1920,1080"
                                     HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="AreaBox"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Quality -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WatermarkRemoverPage_Item_036" Text="Output Quality" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock x:Uid="WatermarkRemoverPage_Item_037" Text="CRF (video re-encode)" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Uid="WatermarkRemoverPage_QualityValueText" x:Name="QualityValueText" Text="23"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource MutedTextStyle}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="QualitySlider" Minimum="0" Maximum="51" Value="23"
                                    TickFrequency="1" StepFrequency="1"
                                AutomationProperties.AutomationId="QualitySlider"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="WatermarkRemoverPage_KeepAudioToggle" x:Name="KeepAudioToggle"
                                      Header="Preserve audio track"
                                      IsOn="True"
                            AutomationProperties.AutomationId="KeepAudioToggle"/>
                        <ToggleSwitch x:Uid="WatermarkRemoverPage_NoHwEncodeToggle" x:Name="NoHwEncodeToggle"
                                      Header="Disable HW encoder (NVENC/QSV)"
                                      IsOn="False"
                            AutomationProperties.AutomationId="NoHwEncodeToggle"/>
                    </StackPanel>
                </Border>

                <!-- Output folder -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="WatermarkRemoverPage_Item_041" Text="Output Folder" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="WatermarkRemoverPage_OutputDirectoryBox" x:Name="OutputDirectoryBox" PlaceholderText="Same folder as source"
                                 IsReadOnly="True" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Uid="WatermarkRemoverPage_WatermarkRemoverPageButton04" Content="Choose Folder" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="WatermarkRemoverPageButton04"/>
                            <Button x:Uid="WatermarkRemoverPage_WatermarkRemoverPageButton05" Content="Same as Source" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="WatermarkRemoverPageButton05"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Uid="WatermarkRemoverPage_StatusText" x:Name="StatusText"
                               Text="Add video or image files to start a removal queue."
                               Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Uid="WatermarkRemoverPage_ClearButton" x:Name="ClearButton" Content="Clear Queue"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="Clear_Click"
                        AutomationProperties.AutomationId="ClearButton"/>
                    <Button x:Uid="WatermarkRemoverPage_WatermarkRemoverPageButton06" Content="Open Output Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenOutputFolder_Click"
                        AutomationProperties.AutomationId="WatermarkRemoverPageButton06"/>
                    <Button x:Uid="WatermarkRemoverPage_RunButton" x:Name="RunButton" Content="Remove"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="Run_Click"
                        AutomationProperties.AutomationId="RunButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress overlay -->
        <Border x:Name="ProgressOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource OverlayBrush}"
                CornerRadius="20"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="480">
                <TextBlock x:Uid="WatermarkRemoverPage_ProgressTitle" x:Name="ProgressTitle" Text="Processing..."
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Uid="WatermarkRemoverPage_ProgressBar" AutomationProperties.Name="Progress" x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                             Width="380" Height="8" CornerRadius="4"/>
                <TextBlock x:Uid="WatermarkRemoverPage_ProgressStage" x:Name="ProgressStage" Text="Starting..."
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ProgressEta" Text=""
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center"/>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ProgressLog" Text=""
                               Style="{StaticResource MutedTextStyle}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <Button x:Uid="WatermarkRemoverPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="Cancel_Click"
                    AutomationProperties.AutomationId="CancelButton"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>

