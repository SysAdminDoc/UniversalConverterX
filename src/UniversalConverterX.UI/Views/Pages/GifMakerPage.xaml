<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.GifMakerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="GifQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE909;" FontSize="20"
                                  Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PlanSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button x:Uid="GifMakerPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveQueued_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="GifMakerPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GifFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="GifMakerPage_Item_003" Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="GifMakerPage_Item_004" Text="GIF Maker" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="GifMakerPage_Item_005" Text="Convert video clips to high-quality animated GIFs via two-pass FFmpeg palettegen + paletteuse."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="GifMakerPage_GifMakerPageButton01" Content="Browse Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="GifMakerPageButton01"/>
                <Button x:Uid="GifMakerPage_RunButton" x:Name="RunButton"
                        Content="Make GIFs"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="GifMakerPage_GifMakerPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="GifMakerPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE909;" FontSize="48"
                                              Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                                <TextBlock x:Uid="GifMakerPage_Item_009" Text="Drop video files here"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="GifMakerPage_Item_010" Text="Each file becomes one GIF using the settings on the right. Defaults are sized for social embedding."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="420"/>
                                <Button x:Uid="GifMakerPage_GifMakerPageButton02" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="GifMakerPageButton02"/>
                            </StackPanel>

                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource GifQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="GifMakerPage_GifMakerPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="GifMakerPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="GifMakerPage_Item_013" Text="No GIFs rendered yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="GifMakerPage_Item_014" Text="Successful and failed renders show up here so you can open the output folder."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource GifFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="GifMakerPage_Item_015" Text="Render Settings" Style="{StaticResource PanelTitleTextStyle}"/>

                        <ComboBox x:Uid="GifMakerPage_WidthCombo" x:Name="WidthCombo"
                                  Header="Width"
                                  SelectedIndex="1"
                                  SelectionChanged="Settings_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="WidthCombo">
                            <ComboBoxItem x:Uid="GifMakerPage_Item_017" Content="240 px (tiny)"  Tag="240"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_018" Content="480 px (social)" Tag="480"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_019" Content="720 px (HD)"    Tag="720"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_020" Content="1080 px (full)" Tag="1080"/>
                        </ComboBox>

                        <ComboBox x:Uid="GifMakerPage_FpsCombo" x:Name="FpsCombo"
                                  Header="Frame rate"
                                  SelectedIndex="1"
                                  SelectionChanged="Settings_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="FpsCombo">
                            <ComboBoxItem x:Uid="GifMakerPage_Item_022" Content="10 fps" Tag="10"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_023" Content="15 fps" Tag="15"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_024" Content="20 fps" Tag="20"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_025" Content="24 fps" Tag="24"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_026" Content="30 fps" Tag="30"/>
                        </ComboBox>

                        <ComboBox x:Uid="GifMakerPage_LoopCombo" x:Name="LoopCombo"
                                  Header="Loop"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="LoopCombo">
                            <ComboBoxItem x:Uid="GifMakerPage_Item_028" Content="Infinite" Tag="0"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_029" Content="Play once" Tag="-1"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_030" Content="Loop 3×" Tag="3"/>
                            <ComboBoxItem x:Uid="GifMakerPage_Item_031" Content="Loop 5×" Tag="5"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="GifMakerPage_Item_032" Text="Trim (seconds)" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="GifMakerPage_StartBox" x:Name="StartBox"
                                 Header="Start"
                                 PlaceholderText="0"
                                 TextChanged="Settings_Text_Changed"
                            AutomationProperties.AutomationId="StartBox"/>
                        <TextBox x:Uid="GifMakerPage_DurationBox" x:Name="DurationBox"
                                 Header="Duration (blank = to end)"
                                 PlaceholderText="5"
                                 TextChanged="Settings_Text_Changed"
                            AutomationProperties.AutomationId="DurationBox"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="GifMakerPage_Item_035" Text="Queue Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="GifMakerPage_QueueSummaryText" x:Name="QueueSummaryText"
                                   Text="0 queued / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="CurrentSetupText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="GifMakerPage_ClearButton" Grid.Column="1"
                    Content="Clear Queue"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="GifMakerPage_CancelButton" Grid.Column="2"
                    Content="Cancel"
                    x:Name="CancelButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
