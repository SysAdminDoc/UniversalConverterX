<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="QueuedFileTemplate">
            <Border Background="Transparent"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0"
                    Padding="12,10"
                    Margin="0"
                    MinWidth="720">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Uid="ConverterPage_Item_001_3" Grid.RowSpan="2" Grid.Column="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Checked="QueueItemSelection_Changed"
                              Unchecked="QueueItemSelection_Changed"
                              AutomationProperties.Name="Select file"/>

                    <Border Grid.RowSpan="2" Grid.Column="1"
                            Width="48" Height="48" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8A5;" FontSize="20"
                                      Visibility="{Binding ThumbnailPlaceholderVisibility}"
                                      Foreground="{StaticResource AccentBlueBrush}"/>
                            <Image x:Uid="ConverterPage_Item_001" Source="{Binding ThumbnailSource}"
                                   Visibility="{Binding ThumbnailVisibility}"
                                   Stretch="UniformToFill"
                                   AutomationProperties.Name="File preview thumbnail"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Grid.Row="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Path}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Grid.Row="0"
                               Text="{Binding Extension}"
                               Style="{StaticResource MutedTextStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="4" Grid.Row="0"
                               Text="{Binding FileSize}"
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Uid="ConverterPage_Item_002" Grid.Column="5" Grid.Row="0"
                               Text="{Binding EstimatedSizeLabel}"
                               Style="{StaticResource MutedTextStyle}"
                               Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasEstimatedSize}"
                               AutomationProperties.Name="Estimated output size"
                               ToolTipService.ToolTip="{Binding EstimatedSizeCaveat}"/>

                    <StackPanel Grid.Column="6" Grid.Row="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5"
                                    Visibility="{Binding WarningVisibility}"
                                    ToolTipService.ToolTip="{Binding WarningSummary}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13"
                                      Foreground="{StaticResource AccentOrangeBrush}"/>
                            <TextBlock Text="{Binding WarningBadgeText}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Foreground="{StaticResource AccentOrangeBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Uid="ConverterPage_Item_003" Text="Ready"
                                   Visibility="{Binding ReadyVisibility}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{StaticResource AccentGreenBrush}"/>
                    </StackPanel>

                    <Grid Grid.Column="2" Grid.ColumnSpan="5" Grid.Row="1">
                        <ProgressBar x:Uid="ConverterPage_Item_005" AutomationProperties.Name="Progress" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="4" CornerRadius="2"
                                     VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FinishedFileTemplate">
            <Border Background="Transparent"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0"
                    Padding="12,10"
                    Margin="0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSubtleBrush}"/>
                    </StackPanel>
                    <Button x:Uid="ConverterPage_Item_006" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,10"
                            FontSize="13"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock x:Uid="ConverterPage_Item_007" Text="Converter" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="ConverterPage_Item_008" Text="Convert your files to the format you need."
                           Style="{StaticResource PageDescriptionTextStyle}"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <SplitButton x:Name="AddFilesSplitButton"
                             Click="AddFilesSplitButton_Click"
                             Background="{StaticResource AccentPrimaryBrush}"
                             Foreground="{StaticResource TextInverseBrush}"
                             BorderThickness="0"
                             CornerRadius="8"
                             MinHeight="40"
                             Padding="16,8"
                             FontSize="14"
                             FontWeight="SemiBold"
                             AutomationProperties.AutomationId="ConverterAddFilesSplitButton">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock x:Uid="ConverterPage_AddFilesLabel" Text="Add files"/>
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="ConverterPage_AddFolderMenuItem"
                                            Text="Add folder"
                                            Click="BrowseFolder_Click"
                                            AutomationProperties.AutomationId="ConverterAddFolderMenuItem"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button x:Uid="ConverterPage_ConvertAction" x:Name="ConvertButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ConvertButton_Click" IsEnabled="False"
                        AutomationProperties.AutomationId="ConvertButton">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Uid="ConverterPage_Item_001_2" Text="Convert"/>
                        <FontIcon Glyph="&#xE72A;" FontSize="16"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderThickness="0"
                    CornerRadius="10"
                    Padding="0"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="ConverterPage_ConverterPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="ConverterPagePivotItem01">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE896;" FontSize="30"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ConverterPage_Item_012" Text="Add media, images, documents, or archives"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="ConverterPage_Item_013" Text="Drop files here, add a folder, or browse from disk."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Uid="ConverterPage_ConverterPageButton03" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BrowseButton_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="ConverterPageButton03"/>
                            </StackPanel>

                            <Grid x:Name="QueueReviewTable" Visibility="Collapsed" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="0" Padding="12,8" MinWidth="720">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Uid="ConverterPage_SelectAllQueueCheckBox" x:Name="SelectAllQueueCheckBox" Grid.Column="0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsThreeState="True"
                                                  Click="SelectAllQueue_Click"
                                                  AutomationProperties.AutomationId="ConverterSelectAllQueue"
                                                  AutomationProperties.Name="Select all queued files"/>
                                        <TextBlock x:Uid="ConverterPage_Item_015" Grid.Column="1" Text=""
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Uid="ConverterPage_QueueSortFileButton" x:Name="QueueSortFileButton" Grid.Column="2" Content="File"
                                                Tag="file" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortFile"/>
                                        <Button x:Uid="ConverterPage_QueueSortFormatButton" x:Name="QueueSortFormatButton" Grid.Column="3" Content="Format"
                                                Tag="format" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortFormat"/>
                                        <Button x:Uid="ConverterPage_QueueSortSizeButton" x:Name="QueueSortSizeButton" Grid.Column="4" Content="Size"
                                                Tag="size" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortSize"/>
                                        <Button x:Uid="ConverterPage_QueueSortEstimateButton" x:Name="QueueSortEstimateButton" Grid.Column="5" Content="Est. output"
                                                Tag="estimate" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortEstimate"/>
                                        <Button x:Uid="ConverterPage_QueueSortWarningsButton" x:Name="QueueSortWarningsButton" Grid.Column="6" Content="Status"
                                                Tag="warnings" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortWarnings"/>
                                    </Grid>
                                </Border>

                                <ListView x:Name="FileList" Grid.Row="1"
                                          Background="Transparent"
                                          SelectionMode="None"
                                          ItemTemplate="{StaticResource QueuedFileTemplate}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>

                                <Border Grid.Row="2"
                                        Background="{StaticResource SurfaceLightBrush}"
                                        Padding="10,6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button x:Uid="ConverterPage_MoveSelectedUpButton" x:Name="MoveSelectedUpButton"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="MoveSelectedUp_Click"
                                                    IsEnabled="False"
                                                    AutomationProperties.AutomationId="ConverterMoveSelectedUp"
                                                    AutomationProperties.Name="Move selected files up"
                                                    ToolTipService.ToolTip="Move selected files up">
                                                <FontIcon Glyph="&#xE74A;" FontSize="16"/>
                                            </Button>
                                            <Button x:Uid="ConverterPage_MoveSelectedDownButton" x:Name="MoveSelectedDownButton"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="MoveSelectedDown_Click"
                                                    IsEnabled="False"
                                                    AutomationProperties.AutomationId="ConverterMoveSelectedDown"
                                                    AutomationProperties.Name="Move selected files down"
                                                    ToolTipService.ToolTip="Move selected files down">
                                                <FontIcon Glyph="&#xE74B;" FontSize="16"/>
                                            </Button>
                                            <Button x:Uid="ConverterPage_RemoveSelectedButton" x:Name="RemoveSelectedButton"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="RemoveSelected_Click"
                                                    IsEnabled="False"
                                                    AutomationProperties.AutomationId="ConverterRemoveSelected"
                                                    AutomationProperties.Name="Remove selected files"
                                                    ToolTipService.ToolTip="Remove selected files">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Uid="ConverterPage_QueueSummaryText" x:Name="QueueSummaryText"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="0 files"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="ConverterPage_ConverterPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="ConverterPagePivotItem02">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="30"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ConverterPage_Item_022" Text="No finished conversions yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="ConverterPage_Item_023" Text="Completed, failed, and cancelled files appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource FinishedFileTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                <Border x:Name="OutputInspector"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderThickness="0"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ConverterPage_Item_035" Text="Output format" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="ConverterPage_FormatSelector" x:Name="FormatSelector"
                                  Header="Format"
                                  PlaceholderText="Select format"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FormatSelector_SelectionChanged"
                            AutomationProperties.AutomationId="FormatSelector">
                            <ComboBoxItem x:Uid="ConverterPage_Item_037" Content="MP4 - Video" Tag="mp4"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_038" Content="MKV - Video" Tag="mkv"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_039" Content="MOV - Video" Tag="mov"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_040" Content="WEBM - Video" Tag="webm"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_041" Content="MP3 - Audio" Tag="mp3"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_042" Content="WAV - Audio" Tag="wav"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_043" Content="FLAC - Audio" Tag="flac"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_044" Content="AAC - Audio" Tag="aac"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_045" Content="PNG - Image" Tag="png"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_046" Content="JPG - Image" Tag="jpg"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_047" Content="WEBP - Image" Tag="webp"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_048" Content="AVIF - Image" Tag="avif"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_049" Content="GIF - Image" Tag="gif"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_050" Content="PDF - Document" Tag="pdf"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_051" Content="DOCX - Document" Tag="docx"/>
                        </ComboBox>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Uid="ConverterPage_QualityPresetSelector" x:Name="QualityPresetSelector" Grid.Column="0"
                                      Header="Preset"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OutputProfile_SelectionChanged"
                                      AutomationProperties.AutomationId="QualityPresetSelector">
                                <ComboBoxItem x:Uid="ConverterPage_Item_003_2" Content="High quality (recommended)" Tag="High" IsSelected="True"/>
                                <ComboBoxItem x:Uid="ConverterPage_Item_004_2" Content="Highest quality" Tag="Highest"/>
                                <ComboBoxItem x:Uid="ConverterPage_Item_005_2" Content="Balanced" Tag="Medium"/>
                                <ComboBoxItem x:Uid="ConverterPage_Item_006_2" Content="Smaller file" Tag="Low"/>
                            </ComboBox>
                            <Button x:Uid="ConverterPage_OutputSettingsButton" Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OpenAdvancedSettings_Click"
                                    AutomationProperties.AutomationId="ConverterOutputSettingsButton"
                                    AutomationProperties.Name="Open advanced output settings"
                                    ToolTipService.ToolTip="Advanced output settings">
                                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            </Button>
                        </Grid>
                        <ComboBox x:Uid="ConverterPage_ResolutionSelector" x:Name="ResolutionSelector"
                                  Header="Resolution"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OutputProfile_SelectionChanged"
                                  AutomationProperties.AutomationId="ResolutionSelector">
                            <ComboBoxItem x:Uid="ConverterPage_Item_008_2" Content="Same as source" Tag="source" IsSelected="True"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_009" Content="4K (3840 x 2160)" Tag="3840x2160"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_010" Content="Full HD (1920 x 1080)" Tag="1920x1080"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_011" Content="HD (1280 x 720)" Tag="1280x720"/>
                        </ComboBox>
                        <ComboBox x:Uid="ConverterPage_FrameRateSelector" x:Name="FrameRateSelector"
                                  Header="Frame rate"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OutputProfile_SelectionChanged"
                                  AutomationProperties.AutomationId="FrameRateSelector">
                            <ComboBoxItem x:Uid="ConverterPage_Item_013_2" Content="Same as source" Tag="source" IsSelected="True"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_014" Content="60 fps" Tag="60"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_015_2" Content="30 fps" Tag="30"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_016" Content="24 fps" Tag="24"/>
                        </ComboBox>
                        <ComboBox x:Uid="ConverterPage_AudioSelector" x:Name="AudioSelector"
                                  Header="Audio"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OutputProfile_SelectionChanged"
                                  AutomationProperties.AutomationId="AudioSelector">
                            <ComboBoxItem x:Uid="ConverterPage_Item_018" Content="AAC, 320 kbps, stereo" Tag="aac-320-2" IsSelected="True"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_019" Content="AAC, 192 kbps, stereo" Tag="aac-192-2"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_020" Content="AAC, 128 kbps, stereo" Tag="aac-128-2"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_021" Content="Automatic" Tag="source"/>
                        </ComboBox>
                        <Border Style="{StaticResource SectionDividerStyle}" Margin="0,4"/>
                        <TextBlock x:Uid="ConverterPage_Item_022_2" Text="Save to" Style="{StaticResource PanelTitleTextStyle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="ConverterPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                     Grid.Column="0"
                                     PlaceholderText="Same as source folder"
                                     IsReadOnly="True"
                                     AutomationProperties.AutomationId="OutputDirectoryBox"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton07" Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                    AutomationProperties.AutomationId="ConverterOutputFolderButton"
                                    AutomationProperties.Name="Choose output folder"
                                    ToolTipService.ToolTip="Choose output folder">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                            </Button>
                        </Grid>
                        <CheckBox x:Uid="ConverterPage_SameAsSourceFolderCheckBox" x:Name="SameAsSourceFolderCheckBox"
                                  Content="Same as source folder"
                                  IsChecked="True"
                                  Checked="SameAsSourceFolder_Changed"
                                  Unchecked="SameAsSourceFolder_Changed"
                                  AutomationProperties.AutomationId="SameAsSourceFolderCheckBox"/>
                        <CheckBox x:Uid="ConverterPage_OpenOutputAfterConversionCheckBox" x:Name="OpenOutputAfterConversionCheckBox"
                                  Content="Open output folder after conversion"
                                  Click="OutputPreference_Changed"
                                  AutomationProperties.AutomationId="OpenOutputAfterConversionCheckBox"/>
                        <Border Style="{StaticResource SectionDividerStyle}" Margin="0,4"/>
                <Expander x:Uid="ConverterPage_Item_025" Header="More output options"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="0,10,0,0">
                        <TextBlock x:Uid="ConverterPage_Item_024" Text="Format Shortcuts" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="ConverterPage_RecommendationText" x:Name="RecommendationText"
                                   Text="Add files to receive a local output recommendation."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button x:Uid="ConverterPage_SmartMatchButton" x:Name="SmartMatchButton"
                                    Grid.Row="0" Grid.Column="0"
                                    Content="Smart Match"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SmartMatch_Click"
                                    IsEnabled="False"
                                AutomationProperties.AutomationId="SmartMatchButton"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton04" Grid.Row="0" Grid.Column="1"
                                    Content="Web MP4"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Tag="mp4"
                                    Click="ProfileShortcut_Click"
                                AutomationProperties.AutomationId="ConverterPageButton04"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton05" Grid.Row="1" Grid.Column="0"
                                    Content="Audio MP3"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Tag="mp3"
                                    Click="ProfileShortcut_Click"
                                AutomationProperties.AutomationId="ConverterPageButton05"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton06" Grid.Row="1" Grid.Column="1"
                                    Content="Image WebP"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Tag="webp"
                                    Click="ProfileShortcut_Click"
                                AutomationProperties.AutomationId="ConverterPageButton06"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander x:Uid="ConverterPage_AdvancedFfmpegExpander" x:Name="AdvancedFfmpegExpander"
                          Header="Advanced FFmpeg command"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="ConverterAdvancedFfmpegExpander">
                    <StackPanel Spacing="10" Padding="0,12,0,0">
                        <TextBlock x:Uid="ConverterPage_Item_031" Text="The preview is a batch-safe template. Each job replaces {input} and {output} with its own paths."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <ToggleSwitch x:Uid="ConverterPage_HighSpeedToggle" x:Name="HighSpeedToggle"
                                      Header="High speed conversion"
                                      OffContent="Software routing"
                                      OnContent="Use fastest available backend"
                                      IsOn="True"
                                      IsEnabled="False"
                                      AutomationProperties.AutomationId="HighSpeedToggle"/>
                        <ToggleSwitch x:Uid="ConverterPage_EditFfmpegCommandToggle" x:Name="EditFfmpegCommandToggle"
                                      Header="Edit before run"
                                      OffContent="Read-only"
                                      OnContent="Custom argument vector"
                                      IsEnabled="False"
                                      Toggled="EditFfmpegCommandToggle_Toggled"
                                      AutomationProperties.AutomationId="EditFfmpegCommandToggle"/>
                        <TextBox x:Uid="ConverterPage_FfmpegCommandBox" x:Name="FfmpegCommandBox"
                                 Header="Command template"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="112"
                                 MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextChanged="FfmpegCommandBox_TextChanged"
                                 AutomationProperties.AutomationId="FfmpegCommandBox"/>
                        <InfoBar x:Uid="ConverterPage_FfmpegCommandInfoBar" x:Name="FfmpegCommandInfoBar"
                                 IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Command preview"
                                 Message="Add a media file and choose an FFmpeg-compatible output."
                                 AutomationProperties.AutomationId="FfmpegCommandInfoBar"/>
                    </StackPanel>
                </Expander>
                </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Ellipse Width="7" Height="7"
                         Fill="{StaticResource AccentGreenBrush}"
                         VerticalAlignment="Center"/>
                <TextBlock x:Uid="ConverterPage_StatusText" x:Name="StatusText"
                           Text="Ready"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="FooterStatusText" Grid.Column="1"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="560">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="ConverterPage_ProgressTitle" x:Name="ProgressTitle" Text="Converting..."
                               Style="{StaticResource TitleTextStyle}"/>

                    <ProgressBar x:Uid="ConverterPage_ConversionProgress" AutomationProperties.Name="Progress" x:Name="ConversionProgress"
                                 Height="8"
                                 CornerRadius="4"
                                 Minimum="0"
                                 Maximum="100"/>

                    <TextBlock x:Name="ProgressStatus"
                               Style="{StaticResource SubtitleTextStyle}"/>

                    <TextBlock x:Name="ProgressDetails"
                               Style="{StaticResource MutedTextStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Uid="ConverterPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="CancelButton_Click"
                            AutomationProperties.AutomationId="CancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
