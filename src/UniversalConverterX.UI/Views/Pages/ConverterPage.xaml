<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="QueuedFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FileSize}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding FormatSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Border>

                    <Button Grid.Column="3" Grid.Row="0"
                            Background="Transparent" BorderThickness="0"
                            Click="RemoveFile_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="12"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="86" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FinishedFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Converter" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Queue files, choose one output profile, and review finished results."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Add Files" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseButton_Click"/>
                <Button Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem Header="Converting">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE896;" FontSize="48"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock Text="Add media, images, documents, or archives"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Drop files here, add a folder, or browse from disk."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BrowseButton_Click"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource QueuedFileTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem Header="Finished">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <FontIcon Glyph="&#xE73E;" FontSize="42"
                                          Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="No finished conversions yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Completed, failed, and cancelled files appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource FinishedFileTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Output Profile" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="FormatSelector"
                                  Header="Convert all files to"
                                  PlaceholderText="Select format"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FormatSelector_SelectionChanged">
                            <ComboBoxItem Content="MP4 - Video" Tag="mp4"/>
                            <ComboBoxItem Content="MKV - Video" Tag="mkv"/>
                            <ComboBoxItem Content="MOV - Video" Tag="mov"/>
                            <ComboBoxItem Content="WEBM - Video" Tag="webm"/>
                            <ComboBoxItem Content="MP3 - Audio" Tag="mp3"/>
                            <ComboBoxItem Content="WAV - Audio" Tag="wav"/>
                            <ComboBoxItem Content="FLAC - Audio" Tag="flac"/>
                            <ComboBoxItem Content="AAC - Audio" Tag="aac"/>
                            <ComboBoxItem Content="PNG - Image" Tag="png"/>
                            <ComboBoxItem Content="JPG - Image" Tag="jpg"/>
                            <ComboBoxItem Content="WEBP - Image" Tag="webp"/>
                            <ComboBoxItem Content="AVIF - Image" Tag="avif"/>
                            <ComboBoxItem Content="GIF - Image" Tag="gif"/>
                            <ComboBoxItem Content="PDF - Document" Tag="pdf"/>
                            <ComboBoxItem Content="DOCX - Document" Tag="docx"/>
                        </ComboBox>
                        <ToggleSwitch x:Name="HighSpeedToggle"
                                      Header="High speed conversion"
                                      OffContent="Software routing"
                                      OnContent="Use fastest available backend"
                                      IsOn="True"
                                      IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="File Location" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBox x:Name="OutputDirectoryBox"
                                 Header="Save to"
                                 PlaceholderText="Same as source file"
                                 IsReadOnly="True"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"/>
                            <Button Grid.Column="1" Content="Same as source"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Batch Summary" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="QueueSummaryText" Text="0 queued"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Add files to start a conversion queue."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Clear Queue"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ClearAll_Click" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Content="Open Output"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click" Margin="0,0,12,0"/>
            <Button x:Name="ConvertButton" Grid.Column="3" Content="Convert All"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ConvertButton_Click" IsEnabled="False"/>
        </Grid>

        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#80000000">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="560">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="ProgressTitle" Text="Converting..."
                               Style="{StaticResource TitleTextStyle}"/>

                    <ProgressBar x:Name="ConversionProgress"
                                 Height="8"
                                 CornerRadius="4"
                                 Minimum="0"
                                 Maximum="100"/>

                    <TextBlock x:Name="ProgressStatus"
                               Style="{StaticResource SubtitleTextStyle}"/>

                    <TextBlock x:Name="ProgressDetails"
                               Style="{StaticResource MutedTextStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
