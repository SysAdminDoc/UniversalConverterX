<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="QueuedFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,8"
                    MinWidth="720">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="48" Height="48" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8A5;" FontSize="20"
                                      Visibility="{Binding ThumbnailPlaceholderVisibility}"
                                      Foreground="{StaticResource AccentBlueBrush}"/>
                            <Image x:Uid="ConverterPage_Item_001" Source="{Binding ThumbnailSource}"
                                   Visibility="{Binding ThumbnailVisibility}"
                                   Stretch="UniformToFill"
                                   AutomationProperties.Name="File preview thumbnail"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Path}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="11"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Grid.Row="0"
                               Text="{Binding FormatSummary}"
                               Style="{StaticResource MutedTextStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="11"/>

                    <TextBlock Grid.Column="3" Grid.Row="0"
                               Text="{Binding FileSize}"
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center" FontSize="11"/>

                    <TextBlock x:Uid="ConverterPage_Item_002" Grid.Column="4" Grid.Row="0"
                               Text="{Binding EstimatedSizeLabel}"
                               Style="{StaticResource MutedTextStyle}" FontSize="11"
                               Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasEstimatedSize}"
                               AutomationProperties.Name="Estimated output size"
                               ToolTipService.ToolTip="{Binding EstimatedSizeCaveat}"/>

                    <StackPanel Grid.Column="5" Grid.Row="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5"
                                    Visibility="{Binding WarningVisibility}"
                                    ToolTipService.ToolTip="{Binding WarningSummary}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                      Foreground="{StaticResource AccentOrangeBrush}"/>
                            <TextBlock Text="{Binding WarningBadgeText}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Foreground="{StaticResource AccentOrangeBrush}"
                                       TextTrimming="CharacterEllipsis" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Uid="ConverterPage_Item_003" Text="Ready"
                                   Visibility="{Binding ReadyVisibility}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   FontSize="11"/>
                    </StackPanel>

                    <Button x:Uid="ConverterPage_Item_004" Grid.Column="6" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="6" Grid.Row="1">
                        <ProgressBar x:Uid="ConverterPage_Item_005" AutomationProperties.Name="Progress" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="7" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FinishedFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSubtleBrush}"/>
                    </StackPanel>
                    <Button x:Uid="ConverterPage_Item_006" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,10"
                            FontSize="12"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock x:Uid="ConverterPage_Item_007" Text="Converter" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock x:Uid="ConverterPage_Item_008" Text="Queue files, choose one output profile, and review finished results."
                           Style="{StaticResource SubtitleTextStyle}" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="ConverterPage_ConverterPageButton01" Content="Add Files" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseButton_Click"
                    AutomationProperties.AutomationId="ConverterPageButton01"/>
                <Button x:Uid="ConverterPage_ConverterPageButton02" Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="ConverterPageButton02"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="ConverterPage_ConverterPagePivotItem01" Header="Converting"
                        AutomationProperties.AutomationId="ConverterPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE896;" FontSize="48"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ConverterPage_Item_012" Text="Add media, images, documents, or archives"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="ConverterPage_Item_013" Text="Drop files here, add a folder, or browse from disk."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Uid="ConverterPage_ConverterPageButton03" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BrowseButton_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="ConverterPageButton03"/>
                            </StackPanel>

                            <Grid x:Name="QueueReviewTable" Visibility="Collapsed" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="10" Padding="12,7" MinWidth="720">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="ConverterPage_Item_015" Grid.Column="0" Text="Preview"
                                                   Style="{StaticResource MutedTextStyle}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Uid="ConverterPage_QueueSortFileButton" x:Name="QueueSortFileButton" Grid.Column="1" Content="File ↑"
                                                Tag="file" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortFile"/>
                                        <Button x:Uid="ConverterPage_QueueSortFormatButton" x:Name="QueueSortFormatButton" Grid.Column="2" Content="Format"
                                                Tag="format" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortFormat"/>
                                        <Button x:Uid="ConverterPage_QueueSortSizeButton" x:Name="QueueSortSizeButton" Grid.Column="3" Content="Size"
                                                Tag="size" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortSize"/>
                                        <Button x:Uid="ConverterPage_QueueSortEstimateButton" x:Name="QueueSortEstimateButton" Grid.Column="4" Content="Est. output"
                                                Tag="estimate" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortEstimate"/>
                                        <Button x:Uid="ConverterPage_QueueSortWarningsButton" x:Name="QueueSortWarningsButton" Grid.Column="5" Content="Warnings"
                                                Tag="warnings" Click="QueueSort_Click"
                                                Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ConverterQueueSortWarnings"/>
                                    </Grid>
                                </Border>

                                <ListView x:Name="FileList" Grid.Row="1"
                                          Background="Transparent"
                                          SelectionMode="None"
                                          ItemTemplate="{StaticResource QueuedFileTemplate}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="ConverterPage_ConverterPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="ConverterPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ConverterPage_Item_022" Text="No finished conversions yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="ConverterPage_Item_023" Text="Completed, failed, and cancelled files appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource FinishedFileTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ConverterPage_Item_024" Text="Format Shortcuts" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="ConverterPage_RecommendationText" x:Name="RecommendationText"
                                   Text="Add files to receive a local output recommendation."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button x:Uid="ConverterPage_SmartMatchButton" x:Name="SmartMatchButton"
                                    Grid.Row="0" Grid.Column="0"
                                    Content="Smart Match"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SmartMatch_Click"
                                    IsEnabled="False"
                                AutomationProperties.AutomationId="SmartMatchButton"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton04" Grid.Row="0" Grid.Column="1"
                                    Content="Web MP4"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Tag="mp4"
                                    Click="ProfileShortcut_Click"
                                AutomationProperties.AutomationId="ConverterPageButton04"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton05" Grid.Row="1" Grid.Column="0"
                                    Content="Audio MP3"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Tag="mp3"
                                    Click="ProfileShortcut_Click"
                                AutomationProperties.AutomationId="ConverterPageButton05"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton06" Grid.Row="1" Grid.Column="1"
                                    Content="Image WebP"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Tag="webp"
                                    Click="ProfileShortcut_Click"
                                AutomationProperties.AutomationId="ConverterPageButton06"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander x:Uid="ConverterPage_AdvancedFfmpegExpander" x:Name="AdvancedFfmpegExpander"
                          Header="Advanced FFmpeg command"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="ConverterAdvancedFfmpegExpander">
                    <StackPanel Spacing="10" Padding="0,12,0,0">
                        <TextBlock x:Uid="ConverterPage_Item_031" Text="The preview is a batch-safe template. Each job replaces {input} and {output} with its own paths."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <ToggleSwitch x:Uid="ConverterPage_EditFfmpegCommandToggle" x:Name="EditFfmpegCommandToggle"
                                      Header="Edit before run"
                                      OffContent="Read-only"
                                      OnContent="Custom argument vector"
                                      IsEnabled="False"
                                      Toggled="EditFfmpegCommandToggle_Toggled"
                                      AutomationProperties.AutomationId="EditFfmpegCommandToggle"/>
                        <TextBox x:Uid="ConverterPage_FfmpegCommandBox" x:Name="FfmpegCommandBox"
                                 Header="Command template"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="112"
                                 MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextChanged="FfmpegCommandBox_TextChanged"
                                 AutomationProperties.AutomationId="FfmpegCommandBox"/>
                        <InfoBar x:Uid="ConverterPage_FfmpegCommandInfoBar" x:Name="FfmpegCommandInfoBar"
                                 IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Command preview"
                                 Message="Add a media file and choose an FFmpeg-compatible output."
                                 AutomationProperties.AutomationId="FfmpegCommandInfoBar"/>
                    </StackPanel>
                </Expander>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ConverterPage_Item_035" Text="Output Profile" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="ConverterPage_FormatSelector" x:Name="FormatSelector"
                                  Header="Convert all files to"
                                  PlaceholderText="Select format"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="FormatSelector_SelectionChanged"
                            AutomationProperties.AutomationId="FormatSelector">
                            <ComboBoxItem x:Uid="ConverterPage_Item_037" Content="MP4 - Video" Tag="mp4"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_038" Content="MKV - Video" Tag="mkv"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_039" Content="MOV - Video" Tag="mov"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_040" Content="WEBM - Video" Tag="webm"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_041" Content="MP3 - Audio" Tag="mp3"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_042" Content="WAV - Audio" Tag="wav"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_043" Content="FLAC - Audio" Tag="flac"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_044" Content="AAC - Audio" Tag="aac"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_045" Content="PNG - Image" Tag="png"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_046" Content="JPG - Image" Tag="jpg"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_047" Content="WEBP - Image" Tag="webp"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_048" Content="AVIF - Image" Tag="avif"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_049" Content="GIF - Image" Tag="gif"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_050" Content="PDF - Document" Tag="pdf"/>
                            <ComboBoxItem x:Uid="ConverterPage_Item_051" Content="DOCX - Document" Tag="docx"/>
                        </ComboBox>
                        <ToggleSwitch x:Uid="ConverterPage_HighSpeedToggle" x:Name="HighSpeedToggle"
                                      Header="High speed conversion"
                                      OffContent="Software routing"
                                      OnContent="Use fastest available backend"
                                      IsOn="True"
                                      IsEnabled="False"
                            AutomationProperties.AutomationId="HighSpeedToggle"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ConverterPage_Item_053" Text="File Location" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="ConverterPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                 Header="Save to"
                                 PlaceholderText="Same as source file"
                                 IsReadOnly="True"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="ConverterPage_ConverterPageButton07" Grid.Column="0" Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="ConverterPageButton07"/>
                            <Button x:Uid="ConverterPage_ConverterPageButton08" Grid.Column="1" Content="Same as source"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="ConverterPageButton08"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoBannerStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="16"
                                  Foreground="{StaticResource AccentBlueBrush}"
                                  VerticalAlignment="Top"/>
                        <TextBlock x:Uid="ConverterPage_Item_057" Text="The Convert button enables after files and an output profile are selected. Finished results remain visible after the queue clears."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="ConverterPage_Item_058" Text="Batch Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="ConverterPage_QueueSummaryText" x:Name="QueueSummaryText" Text="0 queued"
                                   Style="{StaticResource MetricNumberTextStyle}"
                                   Foreground="{StaticResource AccentBlueBrush}"/>
                        <TextBlock x:Uid="ConverterPage_StatusText" x:Name="StatusText"
                                   Text="Add files to start a conversion queue."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="ConverterPage_ConverterPageButton09" Grid.Column="1" Content="Clear Queue"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="ClearAll_Click" Margin="0,0,12,0"
                AutomationProperties.AutomationId="ConverterPageButton09"/>
            <Button x:Uid="ConverterPage_ConverterPageButton10" Grid.Column="2" Content="Open Output"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click" Margin="0,0,12,0"
                AutomationProperties.AutomationId="ConverterPageButton10"/>
            <Button x:Uid="ConverterPage_ConvertButton" x:Name="ConvertButton" Grid.Column="3" Content="Convert All"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ConvertButton_Click" IsEnabled="False"
                AutomationProperties.AutomationId="ConvertButton"/>
        </Grid>

        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="560">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="ConverterPage_ProgressTitle" x:Name="ProgressTitle" Text="Converting..."
                               Style="{StaticResource TitleTextStyle}"/>

                    <ProgressBar x:Uid="ConverterPage_ConversionProgress" AutomationProperties.Name="Progress" x:Name="ConversionProgress"
                                 Height="8"
                                 CornerRadius="4"
                                 Minimum="0"
                                 Maximum="100"/>

                    <TextBlock x:Name="ProgressStatus"
                               Style="{StaticResource SubtitleTextStyle}"/>

                    <TextBlock x:Name="ProgressDetails"
                               Style="{StaticResource MutedTextStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Uid="ConverterPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="CancelButton_Click"
                            AutomationProperties.AutomationId="CancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
