<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.LosslessCutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="LosslessCutPage_Item_001" Text="Lossless Cut" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="LosslessCutPage_Item_002" Text="Cut a clip on keyframe boundaries with no re-encode — a stream copy that keeps the exact source quality."
                           Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap"
                           MaxWidth="820"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="LosslessCutPage_LosslessCutOpenButton" Content="Open Video" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="LosslessCutOpenButton"
                        Click="Open_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Preview + timeline -->
            <Border x:Name="DropZone" Grid.Column="0" Style="{StaticResource CardStyle}"
                    CornerRadius="12" Padding="18" AllowDrop="True"
                    DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <Grid>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12">
                        <Border Width="72" Height="72" CornerRadius="18"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xE8C6;" FontSize="30"
                                      Foreground="{StaticResource AccentGreenBrush}"/>
                        </Border>
                        <TextBlock x:Uid="LosslessCutPage_Item_004" Text="Drop a video to cut"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="LosslessCutPage_Item_005" Text="MP4, MKV, MOV, AVI, WebM, TS and more. Lossless cutting keeps the original codec untouched."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="460"/>
                        <Button x:Uid="LosslessCutPage_Item_006" Content="Open Video" Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="LosslessCutOpenEmptyButton"
                                HorizontalAlignment="Center" Click="Open_Click"/>
                    </StackPanel>

                    <Grid x:Name="EditorPanel" Visibility="Collapsed" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Frame preview -->
                        <Border Grid.Row="0" CornerRadius="12" Background="Black"
                                MinHeight="220">
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   AutomationProperties.AutomationId="LosslessCutPreviewImage"/>
                        </Border>

                        <!-- Thumbnail strip with selection + playhead overlay -->
                        <Grid Grid.Row="1" Height="76" SizeChanged="Timeline_SizeChanged">
                            <Border CornerRadius="8" Background="{StaticResource SurfaceLightBrush}"
                                    Padding="1">
                                <ItemsControl x:Name="ThumbStrip">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Image}" Stretch="UniformToFill"
                                                   Width="{Binding Width}" Height="72"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Canvas x:Name="OverlayCanvas" Background="Transparent"
                                    PointerPressed="Overlay_PointerPressed"
                                    PointerMoved="Overlay_PointerMoved"
                                    PointerReleased="Overlay_PointerReleased">
                                <Rectangle x:Name="SelectionBand" Height="76"
                                           Fill="{StaticResource AccentGreenBrush}" Opacity="0.28"/>
                                <Rectangle x:Name="Playhead" Width="2" Height="76"
                                           Fill="{StaticResource AccentRedBrush}"
                                           Stroke="{StaticResource TextInverseBrush}"
                                           StrokeThickness="1"/>
                            </Canvas>
                        </Grid>

                        <!-- Scrub slider -->
                        <Slider x:Name="ScrubSlider" Grid.Row="2" Minimum="0" Maximum="1000"
                                StepFrequency="1" Value="0"
                                AutomationProperties.AutomationId="LosslessCutScrubSlider"
                                ValueChanged="Scrub_ValueChanged"/>

                        <!-- In / Out summary -->
                        <Grid Grid.Row="3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="8" Background="{StaticResource SurfaceLightBrush}" Padding="10,6">
                                <StackPanel>
                                    <TextBlock x:Uid="LosslessCutPage_Item_007" Text="IN" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock x:Uid="LosslessCutPage_InLabel" x:Name="InLabel" Text="00:00.000"
                                               Style="{StaticResource LabelTextStyle}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Uid="LosslessCutPage_PlayheadLabel" Grid.Column="1" x:Name="PlayheadLabel" Text="00:00.000"
                                       VerticalAlignment="Center" FontFamily="Consolas"
                                       Style="{StaticResource MutedTextStyle}"/>
                            <Border Grid.Column="2" CornerRadius="8" Background="{StaticResource SurfaceLightBrush}" Padding="10,6">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock x:Uid="LosslessCutPage_Item_010" Text="OUT" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Uid="LosslessCutPage_OutLabel" x:Name="OutLabel" Text="00:00.000"
                                               Style="{StaticResource LabelTextStyle}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Controls -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="0,0,4,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="LosslessCutPage_Item_012" Text="Cut points" Style="{StaticResource PanelTitleTextStyle}"/>
                            <Button x:Uid="LosslessCutPage_LosslessCutSetInButton" Content="Set In to playhead" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="LosslessCutSetInButton"
                                    Click="SetIn_Click"/>
                            <Button x:Uid="LosslessCutPage_LosslessCutSetOutButton" Content="Set Out to playhead" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="LosslessCutSetOutButton"
                                    Click="SetOut_Click"/>
                            <TextBlock x:Uid="LosslessCutPage_SelectionSummary" x:Name="SelectionSummary" Text="Whole clip"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="LosslessCutPage_Item_016" Text="Mode" Style="{StaticResource PanelTitleTextStyle}"/>
                            <ToggleSwitch x:Uid="LosslessCutPage_LosslessToggle" x:Name="LosslessToggle" IsOn="True"
                                          Header="Lossless (stream copy)"
                                          OnContent="On — snaps to keyframes"
                                          OffContent="Off — re-encode for frame-exact cuts"
                                          AutomationProperties.AutomationId="LosslessCutModeToggle"
                                          Toggled="Lossless_Toggled"/>
                            <TextBlock x:Uid="LosslessCutPage_KeyframeHint" x:Name="KeyframeHint" Text="Keyframes: —"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="LosslessCutPage_Item_019" Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                            <TextBox x:Uid="LosslessCutPage_OutputBox" x:Name="OutputBox" Header="Destination file" IsReadOnly="True"
                                     PlaceholderText="Choose an output file…"
                                     AutomationProperties.AutomationId="LosslessCutOutputBox"/>
                            <Button x:Uid="LosslessCutPage_Item_021" Content="Choose output…" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="LosslessCutChooseOutputButton"
                                    Click="ChooseOutput_Click"/>
                        </StackPanel>
                    </Border>

                    <Button x:Uid="LosslessCutPage_ExportButton" x:Name="ExportButton" Content="Export cut" HorizontalAlignment="Stretch"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                            AutomationProperties.AutomationId="LosslessCutExportButton"
                            Click="Export_Click"/>
                    <Button x:Uid="LosslessCutPage_CancelButton" x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Stretch"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            AutomationProperties.AutomationId="LosslessCutCancelButton"
                            Click="Cancel_Click"/>
                    <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,12">
            <TextBlock x:Uid="LosslessCutPage_StatusText" x:Name="StatusText" Text="Open a video to begin."
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
