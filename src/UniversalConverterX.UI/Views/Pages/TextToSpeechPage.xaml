<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.TextToSpeechPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="TEXT TO SPEECH"
                           Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Text="Generate voiceover audio from script text using Microsoft Edge Neural TTS — 322 voices, 50+ languages."
                           Style="{StaticResource TitleTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720" LineHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Refresh Voices"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshVoices_Click"
                    AutomationProperties.AutomationId="TextToSpeechPageButton01"/>
                <Button x:Name="GenerateButton"
                        Content="Generate Audio"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Generate_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="GenerateButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" CornerRadius="22" Padding="18">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Script" Style="{StaticResource PanelTitleTextStyle}"/>

                    <TextBox x:Name="ScriptBox"
                             Grid.Row="1"
                             PlaceholderText="Type or paste your script text here..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             MinHeight="320"
                             Style="{StaticResource PremiumTextBoxStyle}"
                             TextChanged="ScriptBox_TextChanged"
                        AutomationProperties.AutomationId="ScriptBox"/>

                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CharCountLabel"
                                   Grid.Column="0"
                                   Text="0 characters"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center"/>
                        <ProgressBar AutomationProperties.Name="Progress" x:Name="ProgressBar"
                                     Grid.Column="1"
                                     Width="220"
                                     Height="6"
                                     CornerRadius="3"
                                     Visibility="Collapsed"
                                     Minimum="0"
                                     Maximum="100"/>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Voice" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="LocaleCombo"
                                  Header="Locale filter"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="LocaleCombo_SelectionChanged"
                            AutomationProperties.AutomationId="LocaleCombo">
                            <ComboBoxItem Content="English (any)" Tag="en"/>
                            <ComboBoxItem Content="English (US)" Tag="en-US"/>
                            <ComboBoxItem Content="English (UK)" Tag="en-GB"/>
                            <ComboBoxItem Content="English (AU)" Tag="en-AU"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="French" Tag="fr"/>
                            <ComboBoxItem Content="German" Tag="de"/>
                            <ComboBoxItem Content="Italian" Tag="it"/>
                            <ComboBoxItem Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Chinese" Tag="zh"/>
                            <ComboBoxItem Content="Russian" Tag="ru"/>
                            <ComboBoxItem Content="(all locales)" Tag=""/>
                        </ComboBox>
                        <ComboBox x:Name="VoiceCombo"
                                  Header="Voice"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Loading..."
                                  SelectionChanged="VoiceCombo_SelectionChanged"
                            AutomationProperties.AutomationId="VoiceCombo"/>
                        <TextBlock x:Name="VoiceMetaText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Delivery" Style="{StaticResource PanelTitleTextStyle}"/>
                        <Slider x:Name="RateSlider"
                                Header="Rate"
                                Minimum="-50" Maximum="100" Value="0"
                                StepFrequency="5"
                                ValueChanged="Setting_Slider_Changed"
                            AutomationProperties.AutomationId="RateSlider"/>
                        <TextBlock x:Name="RateLabel"
                                   Text="0% (normal)"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Right"/>
                        <Slider x:Name="PitchSlider"
                                Header="Pitch (Hz)"
                                Minimum="-50" Maximum="50" Value="0"
                                StepFrequency="5"
                                ValueChanged="Setting_Slider_Changed"
                            AutomationProperties.AutomationId="PitchSlider"/>
                        <TextBlock x:Name="PitchLabel"
                                   Text="0 Hz"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="FormatCombo"
                                  Header="Format"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Setting_Combo_Changed"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem Content="MP3" Tag=".mp3"/>
                            <ComboBoxItem Content="WAV" Tag=".wav"/>
                            <ComboBoxItem Content="FLAC" Tag=".flac"/>
                            <ComboBoxItem Content="OGG Vorbis" Tag=".ogg"/>
                            <ComboBoxItem Content="Opus" Tag=".opus"/>
                            <ComboBoxItem Content="AAC (.m4a)" Tag=".m4a"/>
                        </ComboBox>
                        <Button Content="Save to..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ChooseOutput_Click"
                                HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="TextToSpeechPageButton02"/>
                        <TextBlock x:Name="OutputPathText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1"
                    Content="Open Output"
                    x:Name="OpenOutputButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="OpenOutput_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="OpenOutputButton"/>
            <Button Grid.Column="2"
                    Content="Cancel"
                    x:Name="CancelButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
