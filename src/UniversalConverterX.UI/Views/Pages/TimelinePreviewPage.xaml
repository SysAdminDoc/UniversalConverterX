<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.TimelinePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:UniversalConverterX.UI.Views.Pages"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ThumbTemplate" x:DataType="p:TimelineThumb">
            <Grid Width="120" Height="80" Margin="0,0,2,0">
                <Border Background="{StaticResource SurfaceLightBrush}"
                        CornerRadius="6"/>
                <Image Source="{x:Bind ImagePath}"
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
                <Border VerticalAlignment="Bottom"
                        Background="#80000000"
                        CornerRadius="0,0,6,6"
                        Padding="4,2">
                    <TextBlock Text="{x:Bind TimecodeLabel}"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               FontSize="10"
                               Foreground="White"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Timeline Preview"
                           Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Generate a thumbnail strip + audio waveform image for any video. Useful for visually scrubbing long clips before sending them through ClipForge or VideoCrush. Output drops to a per-clip folder under %TEMP% by default; use Export to move it next to the source."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Open Video"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OpenFile_Click"/>
                <Button x:Name="GenerateButton"
                        Content="Generate"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Generate_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="ThumbFpsBox"
                           Header="Thumbnail rate (per second)"
                           Value="1"
                           Minimum="0.1" Maximum="10"
                           SmallChange="0.1" LargeChange="1"
                           SpinButtonPlacementMode="Inline"/>
                <NumberBox Grid.Column="1"
                           x:Name="ThumbHeightBox"
                           Header="Thumbnail height (px)"
                           Value="72"
                           Minimum="24" Maximum="240"
                           SmallChange="1" LargeChange="8"
                           SpinButtonPlacementMode="Inline"/>
            </Grid>
        </Border>

        <ProgressBar AutomationProperties.Name="Progress" Grid.Row="2"
                     x:Name="GenProgress"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"/>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE71D;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock Text="No timeline yet"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Open a video and click Generate to render a scrubbable thumbnail strip + waveform."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420"/>
                </StackPanel>
                <StackPanel x:Name="TimelineRoot" Spacing="14" Visibility="Collapsed">
                    <ScrollViewer x:Name="ThumbStripScroll"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled">
                        <ItemsControl x:Name="ThumbStrip"
                                      ItemTemplate="{StaticResource ThumbTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border CornerRadius="8"
                            Background="{StaticResource SurfaceLightBrush}"
                            Padding="2"
                            MinHeight="84">
                        <Image x:Name="WaveformImage"
                               Stretch="Fill"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Slider Grid.Row="4"
                x:Name="SeekSlider"
                Minimum="0" Maximum="100" Value="0"
                IsEnabled="False"
                ValueChanged="SeekSlider_ValueChanged"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SeekLabel"
                       Style="{StaticResource MutedTextStyle}"
                       Text="00:00.000 / 00:00.000"
                       FontFamily="Consolas, Cascadia Mono, monospace"/>
            <Button Grid.Column="1"
                    x:Name="ExportButton"
                    Content="Open output folder"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Export_Click"
                    IsEnabled="False"/>
        </Grid>

        <TextBlock Grid.Row="6"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Open a video to begin."/>
    </Grid>
</Page>
