<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.AiLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="AiToolTemplate">
            <Border Width="264" Height="170" Padding="18" Margin="0,0,14,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Padding="8,3" CornerRadius="10"
                                Background="{StaticResource SurfaceLightBrush}">
                            <TextBlock Text="{Binding Phase}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding PhaseBrush}"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="5">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="{Binding Description}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="3"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding WorkflowHint}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Padding="32" RowSpacing="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="24" Padding="32">
                <Grid ColumnSpacing="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="14">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18"
                                Padding="12,5" HorizontalAlignment="Left">
                            <TextBlock Text="AI LAB"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="AI tools show readiness before you start."
                                   Style="{StaticResource HeroTextStyle}"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                        <TextBlock Text="Ready tools open directly. Planned tools stay clear about missing engine, preview, export, and recovery work."
                                   Style="{StaticResource SubtitleTextStyle}"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button Content="Open Toolbox" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenToolbox_Click"/>
                            <Button Content="Start Converter" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenConverter_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="22">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Availability" Style="{StaticResource PanelTitleTextStyle}"/>
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{StaticResource AccentGreenBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Ready - Background Remover"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="6"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <TextBlock Text="Ready" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{StaticResource AccentOrangeBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Planned - engine and UI work"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="6"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <TextBlock Text="Planned" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentOrangeBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{StaticResource TextMutedBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Future - scope not final"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="6"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <TextBlock Text="Roadmap" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="A tool is marked Ready only when import, preview, batch export, and failure recovery are explicit."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AI Tools" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Open status or ready workflow" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="AiToolsGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AiTool_Click"
                          ItemTemplate="{StaticResource AiToolTemplate}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="22">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="1. Import" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="Drop media, inspect streams, detect duration, codec, subtitles, and workflow fit."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="2. Preview" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="Show before/after frames, estimated storage, model requirements, and fallback behavior."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="3. Export" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="Queue batch output with format presets, alpha/subtitle handling, and clear partial-success results."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
