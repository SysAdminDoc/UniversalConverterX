<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.AiLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="AiToolTemplate">
            <Grid Width="248" Height="168" Margin="0,0,10,10"
                  AutomationProperties.Name="{Binding Title}"
                  ToolTipService.ToolTip="{Binding Description}">
                <!-- The solid layer is the deterministic fallback for unsupported materials. -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"/>
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="12"
                        Padding="14">
                    <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding PhaseBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Phase}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding PhaseBrush}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="{Binding Description}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" LineHeight="17"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding WorkflowHint}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Style="{StaticResource PageLayoutStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                    CornerRadius="0" Padding="0">
                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <Border Background="Transparent" CornerRadius="0"
                                Padding="0" HorizontalAlignment="Left">
                            <TextBlock x:Uid="AiLabPage_Item_001" Text="AI Lab"
                                       Style="{StaticResource PageTitleTextStyle}"/>
                        </Border>
                        <TextBlock x:Uid="AiLabPage_Item_002" Text="AI tools show readiness before you start."
                                   Style="{StaticResource PageDescriptionTextStyle}"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                        <TextBlock x:Uid="AiLabPage_Item_003" Text="Ready tools open directly. Planned tools stay clear about missing engine, preview, export, and recovery work."
                                   Style="{StaticResource SubtitleTextStyle}"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button x:Uid="AiLabPage_AiLabPageButton01" Content="Open Toolbox" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenToolbox_Click"
                                AutomationProperties.AutomationId="AiLabPageButton01"/>
                            <Button x:Uid="AiLabPage_AiLabPageButton02" Content="Start Converter" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenConverter_Click"
                                AutomationProperties.AutomationId="AiLabPageButton02"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                            CornerRadius="12" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <TextBlock x:Uid="AiLabPage_Item_006" Text="Availability" Style="{StaticResource PanelTitleTextStyle}"/>
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{StaticResource AccentGreenBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="AiLabPage_Item_007" Grid.Column="1" Text="Ready - Background Remover"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="6"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <TextBlock x:Uid="AiLabPage_Item_008" Text="Ready" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{StaticResource AccentOrangeBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="AiLabPage_Item_009" Grid.Column="1" Text="Planned - engine and UI work"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="6"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <TextBlock x:Uid="AiLabPage_Item_010" Text="Planned" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentOrangeBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{StaticResource TextMutedBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="AiLabPage_Item_011" Grid.Column="1" Text="Future - scope not final"
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="6"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <TextBlock x:Uid="AiLabPage_Item_012" Text="Roadmap" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <TextBlock x:Uid="AiLabPage_Item_013" Text="A tool is marked Ready only when import, preview, batch export, and failure recovery are explicit."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Uid="AiLabPage_Item_014" Text="AI Tools" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock x:Uid="AiLabPage_Item_015" Text="Open status or ready workflow" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="AiToolsGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="AiTool_Click"
                          ItemTemplate="{StaticResource AiToolTemplate}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                    CornerRadius="12" Padding="16" Visibility="Collapsed">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock x:Uid="AiLabPage_Item_016" Text="1. Import" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="AiLabPage_Item_017" Text="Drop media, inspect streams, detect duration, codec, subtitles, and workflow fit."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Uid="AiLabPage_Item_018" Text="2. Preview" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="AiLabPage_Item_019" Text="Show before/after frames, estimated storage, model requirements, and fallback behavior."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock x:Uid="AiLabPage_Item_020" Text="3. Export" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="AiLabPage_Item_021" Text="Queue batch output with format presets, alpha/subtitle handling, and clear partial-success results."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
