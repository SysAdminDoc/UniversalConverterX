<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.RecorderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="RecordingQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE7C8;" FontSize="20"
                                  Foreground="{StaticResource AccentRedBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PresetSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button x:Uid="RecorderPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove session" ToolTipService.ToolTip="Remove session"
                            Click="RemoveQueued_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="RecorderPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6"
                                     CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecordingFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}"
                                  FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="RecorderPage_Item_003" Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="RecorderPage_Item_004" Text="Recorder" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="RecorderPage_Item_005" Text="Record the Windows desktop with local FFmpeg capture, progress, and finished results."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="RecorderPage_RecorderPageButton01" Content="Add Session"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddSession_Click"
                    AutomationProperties.AutomationId="RecorderPageButton01"/>
                <Button x:Uid="RecorderPage_RecordButton" Content="Record All"
                        x:Name="RecordButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="{StaticResource AccentRedBrush}"
                        Click="Record_Click"
                    AutomationProperties.AutomationId="RecordButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="RecorderPage_RecorderPagePivotItem01" Header="Recording"
                        AutomationProperties.AutomationId="RecorderPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="QueueEmpty"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE7C8;" FontSize="48"
                                              Foreground="{StaticResource AccentRedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="RecorderPage_Item_009" Text="Build a recording queue"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="RecorderPage_Item_010" Text="Capture desktop sessions as MP4 files. Select Webcam mode and choose devices from the panel."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="420"/>
                                <Button x:Uid="RecorderPage_RecorderPageButton02" Content="Add Current Setup"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddSession_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="RecorderPageButton02"/>
                            </StackPanel>

                            <ListView x:Name="QueueList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource RecordingQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="RecorderPage_RecorderPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="RecorderPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="RecorderPage_Item_013" Text="No finished recordings yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="RecorderPage_Item_014" Text="Completed, failed, and cancelled recording sessions appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource RecordingFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="RecorderPage_Item_015" Text="Capture Source"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Uid="RecorderPage_ScreenToggle" x:Name="ScreenToggle"
                                          Grid.Column="0"
                                          Content="Screen"
                                          IsChecked="True"
                                          Padding="16,10"
                                          Click="SourceToggle_Click"
                                          HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ScreenToggle"/>
                            <ToggleButton x:Uid="RecorderPage_WebcamToggle" x:Name="WebcamToggle"
                                          Grid.Column="1"
                                          Content="Webcam"
                                          IsChecked="False"
                                          Padding="16,10"
                                          Click="SourceToggle_Click"
                                          HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="WebcamToggle"/>
                        </Grid>

                        <!-- Webcam device (visible when Webcam mode active) -->
                        <StackPanel x:Name="WebcamDevicePanel"
                                    Visibility="Collapsed"
                                    Spacing="6">
                            <TextBlock x:Uid="RecorderPage_Item_018" Text="Webcam device" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Uid="RecorderPage_WebcamDeviceCombo" x:Name="WebcamDeviceCombo"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Loading devices..."
                                      SelectionChanged="Option_Changed"
                                AutomationProperties.AutomationId="WebcamDeviceCombo"/>
                        </StackPanel>

                        <!-- Microphone section (always visible) -->
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="RecorderPage_Item_020" Text="Microphone (optional)" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Uid="RecorderPage_AudioDeviceCombo" x:Name="AudioDeviceCombo"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Loading devices..."
                                      SelectionChanged="Option_Changed"
                                AutomationProperties.AutomationId="AudioDeviceCombo"/>
                        </StackPanel>

                        <!-- System audio loopback (#52) -->
                        <CheckBox x:Uid="RecorderPage_SystemAudioCheck" x:Name="SystemAudioCheck"
                                  Content="Capture system audio (loopback)"
                                  Click="Option_BoolChanged"
                            AutomationProperties.AutomationId="SystemAudioCheck"/>
                        <ComboBox x:Uid="RecorderPage_SystemAudioCombo" x:Name="SystemAudioCombo"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="auto-detect (Stereo Mix / loopback)"
                                  Visibility="Collapsed"
                                  SelectionChanged="Option_Changed"
                            AutomationProperties.AutomationId="SystemAudioCombo"/>

                        <Button x:Uid="RecorderPage_RefreshDevicesButton" x:Name="RefreshDevicesButton"
                                Content="Refresh Devices"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="RefreshDevices_Click"
                            AutomationProperties.AutomationId="RefreshDevicesButton"/>
                    </StackPanel>
                </Border>

                <!-- Region capture (#53) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="RecorderPage_Item_025" Text="Region (screen mode only)"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="RegionCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Option_Changed"
                            AutomationProperties.AutomationId="RegionCombo">
                            <ComboBoxItem x:Uid="RecorderPage_Item_026" Content="Full screen" Tag=""/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_027" Content="1920×1080 at (0,0)"  Tag="0,0,1920,1080"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_028" Content="1280×720 at (0,0)"   Tag="0,0,1280,720"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_029" Content="800×600 at (0,0)"    Tag="0,0,800,600"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_030" Content="Custom..."           Tag="custom"/>
                        </ComboBox>
                        <Grid ColumnSpacing="8" RowSpacing="6"
                              x:Name="CustomRegionGrid"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Uid="RecorderPage_RegionXBox" x:Name="RegionXBox" Header="X"     PlaceholderText="0"     Grid.Row="0" Grid.Column="0" TextChanged="Option_TextChanged"
                                AutomationProperties.AutomationId="RegionXBox"/>
                            <TextBox x:Uid="RecorderPage_RegionYBox" x:Name="RegionYBox" Header="Y"     PlaceholderText="0"     Grid.Row="0" Grid.Column="1" TextChanged="Option_TextChanged"
                                AutomationProperties.AutomationId="RegionYBox"/>
                            <TextBox x:Uid="RecorderPage_RegionWBox" x:Name="RegionWBox" Header="Width" PlaceholderText="1920"  Grid.Row="1" Grid.Column="0" TextChanged="Option_TextChanged"
                                AutomationProperties.AutomationId="RegionWBox"/>
                            <TextBox x:Uid="RecorderPage_RegionHBox" x:Name="RegionHBox" Header="Height" PlaceholderText="1080" Grid.Row="1" Grid.Column="1" TextChanged="Option_TextChanged"
                                AutomationProperties.AutomationId="RegionHBox"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="RecorderPage_Item_035" Text="Recording Setup"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="RecorderPage_DurationCombo" x:Name="DurationCombo"
                                  Header="Duration"
                                  SelectedIndex="1"
                                  SelectionChanged="Option_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="DurationCombo">
                            <ComboBoxItem x:Uid="RecorderPage_Item_037" Content="15 seconds" Tag="15"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_038" Content="30 seconds" Tag="30"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_039" Content="1 minute" Tag="60"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_040" Content="5 minutes" Tag="300"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_041" Content="10 minutes" Tag="600"/>
                        </ComboBox>
                        <ComboBox x:Uid="RecorderPage_FrameRateCombo" x:Name="FrameRateCombo"
                                  Header="Frame rate"
                                  SelectedIndex="1"
                                  SelectionChanged="Option_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="FrameRateCombo">
                            <ComboBoxItem x:Uid="RecorderPage_Item_043" Content="24 fps" Tag="24"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_044" Content="30 fps" Tag="30"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_045" Content="60 fps" Tag="60"/>
                        </ComboBox>
                        <ComboBox x:Uid="RecorderPage_QualityCombo" x:Name="QualityCombo"
                                  Header="Quality"
                                  SelectedIndex="1"
                                  SelectionChanged="Option_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="QualityCombo">
                            <ComboBoxItem x:Uid="RecorderPage_Item_047" Content="Archive quality (CRF 18)" Tag="18"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_048" Content="Balanced (CRF 20)" Tag="20"/>
                            <ComboBoxItem x:Uid="RecorderPage_Item_049" Content="Compact (CRF 24)" Tag="24"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="RecorderPage_Item_050" Text="File Location"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="RecorderPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                 Header="Save to"
                                 IsReadOnly="True"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <Button x:Uid="RecorderPage_RecorderPageButton03" Content="Browse"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BrowseOutputFolder_Click"
                            AutomationProperties.AutomationId="RecorderPageButton03"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="RecorderPage_Item_053" Text="Queue Summary"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="RecorderPage_QueueSummaryText" x:Name="QueueSummaryText"
                                   Text="0 pending / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="CurrentSetupText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="RecorderPage_RecorderPageButton04" Grid.Column="1"
                    Content="Open Output Folder"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click"
                    Margin="0,0,12,0"
                AutomationProperties.AutomationId="RecorderPageButton04"/>
            <Button x:Uid="RecorderPage_ClearQueueButton" Grid.Column="2"
                    Content="Clear Queue"
                    x:Name="ClearQueueButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="ClearQueue_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ClearQueueButton"/>
            <Button x:Uid="RecorderPage_CancelButton" Grid.Column="3"
                    Content="Cancel"
                    x:Name="CancelButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
