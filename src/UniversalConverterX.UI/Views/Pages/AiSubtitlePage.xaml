<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.AiSubtitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Subtitle Studio" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Transcribe with Whisper, translate locally, edit every cue, then export SRT/VTT/ASS or burn captions into video."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Browse File"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="AiSubtitlePageButton01"/>
                <Button x:Name="RunButton"
                        Content="Transcribe &amp; Preview"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="24"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <Grid MinHeight="430">
                    <StackPanel x:Name="DropZonePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <Border Width="116" Height="116" CornerRadius="28"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xED1E;" FontSize="48"
                                      Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock x:Name="DropZoneLabel"
                                   Text="Drop a video or audio file here"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="460"/>
                        <TextBlock x:Name="ProgressLabel"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="460"/>
                        <ProgressBar AutomationProperties.Name="Pipeline progress" x:Name="ProgressBar"
                                     Width="380" Height="6" CornerRadius="3"
                                     Minimum="0" Maximum="100"
                                     Visibility="Collapsed"/>
                        <Button Content="Browse File"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Browse_Click"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="AiSubtitlePageButton02"/>
                    </StackPanel>

                    <Grid x:Name="EditorPanel" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Caption preview" Style="{StaticResource PanelTitleTextStyle}"/>
                                <TextBlock x:Name="CueSummaryText" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Times are seconds" Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ListView Grid.Row="1" x:Name="CueList" SelectionMode="None"
                                  AutomationProperties.Name="Editable subtitle cues">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <NumberBox Grid.Column="1" Header="Start" Value="{Binding StartSeconds, Mode=TwoWay}"
                                                   Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox Grid.Column="2" Header="End" Value="{Binding EndSeconds, Mode=TwoWay}"
                                                   Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact"/>
                                        <TextBox Grid.Column="3" Header="Caption" Text="{Binding Text, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinWidth="220"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Backend" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="BackendCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="BackendCombo">
                            <ComboBoxItem Content="faster-whisper (Python · CUDA / CPU)" Tag="whisper-stt"/>
                            <ComboBoxItem Content="whisper.cpp (Vulkan / CUDA · binary)" Tag="whisper-cpp"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Model + Language" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="ModelCombo"
                                  Header="Model"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="1"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="ModelCombo">
                            <ComboBoxItem Content="tiny (fastest)" Tag="tiny"/>
                            <ComboBoxItem Content="base" Tag="base"/>
                            <ComboBoxItem Content="small" Tag="small"/>
                            <ComboBoxItem Content="medium" Tag="medium"/>
                            <ComboBoxItem Content="large-v3-turbo (fast + accurate)" Tag="large-v3-turbo"/>
                            <ComboBoxItem Content="distil-large-v3 (~6x faster, English-mostly)" Tag="distil-large-v3"/>
                            <ComboBoxItem Content="large-v3 (best)" Tag="large-v3"/>
                        </ComboBox>
                        <ComboBox x:Name="LanguageCombo"
                                  Header="Language"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="LanguageCombo">
                            <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="French" Tag="fr"/>
                            <ComboBoxItem Content="German" Tag="de"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Chinese" Tag="zh"/>
                            <ComboBoxItem Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem Content="Italian" Tag="it"/>
                            <ComboBoxItem Content="Russian" Tag="ru"/>
                            <ComboBoxItem Content="Korean" Tag="ko"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Inference" Style="{StaticResource PanelTitleTextStyle}"/>
                        <CheckBox x:Name="VadCheck"
                                  Content="VAD pre-filter (skip silence)"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="AiSubtitleVadCheck"/>
                        <NumberBox x:Name="BatchSizeBox"
                                   Header="faster-whisper batch size"
                                   Value="8"
                                   Minimum="1"
                                   Maximum="32"
                                   SpinButtonPlacementMode="Inline"
                                   ValueChanged="Settings_Number_Changed"
                            AutomationProperties.AutomationId="AiSubtitleBatchSizeBox"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Translation" Style="{StaticResource PanelTitleTextStyle}"/>
                        <CheckBox x:Name="TranslateCheck"
                                  Content="Translate after transcription"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                                  AutomationProperties.AutomationId="TranslateCheck"/>
                        <ComboBox x:Name="TranslationModelCombo"
                                  Header="Local model"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                                  AutomationProperties.AutomationId="TranslationModelCombo">
                            <ComboBoxItem Content="Helsinki OPUS-MT (ONNX, lightweight)" Tag="opus-mt"/>
                            <ComboBoxItem Content="NLLB-200 distilled (broad coverage)" Tag="facebook/nllb-200-distilled-600M"/>
                        </ComboBox>
                        <ComboBox x:Name="TargetLanguageCombo"
                                  Header="Translate to"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                                  AutomationProperties.AutomationId="TargetLanguageCombo">
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="French" Tag="fr"/>
                            <ComboBoxItem Content="German" Tag="de"/>
                            <ComboBoxItem Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem Content="Italian" Tag="it"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Chinese" Tag="zh"/>
                            <ComboBoxItem Content="Russian" Tag="ru"/>
                            <ComboBoxItem Content="Korean" Tag="ko"/>
                        </ComboBox>
                        <TextBlock Text="Choose the source language above when translating; auto-detect remains available for transcription-only jobs."
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="FormatCombo"
                                  Header="Subtitle format"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem Content="SubRip (.srt)" Tag="srt"/>
                            <ComboBoxItem Content="WebVTT (.vtt)" Tag="vtt"/>
                            <ComboBoxItem Content="Advanced SubStation Alpha (.ass)" Tag="ass"/>
                        </ComboBox>
                        <CheckBox x:Name="BurnInCheck"
                                  Content="Also burn subtitles into a copy of the video"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="BurnInCheck"/>
                        <TextBlock Text="Export uses the edited preview. Burn-in re-encodes video with the exported caption file and keeps both outputs."
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" x:Name="ExportButton" Content="Export Preview"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Export_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="ExportButton"/>
            <Button Grid.Column="2" x:Name="OpenOutputButton" Content="Open Output"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="OpenOutput_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="OpenOutputButton"/>
            <Button Grid.Column="3" x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
