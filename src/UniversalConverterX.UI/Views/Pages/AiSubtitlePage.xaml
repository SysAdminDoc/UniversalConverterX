<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.AiSubtitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Uid="AiSubtitlePage_Item_001" Text="Subtitle Studio" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="AiSubtitlePage_Item_002" Text="Transcribe with Whisper, translate locally, edit every cue, then export SRT/VTT/ASS or burn captions into video."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="AiSubtitlePage_AiSubtitlePageButton01" Content="Browse File"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="AiSubtitlePageButton01"/>
                <Button x:Uid="AiSubtitlePage_RunButton" x:Name="RunButton"
                        Content="Transcribe &amp; Preview"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <Grid MinHeight="430">
                    <StackPanel x:Name="DropZonePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <Border Width="116" Height="116" CornerRadius="28"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xED1E;" FontSize="48"
                                      Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock x:Uid="AiSubtitlePage_DropZoneLabel" x:Name="DropZoneLabel"
                                   Text="Drop a video or audio file here"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="460"/>
                        <TextBlock x:Name="ProgressLabel"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="460"/>
                        <ProgressBar x:Uid="AiSubtitlePage_ProgressBar" AutomationProperties.Name="Pipeline progress" x:Name="ProgressBar"
                                     Width="380" Height="6" CornerRadius="3"
                                     Minimum="0" Maximum="100"
                                     Visibility="Collapsed"/>
                        <Button x:Uid="AiSubtitlePage_AiSubtitlePageButton02" Content="Browse File"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Browse_Click"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="AiSubtitlePageButton02"/>
                    </StackPanel>

                    <Grid x:Name="EditorPanel" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="AiSubtitlePage_Item_008" Text="Caption preview" Style="{StaticResource PanelTitleTextStyle}"/>
                                <TextBlock x:Name="CueSummaryText" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                            <TextBlock x:Uid="AiSubtitlePage_Item_009" Grid.Column="1" Text="Times are seconds" Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ListView x:Uid="AiSubtitlePage_CueList" Grid.Row="1" x:Name="CueList" SelectionMode="None"
                                  AutomationProperties.Name="Editable subtitle cues">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <NumberBox x:Uid="AiSubtitlePage_Item_011" Grid.Column="1" Header="Start" Value="{Binding StartSeconds, Mode=TwoWay}"
                                                   Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Uid="AiSubtitlePage_Item_012" Grid.Column="2" Header="End" Value="{Binding EndSeconds, Mode=TwoWay}"
                                                   Minimum="0" SmallChange="0.1" SpinButtonPlacementMode="Compact"/>
                                        <TextBox x:Uid="AiSubtitlePage_Item_013" Grid.Column="3" Header="Caption" Text="{Binding Text, Mode=TwoWay}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinWidth="220"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="AiSubtitlePage_Item_014" Text="Backend" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="BackendCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="BackendCombo">
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_015" Content="faster-whisper (Python · CUDA / CPU)" Tag="whisper-stt"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_016" Content="whisper.cpp (Vulkan / CUDA · binary)" Tag="whisper-cpp"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_FfmpegWhisperBackend" Content="FFmpeg whisper filter (lightweight · bundled)" Tag="ffmpeg-whisper"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="AiSubtitlePage_Item_017" Text="Model + Language" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="AiSubtitlePage_ModelCombo" x:Name="ModelCombo"
                                  Header="Model"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="1"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="ModelCombo">
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_019" Content="tiny (fastest)" Tag="tiny"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_020" Content="base" Tag="base"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_021" Content="small" Tag="small"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_022" Content="medium" Tag="medium"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_023" Content="large-v3-turbo (fast + accurate)" Tag="large-v3-turbo"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_024" Content="distil-large-v3 (~6x faster, English-mostly)" Tag="distil-large-v3"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_025" Content="large-v3 (best)" Tag="large-v3"/>
                        </ComboBox>
                        <ComboBox x:Uid="AiSubtitlePage_LanguageCombo" x:Name="LanguageCombo"
                                  Header="Language"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="LanguageCombo">
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_027" Content="Auto-detect" Tag="auto"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_028" Content="English" Tag="en"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_029" Content="Spanish" Tag="es"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_030" Content="French" Tag="fr"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_031" Content="German" Tag="de"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_032" Content="Japanese" Tag="ja"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_033" Content="Chinese" Tag="zh"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_034" Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_035" Content="Italian" Tag="it"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_036" Content="Russian" Tag="ru"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_037" Content="Korean" Tag="ko"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="AiSubtitlePage_Item_038" Text="Inference" Style="{StaticResource PanelTitleTextStyle}"/>
                        <CheckBox x:Uid="AiSubtitlePage_VadCheck" x:Name="VadCheck"
                                  Content="VAD pre-filter (skip silence)"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="AiSubtitleVadCheck"/>
                        <NumberBox x:Uid="AiSubtitlePage_BatchSizeBox" x:Name="BatchSizeBox"
                                   Header="faster-whisper batch size"
                                   Value="8"
                                   Minimum="1"
                                   Maximum="32"
                                   SpinButtonPlacementMode="Inline"
                                   ValueChanged="Settings_Number_Changed"
                            AutomationProperties.AutomationId="AiSubtitleBatchSizeBox"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="AiSubtitlePage_Item_041" Text="Translation" Style="{StaticResource PanelTitleTextStyle}"/>
                        <CheckBox x:Uid="AiSubtitlePage_TranslateCheck" x:Name="TranslateCheck"
                                  Content="Translate after transcription"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                                  AutomationProperties.AutomationId="TranslateCheck"/>
                        <ComboBox x:Uid="AiSubtitlePage_TranslationModelCombo" x:Name="TranslationModelCombo"
                                  Header="Local model"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                                  AutomationProperties.AutomationId="TranslationModelCombo">
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_044" Content="Helsinki OPUS-MT (ONNX, lightweight)" Tag="opus-mt"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_045" Content="NLLB-200 distilled (broad coverage)" Tag="facebook/nllb-200-distilled-600M"/>
                        </ComboBox>
                        <ComboBox x:Uid="AiSubtitlePage_TargetLanguageCombo" x:Name="TargetLanguageCombo"
                                  Header="Translate to"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                                  AutomationProperties.AutomationId="TargetLanguageCombo">
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_047" Content="Spanish" Tag="es"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_048" Content="French" Tag="fr"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_049" Content="German" Tag="de"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_050" Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_051" Content="Italian" Tag="it"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_052" Content="Japanese" Tag="ja"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_053" Content="Chinese" Tag="zh"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_054" Content="Russian" Tag="ru"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_055" Content="Korean" Tag="ko"/>
                        </ComboBox>
                        <TextBlock x:Uid="AiSubtitlePage_Item_056" Text="Choose the source language above when translating; auto-detect remains available for transcription-only jobs."
                                   Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="AiSubtitlePage_Item_057" Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="AiSubtitlePage_FormatCombo" x:Name="FormatCombo"
                                  Header="Subtitle format"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_059" Content="SubRip (.srt)" Tag="srt"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_060" Content="WebVTT (.vtt)" Tag="vtt"/>
                            <ComboBoxItem x:Uid="AiSubtitlePage_Item_061" Content="Advanced SubStation Alpha (.ass)" Tag="ass"/>
                        </ComboBox>
                        <CheckBox x:Uid="AiSubtitlePage_BurnInCheck" x:Name="BurnInCheck"
                                  Content="Also burn subtitles into a copy of the video"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="BurnInCheck"/>
                        <TextBlock x:Uid="AiSubtitlePage_Item_063" Text="Export uses the edited preview. Burn-in re-encodes video with the exported caption file and keeps both outputs."
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="AiSubtitlePage_ExportButton" Grid.Column="1" x:Name="ExportButton" Content="Export Preview"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Export_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="ExportButton"/>
            <Button x:Uid="AiSubtitlePage_OpenOutputButton" Grid.Column="2" x:Name="OpenOutputButton" Content="Open Output"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="OpenOutput_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="OpenOutputButton"/>
            <Button x:Uid="AiSubtitlePage_CancelButton" Grid.Column="3" x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
