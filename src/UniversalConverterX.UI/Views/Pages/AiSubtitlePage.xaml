<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.AiSubtitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Auto Subtitle" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Whisper transcription → SRT/VTT subtitle file. Optional burn-in produces a video with hard-coded captions."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Browse File"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="AiSubtitlePageButton01"/>
                <Button x:Name="RunButton"
                        Content="Generate"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="24"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                            MinHeight="430">
                    <Border Width="116" Height="116" CornerRadius="28"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xED1E;" FontSize="48"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Name="DropZoneLabel"
                               Text="Drop a video or audio file here"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="460"/>
                    <TextBlock x:Name="ProgressLabel"
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="460"/>
                    <ProgressBar AutomationProperties.Name="Progress" x:Name="ProgressBar"
                                 Width="380" Height="6" CornerRadius="3"
                                 Minimum="0" Maximum="100"
                                 Visibility="Collapsed"/>
                    <Button Content="Browse File"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Browse_Click"
                            HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="AiSubtitlePageButton02"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Backend" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="BackendCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="BackendCombo">
                            <ComboBoxItem Content="faster-whisper (Python · CUDA / CPU)" Tag="whisper-stt"/>
                            <ComboBoxItem Content="whisper.cpp (Vulkan / CUDA · binary)" Tag="whisper-cpp"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Model + Language" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="ModelCombo"
                                  Header="Model"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="1"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="ModelCombo">
                            <ComboBoxItem Content="tiny (fastest)" Tag="tiny"/>
                            <ComboBoxItem Content="base" Tag="base"/>
                            <ComboBoxItem Content="small" Tag="small"/>
                            <ComboBoxItem Content="medium" Tag="medium"/>
                            <ComboBoxItem Content="large-v3-turbo (fast + accurate)" Tag="large-v3-turbo"/>
                            <ComboBoxItem Content="distil-large-v3 (~6x faster, English-mostly)" Tag="distil-large-v3"/>
                            <ComboBoxItem Content="large-v3 (best)" Tag="large-v3"/>
                        </ComboBox>
                        <ComboBox x:Name="LanguageCombo"
                                  Header="Language"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="LanguageCombo">
                            <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="French" Tag="fr"/>
                            <ComboBoxItem Content="German" Tag="de"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Chinese" Tag="zh"/>
                            <ComboBoxItem Content="Portuguese" Tag="pt"/>
                            <ComboBoxItem Content="Italian" Tag="it"/>
                            <ComboBoxItem Content="Russian" Tag="ru"/>
                            <ComboBoxItem Content="Korean" Tag="ko"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Inference" Style="{StaticResource PanelTitleTextStyle}"/>
                        <CheckBox x:Name="VadCheck"
                                  Content="VAD pre-filter (skip silence)"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="AiSubtitleVadCheck"/>
                        <NumberBox x:Name="BatchSizeBox"
                                   Header="faster-whisper batch size"
                                   Value="8"
                                   Minimum="1"
                                   Maximum="32"
                                   SpinButtonPlacementMode="Inline"
                                   ValueChanged="Settings_Number_Changed"
                            AutomationProperties.AutomationId="AiSubtitleBatchSizeBox"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="FormatCombo"
                                  Header="Subtitle format"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem Content="SubRip (.srt)" Tag="srt"/>
                            <ComboBoxItem Content="WebVTT (.vtt)" Tag="vtt"/>
                        </ComboBox>
                        <CheckBox x:Name="BurnInCheck"
                                  Content="Also burn subtitles into a copy of the video"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="BurnInCheck"/>
                        <TextBlock Text="Burn-in re-encodes the video with hard-coded captions. The original .srt/.vtt is kept alongside."
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" x:Name="OpenOutputButton" Content="Open Output"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="OpenOutput_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="OpenOutputButton"/>
            <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
