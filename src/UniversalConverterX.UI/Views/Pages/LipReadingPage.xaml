<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.LipReadingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="LrQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE909;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding BackendSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Border>
                    <Button x:Uid="LipReadingPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="LipReadingPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="92" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LrFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="LipReadingPage_Item_003" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="LipReadingPage_Item_004" Text="Lip Reading" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock x:Uid="LipReadingPage_Item_005" Text="Transcribe speech from silent or muted video using AI visual speech recognition."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="LipReadingPage_LipReadingPageButton01" Content="Add Files" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="LipReadingPageButton01"/>
                <Button x:Uid="LipReadingPage_LipReadingPageButton02" Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="LipReadingPageButton02"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Drop zone + queue -->
            <Border x:Name="DropZone" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="LipReadingPage_LipReadingPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="LipReadingPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE909;" FontSize="48"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="LipReadingPage_Item_009" Text="Drop video files"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="LipReadingPage_Item_010" Text="MP4, MOV, MKV, AVI, WebM, and more."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Uid="LipReadingPage_LipReadingPageButton03" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="LipReadingPageButton03"/>
                            </StackPanel>
                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource LrQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="LipReadingPage_LipReadingPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="LipReadingPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="LipReadingPage_Item_013" Text="No finished jobs yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="LipReadingPage_Item_014" Text="Completed and failed jobs appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource LrFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <!-- Settings panel -->
            <StackPanel Grid.Column="1" Spacing="14">

                <!-- Backend -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="LipReadingPage_Item_015" Text="Inference Backend" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="BackendCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="Backend_SelectionChanged"
                            AutomationProperties.AutomationId="BackendCombo">
                            <ComboBoxItem x:Uid="LipReadingPage_Item_016" Content="HuggingFace Space (free)" Tag="hf" IsSelected="True"/>
                            <ComboBoxItem x:Uid="LipReadingPage_Item_017" Content="Local Auto-AVSR (free)" Tag="local"/>
                            <ComboBoxItem x:Uid="LipReadingPage_Item_018" Content="Replicate API (token)" Tag="replicate"/>
                            <ComboBoxItem x:Uid="LipReadingPage_Item_019" Content="Custom Endpoint" Tag="custom"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- HF custom URL panel -->
                <Border x:Name="HfPanel" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="LipReadingPage_Item_020" Text="HuggingFace Space URL" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="LipReadingPage_HfUrlBox" x:Name="HfUrlBox"
                                 PlaceholderText="https://your-space.hf.space (optional)"
                                 HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="HfUrlBox"/>
                        <TextBlock x:Uid="LipReadingPage_Item_022" Text="Leave blank to use the built-in public spaces."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Replicate panel -->
                <Border x:Name="ReplicatePanel" Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="LipReadingPage_Item_023" Text="Replicate API Token" Style="{StaticResource PanelTitleTextStyle}"/>
                        <PasswordBox x:Uid="LipReadingPage_ReplicateTokenBox" x:Name="ReplicateTokenBox"
                                     PlaceholderText="r8_…"
                                     HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ReplicateTokenBox"/>
                    </StackPanel>
                </Border>

                <!-- Custom endpoint panel -->
                <Border x:Name="CustomPanel" Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="LipReadingPage_Item_025" Text="Custom Endpoint" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="LipReadingPage_CustomUrlBox" x:Name="CustomUrlBox"
                                 PlaceholderText="https://your-endpoint/transcribe"
                                 HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CustomUrlBox"/>
                        <TextBox x:Uid="LipReadingPage_CustomKeyBox" x:Name="CustomKeyBox"
                                 PlaceholderText="Bearer token (optional)"
                                 HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CustomKeyBox"/>
                    </StackPanel>
                </Border>

                <!-- Detection options -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="LipReadingPage_Item_028" Text="Detection" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ToggleSwitch x:Uid="LipReadingPage_SegmentToggle" x:Name="SegmentToggle"
                                      Header="Auto speech segmentation"
                                      IsOn="True"
                            AutomationProperties.AutomationId="SegmentToggle"/>
                        <StackPanel Spacing="6" x:Name="ThresholdPanel">
                            <Grid>
                                <TextBlock x:Uid="LipReadingPage_Item_030" Text="Mouth-open threshold" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Uid="LipReadingPage_ThresholdValueText" x:Name="ThresholdValueText" Text="0.06"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource MutedTextStyle}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="ThresholdSlider" Minimum="1" Maximum="20" Value="6"
                                    TickFrequency="1" StepFrequency="1"
                                AutomationProperties.AutomationId="ThresholdSlider"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output format -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="LipReadingPage_Item_032" Text="Output Format" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem x:Uid="LipReadingPage_Item_033" Content="SRT subtitles (.srt)" Tag="srt" IsSelected="True"/>
                            <ComboBoxItem x:Uid="LipReadingPage_Item_034" Content="Plain text (.txt)" Tag="txt"/>
                            <ComboBoxItem x:Uid="LipReadingPage_Item_035" Content="JSON (.json)" Tag="json"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Output folder -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="LipReadingPage_Item_036" Text="Output Folder" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="LipReadingPage_OutputDirectoryBox" x:Name="OutputDirectoryBox" PlaceholderText="Same folder as source"
                                 IsReadOnly="True" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Uid="LipReadingPage_LipReadingPageButton04" Content="Choose Folder" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="LipReadingPageButton04"/>
                            <Button x:Uid="LipReadingPage_LipReadingPageButton05" Content="Same as Source" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="LipReadingPageButton05"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="LipReadingPage_StatusText" x:Name="StatusText"
                           Text="Add video files to start a transcription queue."
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Uid="LipReadingPage_ClearButton" x:Name="ClearButton" Content="Clear Queue"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="Clear_Click"
                        AutomationProperties.AutomationId="ClearButton"/>
                    <Button x:Uid="LipReadingPage_LipReadingPageButton06" Content="Open Output Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenOutputFolder_Click"
                        AutomationProperties.AutomationId="LipReadingPageButton06"/>
                    <Button x:Uid="LipReadingPage_RunButton" x:Name="RunButton" Content="Transcribe"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="Run_Click"
                        AutomationProperties.AutomationId="RunButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress overlay -->
        <Border x:Name="ProgressOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource OverlayBrush}"
                CornerRadius="20"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="480">
                <TextBlock x:Uid="LipReadingPage_ProgressTitle" x:Name="ProgressTitle" Text="Transcribing..."
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Uid="LipReadingPage_ProgressBar" AutomationProperties.Name="Progress" x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                             Width="380" Height="8" CornerRadius="4"/>
                <TextBlock x:Uid="LipReadingPage_ProgressStage" x:Name="ProgressStage" Text="Starting..."
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ProgressEta" Text=""
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center"/>
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ProgressLog" Text=""
                               Style="{StaticResource MutedTextStyle}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <Button x:Uid="LipReadingPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="Cancel_Click"
                    AutomationProperties.AutomationId="CancelButton"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
