<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Video Editor" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="Trim clips fast (lossless or re-encode). Crop, upscale, filter, and audio operations land in v2.2+. Powered by the ClipForge sidecar."
                       Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0" Style="{StaticResource CardStyle}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Grid>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE714;" FontSize="64"
                                  Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop a video to edit"
                                   Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="MP4, MKV, MOV, AVI, WebM and more"
                                   Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"/>
                        <Button Content="Browse Files" Style="{StaticResource SecondaryButtonStyle}"
                                Click="Browse_Click" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="FileState" Visibility="Collapsed" VerticalAlignment="Center" Spacing="14">
                        <FontIcon Glyph="&#xE714;" FontSize="48"
                                  Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FileNameText" Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                        <TextBlock x:Name="FileMetaText" Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <Button Content="Choose different file" Style="{StaticResource SecondaryButtonStyle}"
                                Click="Browse_Click" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Trim" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Times in seconds (e.g. 12.5). Leave end blank for end of clip."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <TextBox x:Name="StartBox" Header="Start (s)" PlaceholderText="0" InputScope="Number"/>
                        <TextBox x:Name="EndBox" Header="End (s)" PlaceholderText="(end of clip)" InputScope="Number"/>
                        <CheckBox x:Name="LosslessCheck" Content="Lossless (stream-copy, fast)" IsChecked="True"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Lossless cuts on keyframes — output may be slightly off. Uncheck for frame-accurate re-encode."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Re-encode quality" Style="{StaticResource MutedTextStyle}"/>
                        <Slider x:Name="CrfSlider" Minimum="0" Maximum="51" Value="18" StepFrequency="1"
                                ValueChanged="CrfSlider_ValueChanged"/>
                        <TextBlock x:Name="CrfLabel" Text="CRF 18 (visually lossless)"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Clear" x:Name="ClearButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Clear_Click" Margin="0,0,12,0" IsEnabled="False"/>
            <Button Grid.Column="2" Content="Export" x:Name="ExportButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Export_Click" IsEnabled="False"/>
        </Grid>

        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#80000000">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="420" MaxWidth="520">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="ProgressTitle" Text="Trimming…"
                               Style="{StaticResource TitleTextStyle}"/>
                    <ProgressBar x:Name="ProgressBar" Height="8" CornerRadius="4"
                                 Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressStage" Style="{StaticResource SubtitleTextStyle}"/>
                    <TextBlock x:Name="ProgressEta" Style="{StaticResource MutedTextStyle}"/>
                    <ScrollViewer Height="80" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceLightBrush}" Padding="8" CornerRadius="4">
                        <TextBlock x:Name="ProgressLog" Style="{StaticResource MutedTextStyle}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
