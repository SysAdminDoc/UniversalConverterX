<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="EditQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE714;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding OperationSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button x:Uid="EditorPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="EditorPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6"
                                     CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EditFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}"
                                  FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="EditorPage_Item_003" Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="EditorPage_Item_004" Text="Editor" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="EditorPage_Item_005" Text="Batch-trim clips with local ClipForge processing, progress, and finished results."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="EditorPage_EditorPageButton01" Content="Add Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="EditorPageButton01"/>
                <Button x:Uid="EditorPage_EditorPageButton02" Content="Add Folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="EditorPageButton02"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="EditorPage_EditorPagePivotItem01" Header="Editing"
                        AutomationProperties.AutomationId="EditorPagePivotItem01">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE714;" FontSize="30"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="EditorPage_Item_009" Text="Drop videos to edit"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="EditorPage_Item_010" Text="MP4, MKV, MOV, AVI, WebM, FLV, WMV, TS, MTS, and M4V."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Uid="EditorPage_EditorPageButton03" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="EditorPageButton03"/>
                            </StackPanel>

                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource EditQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="EditorPage_EditorPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="EditorPagePivotItem02">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="30"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="EditorPage_Item_013" Text="No finished edits yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="EditorPage_Item_014" Text="Completed, failed, and cancelled exports appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource EditFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EditorPage_Item_015" Text="Operation"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="OperationCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OperationCombo_SelectionChanged"
                            AutomationProperties.AutomationId="OperationCombo">
                            <ComboBoxItem x:Uid="EditorPage_Item_016" Content="Trim" Tag="trim" IsSelected="True"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_017" Content="Crop" Tag="crop"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_018" Content="Crop Metadata (lossless)" Tag="crop-meta"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_019" Content="Aspect Override (lossless)" Tag="aspect-override"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_020" Content="Rotate / Flip" Tag="rotate"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_021" Content="Normalize Audio" Tag="loudnorm"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_022" Content="Rewrap Container" Tag="rewrap"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Trim panel -->
                <Border x:Name="TrimPanel" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EditorPage_Item_023" Text="Trim"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="EditorPage_Item_024" Text="Times in seconds. Leave end blank to export through the end of each clip."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Uid="EditorPage_StartBox" x:Name="StartBox"
                                 Header="Start"
                                 PlaceholderText="0"
                                 InputScope="Number"
                                 TextChanged="TrimText_Changed"
                                 LostFocus="TrimText_LostFocus"
                            AutomationProperties.AutomationId="StartBox"/>
                        <TextBox x:Uid="EditorPage_EndBox" x:Name="EndBox"
                                 Header="End"
                                 PlaceholderText="End of clip"
                                 InputScope="Number"
                                 TextChanged="TrimText_Changed"
                                 LostFocus="TrimText_LostFocus"
                            AutomationProperties.AutomationId="EndBox"/>
                        <CheckBox x:Uid="EditorPage_LosslessCheck" x:Name="LosslessCheck"
                                  Content="Lossless stream-copy"
                                  IsChecked="True"
                                  Checked="TrimOption_Changed"
                                  Unchecked="TrimOption_Changed"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.AutomationId="LosslessCheck"/>
                        <TextBlock x:Uid="EditorPage_Item_028" Text="Lossless is fast and preserves quality, but cuts on keyframes. Re-encode for frame-accurate trims."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Re-encode Quality panel (trim re-encode + crop + rotate) -->
                <Border x:Name="QualityPanel" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="EditorPage_Item_029" Text="Re-encode Quality"
                                       Style="{StaticResource PanelTitleTextStyle}"/>
                            <ToggleButton x:Uid="EditorPage_QualityLockToggle" x:Name="QualityLockToggle" Grid.Column="1"
                                          AutomationProperties.AutomationId="QualityLockToggle"
                                          AutomationProperties.Name="Lock quality value"
                                          ToolTipService.ToolTip="Lock CRF value across operation/preset changes"
                                          Padding="6,4" MinWidth="0" MinHeight="0">
                                <FontIcon Glyph="&#xE72E;" FontSize="13"/>
                            </ToggleButton>
                        </Grid>
                        <Slider x:Name="CrfSlider"
                                Minimum="0"
                                Maximum="51"
                                Value="18"
                                StepFrequency="1"
                                ValueChanged="CrfSlider_ValueChanged"
                            AutomationProperties.AutomationId="CrfSlider"/>
                        <TextBlock x:Uid="EditorPage_CrfLabel" x:Name="CrfLabel"
                                   Text="CRF 18 (visually lossless)"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Crop panel -->
                <Border x:Name="CropPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="EditorPage_Item_032" Text="Crop Rectangle"
                                       Style="{StaticResource PanelTitleTextStyle}"/>
                            <ToggleButton x:Uid="EditorPage_CropLockToggle" x:Name="CropLockToggle" Grid.Column="1"
                                          AutomationProperties.AutomationId="CropLockToggle"
                                          AutomationProperties.Name="Lock crop values"
                                          ToolTipService.ToolTip="Lock crop values across operation/preset changes"
                                          Padding="6,4" MinWidth="0" MinHeight="0">
                                <FontIcon Glyph="&#xE72E;" FontSize="13"/>
                            </ToggleButton>
                        </Grid>
                        <TextBlock x:Uid="EditorPage_Item_034" Text="All values in pixels. Output = W x H region starting at (X, Y)."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="EditorPage_CropWidthBox" x:Name="CropWidthBox" Grid.Column="0"
                                     Header="Width" PlaceholderText="1920"
                                     InputScope="Number"
                                     TextChanged="TrimText_Changed"
                                     LostFocus="TrimText_LostFocus"
                                AutomationProperties.AutomationId="CropWidthBox"/>
                            <TextBox x:Uid="EditorPage_CropHeightBox" x:Name="CropHeightBox" Grid.Column="1"
                                     Header="Height" PlaceholderText="1080"
                                     InputScope="Number"
                                     TextChanged="TrimText_Changed"
                                     LostFocus="TrimText_LostFocus"
                                AutomationProperties.AutomationId="CropHeightBox"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="EditorPage_CropXBox" x:Name="CropXBox" Grid.Column="0"
                                     Header="X offset" PlaceholderText="0"
                                     InputScope="Number"
                                     TextChanged="TrimText_Changed"
                                     LostFocus="TrimText_LostFocus"
                                AutomationProperties.AutomationId="CropXBox"/>
                            <TextBox x:Uid="EditorPage_CropYBox" x:Name="CropYBox" Grid.Column="1"
                                     Header="Y offset" PlaceholderText="0"
                                     InputScope="Number"
                                     TextChanged="TrimText_Changed"
                                     LostFocus="TrimText_LostFocus"
                                AutomationProperties.AutomationId="CropYBox"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Codec metadata crop panel -->
                <Border x:Name="CropMetaPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EditorPage_Item_039" Text="Lossless Display Crop"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="EditorPage_Item_040" Text="Set H.264/H.265 edge-crop metadata without decoding frames. Coded pictures stay intact; players display the smaller rectangle."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="EditorPage_CropMetaLeftBox" x:Name="CropMetaLeftBox" Grid.Column="0"
                                     Header="Left edge" Text="0" InputScope="Number"
                                     TextChanged="TrimText_Changed" LostFocus="TrimText_LostFocus"
                                     AutomationProperties.AutomationId="CropMetaLeftBox"/>
                            <TextBox x:Uid="EditorPage_CropMetaRightBox" x:Name="CropMetaRightBox" Grid.Column="1"
                                     Header="Right edge" Text="0" InputScope="Number"
                                     TextChanged="TrimText_Changed" LostFocus="TrimText_LostFocus"
                                     AutomationProperties.AutomationId="CropMetaRightBox"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="EditorPage_CropMetaTopBox" x:Name="CropMetaTopBox" Grid.Column="0"
                                     Header="Top edge" Text="0" InputScope="Number"
                                     TextChanged="TrimText_Changed" LostFocus="TrimText_LostFocus"
                                     AutomationProperties.AutomationId="CropMetaTopBox"/>
                            <TextBox x:Uid="EditorPage_CropMetaBottomBox" x:Name="CropMetaBottomBox" Grid.Column="1"
                                     Header="Bottom edge" Text="0" InputScope="Number"
                                     TextChanged="TrimText_Changed" LostFocus="TrimText_LostFocus"
                                     AutomationProperties.AutomationId="CropMetaBottomBox"/>
                        </Grid>
                        <TextBlock x:Uid="EditorPage_Item_045" Text="Offsets replace existing SPS crop metadata. Some chroma formats require even values; unsupported offsets fail without creating a successful export."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Container aspect metadata panel -->
                <Border x:Name="AspectOverridePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EditorPage_Item_046" Text="Display Aspect Override"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="EditorPage_Item_047" Text="Change only the container display ratio. Compressed video and audio packets are copied byte-for-byte."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Uid="EditorPage_AspectRatioBox" x:Name="AspectRatioBox"
                                 Header="Display ratio" Text="16:9" PlaceholderText="16:9"
                                 TextChanged="TrimText_Changed" LostFocus="TrimText_LostFocus"
                                 AutomationProperties.AutomationId="AspectRatioBox"/>
                    </StackPanel>
                </Border>

                <!-- Rotate panel -->
                <Border x:Name="RotatePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EditorPage_Item_049" Text="Rotate / Flip"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="RotateAngleCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="TrimOption_Changed"
                            AutomationProperties.AutomationId="RotateAngleCombo">
                            <ComboBoxItem x:Uid="EditorPage_Item_050" Content="90° clockwise" Tag="90" IsSelected="True"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_051" Content="180°" Tag="180"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_052" Content="270° clockwise" Tag="270"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_053" Content="Flip horizontal" Tag="flip_h"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_054" Content="Flip vertical" Tag="flip_v"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Loudnorm panel -->
                <Border x:Name="LoudnormPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EditorPage_Item_055" Text="Audio Normalisation"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="EditorPage_Item_056" Text="EBU R128 two-pass normalisation. Video stream is copied unchanged."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Uid="EditorPage_LufsBox" x:Name="LufsBox"
                                 Header="Target LUFS"
                                 PlaceholderText="-14"
                                 InputScope="Number"
                                 TextChanged="TrimText_Changed"
                                 LostFocus="TrimText_LostFocus"
                            AutomationProperties.AutomationId="LufsBox"/>
                        <TextBlock x:Uid="EditorPage_Item_058" Text="Default -14 LUFS suits streaming platforms (YouTube, Spotify)."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Rewrap panel -->
                <Border x:Name="RewrapPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EditorPage_Item_059" Text="Rewrap Container"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="EditorPage_Item_060" Text="Stream-copy all tracks into the container chosen by the output extension. No re-encode."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <ComboBox x:Name="RewrapFormatCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="TrimOption_Changed"
                            AutomationProperties.AutomationId="RewrapFormatCombo">
                            <ComboBoxItem x:Uid="EditorPage_Item_061" Content=".mp4 (H.264/AAC)" Tag=".mp4" IsSelected="True"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_062" Content=".mkv (universal)" Tag=".mkv"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_063" Content=".mov (Apple)" Tag=".mov"/>
                            <ComboBoxItem x:Uid="EditorPage_Item_064" Content=".webm (web)" Tag=".webm"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="EditorPage_Item_065" Text="File Location"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="EditorPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                 Header="Save to"
                                 PlaceholderText="Same as source file"
                                 IsReadOnly="True"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="EditorPage_EditorPageButton04" Grid.Column="0"
                                    Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="EditorPageButton04"/>
                            <Button x:Uid="EditorPage_EditorPageButton05" Grid.Column="1"
                                    Content="Same as source"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="EditorPageButton05"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="EditorPage_Item_069" Text="Queue Summary"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="EditorPage_QueueCountText" x:Name="QueueCountText"
                                   Text="0 clips queued"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Uid="EditorPage_OperationText" x:Name="OperationText"
                                   Text="Trim from 0s to end"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Uid="EditorPage_OutputText" x:Name="OutputText"
                                   Text="Output: same as source"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="EditorPage_EditorPageButton06" Grid.Column="1"
                    Content="Open Output Folder"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click"
                    Margin="0,0,12,0"
                AutomationProperties.AutomationId="EditorPageButton06"/>
            <Button x:Uid="EditorPage_UndoButton" Grid.Column="2"
                    x:Name="UndoButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTipService.ToolTip="Undo last setting change"
                    Click="Undo_Click"
                    IsEnabled="False"
                    Margin="0,0,4,0"
                AutomationProperties.AutomationId="UndoButton">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE10E;" FontSize="14"/>
                    <TextBlock x:Uid="EditorPage_Item_075" Text="Undo"/>
                </StackPanel>
            </Button>
            <Button x:Uid="EditorPage_RedoButton" Grid.Column="3"
                    x:Name="RedoButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTipService.ToolTip="Redo last undone change"
                    Click="Redo_Click"
                    IsEnabled="False"
                    Margin="0,0,12,0"
                AutomationProperties.AutomationId="RedoButton">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE10C;" FontSize="14"/>
                    <TextBlock x:Uid="EditorPage_Item_077" Text="Redo"/>
                </StackPanel>
            </Button>
            <Button x:Uid="EditorPage_ClearButton" Grid.Column="4"
                    Content="Clear Queue"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="EditorPage_ExportButton" Grid.Column="5"
                    Content="Export All"
                    x:Name="ExportButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Export_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ExportButton"/>
        </Grid>

        <Grid x:Name="ProgressOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="540">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="EditorPage_ProgressTitle" x:Name="ProgressTitle"
                               Text="Exporting..."
                               Style="{StaticResource TitleTextStyle}"/>
                    <ProgressBar x:Uid="EditorPage_ProgressBar" AutomationProperties.Name="Progress" x:Name="ProgressBar"
                                 Height="8"
                                 CornerRadius="4"
                                 Minimum="0"
                                 Maximum="100"/>
                    <TextBlock x:Name="ProgressStage"
                               Style="{StaticResource SubtitleTextStyle}"/>
                    <TextBlock x:Name="ProgressEta"
                               Style="{StaticResource MutedTextStyle}"/>
                    <ScrollViewer Height="86"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceLightBrush}"
                                  Padding="8"
                                  CornerRadius="4">
                        <TextBlock x:Name="ProgressLog"
                                   Style="{StaticResource CodeTextStyle}"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="12">
                        <Button x:Uid="EditorPage_CancelButton" x:Name="CancelButton"
                                Content="Cancel"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Cancel_Click"
                            AutomationProperties.AutomationId="CancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
