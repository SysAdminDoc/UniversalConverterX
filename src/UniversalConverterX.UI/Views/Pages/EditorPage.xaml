<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Video Editor" Style="{StaticResource TitleTextStyle}"/>
                <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="10" Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="Preview" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentYellowBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Trim, crop, rotate, upscale, filter, and adjust audio. Will be powered by ClipForge in v2.0."
                       Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="6">
                <StackPanel Spacing="6">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="0" Width="56" Height="56"
                            Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE71D;" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="0" Width="56" Height="56"
                            Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE7AD;" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="0" Width="56" Height="56"
                            Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE74A;" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="0" Width="56" Height="56"
                            Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="0" Width="56" Height="56"
                            Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE799;" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Background="#000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE714;" FontSize="56" Foreground="{StaticResource TextMutedBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Preview" Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Properties" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="No clip selected" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Filters" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ComboBox Header="Effect" PlaceholderText="None" Width="240" IsEnabled="False"/>
                        <ComboBox Header="LUT" PlaceholderText="None" Width="240" IsEnabled="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                    <Button Padding="10,6" Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Padding="10,6" Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Padding="10,6" Background="Transparent" BorderThickness="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <TextBlock Text="00:00:00 / 00:00:00" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource SurfaceLightBrush}" CornerRadius="6">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Timeline" Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop a clip to begin" Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
