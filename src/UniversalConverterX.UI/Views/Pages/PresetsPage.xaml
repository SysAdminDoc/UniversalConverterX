<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="PresetCardTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="16"
                    Margin="0,0,0,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="12"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   LineHeight="17"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Spacing="6">
                        <Button Content="Run"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,10"
                                Click="RunPreset_Click"
                                Tag="{Binding Name}"
                                IsEnabled="{Binding CanRun}"
                                ToolTipService.ToolTip="{Binding HealthDetail}"/>
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   TextAlignment="Center" FontSize="10"
                                   TextWrapping="Wrap"
                                   MaxWidth="132"
                                   ToolTipService.ToolTip="{Binding HealthDetail}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="Presets"
                           Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Browse shipped and user-defined presets, filter by engine, and run the same workflows used by the CLI and Explorer menu."
                           Style="{StaticResource SubtitleTextStyle}" FontSize="13"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Reload"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Reload_Click"
                    VerticalAlignment="Center"
                AutomationProperties.AutomationId="PresetsPageButton01"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="Filter by name, folder, engine..."
                                QueryIcon="Find"
                                TextChanged="Search_TextChanged"
                    AutomationProperties.AutomationId="SearchBox"/>
                <ComboBox Grid.Column="1"
                          x:Name="EngineFilter"
                          Header="Engine filter"
                          SelectionChanged="EngineFilter_Changed"
                    AutomationProperties.AutomationId="EngineFilter">
                    <ComboBoxItem Content="All engines" Tag=""/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE946;"
                          Foreground="{StaticResource AccentBlueBrush}"
                          FontSize="20"
                          VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="HealthPanelTitle"
                               Text="Preset health"
                               Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Name="HealthPanelSummary"
                               Text="Checking visible preset engines..."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="HealthPanelDetails"
                               Text=""
                               Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap"
                               MaxLines="3"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="520">
                <Border Width="86" Height="86" CornerRadius="22"
                        Background="{StaticResource SurfaceLightBrush}">
                    <FontIcon Glyph="&#xE71D;" FontSize="38"
                              Foreground="{StaticResource AccentOrangeBrush}"/>
                </Border>
                <TextBlock Text="No presets match this filter"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Clear the search, choose All engines, or add a compatible *.preset.xml file to your UCX presets folder."
                           Style="{StaticResource MutedTextStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer x:Name="PresetScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PresetList"
                              ItemTemplate="{StaticResource PresetCardTemplate}"/>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Loading presets..."/>
    </Grid>
</Page>
