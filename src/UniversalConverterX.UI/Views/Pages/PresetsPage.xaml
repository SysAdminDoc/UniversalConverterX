<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="PresetCardTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="10" Padding="16"
                    Margin="0,0,0,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="12"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource LabelTextStyle}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Background="{StaticResource SurfaceLightBrush}"
                                    CornerRadius="8"
                                    Padding="7,2">
                                <TextBlock Text="{Binding OriginLabel}"
                                           Style="{StaticResource SubtleTextStyle}"
                                           FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   LineHeight="17"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Uid="PresetsPage_Item_001" Content="Run"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,9"
                                    Click="RunPreset_Click"
                                    Tag="{Binding CatalogItem.Id}"
                                    IsEnabled="{Binding CanRun}"
                                    ToolTipService.ToolTip="{Binding HealthDetail}"/>
                            <Button x:Uid="PresetsPage_Item_002" Content="Edit"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,9"
                                    Click="EditPreset_Click"
                                    Tag="{Binding SourcePath}"
                                    IsEnabled="{Binding CanEdit}"
                                    ToolTipService.ToolTip="{Binding EditHint}"/>
                            <Button x:Uid="PresetsPage_Item_003" Content="Duplicate"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,9"
                                    Click="DuplicatePreset_Click"
                                    Tag="{Binding SourcePath}"
                                    ToolTipService.ToolTip="Create an editable custom copy"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   TextAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxWidth="132"
                                   ToolTipService.ToolTip="{Binding HealthDetail}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="PresetsPage_Item_004" Text="Presets"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="PresetsPage_Item_005" Text="Browse, filter, and run shipped or custom conversion presets."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Uid="PresetsPage_PresetsCreatePresetButton" Content="New preset"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CreatePreset_Click"
                        AutomationProperties.AutomationId="PresetsCreatePresetButton"/>
                <Button x:Uid="PresetsPage_PresetsReloadButton" Content="Reload"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Reload_Click"
                        AutomationProperties.AutomationId="PresetsReloadButton"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Uid="PresetsPage_SearchBox" x:Name="SearchBox"
                                PlaceholderText="Filter by name, folder, engine..."
                                QueryIcon="Find"
                                TextChanged="Search_TextChanged"
                    AutomationProperties.AutomationId="SearchBox"/>
                <ComboBox x:Uid="PresetsPage_EngineFilter" Grid.Column="1"
                          x:Name="EngineFilter"
                          Header="Engine filter"
                          SelectionChanged="EngineFilter_Changed"
                    AutomationProperties.AutomationId="EngineFilter">
                    <ComboBoxItem x:Uid="PresetsPage_Item_010" Content="All engines" Tag=""/>
                </ComboBox>
                <ComboBox x:Uid="PresetsPage_FamilyFilter" Grid.Column="2"
                          x:Name="FamilyFilter"
                          Header="Preset family"
                          SelectionChanged="FamilyFilter_Changed"
                          AutomationProperties.AutomationId="PresetsFamilyFilter">
                    <ComboBoxItem x:Uid="PresetsPage_Item_012" Content="All families" Tag=""/>
                    <ComboBoxItem x:Uid="PresetsPage_Item_013" Content="Preservation" Tag="Preservation"/>
                    <ComboBoxItem x:Uid="PresetsPage_Item_014" Content="Production" Tag="Production"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE946;"
                          Foreground="{StaticResource AccentBlueBrush}"
                          FontSize="20"
                          VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="PresetsPage_HealthPanelTitle" x:Name="HealthPanelTitle"
                               Text="Preset health"
                               Style="{StaticResource PanelTitleTextStyle}"/>
                    <TextBlock x:Uid="PresetsPage_HealthPanelSummary" x:Name="HealthPanelSummary"
                               Text="Checking visible preset engines..."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="HealthPanelDetails"
                               Text=""
                               Style="{StaticResource SubtleTextStyle}"
                               TextWrapping="Wrap"
                               MaxLines="3"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="520">
                <Border Width="86" Height="86" CornerRadius="12"
                        Background="{StaticResource SurfaceLightBrush}">
                    <FontIcon Glyph="&#xE71D;" FontSize="38"
                              Foreground="{StaticResource AccentOrangeBrush}"/>
                </Border>
                <TextBlock x:Uid="PresetsPage_Item_017" Text="No presets match this filter"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Uid="PresetsPage_Item_018" Text="Clear the search, choose All engines, or add a compatible *.preset.xml file to your UCX presets folder."
                           Style="{StaticResource MutedTextStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer x:Name="PresetScroll" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="PresetList"
                               ItemTemplate="{StaticResource PresetCardTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Uid="PresetsPage_StatusText" Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Loading presets..."/>
    </Grid>
</Page>
