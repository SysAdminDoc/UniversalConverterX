<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.FontConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="FontFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12"
                    Margin="0,0,0,8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D2;" FontSize="22"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FileName}"
                               Style="{StaticResource LabelTextStyle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Font Converter"
                           Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Convert TTF / OTF / WOFF / WOFF2. WOFF and WOFF2 are the modern web-font wrappers (the latter uses Brotli compression). Backed by fonttools."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Add fonts"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"/>
                <Button x:Name="ConvertButton"
                        Content="Convert"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Convert_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FormatCombo"
                          Header="Target format"
                          SelectedIndex="2">
                    <ComboBoxItem Content="TTF (TrueType)" Tag="ttf"/>
                    <ComboBoxItem Content="OTF (OpenType)" Tag="otf"/>
                    <ComboBoxItem Content="WOFF (web)" Tag="woff"/>
                    <ComboBoxItem Content="WOFF2 (web, Brotli)" Tag="woff2"/>
                </ComboBox>
                <TextBox Grid.Column="1"
                         x:Name="OutputDirBox"
                         Header="Output directory"
                         IsReadOnly="True"
                         PlaceholderText="(same as source)"/>
                <Button Grid.Column="2"
                        Content="Browse..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="BrowseOutputDir_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="80" Height="80" CornerRadius="20"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE8D2;" FontSize="36"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock Text="Add fonts"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop or pick TTF / OTF / WOFF / WOFF2 files. Pick a target format and run."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="FilesScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FilesList"
                                  ItemTemplate="{StaticResource FontFileTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressBar AutomationProperties.Name="Progress"
                     Grid.Row="3"
                     x:Name="WorkProgress"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"/>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Add fonts to begin."/>
    </Grid>
</Page>
