<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.FontConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="FontFileTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D2;" FontSize="24"
                              Foreground="{StaticResource AccentBlueBrush}"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="11"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Button x:Uid="FontConverterPage_Item_001" Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="FontConverterPage_Item_002" Text="FONT CONVERTER"
                           Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock x:Uid="FontConverterPage_Item_003" Text="Convert TTF / OTF / WOFF / WOFF2. WOFF and WOFF2 are the modern web-font wrappers (the latter uses Brotli compression). Backed by fonttools."
                           Style="{StaticResource TitleTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720" LineHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="FontConverterPage_FontConverterPageButton01" Content="Add fonts"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddFiles_Click"
                    AutomationProperties.AutomationId="FontConverterPageButton01"/>
                <Button x:Uid="FontConverterPage_ConvertButton" x:Name="ConvertButton"
                        Content="Convert"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Convert_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="ConvertButton"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Uid="FontConverterPage_FormatCombo" x:Name="FormatCombo"
                          Header="Target format"
                          SelectedIndex="2"
                    AutomationProperties.AutomationId="FormatCombo">
                    <ComboBoxItem x:Uid="FontConverterPage_Item_007" Content="TTF (TrueType)" Tag="ttf"/>
                    <ComboBoxItem x:Uid="FontConverterPage_Item_008" Content="OTF (OpenType)" Tag="otf"/>
                    <ComboBoxItem x:Uid="FontConverterPage_Item_009" Content="WOFF (web)" Tag="woff"/>
                    <ComboBoxItem x:Uid="FontConverterPage_Item_010" Content="WOFF2 (web, Brotli)" Tag="woff2"/>
                </ComboBox>
                <TextBox x:Uid="FontConverterPage_OutputDirBox" Grid.Column="1"
                         x:Name="OutputDirBox"
                         Header="Output directory"
                         IsReadOnly="True"
                         PlaceholderText="(same as source)"
                    AutomationProperties.AutomationId="OutputDirBox"/>
                <Button x:Uid="FontConverterPage_FontConverterPageButton02" Grid.Column="2"
                        Content="Browse..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="BrowseOutputDir_Click"
                    AutomationProperties.AutomationId="FontConverterPageButton02"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <Border Width="88" Height="88" CornerRadius="22"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE8D2;" FontSize="40"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Uid="FontConverterPage_Item_013" Text="Add fonts"
                               Style="{StaticResource SubtitleTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="FontConverterPage_Item_014" Text="Drop or pick TTF / OTF / WOFF / WOFF2 files. Pick a target format and run."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="FilesScroll" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FilesList"
                                  ItemTemplate="{StaticResource FontFileTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressBar x:Uid="FontConverterPage_WorkProgress" AutomationProperties.Name="Progress"
                     Grid.Row="3"
                     x:Name="WorkProgress"
                     Minimum="0" Maximum="100"
                     IsIndeterminate="False"/>

        <TextBlock x:Uid="FontConverterPage_StatusText" Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Add fonts to begin."/>
    </Grid>
</Page>
