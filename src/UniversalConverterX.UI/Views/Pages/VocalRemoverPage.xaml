<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VocalRemoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Vocal Remover" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Split vocals and instrumentals for music production, karaoke, and editing workflows using Demucs stem separation."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>

            <!-- Dev status banner -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentRedBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xEC4F;" FontSize="22"
                                  Foreground="{StaticResource AccentRedBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{StaticResource AccentRedBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="WAVE 2" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource TextInverseBrush}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="Engine: Demucs" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource AccentRedBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Vocal Remover is not yet available in this build."
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="What's needed: Demucs sidecar integration, stem preview playback, and multi-file stem export pipeline."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Input area -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    MinHeight="160"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="18"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEC4F;" FontSize="32"
                                  Foreground="{StaticResource AccentRedBrush}"/>
                    </Border>
                    <TextBlock x:Name="DropZoneLabel"
                               Text="Drop audio or video files here or click Browse"
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="BrowseButton" Content="Browse Files"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="Browse_Click"/>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Separation" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Stems" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Vocals + Instrumentals (2-stem)" IsSelected="True"/>
                                <ComboBoxItem Content="Vocals only"/>
                                <ComboBoxItem Content="Instrumentals only"/>
                                <ComboBoxItem Content="4-stem (vocals/drums/bass/other)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Demucs Model" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="htdemucs (recommended)" IsSelected="True"/>
                                <ComboBoxItem Content="htdemucs_ft (fine-tuned)"/>
                                <ComboBoxItem Content="mdx_extra (MDX-Net)"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Output" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Format" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="WAV (lossless)" IsSelected="True"/>
                                <ComboBoxItem Content="FLAC (lossless)"/>
                                <ComboBoxItem Content="MP3 (320kbps)"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch Header="Separate files per stem" OffContent="Off" OnContent="On" IsOn="True"/>
                        <ToggleSwitch Header="Shift by half a window" OffContent="Off" OnContent="On"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Vocal Remover is coming in Wave 2."
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Separate Stems"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
