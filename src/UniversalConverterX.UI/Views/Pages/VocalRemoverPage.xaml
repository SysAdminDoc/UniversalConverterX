<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VocalRemoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="VrQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xEC4F;" FontSize="20"
                                  Foreground="{StaticResource AccentRedBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding SettingsSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VrFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}"
                                  FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputDir}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputDir}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Vocal Remover" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="Split vocals and instrumentals using Demucs stem separation."
                           Style="{StaticResource SubtitleTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Add Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="VocalRemoverPageButton01"/>
                <Button Content="Add Folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="VocalRemoverPageButton02"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem Header="Queue"
                        AutomationProperties.AutomationId="VocalRemoverPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="48"
                                              Foreground="{StaticResource AccentRedBrush}"/>
                                </Border>
                                <TextBlock Text="Drop audio or video files"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="MP3, WAV, FLAC, M4A, AAC, OGG, MP4, MKV, and more."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="VocalRemoverPageButton03"/>
                            </StackPanel>

                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource VrQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem Header="Finished"
                        AutomationProperties.AutomationId="VocalRemoverPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock Text="No finished separations yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Completed stems appear here after separation."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource VrFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Stems" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="StemCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="StemCombo">
                            <ComboBoxItem Content="Vocals + Instrumentals (2-stem)" Tag="2stem" IsSelected="True"/>
                            <ComboBoxItem Content="Vocals only" Tag="vocals"/>
                            <ComboBoxItem Content="Instrumentals only" Tag="accompaniment"/>
                            <ComboBoxItem Content="4-stem (vocals / drums / bass / other)" Tag="4stem"/>
                            <ComboBoxItem Content="6-stem (+guitar / piano — needs htdemucs_6s)" Tag="6stem"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Model" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="ModelCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="ModelCombo">
                            <ComboBoxItem Content="htdemucs_ft (fine-tuned, recommended)" Tag="htdemucs_ft" IsSelected="True"/>
                            <ComboBoxItem Content="htdemucs (base)" Tag="htdemucs"/>
                            <ComboBoxItem Content="mdx_extra (MDX-Net)" Tag="mdx_extra"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output Format" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="FormatCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Settings_Changed"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem Content="WAV (lossless)" Tag="wav" IsSelected="True"/>
                            <ComboBoxItem Content="FLAC (lossless)" Tag="flac"/>
                            <ComboBoxItem Content="MP3 (320 kbps)" Tag="mp3"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Quality" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ToggleSwitch x:Name="ShiftsToggle"
                                      Header="Equivariant stabilization"
                                      OffContent="Off (faster)"
                                      OnContent="On (better quality)"
                                      Toggled="Settings_Changed"
                            AutomationProperties.AutomationId="ShiftsToggle"/>
                        <TextBlock Text="Runs separation twice with shifted windows and averages the result. Doubles processing time."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Output Folder" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Name="OutputDirectoryBox"
                                 Header="Save stems to"
                                 PlaceholderText="Same folder as each source"
                                 IsReadOnly="True"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="VocalRemoverPageButton04"/>
                            <Button Grid.Column="1"
                                    Content="Same as source"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="VocalRemoverPageButton05"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1"
                    Content="Open Output Folder"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click"
                    Margin="0,0,12,0"
                AutomationProperties.AutomationId="VocalRemoverPageButton06"/>
            <Button Grid.Column="2"
                    Content="Clear Queue"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button Grid.Column="3"
                    Content="Separate Stems"
                    x:Name="RunButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Run_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="RunButton"/>
        </Grid>

        <Grid x:Name="ProgressOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="540">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="ProgressTitle"
                               Text="Separating stems..."
                               Style="{StaticResource TitleTextStyle}"/>
                    <ProgressBar AutomationProperties.Name="Progress" x:Name="ProgressBar"
                                 Height="8" CornerRadius="4"
                                 Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressStage"
                               Style="{StaticResource SubtitleTextStyle}"/>
                    <TextBlock x:Name="ProgressEta"
                               Style="{StaticResource MutedTextStyle}"/>
                    <ScrollViewer Height="86"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceLightBrush}"
                                  Padding="8"
                                  CornerRadius="4">
                        <TextBlock x:Name="ProgressLog"
                                   Style="{StaticResource CodeTextStyle}"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="12">
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Cancel_Click"
                            AutomationProperties.AutomationId="CancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

