<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VmafAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Uid="VmafAnalysisPage_Item_001" Text="VMAF Quality Analysis"
                       Style="{StaticResource TitleTextStyle}"/>
            <TextBlock x:Uid="VmafAnalysisPage_Item_002" Text="Score a distorted (compressed / re-encoded) clip against its high-quality reference. VMAF runs frame-by-frame; results show pooled mean, Netflix-style harmonic mean (more sensitive to worst frames), and the percentage of frames below 70 (visible degradation)."
                       Style="{StaticResource SubtitleTextStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="14" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="VmafAnalysisPage_Item_003" Text="Reference"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Uid="VmafAnalysisPage_ReferenceLabel" x:Name="ReferenceLabel"
                           Grid.Column="1"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="(pick the original master clip)"/>
                <Button x:Uid="VmafAnalysisPage_VmafAnalysisPageButton01" Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Browse..."
                        Click="PickReference_Click"
                    AutomationProperties.AutomationId="VmafAnalysisPageButton01"/>

                <TextBlock x:Uid="VmafAnalysisPage_Item_006" Grid.Row="1" Text="Distorted"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Uid="VmafAnalysisPage_DistortedLabel" x:Name="DistortedLabel"
                           Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="(pick the compressed clip to evaluate)"/>
                <Button x:Uid="VmafAnalysisPage_VmafAnalysisPageButton02" Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Browse..."
                        Click="PickDistorted_Click"
                    AutomationProperties.AutomationId="VmafAnalysisPageButton02"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <ToggleSwitch x:Uid="VmafAnalysisPage_ProxyToggle" x:Name="ProxyToggle"
                              Header="Fast proxy pass (480p approximate)"
                              OffContent="Full-resolution VMAF"
                              OnContent="Proxy both inputs to 480p for a quick approximate score"
                              AutomationProperties.AutomationId="VmafProxyToggle"/>
                <ProgressBar x:Uid="VmafAnalysisPage_VmafProgress" AutomationProperties.Name="Progress" x:Name="VmafProgress"
                             Minimum="0" Maximum="100"
                             IsIndeterminate="False"
                             VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Uid="VmafAnalysisPage_RunButton" Grid.Column="1"
                    x:Name="RunButton"
                    Content="Run VMAF"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Run_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="RunButton"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_011" Text="Mean (pooled)" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatMean" x:Name="StatMean" Text="--" Style="{StaticResource TitleTextStyle}" FontSize="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_013" Text="Harmonic mean" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatHarmonic" x:Name="StatHarmonic" Text="--" Style="{StaticResource TitleTextStyle}"
                                   FontSize="28" Foreground="{StaticResource AccentBlueBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_015" Text="Min frame" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatMin" x:Name="StatMin" Text="--" Style="{StaticResource TitleTextStyle}"
                                   FontSize="28" Foreground="{StaticResource AccentRedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_017" Text="Frames &lt; 70" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatBelow70" x:Name="StatBelow70" Text="--" Style="{StaticResource TitleTextStyle}" FontSize="28"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText"
                               Style="{StaticResource MutedTextStyle}"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Uid="VmafAnalysisPage_StatusText" Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Pick a reference + distorted clip to start."/>
    </Grid>
</Page>
