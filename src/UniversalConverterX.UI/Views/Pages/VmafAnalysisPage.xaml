<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VmafAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Uid="VmafAnalysisPage_Item_001" Text="VMAF Quality Analysis"
                       Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock x:Uid="VmafAnalysisPage_Item_002" Text="Compare an encoded clip with its reference using frame-level VMAF metrics."
                       Style="{StaticResource PageDescriptionTextStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16">
            <Grid ColumnSpacing="14" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="VmafAnalysisPage_Item_003" Text="Reference"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Uid="VmafAnalysisPage_ReferenceLabel" x:Name="ReferenceLabel"
                           Grid.Column="1"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="(pick the original master clip)"/>
                <Button x:Uid="VmafAnalysisPage_VmafAnalysisPageButton01" Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Browse..."
                        Click="PickReference_Click"
                    AutomationProperties.AutomationId="VmafAnalysisPageButton01"/>

                <TextBlock x:Uid="VmafAnalysisPage_Item_006" Grid.Row="1" Text="Distorted"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Uid="VmafAnalysisPage_DistortedLabel" x:Name="DistortedLabel"
                           Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="(pick the compressed clip to evaluate)"/>
                <Button x:Uid="VmafAnalysisPage_VmafAnalysisPageButton02" Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Browse..."
                        Click="PickDistorted_Click"
                    AutomationProperties.AutomationId="VmafAnalysisPageButton02"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <ToggleSwitch x:Uid="VmafAnalysisPage_ProxyToggle" x:Name="ProxyToggle"
                              Header="Fast proxy pass (480p approximate)"
                              OffContent="Full-resolution VMAF"
                              OnContent="Proxy both inputs to 480p for a quick approximate score"
                              AutomationProperties.AutomationId="VmafProxyToggle"/>
                <ProgressBar x:Uid="VmafAnalysisPage_VmafProgress" AutomationProperties.Name="Progress" x:Name="VmafProgress"
                             Minimum="0" Maximum="100"
                             IsIndeterminate="False"
                             VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Uid="VmafAnalysisPage_RunButton" Grid.Column="1"
                    x:Name="RunButton"
                    Content="Run VMAF"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Run_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="RunButton"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_011" Text="Mean (pooled)" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatMean" x:Name="StatMean" Text="--" Style="{StaticResource TitleTextStyle}" FontSize="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_013" Text="Harmonic mean" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatHarmonic" x:Name="StatHarmonic" Text="--" Style="{StaticResource TitleTextStyle}"
                                   FontSize="28" Foreground="{StaticResource AccentBlueBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_015" Text="Min frame" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatMin" x:Name="StatMin" Text="--" Style="{StaticResource TitleTextStyle}"
                                   FontSize="28" Foreground="{StaticResource AccentRedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock x:Uid="VmafAnalysisPage_Item_017" Text="Frames &lt; 70" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Uid="VmafAnalysisPage_StatBelow70" x:Name="StatBelow70" Text="--" Style="{StaticResource TitleTextStyle}" FontSize="28"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="SampleComparisonPanel" Grid.Row="1"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceLightBrush}"
                        CornerRadius="10"
                        Padding="12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="VmafAnalysisPage_SampleComparisonTitle"
                                       Text="Representative sample comparison"
                                       Style="{StaticResource PanelTitleTextStyle}"
                                       VerticalAlignment="Center"/>
                            <NumberBox x:Uid="VmafAnalysisPage_SampleStartBox"
                                       x:Name="SampleStartBox"
                                       Grid.Column="1"
                                       Header="Start (s)"
                                       Value="0"
                                       Minimum="0"
                                       Maximum="86400"
                                       SmallChange="1"
                                       SpinButtonPlacementMode="Inline"
                                       Width="118"
                                       AutomationProperties.AutomationId="VmafSampleStartBox"/>
                            <NumberBox x:Uid="VmafAnalysisPage_SampleDurationBox"
                                       x:Name="SampleDurationBox"
                                       Grid.Column="2"
                                       Header="Length (s)"
                                       Value="10"
                                       Minimum="3"
                                       Maximum="15"
                                       SmallChange="1"
                                       SpinButtonPlacementMode="Inline"
                                       Width="118"
                                       AutomationProperties.AutomationId="VmafSampleDurationBox"/>
                            <Button x:Uid="VmafAnalysisPage_RenderSampleButton"
                                    x:Name="RenderSampleButton"
                                    Grid.Column="3"
                                    Content="Render sample"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RenderSample_Click"
                                    AutomationProperties.AutomationId="VmafRenderSampleButton"/>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="VmafAnalysisPage_SampleSourceLabel"
                                           Text="Source segment"
                                           Style="{StaticResource MutedTextStyle}"/>
                                <MediaPlayerElement x:Name="ReferencePlayer"
                                                    AreTransportControlsEnabled="True"
                                                    AutoPlay="False"
                                                    MinHeight="220"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="VmafAnalysisPage_SampleOutputLabel"
                                           Text="Rendered output"
                                           Style="{StaticResource MutedTextStyle}"/>
                                <MediaPlayerElement x:Name="DistortedPlayer"
                                                    AreTransportControlsEnabled="True"
                                                    AutoPlay="False"
                                                    MinHeight="220"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock x:Uid="VmafAnalysisPage_SampleEstimateLabel"
                                           Text="Estimate"
                                           Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="SampleEstimateText"
                                           Style="{StaticResource SubtleTextStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Uid="VmafAnalysisPage_UseSettingsButton"
                                    x:Name="UseSettingsButton"
                                    Grid.Column="1"
                                    Content="Use these settings for the full job"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="UseSettings_Click"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="VmafUseSettingsButton"/>
                        </Grid>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText"
                               Style="{StaticResource MutedTextStyle}"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock x:Uid="VmafAnalysisPage_StatusText" Grid.Row="4"
                   x:Name="StatusText"
                   Style="{StaticResource MutedTextStyle}"
                   Text="Pick a reference + distorted clip to start."/>
    </Grid>
</Page>
