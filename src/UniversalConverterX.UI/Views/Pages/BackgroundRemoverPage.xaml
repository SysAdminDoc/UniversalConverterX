<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.BackgroundRemoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="BgRemoveQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE91B;" FontSize="20"
                                  Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding ModelSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Border>

                    <Button x:Uid="BackgroundRemoverPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="BackgroundRemoverPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="92" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BgRemoveFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="BackgroundRemoverPage_Item_003" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="BackgroundRemoverPage_Item_004" Text="Background Remover" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="BackgroundRemoverPage_Item_005" Text="Remove or replace video and image backgrounds with AI segmentation. Exports alpha channel or composited output."
                           Style="{StaticResource PageDescriptionTextStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="BackgroundRemoverPage_BackgroundRemoverPageButton01" Content="Add Files" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="BackgroundRemoverPageButton01"/>
                <Button x:Uid="BackgroundRemoverPage_BackgroundRemoverPageButton02" Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="BackgroundRemoverPageButton02"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Drop zone + queue -->
            <Border x:Name="DropZone" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="BackgroundRemoverPage_BackgroundRemoverPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="BackgroundRemoverPagePivotItem01">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE91B;" FontSize="30"
                                              Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                                <TextBlock x:Uid="BackgroundRemoverPage_Item_009" Text="Drop video or image files"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="BackgroundRemoverPage_Item_010" Text="MP4, MOV, MKV, WebM, PNG, JPG, WEBP, and more."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Uid="BackgroundRemoverPage_BackgroundRemoverPageButton03" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="BackgroundRemoverPageButton03"/>
                            </StackPanel>

                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource BgRemoveQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="BackgroundRemoverPage_BackgroundRemoverPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="BackgroundRemoverPagePivotItem02">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="30"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="BackgroundRemoverPage_Item_013" Text="No finished jobs yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="BackgroundRemoverPage_Item_014" Text="Completed, failed, and cancelled jobs appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource BgRemoveFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <!-- Settings panel -->
            <StackPanel Grid.Column="1" Spacing="14">

                <!-- Model -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="BackgroundRemoverPage_Item_015" Text="AI Model" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="ModelCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="ModelCombo_SelectionChanged"
                            AutomationProperties.AutomationId="ModelCombo">
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_016" Content="Human Segmentation (u2net_human_seg)" Tag="u2net_human_seg" IsSelected="True"/>
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_017" Content="General Purpose (isnet-general-use)" Tag="isnet-general-use"/>
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_018" Content="Fast General (u2net)" Tag="u2net"/>
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_019" Content="Anime / Illustration (isnet-anime)" Tag="isnet-anime"/>
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_020" Content="High Accuracy (u2net_cloth_seg)" Tag="u2net_cloth_seg"/>
                        </ComboBox>
                        <TextBlock x:Uid="BackgroundRemoverPage_ModelStatus" x:Name="ModelStatus" Text="Checking model integrity…"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="BackgroundRemoverModelStatus"/>
                        <Button x:Uid="BackgroundRemoverPage_DownloadModelButton" x:Name="DownloadModelButton" Content="Download verified model (168 MB)"
                                HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"
                                Click="DownloadModel_Click"
                                AutomationProperties.AutomationId="BackgroundRemoverDownloadModelButton"/>
                    </StackPanel>
                </Border>

                <!-- Output format -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="BackgroundRemoverPage_Item_021" Text="Output Format" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_022" Content="MP4 (H.264 + alpha composite)" Tag="mp4" IsSelected="True"/>
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_023" Content="MOV (ProRes alpha)" Tag="mov"/>
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_024" Content="WebM (VP9 alpha)" Tag="webm"/>
                            <ComboBoxItem x:Uid="BackgroundRemoverPage_Item_025" Content="PNG Sequence (lossless alpha)" Tag="png_sequence"/>
                        </ComboBox>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="BackgroundRemoverPage_Item_026" Text="Quality" Style="{StaticResource MutedTextStyle}"/>
                            <Slider x:Name="QualitySlider" Minimum="0" Maximum="100" Value="70"
                                    TickFrequency="10"
                                AutomationProperties.AutomationId="QualitySlider"/>
                            <TextBlock Style="{StaticResource MutedTextStyle}">
                                <Run x:Uid="BackgroundRemoverPage_Item_027" Text="Quality: "/>
                                <Run x:Uid="BackgroundRemoverPage_QualityValueText" x:Name="QualityValueText" Text="70"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Edge &amp; mask -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="BackgroundRemoverPage_Item_029" Text="Edge &amp; Mask" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="BackgroundRemoverPage_Item_030" Text="Edge Softness" Style="{StaticResource MutedTextStyle}"/>
                            <Slider x:Name="EdgeSlider" Minimum="0" Maximum="100" Value="0"
                                   
                                AutomationProperties.AutomationId="EdgeSlider"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="BackgroundRemoverPage_InvertMaskToggle" x:Name="InvertMaskToggle" Header="Invert mask (keep background)"
                                      OffContent="Off" OnContent="On"
                            AutomationProperties.AutomationId="InvertMaskToggle"/>
                        <ToggleSwitch x:Uid="BackgroundRemoverPage_KeepAudioToggle" x:Name="KeepAudioToggle" Header="Keep audio track"
                                      IsOn="True" OffContent="Off" OnContent="On"
                            AutomationProperties.AutomationId="KeepAudioToggle"/>
                    </StackPanel>
                </Border>

                <!-- Background -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="BackgroundRemoverPage_Item_033" Text="Background" Style="{StaticResource PanelTitleTextStyle}"/>
                        <RadioButton x:Uid="BackgroundRemoverPage_BgTransparent" x:Name="BgTransparent" Content="Transparent / alpha"
                                     GroupName="BgType" IsChecked="True"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Checked="BgType_Checked"
                            AutomationProperties.AutomationId="BgTransparent"/>
                        <RadioButton x:Uid="BackgroundRemoverPage_BgSolid" x:Name="BgSolid" Content="Solid color"
                                     GroupName="BgType"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Checked="BgType_Checked"
                            AutomationProperties.AutomationId="BgSolid"/>
                        <RadioButton x:Uid="BackgroundRemoverPage_BgImage" x:Name="BgImage" Content="Background image"
                                     GroupName="BgType"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Checked="BgType_Checked"
                            AutomationProperties.AutomationId="BgImage"/>

                        <StackPanel x:Name="BgColorPanel" Spacing="8" Visibility="Collapsed">
                            <TextBox x:Uid="BackgroundRemoverPage_BgColorBox" x:Name="BgColorBox"
                                     Header="Hex color"
                                     PlaceholderText="#ffffff"
                                     MaxLength="9"
                                AutomationProperties.AutomationId="BgColorBox"/>
                        </StackPanel>

                        <StackPanel x:Name="BgImagePanel" Spacing="8" Visibility="Collapsed">
                            <TextBox x:Uid="BackgroundRemoverPage_BgImagePathBox" x:Name="BgImagePathBox"
                                     Header="Image path"
                                     PlaceholderText="No image selected"
                                     IsReadOnly="True"
                                AutomationProperties.AutomationId="BgImagePathBox"/>
                            <Button x:Uid="BackgroundRemoverPage_BackgroundRemoverPageButton04" Content="Browse Image"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseBgImage_Click"
                                AutomationProperties.AutomationId="BackgroundRemoverPageButton04"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output folder -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="BackgroundRemoverPage_Item_040" Text="File Location" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="BackgroundRemoverPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                 Header="Save to"
                                 PlaceholderText="Same as source file"
                                 IsReadOnly="True"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="BackgroundRemoverPage_BackgroundRemoverPageButton05" Grid.Column="0" Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="BackgroundRemoverPageButton05"/>
                            <Button x:Uid="BackgroundRemoverPage_BackgroundRemoverPageButton06" Grid.Column="1" Content="Same as source"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="BackgroundRemoverPageButton06"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="BackgroundRemoverPage_ClearButton" Grid.Column="1" Content="Clear Queue"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click" Margin="0,0,12,0" IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="BackgroundRemoverPage_BackgroundRemoverPageButton07" Grid.Column="2" Content="Open Output"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click" Margin="0,0,12,0"
                AutomationProperties.AutomationId="BackgroundRemoverPageButton07"/>
            <Button x:Uid="BackgroundRemoverPage_RunButton" Grid.Column="3" Content="Remove Backgrounds"
                    x:Name="RunButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Run_Click" IsEnabled="False"
                AutomationProperties.AutomationId="RunButton"/>
        </Grid>

        <!-- Progress overlay -->
        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="560">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="BackgroundRemoverPage_ProgressTitle" x:Name="ProgressTitle" Text="Removing backgrounds..."
                               Style="{StaticResource TitleTextStyle}"/>
                    <ProgressBar x:Uid="BackgroundRemoverPage_ProgressBar" AutomationProperties.Name="Progress" x:Name="ProgressBar" Height="8" CornerRadius="4"
                                 Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressStage" Style="{StaticResource SubtitleTextStyle}"/>
                    <TextBlock x:Name="ProgressEta" Style="{StaticResource MutedTextStyle}"/>
                    <ScrollViewer Height="96" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceLightBrush}" Padding="8" CornerRadius="4">
                        <TextBlock x:Name="ProgressLog" Style="{StaticResource CodeTextStyle}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Uid="BackgroundRemoverPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Cancel_Click"
                            AutomationProperties.AutomationId="CancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
