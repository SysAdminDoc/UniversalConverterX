<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Padding="40,32,40,40" RowSpacing="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hero -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="32">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="UniversalConverter X" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="One app for everything: convert, compress, edit, download, record, and 25+ AI-powered tools — all local, no subscription."
                                   Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" MaxWidth="640"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                            <Button Content="Open Converter" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenConverter_Click"/>
                            <Button Content="Browse Toolbox" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenToolbox_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="16" Width="120" Height="120" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8AB;" FontSize="56"
                                  Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Quick search -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="18"
                              Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" PlaceholderText="Search modules and tools..."
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </Border>

            <!-- Primary modules -->
            <StackPanel Grid.Row="2" Spacing="12">
                <TextBlock Text="Modules" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <GridView x:Name="ModulesGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ModuleTile_Click">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="140" Padding="16" Margin="0,0,12,12"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="10"
                                            Width="44" Height="44">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                                  Foreground="{Binding AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- Recent files -->
            <StackPanel Grid.Row="3" Spacing="12">
                <TextBlock Text="Recent Files" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Style="{StaticResource CardStyle}" Padding="32" MinHeight="120">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32"
                                  Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No recent files yet"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="4" Text="UniversalConverter X v2.0.0 • Local processing, no telemetry"
                       Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </Grid>
    </ScrollViewer>
</Page>
