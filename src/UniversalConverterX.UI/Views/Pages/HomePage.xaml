<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ActionCardTemplate">
            <Border Width="222" Height="172" Padding="18" Margin="0,0,14,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                                Background="{Binding AccentSurfaceBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Padding="8,3" CornerRadius="10"
                                Background="{StaticResource SurfaceLightBrush}"
                                Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding AccentBrush}"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="{Binding Description}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="3"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding ActionText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AiFeatureTemplate">
            <Border Width="232" Height="116" Padding="14" Margin="0,0,12,12"
                    Background="{StaticResource AiGradientBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            Background="{StaticResource SurfaceBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ClusterTemplate">
            <Border Width="304" MinHeight="164" Padding="18" Margin="0,0,14,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="12"
                                Background="{Binding AccentSurfaceBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitleTextStyle}"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" MaxLines="4"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PersonaTemplate">
            <Border Width="244" Height="128" Padding="16" Margin="0,0,12,12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource LabelTextStyle}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" MaxLines="3"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Padding="32" RowSpacing="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="24" Padding="32">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="328"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="999"
                                Padding="12,6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="LOCAL MEDIA WORKSPACE"
                                           Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource AccentPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="The all-in-one media workshop, kept entirely on your machine."
                                   Style="{StaticResource HeroTextStyle}"
                                   TextWrapping="Wrap" MaxWidth="720"/>
                        <TextBlock Text="Convert, compress, edit, download, record, and inspect — every workflow as a guided queue with clear output, recovery, and status. Files stay on disk unless you opt in."
                                   Style="{StaticResource SubtitleTextStyle}"
                                   TextWrapping="Wrap" MaxWidth="720"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                            <Button Content="Open Converter" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenConverter_Click"/>
                            <Button Content="Open AI Lab" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenAiLab_Click"/>
                            <Button Content="Browse Toolbox" Style="{StaticResource GhostButtonStyle}"
                                    Click="OpenToolbox_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="22" VerticalAlignment="Stretch">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="AT A GLANCE" Style="{StaticResource MetricLabelTextStyle}"/>
                                <TextBlock Text="Workspace status" Style="{StaticResource PanelTitleTextStyle}"/>
                            </StackPanel>
                            <Grid RowSpacing="14" ColumnSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="14" Padding="14,12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="7" Style="{StaticResource MetricNumberTextStyle}"
                                                   Foreground="{StaticResource AccentPrimaryBrush}"/>
                                        <TextBlock Text="MODULES READY" Style="{StaticResource MetricLabelTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceSoftBrush}"
                                        CornerRadius="14" Padding="14,12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="29" Style="{StaticResource MetricNumberTextStyle}"
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                        <TextBlock Text="TOOLS MAPPED" Style="{StaticResource MetricLabelTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="14" Padding="14,12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="1,000+" Style="{StaticResource MetricNumberTextStyle}"
                                                   Foreground="{StaticResource AccentOrangeBrush}"/>
                                        <TextBlock Text="FORMATS COVERED" Style="{StaticResource MetricLabelTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceSoftBrush}"
                                        CornerRadius="14" Padding="14,12">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE83D;" FontSize="14"
                                                      Foreground="{StaticResource AccentGreenBrush}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="Local" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentGreenBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="DEFAULT MODE" Style="{StaticResource MetricLabelTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                    CornerRadius="20" Padding="14,8">
                <AutoSuggestBox x:Name="TaskSearchBox"
                                PlaceholderText="Search a task: convert, compress, record, inspect, extract frames..."
                                QueryIcon="Find"
                                TextChanged="TaskSearchBox_TextChanged"
                                SuggestionChosen="TaskSearchBox_SuggestionChosen"
                                QuerySubmitted="TaskSearchBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Border>

            <StackPanel Grid.Row="2" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Workflows" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Ready to use" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="ActionsGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ActionTile_Click"
                          ItemTemplate="{StaticResource ActionCardTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AI Lab" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Local intelligence" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="AiGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AiTile_Click"
                          ItemTemplate="{StaticResource AiFeatureTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Professional Toolbox" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Specialized utilities" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="ClustersGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ClusterTile_Click"
                          ItemTemplate="{StaticResource ClusterTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Choose Your Scenario" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Text="Workflow guidance" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="PersonasGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="PersonaTile_Click"
                          ItemTemplate="{StaticResource PersonaTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Center" Margin="0,4,0,0">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="UniversalConverter X v2.1.0"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource DividerBrush}" Width="1" Height="12"
                        VerticalAlignment="Center"/>
                <TextBlock Text="Local-first processing"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource DividerBrush}" Width="1" Height="12"
                        VerticalAlignment="Center"/>
                <TextBlock Text="No telemetry"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
