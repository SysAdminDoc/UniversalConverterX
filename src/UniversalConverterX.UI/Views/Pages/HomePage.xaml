<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ActionCardTemplate">
            <Border Width="222" Height="172" Padding="18" Margin="0,0,14,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                                Background="{Binding AccentSurfaceBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Padding="8,3" CornerRadius="10"
                                Background="{StaticResource SurfaceLightBrush}"
                                Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding AccentBrush}"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Description}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="3"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding ActionText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AiFeatureTemplate">
            <Border Width="232" Height="116" Padding="14" Margin="0,0,12,12"
                    Background="{StaticResource AiGradientBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            Background="{StaticResource SurfaceBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ClusterTemplate">
            <Border Width="304" MinHeight="164" Padding="18" Margin="0,0,14,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="12"
                                Background="{Binding AccentSurfaceBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" MaxLines="4"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PersonaTemplate">
            <Border Width="244" Height="128" Padding="16" Margin="0,0,12,12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" MaxLines="3"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Padding="34,28,34,38" RowSpacing="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="28" Padding="32">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="14" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18"
                                Padding="12,5" HorizontalAlignment="Left">
                            <TextBlock Text="AI-first local media suite" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="Convert, enhance, compress, record, and finish every media file from one workspace."
                                   FontSize="36" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                        <TextBlock Text="Start with a file, a URL, or a media problem. UCX keeps the workflow local while moving toward UniConverter-style guided modules, AI tools, and batch queues."
                                   Style="{StaticResource SubtitleTextStyle}"
                                   TextWrapping="Wrap" MaxWidth="760"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button Content="Add files to Converter" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OpenConverter_Click"/>
                            <Button Content="Open AI Lab" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenAiLab_Click"/>
                            <Button Content="Browse Toolbox" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenToolbox_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="24" Padding="22" VerticalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Workspace Status" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid RowSpacing="12" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="16" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="1000+" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBlueBrush}"/>
                                        <TextBlock Text="Formats" Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceSoftBrush}"
                                        CornerRadius="16" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="29" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                        <TextBlock Text="Tools mapped" Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="16" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="3" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentOrangeBrush}"/>
                                        <TextBlock Text="Sidecars wired" Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceSoftBrush}"
                                        CornerRadius="16" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Local" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentGreenBrush}"/>
                                        <TextBlock Text="No telemetry" Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="18">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="18"
                              Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <AutoSuggestBox x:Name="TaskSearchBox" Grid.Column="1"
                                    PlaceholderText="Search convert, subtitles, watermark, recorder, compression..."
                                    QueryIcon="Find"
                                    TextChanged="TaskSearchBox_TextChanged"
                                    SuggestionChosen="TaskSearchBox_SuggestionChosen"
                                    QuerySubmitted="TaskSearchBox_QuerySubmitted">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Begin" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Core workflows" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="ActionsGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ActionTile_Click"
                          ItemTemplate="{StaticResource ActionCardTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AI Lab" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Next-generation enhancement queue" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="AiGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AiTile_Click"
                          ItemTemplate="{StaticResource AiFeatureTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Professional Toolbox" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Creation, enhancement, and export" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="ClustersGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ClusterTile_Click"
                          ItemTemplate="{StaticResource ClusterTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Choose Your Scenario" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Guided presets coming next" Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
                <GridView x:Name="PersonasGrid" SelectionMode="None"
                          ItemTemplate="{StaticResource PersonaTemplate}"/>
                <TextBlock Text="UniversalConverter X v2.1.0 - local processing, no telemetry"
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
