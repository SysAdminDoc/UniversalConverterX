<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <Style x:Key="WorkflowCardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="116"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>

        <DataTemplate x:Key="ActionCardTemplate">
            <Button Style="{StaticResource WorkflowCardButtonStyle}"
                    Tag="{Binding RouteKey}"
                    Click="WorkflowCard_Click"
                    AutomationProperties.Name="{Binding Title}"
                    ToolTipService.ToolTip="{Binding Description}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            Background="{Binding AccentSurfaceBrush}"
                            CornerRadius="11">
                        <FontIcon Glyph="{Binding Glyph}"
                                  FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource PanelTitleTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActionText}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding AccentBrush}"/>
                    </StackPanel>

                    <FontIcon Grid.Column="2"
                              Glyph="&#xE76C;"
                              FontSize="12"
                              Foreground="{StaticResource TextMutedBrush}"
                              VerticalAlignment="Top"
                              Margin="0,3,0,0"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RecentActivityTemplate">
            <Grid Padding="14,9" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="30"
                        Height="30"
                        Background="{Binding StatusSurfaceBrush}"
                        CornerRadius="9">
                    <FontIcon Glyph="{Binding Glyph}"
                              FontSize="13"
                              Foreground="{Binding StatusBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Style="{StaticResource SubtleTextStyle}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="1"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding StatusBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Timestamp}"
                               Style="{StaticResource SubtleTextStyle}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Uid="HomePage_UpdateBanner"
                 x:Name="UpdateBanner"
                 Grid.Row="0"
                 Margin="32,12,32,0"
                 IsOpen="False"
                 Severity="Informational"
                 IsClosable="True"
                 Title="Updates available"
                 Message=""
                 AutomationProperties.AutomationId="HomePage_UpdateBanner">
            <InfoBar.ActionButton>
                <Button x:Uid="HomePage_UpdateBannerActionButton"
                        x:Name="UpdateBannerActionButton"
                        Content="Open release notes"
                        Click="UpdateBannerAction_Click"
                        AutomationProperties.AutomationId="HomePage_UpdateBannerActionButton"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Style="{StaticResource PageLayoutStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="3">
                    <TextBlock x:Uid="HomePage_HeroTitle"
                               Text="Your media, ready for anything."
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="30"/>
                    <TextBlock x:Uid="HomePage_HeroSubtitle"
                               Text="Convert, compress, download, record, and inspect media—locally."
                               Style="{StaticResource PageDescriptionTextStyle}"
                               MaxWidth="720"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <Border x:Name="FileIntakeSurface"
                        Grid.Row="1"
                        MinHeight="154"
                        Padding="20,18"
                        Background="{StaticResource HeroSurfaceBrush}"
                        BorderBrush="{StaticResource AccentPrimaryBrush}"
                        BorderThickness="0"
                        CornerRadius="14"
                        AllowDrop="True"
                        DragOver="FileIntake_DragOver"
                        DragLeave="FileIntake_DragLeave"
                        Drop="FileIntake_Drop"
                        AutomationProperties.AutomationId="HomePage_FileIntake">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7">
                        <Border Width="46"
                                Height="46"
                                Background="{StaticResource AccentPrimarySoftBrush}"
                                CornerRadius="13">
                            <FontIcon Glyph="&#xE898;"
                                      FontSize="21"
                                      Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock x:Uid="HomePage_FileIntakeTitle"
                                   Text="Drop files here to get started"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="HomePage_FileIntakeSubtitle"
                                   Text="Start with any media, document, archive, or image."
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <Grid Margin="0,3,0,0"
                              Width="560"
                              MaxWidth="560"
                              ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="HomePage_BrowseFilesButton"
                                    x:Name="BrowseFilesButton"
                                    Content="Browse files"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BrowseFiles_Click"
                                    AutomationProperties.AutomationId="HomePage_BrowseFiles"/>
                            <AutoSuggestBox x:Uid="HomePage_TaskSearchBox"
                                            x:Name="TaskSearchBox"
                                            Grid.Column="1"
                                            PlaceholderText="Search tools and workflows"
                                            QueryIcon="Find"
                                            TextChanged="TaskSearchBox_TextChanged"
                                            SuggestionChosen="TaskSearchBox_SuggestionChosen"
                                            QuerySubmitted="TaskSearchBox_QuerySubmitted"
                                            AutomationProperties.AutomationId="TaskSearchBox">
                                <AutoSuggestBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoSuggestBox.ItemTemplate>
                            </AutoSuggestBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Spacing="11">
                    <StackPanel Spacing="1">
                        <TextBlock x:Uid="HomePage_QuickWorkflowsTitle"
                                   Text="Quick workflows"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock x:Uid="HomePage_QuickWorkflowsSubtitle"
                                   Text="Get started with the most common tasks."
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <ItemsRepeater x:Name="ActionsRepeater"
                                   ItemTemplate="{StaticResource ActionCardTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal"
                                               MaximumRowsOrColumns="3"
                                               MinItemWidth="200"
                                               MinItemHeight="116"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="12"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <Border Grid.Row="3"
                        Style="{StaticResource CardStyle}"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Padding="14,11" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock x:Uid="HomePage_RecentActivityTitle"
                                           Text="Recent activity"
                                           Style="{StaticResource PanelTitleTextStyle}"/>
                                <TextBlock x:Uid="HomePage_RecentActivitySubtitle"
                                           Text="Your latest operations appear here."
                                           Style="{StaticResource SubtleTextStyle}"/>
                            </StackPanel>
                            <Button x:Uid="HomePage_OpenHistoryButton"
                                    Grid.Column="1"
                                    Content="Open history"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="OpenHistory_Click"
                                    AutomationProperties.AutomationId="HomePage_OpenHistory"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border Height="1"
                                    Background="{StaticResource DividerBrush}"
                                    VerticalAlignment="Top"/>
                            <ListView x:Name="RecentActivityList"
                                      MaxHeight="138"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      ItemTemplate="{StaticResource RecentActivityTemplate}"
                                      AutomationProperties.AutomationId="HomePage_RecentActivityList"/>
                            <TextBlock x:Uid="HomePage_RecentEmptyState"
                                       x:Name="RecentEmptyState"
                                       Text="No recent activity yet."
                                       Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,18"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Padding="12,10"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0"
                        CornerRadius="10"
                        AutomationProperties.AutomationId="HomePage_DiagnosticsCard">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="9"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA18;"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentGreenBrush}"/>
                            <StackPanel>
                                <TextBlock x:Uid="HomePage_LocalProcessingText"
                                           Text="Local processing"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Uid="HomePage_VersionText"
                                           Text="UniversalConverter X v2.36.0"
                                           Style="{StaticResource SubtleTextStyle}"/>
                                <TextBlock x:Uid="HomePage_DiagnosticsStatusText"
                                           x:Name="DiagnosticsStatusText"
                                           Text="No issues recorded this session."
                                           Style="{StaticResource SubtleTextStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6">
                            <Button x:Uid="HomePage_OpenLogFolderButton"
                                    x:Name="OpenLogFolderButton"
                                    Content="Open logs"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="OpenLogFolder_Click"
                                    AutomationProperties.AutomationId="HomePage_OpenLogFolder"/>
                            <Button x:Uid="HomePage_ExportCrashBundleButton"
                                    x:Name="ExportCrashBundleButton"
                                    Content="Export bundle"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ExportCrashBundle_Click"
                                    AutomationProperties.AutomationId="HomePage_ExportCrashBundle"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
