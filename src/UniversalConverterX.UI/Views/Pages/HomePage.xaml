<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ActionCardTemplate">
            <Border Width="212" Height="148" Padding="14" Margin="0,0,10,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    AutomationProperties.Name="{Binding Title}"
                    ToolTipService.ToolTip="{Binding Description}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                Background="{Binding AccentSurfaceBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="20"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Padding="0" CornerRadius="0"
                                Background="Transparent"
                                Visibility="{Binding BadgeVisibility}">
                            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding AccentBrush}"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="5">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock Text="{Binding Description}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" LineHeight="17"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding ActionText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AiFeatureTemplate">
            <Border Width="220" Height="108" Padding="12" Margin="0,0,10,10"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    AutomationProperties.Name="{Binding Title}"
                    ToolTipService.ToolTip="{Binding Description}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                            Background="{StaticResource SurfaceBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ClusterTemplate">
            <Border Width="288" MinHeight="138" Padding="14" Margin="0,0,10,10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    AutomationProperties.Name="{Binding Title}"
                    ToolTipService.ToolTip="{Binding Description}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="12"
                                Background="{Binding AccentSurfaceBrush}">
                            <FontIcon Glyph="{Binding Glyph}" FontSize="18"
                                      Foreground="{Binding AccentBrush}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitleTextStyle}"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App/tool update banner. Hidden by default; shown only when the
             UpdateCheckService cache reports updates. -->
        <InfoBar x:Uid="HomePage_UpdateBanner" x:Name="UpdateBanner"
                 Grid.Row="0"
                 Margin="28,12,28,0"
                 IsOpen="False"
                 Severity="Informational"
                 IsClosable="True"
                 Title="Updates available"
                 Message=""
                 AutomationProperties.AutomationId="HomePage_UpdateBanner">
            <InfoBar.ActionButton>
                <Button x:Uid="HomePage_UpdateBannerActionButton" x:Name="UpdateBannerActionButton"
                        Content="Open release notes"
                        Click="UpdateBannerAction_Click"
                        AutomationProperties.AutomationId="HomePage_UpdateBannerActionButton"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid Style="{StaticResource PageLayoutStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock x:Uid="HomePage_Item_003" Text="UniversalConverter X"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="HomePage_Item_004" Text="Convert, compress, download, record, and inspect media—locally."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           MaxWidth="720" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <Button x:Uid="HomePage_HomePageButton01" Content="Convert Files" Style="{StaticResource PrimaryButtonStyle}"
                            Click="OpenConverter_Click"
                        AutomationProperties.AutomationId="HomePageButton01"/>
                    <Button x:Uid="HomePage_HomePageButton02" Content="Open AI Lab" Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenAiLab_Click"
                        AutomationProperties.AutomationId="HomePageButton02"/>
                    <Button x:Uid="HomePage_HomePageButton03" Content="Browse Tools" Style="{StaticResource GhostButtonStyle}"
                            Click="OpenToolbox_Click"
                        AutomationProperties.AutomationId="HomePageButton03"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                    Background="Transparent" CornerRadius="0" Padding="0">
                <AutoSuggestBox x:Uid="HomePage_TaskSearchBox" x:Name="TaskSearchBox"
                                PlaceholderText="Search tasks: convert, compress, record, inspect, frames"
                                QueryIcon="Find"
                                TextChanged="TaskSearchBox_TextChanged"
                                SuggestionChosen="TaskSearchBox_SuggestionChosen"
                                QuerySubmitted="TaskSearchBox_QuerySubmitted"
                    AutomationProperties.AutomationId="TaskSearchBox">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Border>

            <StackPanel Grid.Row="2" Spacing="16">
                <TextBlock x:Uid="HomePage_Item_020" Text="Workflows" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="ActionsGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="ActionTile_Click"
                          ItemTemplate="{StaticResource ActionCardTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="16">
                <TextBlock x:Uid="HomePage_Item_022" Text="AI Lab" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="AiGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="AiTile_Click"
                          ItemTemplate="{StaticResource AiFeatureTemplate}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="12">
                <TextBlock x:Uid="HomePage_Item_024" Text="Toolbox" Style="{StaticResource SectionHeaderTextStyle}"/>
                <GridView x:Name="ClustersGrid" SelectionMode="None" IsItemClickEnabled="True"
                          UseSystemFocusVisuals="True"
                          ItemClick="ClusterTile_Click"
                          ItemTemplate="{StaticResource ClusterTemplate}"/>
            </StackPanel>

            <!-- ROADMAP Item 51: Diagnostics card — local-only crash bundle export and log folder access. -->
            <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0"
                    CornerRadius="12" Padding="16"
                    AutomationProperties.AutomationId="HomePage_DiagnosticsCard">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock x:Uid="HomePage_Item_026" Text="Diagnostics" Style="{StaticResource MetricLabelTextStyle}"/>
                        <TextBlock x:Uid="HomePage_Item_027" Text="Local logs and crash bundles" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="HomePage_DiagnosticsStatusText" x:Name="DiagnosticsStatusText"
                                   Text="No issues recorded this session."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="HomePage_OpenLogFolderButton" x:Name="OpenLogFolderButton"
                                Content="Open log folder"
                                Click="OpenLogFolder_Click"
                                AutomationProperties.AutomationId="HomePage_OpenLogFolder"/>
                        <Button x:Uid="HomePage_ExportCrashBundleButton" x:Name="ExportCrashBundleButton"
                                Content="Export crash bundle"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ExportCrashBundle_Click"
                                AutomationProperties.AutomationId="HomePage_ExportCrashBundle"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Center" Margin="0,4,0,0">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}"
                         VerticalAlignment="Center"/>
                <TextBlock x:Uid="HomePage_Item_031" Text="UniversalConverter X v2.31.2"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource DividerBrush}" Width="1" Height="12"
                        VerticalAlignment="Center"/>
                <TextBlock x:Uid="HomePage_Item_032" Text="Local-first processing"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource DividerBrush}" Width="1" Height="12"
                        VerticalAlignment="Center"/>
                <TextBlock x:Uid="HomePage_Item_033" Text="No telemetry"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</Page>
