<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.FrameSnapshotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="SnapshotQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="138"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2"
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE722;"
                                  FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Grid.Row="0"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10"
                            Padding="10,5"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding PlanSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button x:Uid="FrameSnapshotPage_Item_001" Grid.Column="3"
                            Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveQueued_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;"
                                  FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="FrameSnapshotPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6"
                                     CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="130"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SnapshotFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}"
                                  FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="FrameSnapshotPage_Item_003" Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="FrameSnapshotPage_Item_004" Text="Frame Snapshot" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="FrameSnapshotPage_Item_005" Text="Export precise video stills or image-sequence samples with local FFmpeg processing."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="FrameSnapshotPage_FrameSnapshotPageButton01" Content="Add Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFiles_Click"
                    AutomationProperties.AutomationId="FrameSnapshotPageButton01"/>
                <Button x:Uid="FrameSnapshotPage_FrameSnapshotPageButton02" Content="Add Folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="FrameSnapshotPageButton02"/>
                <Button x:Uid="FrameSnapshotPage_ExtractButton" Content="Extract"
                        x:Name="ExtractButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Extract_Click"
                    AutomationProperties.AutomationId="ExtractButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="366"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="12"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="FrameSnapshotPage_FrameSnapshotPagePivotItem01" Header="Snapshots"
                        AutomationProperties.AutomationId="FrameSnapshotPagePivotItem01">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="QueueEmpty"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE722;" FontSize="30"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="FrameSnapshotPage_Item_010" Text="Drop videos to extract frames"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="FrameSnapshotPage_Item_011" Text="Create stills for thumbnails, contact sheets, review notes, and image-sequence handoff."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="440"/>
                                <Button x:Uid="FrameSnapshotPage_FrameSnapshotPageButton03" Content="Browse Videos"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BrowseFiles_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="FrameSnapshotPageButton03"/>
                            </StackPanel>

                            <ListView x:Name="QueueList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource SnapshotQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="FrameSnapshotPage_FrameSnapshotPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="FrameSnapshotPagePivotItem02">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="30"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="FrameSnapshotPage_Item_014" Text="No exported snapshots yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="FrameSnapshotPage_Item_015" Text="Completed, failed, and cancelled snapshot jobs appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource SnapshotFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="FrameSnapshotPage_Item_016" Text="Engine"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Name="FfmpegStatusText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="FrameSnapshotPage_Item_017" Text="Snapshot Plan"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="FrameSnapshotPage_FormatCombo" x:Name="FormatCombo"
                                  Header="Image format"
                                  SelectedIndex="0"
                                  SelectionChanged="Option_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem x:Uid="FrameSnapshotPage_Item_019" Content="PNG lossless" Tag="png"/>
                            <ComboBoxItem x:Uid="FrameSnapshotPage_Item_020" Content="JPEG compact" Tag="jpg"/>
                            <ComboBoxItem x:Uid="FrameSnapshotPage_Item_021" Content="WebP web-ready" Tag="webp"/>
                        </ComboBox>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="FrameSnapshotPage_StartSecondBox" x:Name="StartSecondBox"
                                     Grid.Column="0"
                                     Header="Start second"
                                     Text="0"
                                     TextChanged="Option_TextChanged"
                                AutomationProperties.AutomationId="StartSecondBox"/>
                            <TextBox x:Uid="FrameSnapshotPage_IntervalSecondBox" x:Name="IntervalSecondBox"
                                     Grid.Column="1"
                                     Header="Interval"
                                     Text="5"
                                     TextChanged="Option_TextChanged"
                                AutomationProperties.AutomationId="IntervalSecondBox"/>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="FrameSnapshotPage_CountBox" x:Name="CountBox"
                                     Grid.Column="0"
                                     Header="Frames per video"
                                     Text="3"
                                     TextChanged="Option_TextChanged"
                                AutomationProperties.AutomationId="CountBox"/>
                            <ComboBox x:Uid="FrameSnapshotPage_QualityCombo" x:Name="QualityCombo"
                                      Grid.Column="1"
                                      Header="Quality"
                                      SelectedIndex="1"
                                      SelectionChanged="Option_Changed"
                                      HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="QualityCombo">
                                <ComboBoxItem x:Uid="FrameSnapshotPage_Item_026" Content="Highest" Tag="2"/>
                                <ComboBoxItem x:Uid="FrameSnapshotPage_Item_027" Content="Balanced" Tag="4"/>
                                <ComboBoxItem x:Uid="FrameSnapshotPage_Item_028" Content="Compact" Tag="8"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="PlanSummaryText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="FrameSnapshotPage_Item_029" Text="File Location"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="FrameSnapshotPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                 Header="Save to"
                                 IsReadOnly="True"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="FrameSnapshotPage_FrameSnapshotPageButton04" Grid.Column="0"
                                    Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="FrameSnapshotPageButton04"/>
                            <Button x:Uid="FrameSnapshotPage_FrameSnapshotPageButton05" Grid.Column="1"
                                    Content="Same as source"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="FrameSnapshotPageButton05"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="FrameSnapshotPage_Item_033" Text="Queue Summary"
                                   Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="FrameSnapshotPage_QueueSummaryText" x:Name="QueueSummaryText"
                                   Text="0 queued / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Uid="FrameSnapshotPage_Item_035" Text="Local-only extraction. UCX never uploads video content for snapshots."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="FrameSnapshotPage_OpenOutputButton" Grid.Column="1"
                    Content="Open Output Folder"
                    x:Name="OpenOutputButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click"
                    Margin="0,0,12,0"
                AutomationProperties.AutomationId="OpenOutputButton"/>
            <Button x:Uid="FrameSnapshotPage_ClearQueueButton" Grid.Column="2"
                    Content="Clear Queue"
                    x:Name="ClearQueueButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="ClearQueue_Click"
                    Margin="0,0,12,0"
                AutomationProperties.AutomationId="ClearQueueButton"/>
            <Button x:Uid="FrameSnapshotPage_CancelButton" Grid.Column="3"
                    Content="Cancel"
                    x:Name="CancelButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
