<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VideoSummarizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageStackLayoutStyle}">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock x:Uid="VideoSummarizerPage_Item_001" Text="Video Summarizer" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="VideoSummarizerPage_Item_002" Text="Create offline summaries, chapters, and highlight cuts from long recordings."
                           Style="{StaticResource PageDescriptionTextStyle}"/>
            </StackPanel>

            <!-- Input area -->
            <Border Style="{StaticResource CardStyle}"
                    MinHeight="150"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="52" Height="52" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8D2;" FontSize="30"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Uid="VideoSummarizerPage_DropZoneLabel" x:Name="DropZoneLabel"
                               Text="Drop a video, audio file, or transcript — or browse."
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <Button x:Uid="VideoSummarizerPage_BrowseButton" x:Name="BrowseButton" AutomationProperties.AutomationId="BrowseButton" Content="Browse Files"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="Browse_Click"/>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="VideoSummarizerPage_Item_005" Text="Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_006" Text="Summary Length" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Name="LengthBox" AutomationProperties.AutomationId="LengthBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_007" Content="Brief (3-5 bullets)" Tag="brief"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_008" Content="Standard (1 paragraph)" Tag="standard" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_009" Content="Detailed (multi-section)" Tag="detailed"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_010" Content="Executive brief" Tag="executive"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_011" Text="Output Format" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Name="FormatBox" AutomationProperties.AutomationId="FormatBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_012" Content="Plain text" Tag="text" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_013" Content="Markdown" Tag="markdown"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_014" Content="Chapters with timestamps" Tag="chapters"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_015" Content="YouTube description format" Tag="youtube"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch x:Uid="VideoSummarizerPage_ChaptersToggle" x:Name="ChaptersToggle" AutomationProperties.AutomationId="ChaptersToggle" Header="Include chapter timestamps"
                                      IsOn="True" OffContent="Off" OnContent="On"/>
                        <ToggleSwitch x:Uid="VideoSummarizerPage_TranscriptToggle" x:Name="TranscriptToggle" AutomationProperties.AutomationId="TranscriptToggle" Header="Export transcript alongside summary"
                                      IsOn="False" OffContent="Off" OnContent="On"/>
                        <ToggleSwitch x:Uid="VideoSummarizerPage_HighlightToggle" x:Name="HighlightToggle" AutomationProperties.AutomationId="HighlightToggle" Header="Render condensed highlight reel (video only)"
                                      IsOn="False" OffContent="Off" OnContent="On"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="VideoSummarizerPage_Item_019" Text="Transcript &amp; Engine" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_020" Text="Whisper Model (for audio/video input)" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Name="ModelBox" AutomationProperties.AutomationId="ModelBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_021" Content="large-v3-turbo (recommended)" Tag="large-v3-turbo" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_022" Content="medium (balanced)" Tag="medium"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_023" Content="small (fast)" Tag="small"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_024" Content="large-v3 (accurate)" Tag="large-v3"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_025" Text="Summarizer Engine" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox x:Name="EngineBox" AutomationProperties.AutomationId="EngineBox" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_026" Content="Extractive (offline, no model)" Tag="extractive" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_027" Content="Local LLM via Ollama (if running)" Tag="auto"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Uid="VideoSummarizerPage_Item_028" Text="Extractive summarization needs no model download and runs entirely on the CPU. The Ollama option is used only when a local server is reachable, otherwise it falls back to extractive."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="VideoSummarizerPage_StatusText" x:Name="StatusText" Grid.Column="0"
                               Text="Load a file to begin."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button x:Uid="VideoSummarizerPage_CancelButton" x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Grid.Column="1" Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="Cancel_Click"/>
                    <Button x:Uid="VideoSummarizerPage_SummarizeButton" x:Name="SummarizeButton" AutomationProperties.AutomationId="SummarizeButton" Grid.Column="2" Content="Summarize"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="Summarize_Click"/>
                </Grid>
            </Border>

            <ProgressBar x:Name="SummaryProgress" Minimum="0" Maximum="100"
                         Visibility="Collapsed"/>

            <!-- Result -->
            <Border x:Name="ResultCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="VideoSummarizerPage_Item_032" Grid.Column="0" Text="Summary" Style="{StaticResource PanelTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Uid="VideoSummarizerPage_CopyButton" Grid.Column="1" x:Name="CopyButton" AutomationProperties.AutomationId="CopyButton" Content="Copy"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                Click="Copy_Click"/>
                        <Button x:Uid="VideoSummarizerPage_SaveButton" Grid.Column="2" x:Name="SaveButton" AutomationProperties.AutomationId="SaveButton" Content="Save As…"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Save_Click"/>
                    </Grid>
                    <TextBox x:Name="ResultBox" AutomationProperties.AutomationId="ResultBox" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="180" MaxHeight="420"
                             FontFamily="Consolas"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
