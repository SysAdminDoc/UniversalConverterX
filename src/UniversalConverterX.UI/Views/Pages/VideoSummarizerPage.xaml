<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VideoSummarizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock x:Uid="VideoSummarizerPage_Item_001" Text="Video Summarizer" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock x:Uid="VideoSummarizerPage_Item_002" Text="Extract chapters, highlights, and written summaries from long recordings using Whisper transcription and a local LLM."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>

            <!-- Dev status banner -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}"
                            VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE8D2;" FontSize="22"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{StaticResource AccentOrangeBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Uid="VideoSummarizerPage_Item_003" Text="PLANNED" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource TextInverseBrush}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceLightBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Uid="VideoSummarizerPage_Item_004" Text="Engine: Whisper + local LLM" Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource AccentBlueBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Uid="VideoSummarizerPage_Item_005" Text="Video Summarizer is not available yet."
                                   Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Uid="VideoSummarizerPage_Item_006" Text="Required before enabling: transcript pipeline, summary model, preview, export path, cancellation, and failure recovery."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Input area -->
            <Border Style="{StaticResource CardStyle}"
                    MinHeight="160"
                    AllowDrop="False"
                    Opacity="0.72"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="18"
                            Background="{StaticResource SurfaceLightBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8D2;" FontSize="32"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <TextBlock x:Uid="VideoSummarizerPage_DropZoneLabel" x:Name="DropZoneLabel"
                               Text="Input is disabled until this workflow is ready."
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"/>
                    <Button x:Uid="VideoSummarizerPage_VideoSummarizerPageButton01" Content="Browse Files"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            HorizontalAlignment="Center"
                            Click="Browse_Click"
                        AutomationProperties.AutomationId="VideoSummarizerPageButton01"/>
                </StackPanel>
            </Border>

            <!-- Settings panel -->
            <Grid ColumnSpacing="16" IsHitTestVisible="False" Opacity="0.72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="VideoSummarizerPage_Item_009" Text="Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_010" Text="Summary Length" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="VideoSummarizerPageComboBox01">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_011" Content="Brief (3-5 bullets)" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_012" Content="Standard (1 paragraph)"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_013" Content="Detailed (multi-section)"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_014" Content="Executive brief"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_015" Text="Output Format" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="VideoSummarizerPageComboBox02">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_016" Content="Plain text" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_017" Content="Markdown"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_018" Content="Chapters with timestamps"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_019" Content="YouTube description format"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_020" Text="Output Language" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="VideoSummarizerPageComboBox03">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_021" Content="Auto (match source)" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_022" Content="English"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_023" Content="Spanish"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_024" Content="French"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="VideoSummarizerPage_Item_025" Text="Transcript &amp; Model" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_026" Text="Whisper Model" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="VideoSummarizerPageComboBox04">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_027" Content="medium (balanced)" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_028" Content="large-v3 (accurate)"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_029" Content="small (fast)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="VideoSummarizerPage_Item_030" Text="LLM Backend" Style="{StaticResource MutedTextStyle}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="VideoSummarizerPageComboBox05">
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_031" Content="Llama.cpp (local)" IsSelected="True"/>
                                <ComboBoxItem x:Uid="VideoSummarizerPage_Item_032" Content="Ollama (local server)"/>
                            </ComboBox>
                        </StackPanel>
                        <ToggleSwitch x:Uid="VideoSummarizerPage_VideoSummarizerPageToggleSwitch01" Header="Export transcript alongside summary"
                                      IsOn="True"
                                      OffContent="Off" OnContent="On"
                            AutomationProperties.AutomationId="VideoSummarizerPageToggleSwitch01"/>
                        <ToggleSwitch x:Uid="VideoSummarizerPage_VideoSummarizerPageToggleSwitch02" Header="Include chapter timestamps"
                                      IsOn="True"
                                      OffContent="Off" OnContent="On"
                            AutomationProperties.AutomationId="VideoSummarizerPageToggleSwitch02"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="VideoSummarizerPage_Item_035" Grid.Column="0" Text="Preview only. Controls are disabled until the workflow is wired."
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                    <Button x:Uid="VideoSummarizerPage_VideoSummarizerPageButton02" Grid.Column="1" Content="Summarize Video"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                        AutomationProperties.AutomationId="VideoSummarizerPageButton02"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
