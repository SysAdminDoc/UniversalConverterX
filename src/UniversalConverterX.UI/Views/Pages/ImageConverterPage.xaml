<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.ImageConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ImgQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xEB9F;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="13"
                                   LineHeight="18"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,6">
                        <TextBlock Text="{Binding PlanSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button x:Uid="ImageConverterPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveQueued_Click"
                            Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="ImageConverterPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="7" CornerRadius="4"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   MinWidth="120"
                                   TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ImgFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   LineHeight="16"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="ImageConverterPage_Item_003" Grid.Column="2"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,10"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock x:Uid="ImageConverterPage_Item_004" Text="Image Converter" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="ImageConverterPage_Item_005" Text="Convert between HEIC, AVIF, JPEG, PNG, WebP, TIFF, BMP. Preserves ICC + EXIF by default."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="ImageConverterPage_ImageConverterPageButton01" Content="Browse Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="ImageConverterPageButton01"/>
                <Button x:Uid="ImageConverterPage_RunButton" x:Name="RunButton"
                        Content="Convert"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="20"
                    Padding="20"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="ImageConverterPage_ImageConverterPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="ImageConverterPagePivotItem01">
                        <Grid MinHeight="320" Padding="0,12,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="14">
                                <Border Width="120" Height="120" CornerRadius="30"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="52"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ImageConverterPage_Item_009" Text="Drop image files here"
                                           Style="{StaticResource TitleTextStyle}"
                                           HorizontalAlignment="Center"
                                           FontSize="17" TextWrapping="Wrap"
                                           MaxWidth="280"/>
                                <TextBlock x:Uid="ImageConverterPage_Item_010" Text="Each file converts to the target format using the settings on the right."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="420"/>
                                <Button x:Uid="ImageConverterPage_ImageConverterPageButton02" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="ImageConverterPageButton02"/>
                            </StackPanel>
                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource ImgQueueTemplate}"/>
                        </Grid>
                    </PivotItem>
                    <PivotItem x:Uid="ImageConverterPage_ImageConverterPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="ImageConverterPagePivotItem02">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="30"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="ImageConverterPage_Item_013" Text="No conversions yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource ImgFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="ImageConverterPage_Item_014" Text="Output Format" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="ImageConverterPage_FormatCombo" x:Name="FormatCombo"
                                  Header="Format"
                                  SelectedIndex="0"
                                  SelectionChanged="Settings_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="FormatCombo">
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_016" Content="JPEG (.jpg)"  Tag="jpeg"/>
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_017" Content="PNG (.png)"   Tag="png"/>
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_018" Content="WebP (.webp)" Tag="webp"/>
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_019" Content="AVIF (.avif)" Tag="avif"/>
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_020" Content="HEIC (.heic)" Tag="heic"/>
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_021" Content="JPEG XL (.jxl)" Tag="jxl"/>
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_022" Content="TIFF (.tiff)" Tag="tiff"/>
                            <ComboBoxItem x:Uid="ImageConverterPage_Item_023" Content="BMP (.bmp)"   Tag="bmp"/>
                        </ComboBox>
                        <Slider x:Uid="ImageConverterPage_QualitySlider" x:Name="QualitySlider"
                                Header="Quality (lossy formats only)"
                                Minimum="40" Maximum="100" Value="85"
                                StepFrequency="1"
                                ValueChanged="Quality_Changed"
                            AutomationProperties.AutomationId="QualitySlider"/>
                        <TextBlock x:Uid="ImageConverterPage_QualityValueText" x:Name="QualityValueText"
                                   Text="85"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Right"/>
                        <NumberBox x:Uid="ImageConverterPage_TargetSizeBox" x:Name="TargetSizeBox"
                                   Header="Target size (KB, optional)"
                                   Minimum="0"
                                   Maximum="100000"
                                   SmallChange="50"
                                   Value="0"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="TargetSize_Changed"
                                   AutomationProperties.AutomationId="TargetSizeBox"/>
                        <TextBlock x:Uid="ImageConverterPage_Item_027" Text="When set, quality is searched automatically. A warning is reported when the target cannot be reached within 5%."
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Expander x:Uid="ImageConverterPage_Item_028" Header="Batch adjustments">
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <ComboBox x:Uid="ImageConverterPage_EditPresetCombo" x:Name="EditPresetCombo"
                                      Header="Look preset"
                                      SelectedIndex="0"
                                      SelectionChanged="Settings_Changed"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="EditPresetCombo">
                                <ComboBoxItem x:Uid="ImageConverterPage_Item_030" Content="None" Tag=""/>
                                <ComboBoxItem x:Uid="ImageConverterPage_Item_031" Content="Vivid" Tag="vivid"/>
                                <ComboBoxItem x:Uid="ImageConverterPage_Item_032" Content="Muted" Tag="muted"/>
                                <ComboBoxItem x:Uid="ImageConverterPage_Item_033" Content="Black &amp; white" Tag="bw"/>
                                <ComboBoxItem x:Uid="ImageConverterPage_Item_034" Content="Vintage" Tag="vintage"/>
                                <ComboBoxItem x:Uid="ImageConverterPage_Item_035" Content="Cold" Tag="cold"/>
                                <ComboBoxItem x:Uid="ImageConverterPage_Item_036" Content="Warm" Tag="warm"/>
                            </ComboBox>
                            <Grid ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <NumberBox x:Uid="ImageConverterPage_BrightnessBox" x:Name="BrightnessBox" Grid.Row="0" Grid.Column="0"
                                           Header="Brightness" Minimum="-100" Maximum="100" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="BrightnessBox"/>
                                <NumberBox x:Uid="ImageConverterPage_ContrastBox" x:Name="ContrastBox" Grid.Row="0" Grid.Column="1"
                                           Header="Contrast" Minimum="-100" Maximum="100" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="ContrastBox"/>
                                <NumberBox x:Uid="ImageConverterPage_SaturationBox" x:Name="SaturationBox" Grid.Row="1" Grid.Column="0"
                                           Header="Saturation" Minimum="-100" Maximum="100" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="SaturationBox"/>
                                <NumberBox x:Uid="ImageConverterPage_SharpnessBox" x:Name="SharpnessBox" Grid.Row="1" Grid.Column="1"
                                           Header="Sharpness" Minimum="0" Maximum="100" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="SharpnessBox"/>
                                <NumberBox x:Uid="ImageConverterPage_BlurBox" x:Name="BlurBox" Grid.Row="2" Grid.Column="0"
                                           Header="Blur px" Minimum="0" Maximum="20" Value="0"
                                           SmallChange="0.5" ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="BlurBox"/>
                                <NumberBox x:Uid="ImageConverterPage_HueBox" x:Name="HueBox" Grid.Row="2" Grid.Column="1"
                                           Header="Hue °" Minimum="0" Maximum="360" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="HueBox"/>
                                <NumberBox x:Uid="ImageConverterPage_VignetteBox" x:Name="VignetteBox" Grid.Row="3" Grid.Column="0"
                                           Header="Vignette" Minimum="0" Maximum="100" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="VignetteBox"/>
                                <NumberBox x:Uid="ImageConverterPage_GrainBox" x:Name="GrainBox" Grid.Row="3" Grid.Column="1"
                                           Header="Grain" Minimum="0" Maximum="100" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="GrainBox"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox x:Uid="ImageConverterPage_GrayscaleCheck" x:Name="GrayscaleCheck" Content="Grayscale"
                                          Checked="Settings_Bool_Changed" Unchecked="Settings_Bool_Changed"
                                          AutomationProperties.AutomationId="GrayscaleCheck"/>
                                <CheckBox x:Uid="ImageConverterPage_SepiaCheck" x:Name="SepiaCheck" Content="Sepia"
                                          Checked="Settings_Bool_Changed" Unchecked="Settings_Bool_Changed"
                                          AutomationProperties.AutomationId="SepiaCheck"/>
                                <CheckBox x:Uid="ImageConverterPage_InvertCheck" x:Name="InvertCheck" Content="Invert"
                                          Checked="Settings_Bool_Changed" Unchecked="Settings_Bool_Changed"
                                          AutomationProperties.AutomationId="InvertCheck"/>
                            </StackPanel>
                            <TextBox x:Uid="ImageConverterPage_TintBox" x:Name="TintBox"
                                     Header="Tint (colour@strength)"
                                     PlaceholderText="#3a6ea5@20"
                                     TextChanged="EditText_Changed"
                                     AutomationProperties.AutomationId="TintBox"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Uid="ImageConverterPage_BorderBox" x:Name="BorderBox" Grid.Column="0"
                                           Header="Border px" Minimum="0" Maximum="1000" Value="0"
                                           ValueChanged="EditNumber_Changed"
                                           AutomationProperties.AutomationId="BorderBox"/>
                                <TextBox x:Uid="ImageConverterPage_BorderColorBox" x:Name="BorderColorBox" Grid.Column="1"
                                         Header="Border colour" Text="#ffffff"
                                         TextChanged="EditText_Changed"
                                         AutomationProperties.AutomationId="BorderColorBox"/>
                            </Grid>
                            <TextBlock x:Uid="ImageConverterPage_Item_051" Text="Adjustments apply to every frame. Alpha is preserved for compatible outputs."
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="ImageConverterPage_Item_052" Text="Metadata" Style="{StaticResource PanelTitleTextStyle}"/>
                        <CheckBox x:Uid="ImageConverterPage_StripExifCheck" x:Name="StripExifCheck"
                                  Content="Strip EXIF metadata"
                                  IsChecked="False"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="StripExifCheck"/>
                        <CheckBox x:Uid="ImageConverterPage_StripIccCheck" x:Name="StripIccCheck"
                                  Content="Strip ICC colour profile"
                                  IsChecked="False"
                                  Checked="Settings_Bool_Changed"
                                  Unchecked="Settings_Bool_Changed"
                            AutomationProperties.AutomationId="StripIccCheck"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="ImageConverterPage_Item_055" Text="Queue Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="ImageConverterPage_QueueSummaryText" x:Name="QueueSummaryText"
                                   Text="0 queued / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="CurrentSetupText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="ImageConverterPage_ClearButton" Grid.Column="1"
                    Content="Clear Queue"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click"
                    Margin="0,0,12,0"
                    IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="ImageConverterPage_CancelButton" Grid.Column="2"
                    Content="Cancel"
                    x:Name="CancelButton"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                    IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
