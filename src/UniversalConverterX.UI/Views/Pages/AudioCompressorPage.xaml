<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.AudioCompressorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="AudioCompressionQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="126"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE91F;" FontSize="20"
                                  Foreground="{StaticResource AccentCyanBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PresetSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Border>

                    <Button x:Uid="AudioCompressorPage_AudioCompressorRemoveButton" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue"
                            AutomationProperties.AutomationId="AudioCompressorRemoveButton"
                            ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="AudioCompressorPage_Item_002" AutomationProperties.Name="Progress"
                                     Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="92" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock x:Uid="AudioCompressorPage_Item_003" Text="AUDIO COMPRESSOR"
                           Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock x:Uid="AudioCompressorPage_Item_004" Text="Apply dynamic-range compression to audio (or video audio tracks). Tame loud peaks, lift quiet passages, level a podcast guest."
                           Style="{StaticResource TitleTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720" LineHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="AudioCompressorPage_AudioCompressorAddFilesButton" Content="Add Files"
                        AutomationProperties.AutomationId="AudioCompressorAddFilesButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"/>
                <Button x:Uid="AudioCompressorPage_AudioCompressorAddFolderButton" Content="Add Folder"
                        AutomationProperties.AutomationId="AudioCompressorAddFolderButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Grid MinHeight="430" Padding="0,8,0,0">
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <Border Width="116" Height="116" CornerRadius="28"
                                Background="{StaticResource SurfaceLightBrush}">
                            <FontIcon Glyph="&#xE91F;" FontSize="48"
                                      Foreground="{StaticResource AccentCyanBrush}"/>
                        </Border>
                        <TextBlock x:Uid="AudioCompressorPage_Item_007" Text="Drop audio files to compress"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="AudioCompressorPage_Item_008" Text="MP3, WAV, FLAC, M4A, AAC, OGG, OPUS, WMA, ALAC, APE, WV, AIFF and most video containers."
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   TextAlignment="Center"/>
                        <Button x:Uid="AudioCompressorPage_AudioCompressorBrowseButton" Content="Browse Files"
                                AutomationProperties.AutomationId="AudioCompressorBrowseButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Browse_Click"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ListView x:Name="FileList"
                              Visibility="Collapsed"
                              Background="Transparent"
                              SelectionMode="None"
                              ItemTemplate="{StaticResource AudioCompressionQueueTemplate}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="AudioCompressorPage_Item_010" Text="Compression Preset" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="PresetCombo"
                                  AutomationProperties.AutomationId="AudioCompressorPresetCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Preset_SelectionChanged">
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_011" Content="Light (gentle, transparent)" Tag="light"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_012" Content="Medium (default, all-purpose)" Tag="medium" IsSelected="True"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_013" Content="Heavy (obvious, loud sources)" Tag="heavy"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_014" Content="Podcast (spoken word)" Tag="podcast"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_015" Content="Broadcast (heavy, fast attack)" Tag="broadcast"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_016" Content="Custom (sliders below)" Tag="__custom__"/>
                        </ComboBox>
                        <TextBlock x:Name="PresetSummary"
                                   Text=""
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CustomCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="AudioCompressorPage_Item_017" Text="Custom Parameters" Style="{StaticResource PanelTitleTextStyle}"/>
                        <Slider x:Uid="AudioCompressorPage_ThresholdSlider" x:Name="ThresholdSlider"
                                AutomationProperties.AutomationId="AudioCompressorThresholdSlider"
                                Header="Threshold (dB)"
                                Minimum="-60" Maximum="0" Value="-20"
                                StepFrequency="1" SnapsTo="StepValues"
                                ValueChanged="Param_ValueChanged"/>
                        <Slider x:Uid="AudioCompressorPage_RatioSlider" x:Name="RatioSlider"
                                AutomationProperties.AutomationId="AudioCompressorRatioSlider"
                                Header="Ratio (:1)"
                                Minimum="1" Maximum="20" Value="3"
                                StepFrequency="0.5" SnapsTo="StepValues"
                                ValueChanged="Param_ValueChanged"/>
                        <Slider x:Uid="AudioCompressorPage_AttackSlider" x:Name="AttackSlider"
                                AutomationProperties.AutomationId="AudioCompressorAttackSlider"
                                Header="Attack (ms)"
                                Minimum="0.1" Maximum="500" Value="10"
                                StepFrequency="0.5" SnapsTo="StepValues"
                                ValueChanged="Param_ValueChanged"/>
                        <Slider x:Uid="AudioCompressorPage_ReleaseSlider" x:Name="ReleaseSlider"
                                AutomationProperties.AutomationId="AudioCompressorReleaseSlider"
                                Header="Release (ms)"
                                Minimum="1" Maximum="2000" Value="200"
                                StepFrequency="1" SnapsTo="StepValues"
                                ValueChanged="Param_ValueChanged"/>
                        <Slider x:Uid="AudioCompressorPage_MakeupSlider" x:Name="MakeupSlider"
                                AutomationProperties.AutomationId="AudioCompressorMakeupSlider"
                                Header="Makeup gain (dB)"
                                Minimum="0" Maximum="24" Value="4"
                                StepFrequency="0.5" SnapsTo="StepValues"
                                ValueChanged="Param_ValueChanged"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="AudioCompressorPage_Item_023" Text="Output Encoding" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="EncodeCombo"
                                  AutomationProperties.AutomationId="AudioCompressorEncodeCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Encode_SelectionChanged">
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_024" Content="Preserve (same container + codec)" Tag="" IsSelected="True"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_025" Content="MP3 (libmp3lame, V2)" Tag="mp3"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_026" Content="AAC (192 kbps M4A)" Tag="aac"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_027" Content="Opus (128 kbps)" Tag="opus"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_028" Content="FLAC (lossless)" Tag="flac"/>
                            <ComboBoxItem x:Uid="AudioCompressorPage_Item_029" Content="WAV (16-bit PCM)" Tag="wav"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="AudioCompressorPage_Item_030" Text="Output Folder" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="AudioCompressorPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                 AutomationProperties.AutomationId="AudioCompressorOutputDirBox"
                                 Header="Save to"
                                 PlaceholderText="Same folder as each source file"
                                 IsReadOnly="True"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="AudioCompressorPage_AudioCompressorBrowseOutputButton" Grid.Column="0" Content="Browse"
                                    AutomationProperties.AutomationId="AudioCompressorBrowseOutputButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"/>
                            <Button x:Uid="AudioCompressorPage_AudioCompressorSameAsSourceButton" Grid.Column="1" Content="Same as source"
                                    AutomationProperties.AutomationId="AudioCompressorSameAsSourceButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoBannerStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="16"
                                  Foreground="{StaticResource AccentCyanBrush}"
                                  VerticalAlignment="Top"/>
                        <TextBlock x:Uid="AudioCompressorPage_Item_034" Text="Originals are kept. Outputs land beside each source (or in the chosen folder) with a preset suffix appended to the stem."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="AudioCompressorPage_ClearButton" Grid.Column="1" Content="Clear Queue"
                    x:Name="ClearButton"
                    AutomationProperties.AutomationId="AudioCompressorClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click" Margin="0,0,12,0" IsEnabled="False"/>
            <Button x:Uid="AudioCompressorPage_AudioCompressorOpenOutputButton" Grid.Column="2" Content="Open Output"
                    AutomationProperties.AutomationId="AudioCompressorOpenOutputButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click" Margin="0,0,12,0"/>
            <Button x:Uid="AudioCompressorPage_CompressButton" Grid.Column="3" Content="Compress All"
                    x:Name="CompressButton"
                    AutomationProperties.AutomationId="AudioCompressorCompressButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Compress_Click" IsEnabled="False"/>
        </Grid>

        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="560">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="AudioCompressorPage_ProgressTitle" x:Name="ProgressTitle" Text="Compressing..."
                               Style="{StaticResource TitleTextStyle}"/>
                    <ProgressBar x:Uid="AudioCompressorPage_ProgressBar" AutomationProperties.Name="Progress"
                                 x:Name="ProgressBar" Height="8" CornerRadius="4"
                                 Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressStage" Style="{StaticResource SubtitleTextStyle}"/>
                    <TextBlock x:Name="ProgressEta" Style="{StaticResource MutedTextStyle}"/>
                    <ScrollViewer Height="96" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceLightBrush}" Padding="8" CornerRadius="4">
                        <TextBlock x:Name="ProgressLog" Style="{StaticResource CodeTextStyle}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Uid="AudioCompressorPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                                AutomationProperties.AutomationId="AudioCompressorCancelButton"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
