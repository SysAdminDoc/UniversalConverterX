<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.CompressorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="CompressionQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="126"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Grid.Column="0"
                            Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE91F;" FontSize="20"
                                  Foreground="{StaticResource AccentCyanBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Grid.Row="0" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PresetSummary}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Border>

                    <Button x:Uid="CompressorPage_Item_001" Grid.Column="3" Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove from queue" ToolTipService.ToolTip="Remove from queue"
                            Click="RemoveFile_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>

                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="CompressorPage_Item_002" AutomationProperties.Name="Progress" Grid.Column="0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="6" CornerRadius="3"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="92" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompressionFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Uid="CompressorPage_Item_003" Grid.Column="2" Content="Open folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,8"
                            Click="OpenFinishedFolder_Click"
                            Tag="{Binding OutputPath}"
                            IsEnabled="{Binding CanOpenFolder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock x:Uid="CompressorPage_Item_004" Text="Compressor" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock x:Uid="CompressorPage_Item_005" Text="Batch-compress videos with target profiles, progress, and finished results."
                           Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Uid="CompressorPage_CompressorPageButton01" Content="Add Files" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="CompressorPageButton01"/>
                <Button x:Uid="CompressorPage_CompressorPageButton02" Content="Add Folder" Style="{StaticResource SecondaryButtonStyle}"
                        Click="BrowseFolder_Click"
                    AutomationProperties.AutomationId="CompressorPageButton02"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DropZone" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    CornerRadius="22"
                    Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="CompressorPage_CompressorPagePivotItem01" Header="Compressing"
                        AutomationProperties.AutomationId="CompressorPagePivotItem01">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE91F;" FontSize="48"
                                              Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>
                                <TextBlock x:Uid="CompressorPage_Item_009" Text="Drop video files to compress"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="CompressorPage_Item_010" Text="MP4, MKV, MOV, AVI, WebM, FLV, WMV, TS, MTS, and M4V."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button x:Uid="CompressorPage_CompressorPageButton03" Content="Browse Files"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click"
                                        HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="CompressorPageButton03"/>
                            </StackPanel>

                            <ListView x:Name="FileList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource CompressionQueueTemplate}"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="CompressorPage_CompressorPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="CompressorPagePivotItem02">
                        <Grid MinHeight="430" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Border Width="116" Height="116" CornerRadius="28"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="48"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="CompressorPage_Item_013" Text="No finished compressions yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="CompressorPage_Item_014" Text="Completed, failed, and cancelled jobs appear here."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList"
                                      Visibility="Collapsed"
                                      Background="Transparent"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource CompressionFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Padding="0,0,4,0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="CompressorPage_Item_015" Text="Hardware Acceleration" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Name="HwAccelCombo"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="HwAccel_SelectionChanged"
                            AutomationProperties.AutomationId="HwAccelCombo">
                            <ComboBoxItem x:Uid="CompressorPage_Item_016" Content="Software (CPU)" Tag="none" IsSelected="True"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_017" Content="NVIDIA NVENC" Tag="nvenc"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_018" Content="AMD AMF" Tag="amf"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_019" Content="Intel QSV" Tag="qsv"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_020" Content="D3D12 (Windows)" Tag="d3d12"/>
                        </ComboBox>
                        <TextBlock x:Uid="CompressorPage_Item_021" Text="GPU encoding is faster but may produce larger files at the same CRF."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>
                        <CheckBox x:Uid="CompressorPage_D3D12DeinterlaceToggle"
                                  x:Name="D3D12DeinterlaceToggle"
                                  Content="Deinterlace with D3D12 (guarded)"
                                  Visibility="Collapsed"
                                  AutomationProperties.AutomationId="CompressorD3D12DeinterlaceToggle"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="CompressorPage_Item_022" Text="Preset Profile" Style="{StaticResource PanelTitleTextStyle}"/>
                        <RadioButton x:Uid="CompressorPage_PresetWeb" x:Name="PresetWeb" Content="Web upload (1080p, CRF 23)"
                                     GroupName="Preset"
                                     Tag="web-1080p"
                                     IsChecked="True"
                                     Checked="Preset_Checked"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.AutomationId="PresetWeb"/>
                        <RadioButton x:Uid="CompressorPage_PresetEmail" x:Name="PresetEmail" Content="Email friendly (~9.5 MB)"
                                     GroupName="Preset"
                                     Tag="email-10mb"
                                     Checked="Preset_Checked"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.AutomationId="PresetEmail"/>
                        <RadioButton x:Uid="CompressorPage_PresetTarget" x:Name="PresetTarget" Content="Target file size"
                                     GroupName="Preset"
                                     Tag="__target__"
                                     Checked="Preset_Checked"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.AutomationId="PresetTarget"/>
                        <StackPanel x:Name="TargetSizePanel"
                                    Visibility="Collapsed"
                                    Spacing="8">
                            <ComboBox x:Uid="CompressorPage_SocialTargetCombo" x:Name="SocialTargetCombo"
                                      Header="Platform size limit"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0"
                                      SelectionChanged="SocialTarget_Changed"
                                AutomationProperties.AutomationId="CompressorSocialTargetCombo">
                                <ComboBoxItem x:Uid="CompressorPage_Item_027" Content="Discord 10 MB" Tag="discord-10mb"/>
                                <ComboBoxItem x:Uid="CompressorPage_Item_028" Content="Discord 25 MB" Tag="discord-25mb"/>
                                <ComboBoxItem x:Uid="CompressorPage_Item_029" Content="Discord 50 MB" Tag="discord-50mb"/>
                                <ComboBoxItem x:Uid="CompressorPage_Item_030" Content="Email 25 MB" Tag="email-25mb"/>
                                <ComboBoxItem x:Uid="CompressorPage_Item_031" Content="Custom limit" Tag="custom"/>
                            </ComboBox>
                            <NumberBox x:Uid="CompressorPage_TargetSizeBox" x:Name="TargetSizeBox"
                                       Header="Maximum size (MB)"
                                       Value="10"
                                       Minimum="1"
                                       Maximum="2048"
                                       SmallChange="0.5"
                                       SpinButtonPlacementMode="Inline"
                                       IsEnabled="False"
                                       ValueChanged="TargetSize_Changed"
                                AutomationProperties.AutomationId="CompressorTargetSizeBox"/>
                            <TextBlock x:Uid="CompressorPage_Item_033" Text="Target-size mode uses CPU two-pass encoding and reserves 5% for MP4 overhead."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       FontSize="11"/>
                        </StackPanel>
                        <RadioButton x:Uid="CompressorPage_PresetVmaf" x:Name="PresetVmaf" Content="Smart quality target (VMAF)"
                                     GroupName="Preset"
                                     Tag="__vmaf__"
                                     Checked="Preset_Checked"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.AutomationId="PresetVmaf"/>
                        <StackPanel x:Name="VmafTargetPanel"
                                    Visibility="Collapsed"
                                    Spacing="8">
                            <NumberBox x:Uid="CompressorPage_VmafTargetBox" x:Name="VmafTargetBox"
                                       Header="Minimum VMAF quality"
                                       Value="93"
                                       Minimum="50"
                                       Maximum="100"
                                       SmallChange="1"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="VmafTarget_Changed"
                                AutomationProperties.AutomationId="CompressorVmafTargetBox"/>
                            <ComboBox x:Uid="CompressorPage_VmafEncoderCombo" x:Name="VmafEncoderCombo"
                                      Header="Video encoder"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0"
                                      SelectionChanged="VmafEncoder_Changed"
                                AutomationProperties.AutomationId="CompressorVmafEncoderCombo">
                                <ComboBoxItem x:Uid="CompressorPage_Item_037" Content="AV1 (SVT-AV1, smallest)" Tag="libsvtav1"/>
                                <ComboBoxItem x:Uid="CompressorPage_Item_038" Content="H.265 / HEVC (compatible)" Tag="libx265"/>
                                <ComboBoxItem x:Uid="CompressorPage_Item_039" Content="H.264 / AVC (most compatible)" Tag="libx264"/>
                            </ComboBox>
                            <TextBlock x:Uid="CompressorPage_VmafHealthText" x:Name="VmafHealthText"
                                       Text="ab-av1 availability is checked before each smart compression."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       FontSize="11"/>
                            <TextBlock x:Uid="CompressorPage_Item_041" Text="Smart mode samples CRF candidates, encodes the smallest result meeting the target, then verifies the finished file with a full VMAF pass."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       FontSize="11"/>
                        </StackPanel>
                        <RadioButton x:Uid="CompressorPage_PresetArchive" x:Name="PresetArchive" Content="Archive (AV1, CRF 28)"
                                     GroupName="Preset"
                                     Tag="archive-av1"
                                     Checked="Preset_Checked"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.AutomationId="PresetArchive"/>
                        <RadioButton x:Uid="CompressorPage_PresetPro" x:Name="PresetPro" Content="Professional / archival ▾"
                                     GroupName="Preset"
                                     Tag="__pro__"
                                     Checked="Preset_Checked"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.AutomationId="PresetPro"/>
                        <ComboBox x:Uid="CompressorPage_ProPresetCombo" x:Name="ProPresetCombo"
                                  Header="Intermediate / archival codec"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="2"
                                  SelectionChanged="ProPreset_Changed"
                                  Visibility="Collapsed"
                            AutomationProperties.AutomationId="ProPresetCombo">
                            <ComboBoxItem x:Uid="CompressorPage_Item_045" Content="ProRes 422 Proxy (low-res rough cut)" Tag="prores-422-proxy"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_046" Content="ProRes 422 LT (offline edit)"        Tag="prores-422-lt"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_047" Content="ProRes 422 (online edit)"            Tag="prores-422"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_048" Content="ProRes 422 HQ (master / colour grade)" Tag="prores-422-hq"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_049" Content="ProRes 4444 (alpha + grading)"       Tag="prores-4444"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_050" Content="DNxHR SQ (Avid offline edit)"        Tag="dnxhr-sq"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_051" Content="DNxHR HQ (Avid online edit)"         Tag="dnxhr-hq"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_052" Content="DNxHR HQX (10-bit master)"           Tag="dnxhr-hqx"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_053" Content="DNxHR 444 (4:4:4 grading)"           Tag="dnxhr-444"/>
                            <ComboBoxItem x:Uid="CompressorPage_Item_054" Content="FFV1 + FLAC archival (lossless, MKV)" Tag="archive-ffv1"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="CompressorPage_Item_055" Text="File Location" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBox x:Uid="CompressorPage_OutputDirectoryBox" x:Name="OutputDirectoryBox"
                                 Header="Save to"
                                 PlaceholderText="Same as source file"
                                 IsReadOnly="True"
                            AutomationProperties.AutomationId="OutputDirectoryBox"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Uid="CompressorPage_CompressorPageButton04" Grid.Column="0" Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputFolder_Click"
                                AutomationProperties.AutomationId="CompressorPageButton04"/>
                            <Button x:Uid="CompressorPage_CompressorPageButton05" Grid.Column="1" Content="Same as source"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SameAsSource_Click"
                                AutomationProperties.AutomationId="CompressorPageButton05"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoBannerStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="16"
                                  Foreground="{StaticResource AccentCyanBrush}"
                                  VerticalAlignment="Top"/>
                        <TextBlock x:Uid="CompressorPage_Item_059" Text="Compression keeps originals by default and writes finished outputs to the selected folder or beside each source."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="CompressorPage_Item_060" Text="Size comparison" Style="{StaticResource PanelTitleTextStyle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock x:Uid="CompressorPage_Item_061" Text="SOURCE" Style="{StaticResource MetricLabelTextStyle}"/>
                                <TextBlock x:Uid="CompressorPage_SourceSizeText" x:Name="SourceSizeText" Text="0 B"
                                           Style="{StaticResource MetricNumberTextStyle}"
                                           Foreground="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="&#xE8AB;" FontSize="14"
                                      Foreground="{StaticResource TextMutedBrush}"
                                      VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock x:Uid="CompressorPage_Item_063" Text="RESULT" Style="{StaticResource MetricLabelTextStyle}"/>
                                <TextBlock x:Uid="CompressorPage_ResultSizeText" x:Name="ResultSizeText" Text="0 B"
                                           Style="{StaticResource MetricNumberTextStyle}"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Uid="CompressorPage_SavingsText" x:Name="SavingsText" Text="Savings appear after compression."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="CompressorPage_ClearButton" Grid.Column="1" Content="Clear Queue"
                    x:Name="ClearButton"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="Clear_Click" Margin="0,0,12,0" IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="CompressorPage_CompressorPageButton06" Grid.Column="2" Content="Open Output"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenOutputFolder_Click" Margin="0,0,12,0"
                AutomationProperties.AutomationId="CompressorPageButton06"/>
            <Button x:Uid="CompressorPage_CompressButton" Grid.Column="3" Content="Compress All"
                    x:Name="CompressButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Compress_Click" IsEnabled="False"
                AutomationProperties.AutomationId="CompressButton"/>
        </Grid>

        <Grid x:Name="ProgressOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{StaticResource OverlayBrush}">
            <Border Style="{StaticResource CardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="440"
                    MaxWidth="560">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="CompressorPage_ProgressTitle" x:Name="ProgressTitle" Text="Compressing..."
                               Style="{StaticResource TitleTextStyle}"/>
                    <ProgressBar x:Uid="CompressorPage_ProgressBar" AutomationProperties.Name="Progress" x:Name="ProgressBar" Height="8" CornerRadius="4"
                                 Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressStage" Style="{StaticResource SubtitleTextStyle}"/>
                    <TextBlock x:Name="ProgressEta" Style="{StaticResource MutedTextStyle}"/>
                    <ScrollViewer Height="96" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource SurfaceLightBrush}" Padding="8" CornerRadius="4">
                        <TextBlock x:Name="ProgressLog" Style="{StaticResource CodeTextStyle}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Uid="CompressorPage_CancelButton" x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="Cancel_Click"
                            AutomationProperties.AutomationId="CancelButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
