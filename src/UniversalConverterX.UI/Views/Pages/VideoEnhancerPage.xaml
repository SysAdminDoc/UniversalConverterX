<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UniversalConverterX.UI.Views.Pages.VideoEnhancerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="VeQueueTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceLightBrush}">
                        <FontIcon Glyph="&#xE799;" FontSize="20"
                                  Foreground="{StaticResource AccentBlueBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceLightBrush}"
                            CornerRadius="10" Padding="10,5">
                        <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource MutedTextStyle}"
                                   FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button x:Uid="VideoEnhancerPage_Item_001" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="Remove" ToolTipService.ToolTip="Remove" Click="RemoveQueued_Click" Tag="{Binding}">
                        <FontIcon Glyph="&#xE711;" FontSize="14"
                                  Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Grid Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Uid="VideoEnhancerPage_Item_002" AutomationProperties.Name="Progress" Minimum="0" Maximum="100" Value="{Binding Progress}"
                                     Height="6" CornerRadius="3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   MinWidth="112" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VeFinishedTemplate">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" CornerRadius="12" Padding="14"
                    Margin="0,0,0,10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10"
                            Background="{StaticResource SurfaceSoftBrush}">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="19"
                                  Foreground="{Binding AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OutputPath}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <Button x:Uid="VideoEnhancerPage_Item_003" Content="Open folder"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                Click="OpenFinishedFolder_Click" Tag="{Binding OutputPath}"
                                IsEnabled="{Binding CanOpenFolder}"/>
                        <Button x:Uid="VideoEnhancerPage_RetryButton" Content="Retry"
                                Style="{StaticResource GhostButtonStyle}" Padding="14,8"
                                Click="RetryFinished_Click" Tag="{Binding}"
                                IsEnabled="{Binding CanRetry}"
                                AutomationProperties.Name="Retry video job"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource PageLayoutStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="VideoEnhancerPage_Item_004" Text="Video Enhancer"
                           Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="VideoEnhancerPage_Item_005" Text="Restore, upscale, or interpolate video with Real-ESRGAN, RIFE Vulkan, Anime4K GLSL, or the optional CUDA-only SeedVR2 diffusion engine."
                           Style="{StaticResource PageDescriptionTextStyle}"
                           TextWrapping="Wrap"
                           MaxWidth="720"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="VideoEnhancerPage_VideoEnhancerPageButton01" Content="Browse Files"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Browse_Click"
                    AutomationProperties.AutomationId="VideoEnhancerPageButton01"/>
                <Button x:Uid="VideoEnhancerPage_PreviewSampleButton" x:Name="PreviewSampleButton"
                        Content="Preview sample"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="PreviewSample_Click"
                    AutomationProperties.AutomationId="VideoEnhancerPreviewSampleButton"/>
                <Button x:Uid="VideoEnhancerPage_RunButton" x:Name="RunButton"
                        Content="Enhance Video"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Run_Click"
                        IsEnabled="False"
                    AutomationProperties.AutomationId="RunButton"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" CornerRadius="12" Padding="18"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop"
                    PointerPressed="DropZone_PointerPressed">
                <Pivot x:Name="QueuePivot" SelectionChanged="QueuePivot_SelectionChanged">
                    <PivotItem x:Uid="VideoEnhancerPage_VideoEnhancerPagePivotItem01" Header="Queue"
                        AutomationProperties.AutomationId="VideoEnhancerPagePivotItem01">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE799;" FontSize="30"
                                              Foreground="{StaticResource AccentBlueBrush}"/>
                                </Border>
                                <TextBlock x:Uid="VideoEnhancerPage_Item_009" Text="Drop video files here"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Uid="VideoEnhancerPage_Item_010" Text="Choose an engine, then queue clips for local restoration or frame interpolation. RIFE needs its pinned Vulkan runtime; Anime4K needs optional mpv and shaders; SeedVR2 requires its CUDA model pack."
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="420"/>
                                <Button x:Uid="VideoEnhancerPage_VideoEnhancerPageButton02" Content="Browse Files" Style="{StaticResource PrimaryButtonStyle}"
                                        Click="Browse_Click" HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="VideoEnhancerPageButton02"/>
                            </StackPanel>
                            <ListView x:Name="FileList" Visibility="Collapsed"
                                      Background="Transparent" SelectionMode="None"
                                      ItemTemplate="{StaticResource VeQueueTemplate}"/>
                        </Grid>
                    </PivotItem>
                    <PivotItem x:Uid="VideoEnhancerPage_VideoEnhancerPagePivotItem02" Header="Finished"
                        AutomationProperties.AutomationId="VideoEnhancerPagePivotItem02">
                        <Grid MinHeight="320" Padding="0,8,0,0">
                            <StackPanel x:Name="FinishedEmptyState"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <Border Width="72" Height="72" CornerRadius="18"
                                        Background="{StaticResource SurfaceLightBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="30"
                                              Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Uid="VideoEnhancerPage_Item_013" Text="No upscaled videos yet"
                                           Style="{StaticResource SubtitleTextStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="FinishedList" Visibility="Collapsed"
                                      Background="Transparent" SelectionMode="None"
                                      ItemTemplate="{StaticResource VeFinishedTemplate}"/>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="VideoEnhancerPage_Item_014" Text="Engine" Style="{StaticResource PanelTitleTextStyle}"/>
                        <ComboBox x:Uid="VideoEnhancerPage_EngineCombo" x:Name="EngineCombo" Header="Restoration engine"
                                  HorizontalAlignment="Stretch" SelectedIndex="0"
                                  SelectionChanged="Engine_Changed"
                                  AutomationProperties.AutomationId="EngineCombo">
                            <ComboBoxItem x:Uid="VideoEnhancerPage_Item_016" Content="Real-ESRGAN (portable)" Tag="realesrgan"/>
                            <ComboBoxItem x:Uid="VideoEnhancerPage_Item_017" Content="SeedVR2 3B FP8 (CUDA, optional)" Tag="seedvr2"/>
                            <ComboBoxItem x:Uid="VideoEnhancerPage_Anime4KEngine" Content="Anime4K GLSL (mpv, optional)" Tag="anime4k"/>
                            <ComboBoxItem x:Uid="VideoEnhancerPage_RifeEngine" Content="RIFE frame interpolation (Vulkan)" Tag="rife"/>
                        </ComboBox>
                        <StackPanel x:Name="RealEsrganModelPanel" Spacing="8">
                            <ComboBox x:Uid="VideoEnhancerPage_ModelCombo" x:Name="ModelCombo" Header="Model"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Discovering..."
                                      SelectionChanged="Settings_Changed"
                                AutomationProperties.AutomationId="ModelCombo"/>
                            <TextBlock x:Name="ModelHintText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                            <Button x:Uid="VideoEnhancerPage_VideoEnhancerPageButton03" Content="Refresh Models" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RefreshModels_Click" HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="VideoEnhancerPageButton03"/>
                        </StackPanel>
                        <StackPanel x:Name="SeedVr2ModelPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock x:Uid="VideoEnhancerPage_Item_020" Text="SeedVR2 3B FP8 restoration pack"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock x:Uid="VideoEnhancerPage_Item_021" Text="Pinned local runtime and weights · Apache-2.0 · approximately 3.9 GB. Requires NVIDIA CUDA with at least 10 GB VRAM; 12 GB or more is recommended."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                            <Button x:Uid="VideoEnhancerPage_DownloadSeedVr2ModelButton" x:Name="DownloadSeedVr2ModelButton"
                                    Content="Review &amp; download model"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="DownloadSeedVr2Model_Click"
                                    AutomationProperties.AutomationId="DownloadSeedVr2ModelButton"/>
                            <TextBlock x:Uid="VideoEnhancerPage_SeedVr2ModelStatus" x:Name="SeedVr2ModelStatus"
                                       Text="Checking local model pack..."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <StackPanel x:Name="Anime4KModelPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock x:Uid="VideoEnhancerPage_Anime4KPackTitle" Text="Anime4K v4.0.1 GLSL shader pack"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock x:Uid="VideoEnhancerPage_Anime4KPackDescription" Text="Pinned MIT-licensed shaders · approximately 0.8 MB. Export runs locally through an optional mpv installation; no model weights are required."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                            <ComboBox x:Uid="VideoEnhancerPage_Anime4KProfileCombo" x:Name="Anime4KProfileCombo"
                                      Header="Shader profile" SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="Settings_Changed"
                                      AutomationProperties.AutomationId="Anime4KProfileCombo">
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Anime4KProfileA" Content="Mode A · line restoration" Tag="a"/>
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Anime4KProfileB" Content="Mode B · soft restoration" Tag="b"/>
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Anime4KProfileC" Content="Mode C · denoise" Tag="c"/>
                            </ComboBox>
                            <Button x:Uid="VideoEnhancerPage_DownloadAnime4KShadersButton" x:Name="DownloadAnime4KShadersButton"
                                    Content="Review &amp; download shaders"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="DownloadAnime4KShaders_Click"
                                    AutomationProperties.AutomationId="DownloadAnime4KShadersButton"/>
                            <TextBlock x:Uid="VideoEnhancerPage_Anime4KStatus" x:Name="Anime4KStatus"
                                       Text="Checking mpv and local shader pack..."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <StackPanel x:Name="RifeModelPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock x:Uid="VideoEnhancerPage_RifeRuntimeTitle" Text="RIFE ncnn-vulkan runtime"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBlock x:Uid="VideoEnhancerPage_RifeRuntimeDescription" Text="Pinned rife-v4.6 model through the managed Vulkan runtime. The source remains untouched and the output is promoted only after frame-rate validation."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Uid="VideoEnhancerPage_RifeStatusText" x:Name="RifeStatusText"
                                       Text="Checking pinned RIFE runtime and Vulkan readiness..."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="VideoEnhancerPage_Item_024" Text="Windows AI VSR" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Name="WindowsVsrStatusText"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="WindowsVsrDetailText"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="VideoEnhancerPage_Item_025" Text="Quality" Style="{StaticResource PanelTitleTextStyle}"/>
                        <StackPanel x:Name="RealEsrganQualityPanel" Spacing="8">
                            <ComboBox x:Uid="VideoEnhancerPage_ScaleCombo" x:Name="ScaleCombo" Header="Upscale factor" SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="Settings_Changed"
                                AutomationProperties.AutomationId="ScaleCombo">
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Item_027" Content="2× (recommended)" Tag="2"/>
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Item_028" Content="3× (slower)"      Tag="3"/>
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Item_029" Content="4× (slowest)"     Tag="4"/>
                            </ComboBox>
                            <Slider x:Uid="VideoEnhancerPage_CrfSlider" x:Name="CrfSlider"
                                    Header="x264 CRF"
                                    Minimum="14" Maximum="32" Value="20"
                                    StepFrequency="1"
                                    ValueChanged="Crf_Changed"
                                AutomationProperties.AutomationId="CrfSlider"/>
                            <TextBlock x:Uid="VideoEnhancerPage_CrfLabel" x:Name="CrfLabel"
                                       Text="CRF 20 (high quality)"
                                       Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel x:Name="SeedVr2QualityPanel" Visibility="Collapsed" Spacing="8">
                            <ComboBox x:Uid="VideoEnhancerPage_SeedVr2ResolutionCombo" x:Name="SeedVr2ResolutionCombo" Header="Target short side" SelectedIndex="1"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="Settings_Changed"
                                      AutomationProperties.AutomationId="SeedVr2ResolutionCombo">
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Item_033" Content="540p (lower VRAM)" Tag="540"/>
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Item_034" Content="720p (recommended)" Tag="720"/>
                                <ComboBoxItem x:Uid="VideoEnhancerPage_Item_035" Content="1080p (slowest)" Tag="1080"/>
                            </ComboBox>
                            <TextBlock x:Uid="VideoEnhancerPage_Item_036" Text="Uses streaming, CPU offload, BlockSwap, and tiled VAE processing. The source and result stay local."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="Anime4KQualityPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock x:Uid="VideoEnhancerPage_Anime4KScaleNote" Text="Fixed 2× output through the selected Anime4K shader chain. Audio is preserved as AAC."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                            <Slider x:Uid="VideoEnhancerPage_Anime4KCrfSlider" x:Name="Anime4KCrfSlider"
                                    Header="x264 CRF"
                                    Minimum="14" Maximum="32" Value="18"
                                    StepFrequency="1"
                                    ValueChanged="Anime4KCrf_Changed"
                                    AutomationProperties.AutomationId="Anime4KCrfSlider"/>
                            <TextBlock x:Uid="VideoEnhancerPage_Anime4KCrfLabel" x:Name="Anime4KCrfLabel"
                                       Text="CRF 18 (high quality)"
                                       Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel x:Name="RifeQualityPanel" Visibility="Collapsed" Spacing="8">
                            <ComboBox x:Uid="VideoEnhancerPage_RifeTargetFpsCombo" x:Name="TargetFpsCombo"
                                      Header="Target frame rate" SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="Settings_Changed"
                                      AutomationProperties.AutomationId="RifeTargetFpsCombo">
                                <ComboBoxItem x:Uid="VideoEnhancerPage_RifeTargetFps60" Content="60 FPS (recommended)" Tag="60"/>
                                <ComboBoxItem x:Uid="VideoEnhancerPage_RifeTargetFps120" Content="120 FPS" Tag="120"/>
                            </ComboBox>
                            <TextBlock x:Uid="VideoEnhancerPage_RifeQualityNote" Text="RIFE raises the frame rate without replacing the source. The managed Vulkan readiness check and output artifact validation run before each queued clip."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="VideoEnhancerPage_Item_037" Text="Queue Summary" Style="{StaticResource PanelTitleTextStyle}"/>
                        <TextBlock x:Uid="VideoEnhancerPage_QueueSummaryText" x:Name="QueueSummaryText" Text="0 queued / 0 finished"
                                   Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock x:Name="CurrentSetupText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Uid="VideoEnhancerPage_ClearButton" Grid.Column="1" x:Name="ClearButton" Content="Clear Queue"
                    Style="{StaticResource GhostButtonStyle}" Click="Clear_Click"
                    Margin="0,0,12,0" IsEnabled="False"
                AutomationProperties.AutomationId="ClearButton"/>
            <Button x:Uid="VideoEnhancerPage_CancelButton" Grid.Column="2" x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click" IsEnabled="False"
                AutomationProperties.AutomationId="CancelButton"/>
        </Grid>
    </Grid>
</Page>
