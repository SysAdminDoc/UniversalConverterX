<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UniversalConverterX.UI.Views.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BackgroundBrush}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock x:Uid="ProgressWindow_TitleText" x:Name="TitleText" 
                       Text="Converting files"
                       Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock x:Uid="ProgressWindow_StatusText" x:Name="StatusText" 
                       Text="Preparing queue..."
                       Style="{StaticResource PageDescriptionTextStyle}"/>
        </StackPanel>

        <!-- File List -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="12"
                Margin="0,0,0,16">
        <ListView x:Name="FileListView"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Background="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status Icon -->
                        <FontIcon Grid.Column="0" 
                                  Grid.RowSpan="3"
                                  Glyph="{Binding StatusIcon}"
                                  Foreground="{Binding StatusColor}"
                                  FontSize="24"
                                  VerticalAlignment="Center"/>

                        <!-- File Name -->
                        <TextBlock Grid.Column="1" 
                                   Grid.Row="0"
                                   Text="{Binding FileName}"
                                   Style="{StaticResource LabelTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Status Text -->
                        <TextBlock Grid.Column="1" 
                                   Grid.Row="1"
                                   Text="{Binding StatusMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding ShowStatus}"/>

                        <!-- Progress Bar -->
                        <ProgressBar Grid.Column="1" 
                                     Grid.Row="2"
                                     Value="{Binding Progress}"
                                     Maximum="100"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Visibility="{Binding ShowProgress}"
                                     Margin="0,4,0,0"/>

                        <!-- Size/Time Info -->
                        <StackPanel Grid.Column="2" 
                                    Grid.RowSpan="3"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SizeInfo}"
                                       Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TimeInfo}"
                                       Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Border>

        <!-- Overall Progress -->
        <Border Grid.Row="2" Style="{StaticResource QuietSurfaceStyle}" Margin="0,0,0,16">
        <StackPanel Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ProgressWindow_OverallProgressText" x:Name="OverallProgressText" 
                           Text="0 of 0 files"
                           Style="{StaticResource BodyTextStyle}"/>
                <TextBlock x:Name="EtaText" 
                           Grid.Column="1"
                           Text=""
                           Style="{StaticResource MutedTextStyle}"/>
            </Grid>
            <ProgressBar x:Name="OverallProgressBar"
                         Value="0"
                         Maximum="100"/>
        </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    Spacing="8"
                    HorizontalAlignment="Right">
            <Button x:Uid="ProgressWindow_OpenFolderButton" x:Name="OpenFolderButton"
                    Content="Open Output Folder"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenFolder_Click"
                    Visibility="Collapsed"
                AutomationProperties.AutomationId="OpenFolderButton"/>
            <Button x:Uid="ProgressWindow_PauseButton" x:Name="PauseButton"
                    Content="Pause"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Pause_Click"
                AutomationProperties.AutomationId="PauseButton"/>
            <Button x:Uid="ProgressWindow_CancelButton" x:Name="CancelButton"
                    Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Cancel_Click"
                AutomationProperties.AutomationId="CancelButton"/>
            <Button x:Uid="ProgressWindow_CloseButton" x:Name="CloseButton"
                    Content="Close"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Close_Click"
                    Visibility="Collapsed"
                AutomationProperties.AutomationId="CloseButton"/>
        </StackPanel>
    </Grid>
</Window>
