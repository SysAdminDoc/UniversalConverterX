<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UniversalConverterX.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings - UniversalConverter X">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ShellGradientBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="30,20">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="Set defaults, local tool paths, Explorer integration, and appearance."
                               Style="{StaticResource SubtitleTextStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE83D;" FontSize="15"
                                  Foreground="{StaticResource AccentGreenBrush}"/>
                        <TextBlock Text="Local defaults"
                                   Style="{StaticResource PillTextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="30,26">
            <StackPanel Spacing="18" MaxWidth="920">
                
                <!-- General Settings -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="20" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="General" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="Output location, overwrite behavior, notifications" 
                                           Style="{StaticResource MutedTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="16" Padding="0,16,0,0">
                        <!-- Default Output Directory -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirectoryTextBox"
                                     Header="Default output folder"
                                     PlaceholderText="Same as input file"
                                     Style="{StaticResource PremiumTextBoxStyle}"
                                     IsReadOnly="True"/>
                            <Button Grid.Column="1" 
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputDirectory_Click"/>
                        </Grid>

                        <!-- Overwrite Behavior -->
                        <ComboBox x:Name="OverwriteBehaviorComboBox"
                                  Header="When output file exists"
                                  SelectedIndex="0"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Ask each time"/>
                            <ComboBoxItem Content="Always overwrite"/>
                            <ComboBoxItem Content="Never overwrite (rename)"/>
                            <ComboBoxItem Content="Skip file"/>
                        </ComboBox>

                        <!-- Delete Source -->
                        <ToggleSwitch x:Name="DeleteSourceToggle"
                                      Header="Delete source files after conversion"
                                      OffContent="Keep original files"
                                      OnContent="Move to Recycle Bin"
                                      Toggled="SettingsToggle_Changed"/>

                        <!-- Notifications -->
                        <ToggleSwitch x:Name="NotificationsToggle"
                                      Header="Show notifications"
                                      OffContent="Disabled"
                                      OnContent="Enabled"
                                      IsOn="True"
                                      Toggled="SettingsToggle_Changed"/>

                        <!-- Sound -->
                        <ToggleSwitch x:Name="SoundToggle"
                                      Header="Play sound when complete"
                                      OffContent="Silent"
                                      OnContent="Enabled"
                                      IsOn="True"
                                      Toggled="SettingsToggle_Changed"/>
                    </StackPanel>
                </Expander>

                <!-- Quality & Performance -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D9;" FontSize="20" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Quality &amp; Performance" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="Default quality, hardware acceleration, parallel processing" 
                                           Style="{StaticResource MutedTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="16" Padding="0,16,0,0">
                        <!-- Default Quality -->
                        <ComboBox x:Name="DefaultQualityComboBox"
                                  Header="Default quality preset"
                                  SelectedIndex="3"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Lowest - Smallest file size"/>
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium - Balanced"/>
                            <ComboBoxItem Content="High - Recommended"/>
                            <ComboBoxItem Content="Highest - Largest files"/>
                            <ComboBoxItem Content="Lossless - No quality loss"/>
                        </ComboBox>

                        <!-- Hardware Acceleration -->
                        <ComboBox x:Name="HardwareAccelComboBox"
                                  Header="Hardware acceleration"
                                  SelectedIndex="0"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Auto-detect"/>
                            <ComboBoxItem Content="NVIDIA NVENC (CUDA)"/>
                            <ComboBoxItem Content="Intel Quick Sync"/>
                            <ComboBoxItem Content="AMD AMF"/>
                            <ComboBoxItem Content="Disabled (CPU only)"/>
                        </ComboBox>

                        <!-- Parallel Conversions -->
                        <StackPanel>
                            <TextBlock Text="Maximum parallel conversions" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ParallelSlider"
                                        Minimum="1"
                                        Maximum="16"
                                        Value="4"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        TickPlacement="Outside"
                                        ValueChanged="ParallelSlider_ValueChanged"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Value, ElementName=ParallelSlider}"
                                           Width="30"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Preserve Metadata -->
                        <ToggleSwitch x:Name="PreserveMetadataToggle"
                                      Header="Preserve metadata"
                                      OffContent="Strip metadata"
                                      OnContent="Keep EXIF, tags, etc."
                                      IsOn="True"
                                      Toggled="SettingsToggle_Changed"/>
                    </StackPanel>
                </Expander>

                <!-- Tools Management -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE90F;" FontSize="20" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Converter Tools" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="Manage FFmpeg, ImageMagick, and other CLI tools" 
                                           Style="{StaticResource MutedTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="16" Padding="0,16,0,0">
                        <!-- Tools Path -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ToolsPathTextBox"
                                     Header="Tools directory"
                                     PlaceholderText="Default location"
                                     Style="{StaticResource PremiumTextBoxStyle}"
                                     IsReadOnly="True"/>
                            <Button Grid.Column="1" 
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseToolsPath_Click"/>
                        </Grid>

                        <!-- Tools List -->
                        <ListView x:Name="ToolsListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Status Icon -->
                                        <FontIcon Grid.Column="0"
                                                  Glyph="{Binding StatusGlyph}"
                                                  Foreground="{Binding StatusColor}"
                                                  FontSize="16"/>
                                        
                                        <!-- Tool Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource LabelTextStyle}"/>
                                            <TextBlock Text="{Binding StatusText}" 
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        
                                        <!-- Version -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Version}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        
                                        <!-- Action Button -->
                                        <Button Grid.Column="3"
                                                Content="{Binding ActionText}"
                                                Click="ToolAction_Click"
                                                Tag="{Binding Id}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinWidth="100"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Download All Button -->
                        <Button x:Name="DownloadAllToolsButton"
                                Content="Install Missing Tools"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="DownloadAllTools_Click"/>
                    </StackPanel>
                </Expander>

                <!-- Shell Integration -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Shell Integration" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="Windows Explorer context menu options" 
                                           Style="{StaticResource MutedTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="16" Padding="0,16,0,0">
                        <!-- Enable Context Menu -->
                        <ToggleSwitch x:Name="ContextMenuToggle"
                                      Header="Show in Explorer context menu"
                                      OffContent="Disabled"
                                      OnContent="Enabled"
                                      IsOn="True"
                                      Toggled="ContextMenuToggle_Toggled"/>

                        <!-- Context Menu Style -->
                        <ComboBox x:Name="ContextMenuStyleComboBox"
                                  Header="Context menu style"
                                  SelectedIndex="0"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding IsOn, ElementName=ContextMenuToggle}">
                            <ComboBoxItem Content="Cascading menu (Convert to →)"/>
                            <ComboBoxItem Content="Flat menu (individual formats)"/>
                            <ComboBoxItem Content="Single item (opens app)"/>
                        </ComboBox>

                        <!-- Quick Convert Presets -->
                        <TextBlock Text="Quick convert presets in context menu" Margin="0,8,0,0"/>
                        <StackPanel Spacing="8">
                            <CheckBox x:Name="PresetWebpCheckBox" Content="Convert to WebP" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            <CheckBox x:Name="PresetPngCheckBox" Content="Convert to PNG" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            <CheckBox x:Name="PresetJpgCheckBox" Content="Convert to JPG" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            <CheckBox x:Name="PresetMp4CheckBox" Content="Convert to MP4" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            <CheckBox x:Name="PresetMp3CheckBox" Content="Extract audio as MP3" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                            <CheckBox x:Name="PresetPdfCheckBox" Content="Convert to PDF" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"/>
                        </StackPanel>

                        <!-- Register/Unregister Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="RegisterShellButton"
                                    Content="Register"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RegisterShell_Click"/>
                            <Button x:Name="UnregisterShellButton"
                                    Content="Unregister"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UnregisterShell_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Appearance -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;" FontSize="20" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Appearance" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="Theme, accent color, window behavior" 
                                           Style="{StaticResource MutedTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="16" Padding="0,16,0,0">
                        <!-- Theme -->
                        <ComboBox x:Name="ThemeComboBox"
                                  Header="App theme"
                                  SelectedIndex="1"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Use system setting"/>
                        </ComboBox>

                        <!-- Accent Color -->
                        <StackPanel>
                            <TextBlock Text="Accent color" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AccentGreenButton" 
                                        Width="40" Height="40" 
                                        Background="#22c55e"
                                        CornerRadius="20"
                                        Click="AccentColor_Click" Tag="#22c55e"/>
                                <Button x:Name="AccentBlueButton" 
                                        Width="40" Height="40" 
                                        Background="#60a5fa"
                                        CornerRadius="20"
                                        Click="AccentColor_Click" Tag="#60a5fa"/>
                                <Button x:Name="AccentPurpleButton" 
                                        Width="40" Height="40" 
                                        Background="#a78bfa"
                                        CornerRadius="20"
                                        Click="AccentColor_Click" Tag="#a78bfa"/>
                                <Button x:Name="AccentOrangeButton" 
                                        Width="40" Height="40" 
                                        Background="#fb923c"
                                        CornerRadius="20"
                                        Click="AccentColor_Click" Tag="#fb923c"/>
                                <Button x:Name="AccentRedButton" 
                                        Width="40" Height="40" 
                                        Background="#f87171"
                                        CornerRadius="20"
                                        Click="AccentColor_Click" Tag="#f87171"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Minimize to Tray -->
                        <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                      Header="Minimize to system tray"
                                      OffContent="Close to taskbar"
                                      OnContent="Minimize to tray"
                                      Toggled="SettingsToggle_Changed"/>

                        <!-- Start Minimized -->
                        <ToggleSwitch x:Name="StartMinimizedToggle"
                                      Header="Start minimized"
                                      OffContent="Show window on startup"
                                      OnContent="Start in background"
                                      Toggled="SettingsToggle_Changed"/>
                    </StackPanel>
                </Expander>

                <!-- About -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="20" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="About" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Text="Version info, updates, licenses" 
                                           Style="{StaticResource MutedTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="16" Padding="0,16,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="UniversalConverter X" Style="{StaticResource SubtitleTextStyle}"/>
                            <TextBlock x:Name="VersionText" 
                                       Text="Version 2.2.0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="A local file conversion workspace with optional Windows Explorer integration."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/SysAdminDoc/UniversalConverterX"/>
                            <HyperlinkButton Content="Documentation" NavigateUri="https://github.com/SysAdminDoc/UniversalConverterX#readme"/>
                            <HyperlinkButton Content="Report Issue" NavigateUri="https://github.com/SysAdminDoc/UniversalConverterX/issues/new"/>
                        </StackPanel>

                        <Button x:Name="CheckUpdatesButton"
                                Content="View Releases"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CheckUpdates_Click"/>

                        <!-- Credits -->
                        <TextBlock Text="Local engines:" Margin="0,16,0,0"/>
                        <TextBlock Text="• FFmpeg - Video/Audio processing (LGPL/GPL)&#x0a;• ImageMagick - Image processing (Apache 2.0)&#x0a;• Pandoc - Document conversion (GPL)&#x0a;• LibreOffice - Office documents (MPL)&#x0a;• Ghostscript - PDF processing (AGPL)&#x0a;• Inkscape - Vector graphics (GPL)&#x0a;• Calibre - Ebook conversion (GPL)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="30,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ResetButton"
                        Content="Reset Defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ResetSettings_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"/>
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
