<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UniversalConverterX.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                 Background="{StaticResource SurfaceMutedBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="0,0,0,1"
                 Padding="24,10">
            <StackPanel Spacing="3">
                <TextBlock x:Uid="SettingsWindow_Item_002" Text="Settings" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock x:Uid="SettingsWindow_Item_003" Text="Defaults, local tools, integrations, and appearance."
                           Style="{StaticResource PageDescriptionTextStyle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,12">
            <Grid MaxWidth="920">
                <!-- Keep a solid panel under Mica for unsupported/RDP configurations. -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"/>
                <SystemBackdropElement x:Name="SettingsBackdropHost"
                                       CornerRadius="12"
                                       IsHitTestVisible="False"/>
                <StackPanel Spacing="10" Padding="14">
                
                <!-- General Settings -->
                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_005" Text="General" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <!-- Default Output Directory -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="SettingsWindow_OutputDirectoryTextBox" x:Name="OutputDirectoryTextBox"
                                     Header="Default output folder"
                                     PlaceholderText="Same as input file"
                                     Style="{StaticResource PremiumTextBoxStyle}"
                                     IsReadOnly="True"
                                AutomationProperties.AutomationId="OutputDirectoryTextBox"/>
                            <Button x:Uid="SettingsWindow_SettingsWindowButton01" Grid.Column="1" 
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseOutputDirectory_Click"
                                AutomationProperties.AutomationId="SettingsWindowButton01"/>
                        </Grid>

                        <!-- Overwrite Behavior -->
                        <ComboBox x:Uid="SettingsWindow_OverwriteBehaviorComboBox" x:Name="OverwriteBehaviorComboBox"
                                  Header="When output file exists"
                                  SelectedIndex="0"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="OverwriteBehaviorComboBox">
                            <ComboBoxItem x:Uid="SettingsWindow_Item_010" Content="Ask each time"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_011" Content="Always overwrite"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_012" Content="Never overwrite (rename)"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_013" Content="Skip file"/>
                        </ComboBox>

                        <!-- Post-conversion source action -->
                        <ComboBox x:Uid="SettingsWindow_PostConversionActionComboBox" x:Name="PostConversionActionComboBox"
                                  Header="After successful conversion"
                                  SelectedIndex="0"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="PostConversionAction_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="PostConversionActionComboBox"
                            AutomationProperties.HelpText="Choose whether original source files are kept, moved to an archive folder, or permanently deleted after output is created.">
                            <ComboBoxItem x:Uid="SettingsWindow_Item_015" Content="Keep original files"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_016" Content="Move originals to archive folder"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_017" Content="Permanently delete originals"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="SettingsWindow_PostConversionArchiveTextBox" x:Name="PostConversionArchiveTextBox"
                                     Header="Archive folder for moved originals"
                                     PlaceholderText="_converted-sources or an absolute path"
                                     Style="{StaticResource PremiumTextBoxStyle}"
                                     TextChanged="SettingsText_Changed"
                                AutomationProperties.AutomationId="PostConversionArchiveTextBox"/>
                            <Button x:Uid="SettingsWindow_BrowsePostConversionArchiveButton" x:Name="BrowsePostConversionArchiveButton"
                                    Grid.Column="1"
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowsePostConversionArchive_Click"
                                AutomationProperties.AutomationId="BrowsePostConversionArchiveButton"/>
                        </Grid>

                        <TextBlock x:Uid="SettingsWindow_Item_020" Text="Delete runs only after verified output. Moving originals is safer."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <!-- Notifications -->
                        <ToggleSwitch x:Uid="SettingsWindow_NotificationsToggle" x:Name="NotificationsToggle"
                                      Header="Show notifications"
                                      OffContent="Disabled"
                                      OnContent="Enabled"
                                      IsOn="True"
                                      Toggled="SettingsToggle_Changed"
                            AutomationProperties.AutomationId="NotificationsToggle"/>

                        <!-- Sound -->
                        <ToggleSwitch x:Uid="SettingsWindow_SoundToggle" x:Name="SoundToggle"
                                      Header="Play sound when complete"
                                      OffContent="Silent"
                                      OnContent="Enabled"
                                      IsOn="True"
                                      Toggled="SettingsToggle_Changed"
                            AutomationProperties.AutomationId="SoundToggle"/>

                        <ComboBox x:Uid="SettingsWindow_QueueCompletionActionComboBox" x:Name="QueueCompletionActionComboBox"
                                  Header="After a queue completes"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="QueueCompletionAction_Changed"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="QueueCompletionActionComboBox">
                            <ComboBoxItem x:Uid="SettingsWindow_Item_024" Content="Do nothing"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_025" Content="Show notification"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_026" Content="Put the computer to sleep"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_027" Content="Shut down the computer"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_028" Content="Run PowerShell script"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="SettingsWindow_QueueCompletionScriptTextBox" x:Name="QueueCompletionScriptTextBox"
                                     Header="Post-queue script"
                                     PlaceholderText="PowerShell .ps1"
                                     Style="{StaticResource PremiumTextBoxStyle}"
                                     TextChanged="SettingsText_Changed"
                                     AutomationProperties.AutomationId="QueueCompletionScriptTextBox"/>
                            <Button x:Uid="SettingsWindow_BrowseQueueCompletionScriptButton" x:Name="BrowseQueueCompletionScriptButton"
                                    Grid.Column="1"
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseQueueCompletionScript_Click"
                                    AutomationProperties.AutomationId="BrowseQueueCompletionScriptButton"/>
                        </Grid>

                        <TextBlock x:Uid="SettingsWindow_Item_031" Text="Sleep and shutdown require every job to succeed. Shutdown includes a 60-second cancellation window; scripts receive the JSON summary path."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Expander>

                <!-- Quality & Performance -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_032" Text="Quality &amp; Performance" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <!-- Default Quality -->
                        <ComboBox x:Uid="SettingsWindow_DefaultQualityComboBox" x:Name="DefaultQualityComboBox"
                                  Header="Default quality preset"
                                  SelectedIndex="3"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="DefaultQualityComboBox">
                            <ComboBoxItem x:Uid="SettingsWindow_Item_035" Content="Lowest - Smallest file size"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_036" Content="Low"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_037" Content="Medium - Balanced"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_038" Content="High - Recommended"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_039" Content="Highest - Largest files"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_040" Content="Lossless - No quality loss"/>
                        </ComboBox>

                        <!-- Hardware Acceleration -->
                        <ComboBox x:Uid="SettingsWindow_HardwareAccelComboBox" x:Name="HardwareAccelComboBox"
                                  Header="Hardware acceleration"
                                  SelectedIndex="0"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="HardwareAccelComboBox">
                            <ComboBoxItem x:Uid="SettingsWindow_Item_042" Tag="Auto" Content="Auto-detect"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_043" Tag="Nvenc" Content="NVIDIA NVENC (CUDA)"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_044" Tag="Qsv" Content="Intel Quick Sync"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_045" Tag="Amf" Content="AMD AMF"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_046" Tag="None" Content="Disabled (CPU only)"/>
                        </ComboBox>

                        <!-- Parallel Conversions -->
                        <StackPanel>
                            <TextBlock x:Uid="SettingsWindow_Item_047" Text="Maximum parallel conversions" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ParallelSlider"
                                        Minimum="1"
                                        Maximum="16"
                                        Value="4"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        TickPlacement="Outside"
                                        ValueChanged="ParallelSlider_ValueChanged"
                                    AutomationProperties.AutomationId="ParallelSlider"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Value, ElementName=ParallelSlider}"
                                           Width="30"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Preserve Metadata -->
                        <ToggleSwitch x:Uid="SettingsWindow_PreserveMetadataToggle" x:Name="PreserveMetadataToggle"
                                      Header="Preserve metadata"
                                      OffContent="Strip metadata"
                                      OnContent="Keep EXIF, tags, etc."
                                      IsOn="True"
                                      Toggled="SettingsToggle_Changed"
                            AutomationProperties.AutomationId="PreserveMetadataToggle"/>
                    </StackPanel>
                </Expander>

                <!-- Tools Management -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_049" Text="Converter Tools" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <!-- Tools Path -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="SettingsWindow_ToolsPathTextBox" x:Name="ToolsPathTextBox"
                                     Header="Tools directory"
                                     PlaceholderText="Default location"
                                     Style="{StaticResource PremiumTextBoxStyle}"
                                     IsReadOnly="True"
                                AutomationProperties.AutomationId="ToolsPathTextBox"/>
                            <Button x:Uid="SettingsWindow_SettingsWindowButton02" Grid.Column="1" 
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseToolsPath_Click"
                                AutomationProperties.AutomationId="SettingsWindowButton02"/>
                        </Grid>

                        <!-- Tools List -->
                        <ListView x:Name="ToolsListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Status Icon -->
                                        <FontIcon Grid.Column="0"
                                                  Glyph="{Binding StatusGlyph}"
                                                  Foreground="{Binding StatusColor}"
                                                  FontSize="16"/>
                                        
                                        <!-- Tool Info -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource LabelTextStyle}"/>
                                            <TextBlock Text="{Binding StatusText}" 
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        
                                        <!-- Version -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Version}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        
                                        <!-- Action Button -->
                                        <Button Grid.Column="3"
                                                Content="{Binding ActionText}"
                                                Click="ToolAction_Click"
                                                Tag="{Binding Id}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinWidth="100"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Download All Button -->
                        <Button x:Uid="SettingsWindow_DownloadAllToolsButton" x:Name="DownloadAllToolsButton"
                                Content="Install missing tools"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="DownloadAllTools_Click"
                            AutomationProperties.AutomationId="DownloadAllToolsButton"/>
                    </StackPanel>
                </Expander>

                <!-- Third-party plugins -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE74C;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_054" Text="Trusted Plugins" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <TextBlock x:Uid="SettingsWindow_Item_056" Text="New plugins stay quarantined until you trust their file hashes. Changes disable them again; links and reparse points are rejected."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <ListView x:Name="PluginsListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding StatusGlyph}"
                                                  Foreground="{Binding StatusColor}"
                                                  FontSize="16"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource LabelTextStyle}"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Sha256Display}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource MutedTextStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="{Binding ActionText}"
                                                IsEnabled="{Binding CanChangeTrust}"
                                                Tag="{Binding Id}"
                                                Click="PluginTrustAction_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinWidth="100"
                                                AutomationProperties.Name="{Binding ActionText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Uid="SettingsWindow_NoPluginsText" x:Name="NoPluginsText"
                                   Text="No plugins found. Drop a plugin directory containing manifest.json into the local plugins folder."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
                        <Button x:Uid="SettingsWindow_OpenPluginsFolderButton" Content="Open plugins folder"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OpenPluginsFolder_Click"
                                AutomationProperties.AutomationId="OpenPluginsFolderButton"/>
                    </StackPanel>
                </Expander>

                <!-- Shell Integration -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_059" Text="Shell Integration" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <!-- Enable Context Menu -->
                        <ToggleSwitch x:Uid="SettingsWindow_ContextMenuToggle" x:Name="ContextMenuToggle"
                                      Header="Show in Explorer context menu"
                                      OffContent="Disabled"
                                      OnContent="Enabled"
                                      IsOn="True"
                                      Toggled="ContextMenuToggle_Toggled"
                            AutomationProperties.AutomationId="ContextMenuToggle"/>

                        <!-- Context Menu Style -->
                        <ComboBox x:Uid="SettingsWindow_ContextMenuStyleComboBox" x:Name="ContextMenuStyleComboBox"
                                  Header="Context menu style"
                                  SelectedIndex="0"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  SelectionChanged="SettingsSelection_Changed"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding IsOn, ElementName=ContextMenuToggle}"
                            AutomationProperties.AutomationId="ContextMenuStyleComboBox">
                            <ComboBoxItem x:Uid="SettingsWindow_Item_063" Content="Cascading menu (Convert to →)"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_064" Content="Flat menu (individual formats)"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_065" Content="Single item (opens app)"/>
                        </ComboBox>

                        <!-- Quick Convert Presets -->
                        <TextBlock x:Uid="SettingsWindow_Item_066" Text="Quick convert presets in context menu" Margin="0,8,0,0"/>
                        <StackPanel Spacing="8">
                            <CheckBox x:Uid="SettingsWindow_PresetWebpCheckBox" x:Name="PresetWebpCheckBox" Content="Convert to WebP" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"
                                AutomationProperties.AutomationId="PresetWebpCheckBox"/>
                            <CheckBox x:Uid="SettingsWindow_PresetPngCheckBox" x:Name="PresetPngCheckBox" Content="Convert to PNG" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"
                                AutomationProperties.AutomationId="PresetPngCheckBox"/>
                            <CheckBox x:Uid="SettingsWindow_PresetJpgCheckBox" x:Name="PresetJpgCheckBox" Content="Convert to JPG" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"
                                AutomationProperties.AutomationId="PresetJpgCheckBox"/>
                            <CheckBox x:Uid="SettingsWindow_PresetMp4CheckBox" x:Name="PresetMp4CheckBox" Content="Convert to MP4" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"
                                AutomationProperties.AutomationId="PresetMp4CheckBox"/>
                            <CheckBox x:Uid="SettingsWindow_PresetMp3CheckBox" x:Name="PresetMp3CheckBox" Content="Extract audio as MP3" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"
                                AutomationProperties.AutomationId="PresetMp3CheckBox"/>
                            <CheckBox x:Uid="SettingsWindow_PresetPdfCheckBox" x:Name="PresetPdfCheckBox" Content="Convert to PDF" IsChecked="True" Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed"
                                AutomationProperties.AutomationId="PresetPdfCheckBox"/>
                        </StackPanel>

                        <!-- Register/Unregister Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Uid="SettingsWindow_RegisterShellButton" x:Name="RegisterShellButton"
                                    Content="Register menu"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RegisterShell_Click"
                                AutomationProperties.AutomationId="RegisterShellButton"/>
                            <Button x:Uid="SettingsWindow_UnregisterShellButton" x:Name="UnregisterShellButton"
                                    Content="Remove menu"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UnregisterShell_Click"
                                AutomationProperties.AutomationId="UnregisterShellButton"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Advanced -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE943;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_075" Text="Advanced" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <ToggleSwitch x:Uid="SettingsWindow_FfmpegCommandEditingToggle" x:Name="FfmpegCommandEditingToggle"
                                      Header="Allow FFmpeg command editing before run"
                                      OffContent="Read-only command previews"
                                      OnContent="Editing enabled"
                                      IsOn="False"
                                      Toggled="SettingsToggle_Changed"
                                      AutomationProperties.AutomationId="FfmpegCommandEditingToggle"/>
                        <TextBlock x:Uid="SettingsWindow_Item_078" Text="Commands run without a shell. Input/output placeholders are required; shell metacharacters are rejected."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Expander>

                <!-- Appearance -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_079" Text="Appearance" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <!-- Theme -->
                        <ComboBox x:Uid="SettingsWindow_ThemeComboBox" x:Name="ThemeComboBox"
                                  Header="App theme"
                                  SelectedIndex="1"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ThemeComboBox_SelectionChanged"
                            AutomationProperties.AutomationId="ThemeComboBox">
                            <ComboBoxItem x:Uid="SettingsWindow_Item_082" Content="Light"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_083" Content="Dark"/>
                            <ComboBoxItem x:Uid="SettingsWindow_Item_084" Content="Use system setting"/>
                        </ComboBox>

                        <ComboBox x:Uid="SettingsWindow_LanguageComboBox"
                                  x:Name="LanguageComboBox"
                                  Header="Display language"
                                  Style="{StaticResource PremiumComboBoxStyle}"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="SettingsSelection_Changed"
                                  AutomationProperties.AutomationId="LanguageComboBox">
                            <ComboBoxItem x:Uid="SettingsWindow_LanguageSystem" Content="Use Windows language"/>
                            <ComboBoxItem x:Uid="SettingsWindow_LanguageEnglish" Content="English"/>
                            <ComboBoxItem x:Uid="SettingsWindow_LanguageGerman" Content="German"/>
                            <ComboBoxItem x:Uid="SettingsWindow_LanguageFrench" Content="French"/>
                            <ComboBoxItem x:Uid="SettingsWindow_LanguageSpanish" Content="Spanish"/>
                            <ComboBoxItem x:Uid="SettingsWindow_LanguagePolish" Content="Polish"/>
                            <ComboBoxItem x:Uid="SettingsWindow_LanguageChinese" Content="Simplified Chinese"/>
                        </ComboBox>
                        <TextBlock x:Uid="SettingsWindow_LanguageRestartNote"
                                   Text="Language changes apply after restarting the app."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>

                        <!-- Accent Color -->
                        <StackPanel>
                            <TextBlock x:Uid="SettingsWindow_Item_085" Text="Accent color" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="SettingsWindow_AccentGreenButton" x:Name="AccentGreenButton" 
                                        Width="40" Height="40" 
                                        Background="#22c55e"
                                        AutomationProperties.Name="Green accent"
                                        CornerRadius="10"
                                        Click="AccentColor_Click" Tag="#22c55e"
                                    AutomationProperties.AutomationId="AccentGreenButton"/>
                                <Button x:Uid="SettingsWindow_AccentBlueButton" x:Name="AccentBlueButton" 
                                        Width="40" Height="40" 
                                        Background="#60a5fa"
                                        AutomationProperties.Name="Blue accent"
                                        CornerRadius="10"
                                        Click="AccentColor_Click" Tag="#60a5fa"
                                    AutomationProperties.AutomationId="AccentBlueButton"/>
                                <Button x:Uid="SettingsWindow_AccentPurpleButton" x:Name="AccentPurpleButton" 
                                        Width="40" Height="40" 
                                        Background="#a78bfa"
                                        AutomationProperties.Name="Purple accent"
                                        CornerRadius="10"
                                        Click="AccentColor_Click" Tag="#a78bfa"
                                    AutomationProperties.AutomationId="AccentPurpleButton"/>
                                <Button x:Uid="SettingsWindow_AccentOrangeButton" x:Name="AccentOrangeButton" 
                                        Width="40" Height="40" 
                                        Background="#fb923c"
                                        AutomationProperties.Name="Orange accent"
                                        CornerRadius="10"
                                        Click="AccentColor_Click" Tag="#fb923c"
                                    AutomationProperties.AutomationId="AccentOrangeButton"/>
                                <Button x:Uid="SettingsWindow_AccentRedButton" x:Name="AccentRedButton" 
                                        Width="40" Height="40" 
                                        Background="#f87171"
                                        AutomationProperties.Name="Red accent"
                                        CornerRadius="10"
                                        Click="AccentColor_Click" Tag="#f87171"
                                    AutomationProperties.AutomationId="AccentRedButton"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Minimize to Tray -->
                        <ToggleSwitch x:Uid="SettingsWindow_MinimizeToTrayToggle" x:Name="MinimizeToTrayToggle"
                                      Header="Minimize to system tray"
                                      OffContent="Close to taskbar"
                                      OnContent="Minimize to tray"
                                      Toggled="SettingsToggle_Changed"
                            AutomationProperties.AutomationId="MinimizeToTrayToggle"/>

                        <!-- Start Minimized -->
                        <ToggleSwitch x:Uid="SettingsWindow_StartMinimizedToggle" x:Name="StartMinimizedToggle"
                                      Header="Start minimized"
                                      OffContent="Show window on startup"
                                      OnContent="Start in background"
                                      Toggled="SettingsToggle_Changed"
                            AutomationProperties.AutomationId="StartMinimizedToggle"/>
                    </StackPanel>
                </Expander>

                <!-- About -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Uid="SettingsWindow_Item_093" Text="About" Style="{StaticResource LabelTextStyle}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SettingsWindow_Item_095" Text="UniversalConverter X" Style="{StaticResource SubtitleTextStyle}"/>
                            <TextBlock x:Uid="SettingsWindow_VersionText" x:Name="VersionText" 
                                       Text="Version 2.34.0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock x:Uid="SettingsWindow_Item_097" Text="Local conversion with optional Explorer integration."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton x:Uid="SettingsWindow_SettingsWindowHyperlinkButton01" Content="GitHub" NavigateUri="https://github.com/SysAdminDoc/UniversalConverterX"
                                AutomationProperties.AutomationId="SettingsWindowHyperlinkButton01"/>
                            <HyperlinkButton x:Uid="SettingsWindow_SettingsWindowHyperlinkButton02" Content="Documentation" NavigateUri="https://github.com/SysAdminDoc/UniversalConverterX#readme"
                                AutomationProperties.AutomationId="SettingsWindowHyperlinkButton02"/>
                            <HyperlinkButton x:Uid="SettingsWindow_SettingsWindowHyperlinkButton03" Content="Report Issue" NavigateUri="https://github.com/SysAdminDoc/UniversalConverterX/issues/new"
                                AutomationProperties.AutomationId="SettingsWindowHyperlinkButton03"/>
                        </StackPanel>

                        <InfoBar x:Uid="SettingsWindow_UpdateStatusInfoBar" x:Name="UpdateStatusInfoBar"
                                 IsOpen="False"
                                 IsClosable="True"
                                 Severity="Informational"
                                 Title="Update status"
                                 Message=""
                                 AutomationProperties.AutomationId="Settings_UpdateStatusInfoBar"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="SettingsWindow_CheckUpdatesButton" x:Name="CheckUpdatesButton"
                                    Content="Check for updates"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CheckUpdates_Click"
                                    AutomationProperties.AutomationId="CheckUpdatesButton"/>
                            <Button x:Uid="SettingsWindow_OpenReleaseButton" x:Name="OpenReleaseButton"
                                    Content="Open release"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenRelease_Click"
                                    AutomationProperties.AutomationId="OpenReleaseButton"/>
                        </StackPanel>

                        <!-- Credits -->
                        <TextBlock x:Uid="SettingsWindow_Item_104" Text="Local engines:" Margin="0,16,0,0"/>
                        <TextBlock x:Uid="SettingsWindow_Item_105" Text="• FFmpeg - Video/Audio processing (LGPL/GPL)&#x0a;• ImageMagick - Image processing (Apache 2.0)&#x0a;• Pandoc - Document conversion (GPL)&#x0a;• LibreOffice - Office documents (MPL)&#x0a;• Ghostscript - PDF processing (AGPL)&#x0a;• Inkscape - Vector graphics (GPL)&#x0a;• Calibre - Ebook conversion (GPL)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                </Expander>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Uid="SettingsWindow_ResetButton" x:Name="ResetButton"
                            Content="Reset defaults"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ResetSettings_Click"
                        AutomationProperties.AutomationId="ResetButton"/>
                    <TextBlock x:Uid="SettingsWindow_UnsavedStatusText" x:Name="UnsavedStatusText"
                               Text="No unsaved changes"
                               Style="{StaticResource MutedTextStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="SettingsWindow_CancelButton" x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"
                        AutomationProperties.AutomationId="CancelButton"/>
                    <Button x:Uid="SettingsWindow_SaveButton" x:Name="SaveButton"
                            Content="Save"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="Save_Click"
                        AutomationProperties.AutomationId="SaveButton"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
