<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UniversalConverterX.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Solid theme fallback remains visible when compositor materials are unavailable. -->
        <Border Width="216"
                HorizontalAlignment="Left"
                Background="{StaticResource NavigationSurfaceBrush}"/>
        <controls:SystemBackdropElement x:Name="NavigationBackdropHost"
                                        Width="216"
                                        HorizontalAlignment="Left"
                                        Opacity="0.28"
                                        IsHitTestVisible="False"/>
        <Border Width="1"
                Margin="215,0,0,0"
                HorizontalAlignment="Left"
                Background="{StaticResource DividerBrush}"
                IsHitTestVisible="False"/>
        <NavigationView x:Name="MainNav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="216"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="MainNav_SelectionChanged"
                        Background="Transparent">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"
                                 Color="{ThemeResource BrandAccentPrimary}"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"
                                 Color="{ThemeResource BrandSurfaceLight}"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver"
                                 Color="{ThemeResource BrandSurfaceRaised}"/>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,10,6,12">
                    <Image Width="30" Height="30"
                           Source="ms-appx:///Assets/AppLogo.png"
                           Stretch="Uniform"/>
                    <TextBlock x:Uid="MainWindow_Item_002"
                               Text="UniversalConverter X"
                               Style="{StaticResource LabelTextStyle}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Uid="MainWindow_NavSearchBox" x:Name="NavSearchBox"
                                Visibility="Collapsed"
                                PlaceholderText="Search tools"
                                QueryIcon="Find"
                                TextChanged="NavSearchBox_TextChanged"
                                SuggestionChosen="NavSearchBox_SuggestionChosen"
                                QuerySubmitted="NavSearchBox_QuerySubmitted"
                    AutomationProperties.AutomationId="NavSearchBox">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainWindow_HomeItem"
                                    Tag="home"
                                    Content="Home"
                                    AutomationProperties.AutomationId="MainWindow_Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_Item_006" Tag="converter" Content="Converter">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_Item_010" Tag="downloader" Content="Downloader">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_Item_008" Tag="compressor" Content="Compressor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_Item_009" Tag="editor" Content="Editor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_Item_013" Tag="universal-convert" Content="Universal Convert">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED0C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_Item_001_3" Tag="dvd-rip" Content="DVD Rip">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE958;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_Item_012" Tag="toolbox" Content="Toolbox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="MainWindow_AboutItem" Tag="about" Content="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Border Margin="10,6,10,10"
                        Padding="10"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30"
                                Height="30"
                                Background="{StaticResource SurfaceSoftBrush}"
                                CornerRadius="9">
                            <FontIcon Glyph="&#xEA18;"
                                      FontSize="14"
                                      Foreground="{StaticResource AccentGreenBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock x:Uid="MainWindow_LocalProcessingText"
                                       Text="Local processing"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Uid="MainWindow_NoTelemetryText"
                                       Text="No telemetry"
                                       Style="{StaticResource SubtleTextStyle}"
                                       Foreground="{StaticResource AccentGreenBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Background="{StaticResource BackgroundBrush}"/>
        </NavigationView>
    </Grid>
</Window>
