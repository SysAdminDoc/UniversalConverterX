<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="UniversalConverterX.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ════════════════════════════════════════════════════════════════
                 PALETTE
                 Default = Dark (existing UCX identity).
                 Light   = Catppuccin Latte-inspired companion (#54).
                 ThemeResource refs in the SolidColorBrush definitions below mean
                 every consumer page that uses `{StaticResource SurfaceBrush}`
                 etc. picks up the theme switch automatically — no per-page churn.
                 ════════════════════════════════════════════════════════════════ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Surfaces -->
                    <Color x:Key="BrandBackground">#0f1117</Color>
                    <Color x:Key="BrandSurface">#1c1f2a</Color>
                    <Color x:Key="BrandSurfaceMuted">#15181f</Color>
                    <Color x:Key="BrandSurfaceLight">#1f2338</Color>
                    <Color x:Key="BrandSurfaceSoft">#162a20</Color>
                    <Color x:Key="BrandSurfaceWarm">#1e160a</Color>
                    <Color x:Key="BrandSurfaceDanger">#200d0d</Color>
                    <Color x:Key="BrandSurfaceInfo">#0c1629</Color>
                    <!-- Borders -->
                    <Color x:Key="BrandBorder">#252a38</Color>
                    <Color x:Key="BrandBorderStrong">#333a52</Color>
                    <Color x:Key="BrandDivider">#1a1e2b</Color>
                    <!-- Accents -->
                    <Color x:Key="BrandAccentPrimary">#5b8af7</Color>
                    <Color x:Key="BrandAccentPrimaryHover">#7aa3f9</Color>
                    <Color x:Key="BrandAccentPrimaryPressed">#4070e8</Color>
                    <Color x:Key="BrandAccentBlue">#60a5fa</Color>
                    <Color x:Key="BrandAccentCyan">#22d3ee</Color>
                    <Color x:Key="BrandAccentGreen">#34d399</Color>
                    <Color x:Key="BrandAccentOrange">#fb923c</Color>
                    <Color x:Key="BrandAccentYellow">#fbbf24</Color>
                    <Color x:Key="BrandAccentRed">#f87171</Color>
                    <!-- Text -->
                    <Color x:Key="BrandTextPrimary">#e8ecf3</Color>
                    <Color x:Key="BrandTextSecondary">#94a3b8</Color>
                    <Color x:Key="BrandTextMuted">#6d7d96</Color>
                    <Color x:Key="BrandTextSubtle">#4a5568</Color>
                    <Color x:Key="BrandTextInverse">#0f172a</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Surfaces — Catppuccin Latte mantle / base / surfaces -->
                    <Color x:Key="BrandBackground">#eff1f5</Color>
                    <Color x:Key="BrandSurface">#ffffff</Color>
                    <Color x:Key="BrandSurfaceMuted">#e6e9ef</Color>
                    <Color x:Key="BrandSurfaceLight">#dce0e8</Color>
                    <Color x:Key="BrandSurfaceSoft">#dceee0</Color>
                    <Color x:Key="BrandSurfaceWarm">#f7e8d6</Color>
                    <Color x:Key="BrandSurfaceDanger">#fadcdc</Color>
                    <Color x:Key="BrandSurfaceInfo">#d6e4ff</Color>
                    <!-- Borders -->
                    <Color x:Key="BrandBorder">#bcc0cc</Color>
                    <Color x:Key="BrandBorderStrong">#9ca0b0</Color>
                    <Color x:Key="BrandDivider">#ccd0da</Color>
                    <!-- Accents — Catppuccin Latte tints -->
                    <Color x:Key="BrandAccentPrimary">#1e66f5</Color>
                    <Color x:Key="BrandAccentPrimaryHover">#3a7af7</Color>
                    <Color x:Key="BrandAccentPrimaryPressed">#1850c4</Color>
                    <Color x:Key="BrandAccentBlue">#1e66f5</Color>
                    <Color x:Key="BrandAccentCyan">#04a5e5</Color>
                    <Color x:Key="BrandAccentGreen">#40a02b</Color>
                    <Color x:Key="BrandAccentOrange">#fe640b</Color>
                    <Color x:Key="BrandAccentYellow">#df8e1d</Color>
                    <Color x:Key="BrandAccentRed">#d20f39</Color>
                    <!-- Text — dark on light -->
                    <Color x:Key="BrandTextPrimary">#4c4f69</Color>
                    <Color x:Key="BrandTextSecondary">#5c5f77</Color>
                    <Color x:Key="BrandTextMuted">#6c6f85</Color>
                    <Color x:Key="BrandTextSubtle">#8c8fa1</Color>
                    <Color x:Key="BrandTextInverse">#eff1f5</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ════════════════════════════════════════════════════════════════
                 BRUSHES
                 ════════════════════════════════════════════════════════════════ -->

            <SolidColorBrush x:Key="BackgroundBrush" Color="{ThemeResource BrandBackground}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource BrandSurface}"/>
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{ThemeResource BrandSurfaceMuted}"/>
            <SolidColorBrush x:Key="SurfaceLightBrush" Color="{ThemeResource BrandSurfaceLight}"/>
            <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{ThemeResource BrandSurfaceSoft}"/>
            <SolidColorBrush x:Key="SurfaceWarmBrush" Color="{ThemeResource BrandSurfaceWarm}"/>
            <SolidColorBrush x:Key="SurfaceDangerBrush" Color="{ThemeResource BrandSurfaceDanger}"/>
            <SolidColorBrush x:Key="SurfaceInfoBrush" Color="{ThemeResource BrandSurfaceInfo}"/>

            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BrandBorder}"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{ThemeResource BrandBorderStrong}"/>
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource BrandDivider}"/>

            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{ThemeResource BrandAccentPrimary}"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{ThemeResource BrandAccentBlue}"/>
            <SolidColorBrush x:Key="AccentCyanBrush" Color="{ThemeResource BrandAccentCyan}"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{ThemeResource BrandAccentGreen}"/>
            <SolidColorBrush x:Key="AccentOrangeBrush" Color="{ThemeResource BrandAccentOrange}"/>
            <SolidColorBrush x:Key="AccentYellowBrush" Color="{ThemeResource BrandAccentYellow}"/>
            <SolidColorBrush x:Key="AccentRedBrush" Color="{ThemeResource BrandAccentRed}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource BrandTextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource BrandTextSecondary}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource BrandTextMuted}"/>
            <SolidColorBrush x:Key="TextSubtleBrush" Color="{ThemeResource BrandTextSubtle}"/>
            <SolidColorBrush x:Key="TextInverseBrush" Color="{ThemeResource BrandTextInverse}"/>

            <!-- Overlay (modal scrim) -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#b2000000"/>

            <!-- Accent hover / pressed variants as brushes -->
            <SolidColorBrush x:Key="AccentPrimaryHoverBrush"   Color="{ThemeResource BrandAccentPrimaryHover}"/>
            <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{ThemeResource BrandAccentPrimaryPressed}"/>

            <!-- ════════════════════════════════════════════════════════════════
                 GRADIENTS (hero / shell accents)
                 ════════════════════════════════════════════════════════════════ -->

            <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2040" Offset="0"/>
                <GradientStop Color="#0f1520" Offset="0.45"/>
                <GradientStop Color="#0f2018" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AiGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0c1a30" Offset="0"/>
                <GradientStop Color="#101728" Offset="0.55"/>
                <GradientStop Color="#131922" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ShellGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1e2235" Offset="0"/>
                <GradientStop Color="#161b2e" Offset="0.56"/>
                <GradientStop Color="#14201a" Offset="1"/>
            </LinearGradientBrush>

            <!-- ════════════════════════════════════════════════════════════════
                 TYPOGRAPHY
                 Display 32 / Title 24 / Section 18 / Panel 15 /
                 Subtitle 14 / Body 14 / Muted 12 / Subtle 11 / Eyebrow 11 (caps)
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="40"/>
            </Style>

            <!-- HeroTextStyle: hero-section headlines (slightly larger than Display) -->
            <Style x:Key="HeroTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="42"/>
            </Style>

            <Style x:Key="TitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="30"/>
            </Style>

            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="24"/>
            </Style>

            <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="LineHeight" Value="22"/>
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="LineHeight" Value="18"/>
            </Style>

            <!-- LabelTextStyle: compact section labels (settings expanders, tile titles) -->
            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}"/>
                <Setter Property="LineHeight" Value="16"/>
            </Style>

            <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="80"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            </Style>

            <Style x:Key="PillTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="20"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>

            <!-- CodeTextStyle: monospaced output, log panels -->
            <Style x:Key="CodeTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="LineHeight" Value="17"/>
            </Style>

            <Style x:Key="MetricNumberTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="LineHeight" Value="30"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="40"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            </Style>

            <!-- ════════════════════════════════════════════════════════════════
                 SURFACES
                 - CardStyle: standard panel
                 - SubtleCardStyle: low-contrast nested card on muted background
                 - SectionDividerStyle: 1px hairline rule between groups
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
            </Style>

            <Style x:Key="SubtleCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
            </Style>

            <!-- ════════════════════════════════════════════════════════════════
                 BUTTONS
                 WinUI 3's DefaultButtonStyle handles hover/pressed/focus visuals
                 via subtle overlay layers on top of the explicit Background brush
                 we set here, so all variants get correct interactive feedback
                 without needing a custom ControlTemplate.
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Padding" Value="20,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Padding" Value="20,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- Ghost: text-only inline action. Used when a secondary action
                 should not compete visually with primary actions next to it
                 (e.g., "Clear", "Cancel" in a row that already has "Convert"). -->
            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- Danger: destructive actions (Stop, Delete, Cancel-job). -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceDangerBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                <Setter Property="BorderBrush" Value="#7f1d1d"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Padding" Value="20,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- IconButton: 32×32 circular icon-only button (close, remove, options) -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- ════════════════════════════════════════════════════════════════
                 INPUTS
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="PremiumTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style x:Key="PremiumComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
