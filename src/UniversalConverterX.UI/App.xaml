<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="UniversalConverterX.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ════════════════════════════════════════════════════════════════
                 PALETTE
                 Default = deep-ink media workbench.
                 Light   = low-glare companion for daylight use.
                 ThemeResource refs in the SolidColorBrush definitions below mean
                 every consumer page that uses `{StaticResource SurfaceBrush}`
                 etc. picks up the theme switch automatically — no per-page churn.
                 ════════════════════════════════════════════════════════════════ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Surfaces -->
                    <Color x:Key="BrandBackground">#080e16</Color>
                    <Color x:Key="BrandNavigation">#0b121c</Color>
                    <Color x:Key="BrandSurface">#111a26</Color>
                    <Color x:Key="BrandSurfaceRaised">#152132</Color>
                    <Color x:Key="BrandSurfaceMuted">#0d1520</Color>
                    <Color x:Key="BrandSurfaceLight">#182536</Color>
                    <Color x:Key="BrandSurfaceSoft">#102a25</Color>
                    <Color x:Key="BrandSurfaceWarm">#281c10</Color>
                    <Color x:Key="BrandSurfaceDanger">#2a1518</Color>
                    <Color x:Key="BrandSurfaceInfo">#0d1d34</Color>
                    <Color x:Key="BrandAccentPrimarySoft">#132c52</Color>
                    <Color x:Key="BrandHeroStart">#121f30</Color>
                    <Color x:Key="BrandHeroEnd">#0b1623</Color>
                    <!-- Borders -->
                    <Color x:Key="BrandBorder">#253547</Color>
                    <Color x:Key="BrandBorderStrong">#385069</Color>
                    <Color x:Key="BrandDivider">#1c2938</Color>
                    <!-- Accents -->
                    <Color x:Key="BrandAccentPrimary">#3e7bfa</Color>
                    <Color x:Key="BrandAccentPrimaryHover">#5a91ff</Color>
                    <Color x:Key="BrandAccentPrimaryPressed">#2f64d8</Color>
                    <Color x:Key="BrandAccentBlue">#5a9bff</Color>
                    <Color x:Key="BrandAccentCyan">#2ed3e8</Color>
                    <Color x:Key="BrandAccentGreen">#2dd4a7</Color>
                    <Color x:Key="BrandAccentOrange">#ff9b50</Color>
                    <Color x:Key="BrandAccentYellow">#f4c95d</Color>
                    <Color x:Key="BrandAccentRed">#ff6b72</Color>
                    <!-- Text -->
                    <Color x:Key="BrandTextPrimary">#f3f7fc</Color>
                    <Color x:Key="BrandTextSecondary">#afbbcb</Color>
                    <Color x:Key="BrandTextMuted">#8290a3</Color>
                    <Color x:Key="BrandTextSubtle">#637187</Color>
                    <Color x:Key="BrandTextInverse">#07111f</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Surfaces -->
                    <Color x:Key="BrandBackground">#f2f5f9</Color>
                    <Color x:Key="BrandNavigation">#e9eef5</Color>
                    <Color x:Key="BrandSurface">#ffffff</Color>
                    <Color x:Key="BrandSurfaceRaised">#ffffff</Color>
                    <Color x:Key="BrandSurfaceMuted">#e9eef5</Color>
                    <Color x:Key="BrandSurfaceLight">#dfe7f1</Color>
                    <Color x:Key="BrandSurfaceSoft">#ddf1e9</Color>
                    <Color x:Key="BrandSurfaceWarm">#faeadc</Color>
                    <Color x:Key="BrandSurfaceDanger">#fde1e3</Color>
                    <Color x:Key="BrandSurfaceInfo">#dce9ff</Color>
                    <Color x:Key="BrandAccentPrimarySoft">#dbe7ff</Color>
                    <Color x:Key="BrandHeroStart">#f8fbff</Color>
                    <Color x:Key="BrandHeroEnd">#eaf1fb</Color>
                    <!-- Borders -->
                    <Color x:Key="BrandBorder">#c6d0dd</Color>
                    <Color x:Key="BrandBorderStrong">#aebdcc</Color>
                    <Color x:Key="BrandDivider">#d5dde7</Color>
                    <!-- Accents -->
                    <Color x:Key="BrandAccentPrimary">#2764de</Color>
                    <Color x:Key="BrandAccentPrimaryHover">#3c76e7</Color>
                    <Color x:Key="BrandAccentPrimaryPressed">#1f50b7</Color>
                    <Color x:Key="BrandAccentBlue">#2764de</Color>
                    <Color x:Key="BrandAccentCyan">#087f9c</Color>
                    <Color x:Key="BrandAccentGreen">#16845f</Color>
                    <Color x:Key="BrandAccentOrange">#c75f11</Color>
                    <Color x:Key="BrandAccentYellow">#a96800</Color>
                    <Color x:Key="BrandAccentRed">#c43b47</Color>
                    <!-- Text -->
                    <Color x:Key="BrandTextPrimary">#172335</Color>
                    <Color x:Key="BrandTextSecondary">#40516a</Color>
                    <Color x:Key="BrandTextMuted">#62738a</Color>
                    <Color x:Key="BrandTextSubtle">#8693a5</Color>
                    <Color x:Key="BrandTextInverse">#f7faff</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ════════════════════════════════════════════════════════════════
                 BRUSHES
                 ════════════════════════════════════════════════════════════════ -->

            <SolidColorBrush x:Key="BackgroundBrush" Color="{ThemeResource BrandBackground}"/>
            <SolidColorBrush x:Key="NavigationSurfaceBrush" Color="{ThemeResource BrandNavigation}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource BrandSurface}"/>
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource BrandSurfaceRaised}"/>
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{ThemeResource BrandSurfaceMuted}"/>
            <SolidColorBrush x:Key="SurfaceLightBrush" Color="{ThemeResource BrandSurfaceLight}"/>
            <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{ThemeResource BrandSurfaceSoft}"/>
            <SolidColorBrush x:Key="SurfaceWarmBrush" Color="{ThemeResource BrandSurfaceWarm}"/>
            <SolidColorBrush x:Key="SurfaceDangerBrush" Color="{ThemeResource BrandSurfaceDanger}"/>
            <SolidColorBrush x:Key="SurfaceInfoBrush" Color="{ThemeResource BrandSurfaceInfo}"/>
            <SolidColorBrush x:Key="AccentPrimarySoftBrush" Color="{ThemeResource BrandAccentPrimarySoft}"/>

            <LinearGradientBrush x:Key="HeroSurfaceBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Offset="0" Color="{ThemeResource BrandHeroStart}"/>
                <GradientStop Offset="1" Color="{ThemeResource BrandHeroEnd}"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BrandBorder}"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{ThemeResource BrandBorderStrong}"/>
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource BrandDivider}"/>

            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{ThemeResource BrandAccentPrimary}"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{ThemeResource BrandAccentBlue}"/>
            <SolidColorBrush x:Key="AccentCyanBrush" Color="{ThemeResource BrandAccentCyan}"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{ThemeResource BrandAccentGreen}"/>
            <SolidColorBrush x:Key="AccentOrangeBrush" Color="{ThemeResource BrandAccentOrange}"/>
            <SolidColorBrush x:Key="AccentYellowBrush" Color="{ThemeResource BrandAccentYellow}"/>
            <SolidColorBrush x:Key="AccentRedBrush" Color="{ThemeResource BrandAccentRed}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource BrandTextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource BrandTextSecondary}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource BrandTextMuted}"/>
            <SolidColorBrush x:Key="TextSubtleBrush" Color="{ThemeResource BrandTextSubtle}"/>
            <SolidColorBrush x:Key="TextInverseBrush" Color="{ThemeResource BrandTextInverse}"/>

            <!-- Overlay (modal scrim) -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#b2000000"/>

            <!-- Accent hover / pressed variants as brushes -->
            <SolidColorBrush x:Key="AccentPrimaryHoverBrush"   Color="{ThemeResource BrandAccentPrimaryHover}"/>
            <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{ThemeResource BrandAccentPrimaryPressed}"/>

            <!-- ════════════════════════════════════════════════════════════════
                 TYPOGRAPHY
                 Page 28 / Title 24 / Section 18 / Panel 16 /
                 Body 15 / Subtitle 14 / Muted 13 / Subtle 12
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="36"/>
            </Style>

            <!-- HeroTextStyle: hero-section headlines (slightly larger than Display) -->
            <Style x:Key="HeroTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="36"/>
            </Style>

            <Style x:Key="TitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="30"/>
            </Style>

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="34"/>
            </Style>

            <Style x:Key="PageDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="LineHeight" Value="20"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="MaxLines" Value="2"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="24"/>
            </Style>

            <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="LineHeight" Value="18"/>
            </Style>

            <!-- LabelTextStyle: compact section labels (settings expanders, tile titles) -->
            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="20"/>
            </Style>

            <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}"/>
                <Setter Property="LineHeight" Value="16"/>
            </Style>

            <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="40"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            </Style>

            <!-- CodeTextStyle: monospaced output, log panels -->
            <Style x:Key="CodeTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="LineHeight" Value="17"/>
            </Style>

            <Style x:Key="MetricNumberTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="LineHeight" Value="30"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CharacterSpacing" Value="40"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            </Style>

            <!-- ════════════════════════════════════════════════════════════════
                 SURFACES
                 - CardStyle: standard panel
                 - SubtleCardStyle: low-contrast nested card on muted background
                 - SectionDividerStyle: 1px hairline rule between groups
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="SubtleCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14"/>
            </Style>

            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
            </Style>

            <Style x:Key="InfoBannerStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceInfoBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>

            <Style x:Key="QuietSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10"/>
            </Style>

            <Style x:Key="MetricTileStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>

            <Style x:Key="PageLayoutStyle" TargetType="Grid">
                <Setter Property="Padding" Value="32,22,32,28"/>
                <Setter Property="RowSpacing" Value="16"/>
            </Style>

            <Style x:Key="PageStackLayoutStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="32,22,32,28"/>
                <Setter Property="Spacing" Value="16"/>
            </Style>

            <!-- ════════════════════════════════════════════════════════════════
                 BUTTONS
                 WinUI 3's DefaultButtonStyle handles hover/pressed/focus visuals
                 via subtle overlay layers on top of the explicit Background brush
                 we set here, so all variants get correct interactive feedback
                 without needing a custom ControlTemplate.
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- Ghost: text-only inline action. Used when a secondary action
                 should not compete visually with primary actions next to it
                 (e.g., "Clear", "Cancel" in a row that already has "Convert"). -->
            <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- Danger: destructive actions (Stop, Delete, Cancel-job). -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SurfaceDangerBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                <Setter Property="BorderBrush" Value="#7f1d1d"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- IconButton: 32×32 circular icon-only button (close, remove, options) -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="MinWidth" Value="32"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
            </Style>

            <!-- ════════════════════════════════════════════════════════════════
                 INPUTS
                 ════════════════════════════════════════════════════════════════ -->

            <Style x:Key="PremiumTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Key="PremiumComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource PremiumTextBoxStyle}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBoxStyle}"/>
            <Style TargetType="AutoSuggestBox">
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
