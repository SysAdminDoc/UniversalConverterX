<?xml version="1.0" encoding="UTF-8"?>

<!-- WiX 4/5 installer for UniversalConverter X.

     Build:
       wix build installer/wix/Product.wxs ^
         -d PublishDir=publish/win-x64/ ^
         -d Version=2.5.0.0 ^
         -o installer/output/UniversalConverterX_2.5.0.0.msi

     Notes:
       * UpgradeCode is stable across versions; ProductCode rotates per build (auto via "*").
       * Shell-extension CLSID matches Guids.ExplorerCommand
         (7E8B9A1C-2D3E-4F5A-B6C7-D8E9F0A1B2C3) so the COM-host DLL the
         build produces lines up with the registry registration this MSI
         performs in InstallExecuteSequence.
       * Presets ship under <INSTALLFOLDER>\presets and the shell extension
         resolves them via $env:LOCALAPPDATA -> SOFTWARE\UniversalConverterX
         InstallPath -> assembly-adjacent fallback.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="UniversalConverter X"
           Manufacturer="UniversalConverterX"
           Version="$(var.Version)"
           UpgradeCode="A37E9F70-2B1E-4D58-9C39-2B61CDEF1234"
           Scope="perMachine"
           Language="1033"
           Codepage="1252">

    <SummaryInformation Description="UniversalConverter X -- universal file conversion + right-click context menu"
                        Manufacturer="UniversalConverterX"
                        Keywords="converter,ffmpeg,imagemagick,libreoffice,calibre,tesseract,7zip,pdf,subtitles,fonts,ocr,context-menu" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowSameVersionUpgrades="yes" />

    <!-- Win10 1809 minimum (matches WindowsAppSDK 1.7 floor). -->
    <Launch Condition="VersionNT &gt;= 603" Message="UniversalConverter X requires Windows 10 (1809) or later." />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/SysAdminDoc/UniversalConverterX" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/SysAdminDoc/UniversalConverterX" />

    <!-- ── Features ──────────────────────────────────────────────────── -->
    <Feature Id="MainApplication" Title="UniversalConverter X" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="PresetFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="RegistryEntries" />
    </Feature>

    <Feature Id="ShellExtensionFeature"
             Title="Right-click context menu"
             Description="Adds 'Convert with UCX' to Windows Explorer's right-click menu, with a submenu populated from the preset XML files."
             Level="1">
      <ComponentGroupRef Id="ShellExtension" />
      <ComponentGroupRef Id="ContextMenuRegistration" />
    </Feature>

    <Feature Id="CLITool"
             Title="ucx CLI"
             Description="Adds the install dir to PATH so 'ucx' is callable from any shell."
             Level="1">
      <ComponentRef Id="PathEnvironment" />
    </Feature>

  </Package>

  <!-- ── Directory layout ─────────────────────────────────────────────── -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="UniversalConverterX">
        <Directory Id="PresetsFolder" Name="presets" />
        <Directory Id="ToolsFolder"   Name="tools" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="UniversalConverter X" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- ── Application files ─────────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">

      <Component Id="MainExecutable" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF1001">
        <File Id="UIExe" Source="$(var.PublishDir)UniversalConverterX.UI.exe" KeyPath="yes" />
      </Component>

      <Component Id="ConsoleExecutable" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF1002">
        <File Id="ConsoleExe" Source="$(var.PublishDir)ucx.exe" KeyPath="yes" />
      </Component>

      <Component Id="CoreLibrary" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF1003">
        <File Id="CoreDll" Source="$(var.PublishDir)UniversalConverterX.Core.dll" KeyPath="yes" />
      </Component>

      <Component Id="RuntimeConfig" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF1004">
        <File Id="UIRuntimeConfig" Source="$(var.PublishDir)UniversalConverterX.UI.runtimeconfig.json" KeyPath="yes" />
        <File Id="ConsoleRuntimeConfig" Source="$(var.PublishDir)ucx.runtimeconfig.json" />
        <File Id="UIDepsJson"      Source="$(var.PublishDir)UniversalConverterX.UI.deps.json" />
        <File Id="ConsoleDepsJson" Source="$(var.PublishDir)ucx.deps.json" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Preset XML files ─────────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="PresetFiles" Directory="PresetsFolder">

      <Component Id="PresetReadme" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2000">
        <File Id="PresetReadmeMd" Source="$(var.PublishDir)presets\README.md" KeyPath="yes" />
      </Component>

      <Component Id="PresetMp4Hd" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2001">
        <File Id="P_Mp4Hd" Source="$(var.PublishDir)presets\to-mp4-h264-1080p.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetDiscord" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2002">
        <File Id="P_Discord" Source="$(var.PublishDir)presets\to-discord-9mb.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetVertical" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2003">
        <File Id="P_Vertical" Source="$(var.PublishDir)presets\to-vertical-9-16.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetProRes" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2004">
        <File Id="P_ProRes" Source="$(var.PublishDir)presets\to-prores-422-hq.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetGif" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2005">
        <File Id="P_Gif" Source="$(var.PublishDir)presets\to-gif.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetPng" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2006">
        <File Id="P_Png" Source="$(var.PublishDir)presets\to-png.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetJpeg" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2007">
        <File Id="P_Jpeg" Source="$(var.PublishDir)presets\to-jpeg-90.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetWebp" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2008">
        <File Id="P_Webp" Source="$(var.PublishDir)presets\to-webp-q85.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetMp3" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF2009">
        <File Id="P_Mp3" Source="$(var.PublishDir)presets\to-mp3-192.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetPdf" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF200A">
        <File Id="P_Pdf" Source="$(var.PublishDir)presets\to-pdf.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="Preset7z" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF200B">
        <File Id="P_7z" Source="$(var.PublishDir)presets\to-7z-archive.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetUnpack" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF200C">
        <File Id="P_Unpack" Source="$(var.PublishDir)presets\unpack-archive.preset.xml" KeyPath="yes" />
      </Component>
      <Component Id="PresetSrt" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF200D">
        <File Id="P_Srt" Source="$(var.PublishDir)presets\to-srt.preset.xml" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ── Shell extension binaries ─────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ShellExtension" Directory="INSTALLFOLDER">
      <Component Id="ShellExtensionDll" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF3001">
        <File Id="ShellExtDll"     Source="$(var.PublishDir)UniversalConverterX.ShellExtension.dll" KeyPath="yes" />
        <File Id="ShellExtComHost" Source="$(var.PublishDir)UniversalConverterX.ShellExtension.comhost.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ── Shortcuts ─────────────────────────────────────────────────────── -->
  <Fragment>
    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF4001">
      <Shortcut Id="AppShortcut"
                Name="UniversalConverter X"
                Target="[INSTALLFOLDER]UniversalConverterX.UI.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />
      <RemoveFolder Id="RemoveAppFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\UniversalConverterX" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF4002">
      <Shortcut Id="DeskShortcut"
                Name="UniversalConverter X"
                Target="[INSTALLFOLDER]UniversalConverterX.UI.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />
      <RegistryValue Root="HKCU" Key="Software\UniversalConverterX" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ── Registry: install path hint (read by shell extension + CLI) ──── -->
  <Fragment>
    <Component Id="RegistryEntries" Directory="INSTALLFOLDER" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF5001">
      <RegistryKey Root="HKLM" Key="SOFTWARE\UniversalConverterX">
        <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Name="Version"     Type="string" Value="$(var.Version)" />
        <RegistryValue Name="ToolsPath"   Type="string" Value="[INSTALLFOLDER]tools\" />
        <RegistryValue Name="PresetsPath" Type="string" Value="[INSTALLFOLDER]presets\" />
      </RegistryKey>
    </Component>
  </Fragment>

  <!-- ── PATH ──────────────────────────────────────────────────────────── -->
  <Fragment>
    <Component Id="PathEnvironment" Directory="INSTALLFOLDER" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF6001">
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
    </Component>
  </Fragment>

  <!-- ── Shell extension COM registration ─────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="ContextMenuRegistration" Directory="INSTALLFOLDER">

      <Component Id="ContextMenuCLSID" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF7001">
        <RegistryKey Root="HKCR" Key="CLSID\{7E8B9A1C-2D3E-4F5A-B6C7-D8E9F0A1B2C3}">
          <RegistryValue Type="string" Value="UniversalConverterX Shell Extension" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="CLSID\{7E8B9A1C-2D3E-4F5A-B6C7-D8E9F0A1B2C3}\InprocServer32">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]UniversalConverterX.ShellExtension.comhost.dll" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </Component>

      <Component Id="FileContextMenu" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF7002">
        <RegistryKey Root="HKCR" Key="*\shell\UniversalConverterX">
          <RegistryValue Type="string" Value="Convert with UniversalConverter X" />
          <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]UniversalConverterX.UI.exe,0" />
          <RegistryValue Name="ExplorerCommandHandler" Type="string" Value="{7E8B9A1C-2D3E-4F5A-B6C7-D8E9F0A1B2C3}" />
        </RegistryKey>
      </Component>

      <Component Id="DirectoryContextMenu" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF7003">
        <RegistryKey Root="HKCR" Key="Directory\shell\UniversalConverterX">
          <RegistryValue Type="string" Value="Convert with UniversalConverter X" />
          <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]UniversalConverterX.UI.exe,0" />
          <RegistryValue Name="ExplorerCommandHandler" Type="string" Value="{7E8B9A1C-2D3E-4F5A-B6C7-D8E9F0A1B2C3}" />
        </RegistryKey>
      </Component>

      <Component Id="ApprovedExtension" Guid="A37E9F70-2B1E-4D58-9C39-2B61CDEF7004">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved">
          <RegistryValue Name="{7E8B9A1C-2D3E-4F5A-B6C7-D8E9F0A1B2C3}" Type="string" Value="UniversalConverterX Shell Extension" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Icon Id="AppIcon.exe" SourceFile="$(var.PublishDir)UniversalConverterX.UI.exe" />
  </Fragment>

</Wix>
