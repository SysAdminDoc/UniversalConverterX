<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>JSON to YAML</Name>
    <Folder>Data</Folder>
    <InputTypes>
        <Extension>json</Extension>
        <Extension>ndjson</Extension>
        <Extension>jsonl</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>yml</OutputExtension>
    <Engine>datakit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>yaml</Arg>
    </Args>
</Preset>
