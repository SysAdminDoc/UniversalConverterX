<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>MIDI to WAV (FluidSynth)</Name>
    <Folder>Audio</Folder>
    <InputTypes>
        <Extension>mid</Extension>
        <Extension>midi</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>wav</OutputExtension>
    <Engine>midisynth</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>render</Arg>
        <Arg>--format</Arg>
        <Arg>wav</Arg>
    </Args>
</Preset>
