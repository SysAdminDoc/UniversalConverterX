<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>VCF -> BCF (binary)</Name>
    <Folder>Bioinformatics</Folder>
    <InputTypes>
        <Extension>vcf</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>bcf</OutputExtension>
    <Engine>genome</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>vcf-to-bcf</Arg>
    </Args>
</Preset>
