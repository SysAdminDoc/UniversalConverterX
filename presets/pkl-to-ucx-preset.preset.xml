<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Pkl -&gt; Validated UCX Preset</Name>
    <Folder>Automation/Presets</Folder>
    <Description>Compiles one confined offline Pkl module into validated UCX preset XML.</Description>
    <InputTypes>
        <Extension>pkl</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>preset.xml</OutputExtension>
    <Engine>pkl-preset</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>compile</Arg>
    </Args>
</Preset>
