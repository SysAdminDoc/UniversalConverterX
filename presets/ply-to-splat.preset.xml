<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>3DGS .ply -> Gaussian Splatting .splat</Name>
    <Folder>3D/Splat</Folder>
    <InputTypes>
        <Extension>ply</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>splat</OutputExtension>
    <Engine>gsplat</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>ply-to-splat</Arg>
    </Args>
</Preset>
