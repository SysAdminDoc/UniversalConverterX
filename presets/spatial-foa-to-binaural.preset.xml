<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Ambisonics FOA -&gt; Binaural Stereo</Name>
    <Folder>Audio/Spatial</Folder>
    <InputTypes>
        <Extension>wav</Extension>
        <Extension>flac</Extension>
        <Extension>caf</Extension>
        <Extension>m4a</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_binaural</OutputFileNameTemplate>
    <OutputExtension>flac</OutputExtension>
    <Engine>spatialaudio</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--mode</Arg>
        <Arg>foa-to-binaural</Arg>
    </Args>
</Preset>
