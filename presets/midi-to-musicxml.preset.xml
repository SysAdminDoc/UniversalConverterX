<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>MIDI -> MusicXML</Name>
    <Folder>Music</Folder>
    <InputTypes>
        <Extension>mid</Extension>
        <Extension>midi</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>musicxml</OutputExtension>
    <Engine>music</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>musicxml</Arg>
    </Args>
</Preset>
