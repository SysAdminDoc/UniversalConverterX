<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>GraphML -> JSON (Nodes + Edges)</Name>
    <Folder>Documents/Diagrams</Folder>
    <InputTypes>
        <Extension>graphml</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>diagrammore</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>graphml-to-json</Arg>
    </Args>
</Preset>
