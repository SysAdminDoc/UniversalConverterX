<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Audio Tag Read (ID3 / FLAC / Vorbis)</Name>
    <Folder>Audio/Metadata</Folder>
    <InputTypes>
        <Extension>mp3</Extension>
        <Extension>flac</Extension>
        <Extension>ogg</Extension>
        <Extension>m4a</Extension>
        <Extension>opus</Extension>
        <Extension>wav</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}.tags</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>audiotag</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>read</Arg>
    </Args>
</Preset>
