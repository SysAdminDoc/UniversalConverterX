<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>BGP MRT RIB -> CSV</Name>
    <Folder>Network/Routing</Folder>
    <InputTypes>
        <Extension>mrt</Extension>
        <Extension>bz2</Extension>
        <Extension>gz</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>bgpkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>mrt-rib-to-csv</Arg>
    </Args>
</Preset>
