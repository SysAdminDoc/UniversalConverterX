<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Text -&gt; Consented Voice Clone (Chatterbox Turbo, Offline)</Name>
    <Folder>AI/Audio</Folder>
    <InputTypes>
        <Extension>txt</Extension>
        <Extension>md</Extension>
        <Extension>wav</Extension>
        <Extension>flac</Extension>
        <Extension>mp3</Extension>
        <Extension>m4a</Extension>
        <Extension>ogg</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_chatterbox</OutputFileNameTemplate>
    <OutputExtension>wav</OutputExtension>
    <Engine>chatterboxtts</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>speak</Arg>
        <Arg>--accept-voice-cloning</Arg>
    </Args>
</Preset>
