<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Parquet / Feather / Avro / ORC to CSV</Name>
    <Folder>Data</Folder>
    <InputTypes>
        <Extension>parquet</Extension>
        <Extension>pq</Extension>
        <Extension>feather</Extension>
        <Extension>arrow</Extension>
        <Extension>avro</Extension>
        <Extension>orc</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>datasci</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>csv</Arg>
    </Args>
</Preset>
