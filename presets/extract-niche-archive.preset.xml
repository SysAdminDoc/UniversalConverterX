        <Extension>sit</Extension>
        <Extension>sitx</Extension>
        <Extension>lha</Extension>
        <Extension>lzh</Extension>
        <Extension>arj</Extension>
        <Extension>zoo</Extension>
        <Extension>ha</Extension>
