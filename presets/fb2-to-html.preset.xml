<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>FictionBook 2 -> HTML</Name>
    <Folder>Documents/eBooks</Folder>
    <InputTypes>
        <Extension>fb2</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>html</OutputExtension>
    <Engine>ebookmore</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>fb2-to-html</Arg>
    </Args>
</Preset>
