<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>VMDK / VHD / VHDX / VDI to QCOW2</Name>
    <Folder>Disk Images</Folder>
    <InputTypes>
        <Extension>vmdk</Extension>
        <Extension>vhd</Extension>
        <Extension>vhdx</Extension>
        <Extension>vdi</Extension>
        <Extension>raw</Extension>
        <Extension>img</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>qcow2</OutputExtension>
    <Engine>diskimage</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>qcow2</Arg>
        <Arg>--compress</Arg>
    </Args>
</Preset>
