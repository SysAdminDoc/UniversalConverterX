<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>xAPI Statements -> CSV</Name>
    <Folder>Documents/LMS</Folder>
    <InputTypes>
        <Extension>json</Extension>
        <Extension>ndjson</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}.xapi</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>lmskit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>xapi-to-csv</Arg>
    </Args>
</Preset>
