<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>HWP / HWPX (Korean Hangul) -> PDF</Name>
    <Folder>Documents/Asian</Folder>
    <InputTypes>
        <Extension>hwp</Extension>
        <Extension>hwpx</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>pdf</OutputExtension>
    <Engine>hwpkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>pdf</Arg>
    </Args>
</Preset>
