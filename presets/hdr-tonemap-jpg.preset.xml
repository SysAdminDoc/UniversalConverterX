<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>HDR -> tone-mapped JPG (Reinhard)</Name>
    <Folder>Image/HDR</Folder>
    <InputTypes>
        <Extension>hdr</Extension>
        <Extension>exr</Extension>
        <Extension>pfm</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_ldr</OutputFileNameTemplate>
    <OutputExtension>jpg</OutputExtension>
    <Engine>hdrkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>tonemap</Arg>
        <Arg>--operator</Arg>
        <Arg>reinhard</Arg>
        <Arg>--format</Arg>
        <Arg>jpg</Arg>
    </Args>
</Preset>
