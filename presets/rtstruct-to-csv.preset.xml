<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>DICOM RTSTRUCT -> ROI CSV</Name>
    <Folder>Bio/Radiation Therapy</Folder>
    <InputTypes>
        <Extension>dcm</Extension>
        <Extension>rtss</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}.roi</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>dicomrt</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>rtstruct-to-csv</Arg>
    </Args>
</Preset>
