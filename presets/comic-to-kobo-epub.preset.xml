<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Comic -> Kobo EPUB (device profile)</Name>
    <Folder>Comics</Folder>
    <InputTypes>
        <Extension>cbz</Extension>
        <Extension>cbr</Extension>
        <Extension>cbt</Extension>
        <Extension>cb7</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}.kobo</OutputFileNameTemplate>
    <OutputExtension>epub</OutputExtension>
    <Engine>comic</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>to-device</Arg>
        <Arg>--format</Arg>
        <Arg>epub</Arg>
        <Arg>--profile</Arg>
        <Arg>kobo</Arg>
    </Args>
</Preset>
