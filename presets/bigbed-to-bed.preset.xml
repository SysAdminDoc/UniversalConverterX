<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>bigBed -> BED</Name>
    <Folder>Bio/Genomics</Folder>
    <InputTypes>
        <Extension>bb</Extension>
        <Extension>bigbed</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>bed</OutputExtension>
    <Engine>bed</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>bigbed-to-bed</Arg>
    </Args>
</Preset>
