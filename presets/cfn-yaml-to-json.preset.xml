<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>CloudFormation YAML -> JSON</Name>
    <Folder>DevOps/IaC</Folder>
    <InputTypes>
        <Extension>yml</Extension>
        <Extension>yaml</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>iac</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>cfn-yaml-to-json</Arg>
    </Args>
</Preset>
