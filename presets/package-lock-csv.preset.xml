<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>npm package-lock.json -> CSV</Name>
    <Folder>Code/Build</Folder>
    <InputTypes>
        <Extension>json</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}.npm</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>devbuild</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>package-lock-csv</Arg>
    </Args>
</Preset>
