<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>JSON5 (Relaxed JSON) -> JSON</Name>
    <Folder>Data/Niche</Folder>
    <InputTypes>
        <Extension>json5</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>datakitmore</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>json5-to-json</Arg>
    </Args>
</Preset>
