<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>To STL (3D printing)</Name>
    <Folder>3D</Folder>
    <InputTypes>
        <Extension>obj</Extension>
        <Extension>ply</Extension>
        <Extension>glb</Extension>
        <Extension>gltf</Extension>
        <Extension>fbx</Extension>
        <Extension>dae</Extension>
        <Extension>3ds</Extension>
        <Extension>off</Extension>
        <Extension>x3d</Extension>
        <Extension>wrl</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>stl</OutputExtension>
    <Engine>meshconvert</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>stl</Arg>
    </Args>
</Preset>
