<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>OpenPGP binary -> ASCII armor (.asc)</Name>
    <Folder>Security/PGP</Folder>
    <InputTypes>
        <Extension>gpg</Extension>
        <Extension>pgp</Extension>
        <Extension>sig</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>asc</OutputExtension>
    <Engine>gpgkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>armor</Arg>
    </Args>
</Preset>
