<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Anime upscale 4× (still images, Real-ESRGAN ncnn-vulkan)</Name>
    <Folder>AI/Image</Folder>
    <InputTypes>
        <Extension>jpg</Extension>
        <Extension>jpeg</Extension>
        <Extension>png</Extension>
        <Extension>webp</Extension>
        <Extension>tiff</Extension>
        <Extension>tif</Extension>
        <Extension>bmp</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_anime4x</OutputFileNameTemplate>
    <OutputExtension>png</OutputExtension>
    <Engine>anime-upscale</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>image</Arg>
        <Arg>--scale</Arg>
        <Arg>4</Arg>
        <Arg>--model</Arg>
        <Arg>realesrgan-x4plus-anime</Arg>
        <Arg>--format</Arg>
        <Arg>png</Arg>
    </Args>
</Preset>
