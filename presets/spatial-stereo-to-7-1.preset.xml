        <Extension>wav</Extension>
        <Extension>flac</Extension>
        <Extension>mp3</Extension>
        <Extension>m4a</Extension>
        <Extension>opus</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_7_1</OutputFileNameTemplate>
    <OutputExtension>flac</OutputExtension>
    <Engine>spatialaudio</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--mode</Arg>
        <Arg>stereo-to-7.1</Arg>
    </Args>
</Preset>
