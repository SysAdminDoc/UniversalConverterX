<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>DICOM RTDOSE -> NIfTI</Name>
    <Folder>Bio/Radiation Therapy</Folder>
    <InputTypes>
        <Extension>dcm</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>nii.gz</OutputExtension>
    <Engine>dicomrt</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>rtdose-to-nifti</Arg>
    </Args>
</Preset>
