<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Apple plist -> JSON</Name>
    <Folder>Apple</Folder>
    <InputTypes>
        <Extension>plist</Extension>
        <Extension>bplist</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>plistkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--target</Arg>
        <Arg>to-json</Arg>
    </Args>
</Preset>
