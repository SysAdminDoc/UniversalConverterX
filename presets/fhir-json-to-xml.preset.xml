<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>FHIR JSON -> XML</Name>
    <Folder>Healthcare/HL7</Folder>
    <InputTypes>
        <Extension>json</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_fhir</OutputFileNameTemplate>
    <OutputExtension>xml</OutputExtension>
    <Engine>hl7</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>fhir-to-xml</Arg>
    </Args>
</Preset>
