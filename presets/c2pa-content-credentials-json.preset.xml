<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>C2PA Content Credentials - Verified JSON</Name>
    <Folder>Metadata/Authenticity</Folder>
    <Description>Inspect and validate embedded Content Credentials offline; remote manifests and network trust lookups are disabled.</Description>
    <InputTypes>
        <Extension>jpg</Extension>
        <Extension>jpeg</Extension>
        <Extension>png</Extension>
        <Extension>webp</Extension>
        <Extension>avif</Extension>
        <Extension>mp4</Extension>
        <Extension>mov</Extension>
        <Extension>wav</Extension>
        <Extension>mp3</Extension>
        <Extension>pdf</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_content_credentials</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>c2pa</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>inspect</Arg>
        <Arg>--mode</Arg>
        <Arg>manifest</Arg>
    </Args>
</Preset>
