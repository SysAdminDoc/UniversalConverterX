<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>GPS Coordinates: DD / DMS / UTM / MGRS / Geohash / Plus Codes</Name>
    <Folder>Data/Wireless</Folder>
    <InputTypes>
        <Extension>txt</Extension>
        <Extension>csv</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}.coords</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>coordfmt</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
    </Args>
</Preset>
