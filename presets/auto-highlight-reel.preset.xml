<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Auto Highlight Reel (Scene + Motion)</Name>
    <Folder>Video/Editing</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mkv</Extension>
        <Extension>mov</Extension>
        <Extension>m4v</Extension>
        <Extension>avi</Extension>
        <Extension>webm</Extension>
        <Extension>ts</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_highlights</OutputFileNameTemplate>
    <OutputExtension>mp4</OutputExtension>
    <Engine>scenedetect</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>highlights</Arg>
        <Arg>--top-n</Arg>
        <Arg>5</Arg>
        <Arg>--clip-length</Arg>
        <Arg>12</Arg>
        <Arg>--min-gap</Arg>
        <Arg>2</Arg>
    </Args>
</Preset>
