<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>STL / OBJ / PLY -> AMF</Name>
    <Folder>3D/Printing</Folder>
    <InputTypes>
        <Extension>stl</Extension>
        <Extension>obj</Extension>
        <Extension>ply</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>amf</OutputExtension>
    <Engine>cadmore</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>amf</Arg>
    </Args>
</Preset>
