<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Speak text (Kokoro Bella, en-US)</Name>
    <Folder>AI/Audio</Folder>
    <InputTypes>
        <Extension>txt</Extension>
        <Extension>md</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_speech</OutputFileNameTemplate>
    <OutputExtension>wav</OutputExtension>
    <Engine>premiumtts</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>speak</Arg>
        <Arg>--backend</Arg>
        <Arg>kokoro</Arg>
        <Arg>--voice</Arg>
        <Arg>af_bella</Arg>
        <Arg>--lang-code</Arg>
        <Arg>a</Arg>
    </Args>
</Preset>
