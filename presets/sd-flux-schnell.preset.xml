<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>FLUX.1 schnell img2img (SOTA)</Name>
    <Folder>AI/Image</Folder>
    <InputTypes>
        <Extension>jpg</Extension>
        <Extension>jpeg</Extension>
        <Extension>png</Extension>
        <Extension>webp</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_flux</OutputFileNameTemplate>
    <OutputExtension>png</OutputExtension>
    <Engine>sdkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>img2img</Arg>
        <Arg>--model</Arg>
        <Arg>flux-schnell</Arg>
        <Arg>--prompt</Arg>
        <Arg>high quality, detailed, sharp focus</Arg>
        <Arg>--strength</Arg>
        <Arg>0.55</Arg>
    </Args>
</Preset>
