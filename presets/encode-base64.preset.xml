<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Base64 encode (any file)</Name>
    <Folder>Encoding</Folder>
    <InputTypes/>
    <OutputFileNameTemplate>{dir}/{stem}{ext}</OutputFileNameTemplate>
    <OutputExtension>b64</OutputExtension>
    <Engine>encodekit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>encode</Arg>
        <Arg>--encoding</Arg>
        <Arg>base64</Arg>
    </Args>
</Preset>
