<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Image OCR (Tesseract -> TXT / hOCR / PDF / TSV / ALTO)</Name>
    <Folder>Documents/OCR</Folder>
    <InputTypes>
        <Extension>jpg</Extension>
        <Extension>jpeg</Extension>
        <Extension>png</Extension>
        <Extension>tiff</Extension>
        <Extension>tif</Extension>
        <Extension>bmp</Extension>
        <Extension>webp</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>txt</OutputExtension>
    <Engine>ocr</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>recognize</Arg>
    </Args>
</Preset>
