<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>HCL / Terraform -> JSON</Name>
    <Folder>DevOps/Config</Folder>
    <InputTypes>
        <Extension>hcl</Extension>
        <Extension>tf</Extension>
        <Extension>tfvars</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>config</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>json</Arg>
    </Args>
</Preset>
