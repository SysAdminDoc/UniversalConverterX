<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>AIS Marine Tracking -> JSON</Name>
    <Folder>Data/Wireless</Folder>
    <InputTypes>
        <Extension>ais</Extension>
        <Extension>nmea</Extension>
        <Extension>txt</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>wirelesskit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>ais-to-json</Arg>
    </Args>
</Preset>
