<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Swedish SIE 4 -> CSV</Name>
    <Folder>Documents/Tax</Folder>
    <InputTypes>
        <Extension>se</Extension>
        <Extension>sie</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>taxkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>sie-to-csv</Arg>
    </Args>
</Preset>
