<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>VVC / H.266 Slow (Best Quality, Experimental)</Name>
    <Folder>Video/Codec</Folder>
    <InputTypes>
        <Extension>y4m</Extension>
        <Extension>yuv</Extension>
        <Extension>mp4</Extension>
        <Extension>mkv</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_vvc-hq</OutputFileNameTemplate>
    <OutputExtension>266</OutputExtension>
    <Engine>vvc-encoder</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>encode</Arg>
        <Arg>--preset</Arg>
        <Arg>slow</Arg>
        <Arg>--qp</Arg>
        <Arg>28</Arg>
    </Args>
</Preset>
