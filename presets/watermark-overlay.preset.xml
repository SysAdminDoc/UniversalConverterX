<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Watermark overlay (PNG/JPEG)</Name>
    <Folder>Video/Edit</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mkv</Extension>
        <Extension>mov</Extension>
        <Extension>m4v</Extension>
        <Extension>avi</Extension>
        <Extension>ts</Extension>
        <Extension>webm</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_watermarked</OutputFileNameTemplate>
    <OutputExtension>mp4</OutputExtension>
    <Engine>clipforge</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <RequiresExtraInput>true</RequiresExtraInput>
    <ExtraInputPrompt>Pick a logo PNG or JPEG to stamp onto the video.</ExtraInputPrompt>
    <Args>
        <Arg>watermark</Arg>
        <Arg>--position</Arg>
        <Arg>br</Arg>
        <Arg>--opacity</Arg>
        <Arg>0.7</Arg>
        <Arg>--scale</Arg>
        <Arg>15</Arg>
        <Arg>--margin</Arg>
        <Arg>24</Arg>
        <Arg>--crf</Arg>
        <Arg>20</Arg>
    </Args>
</Preset>
