<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Apache / Nginx access log -> JSONL</Name>
    <Folder>Logs</Folder>
    <InputTypes>
        <Extension>log</Extension>
        <Extension>txt</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>jsonl</OutputExtension>
    <Engine>logkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>to-jsonl</Arg>
        <Arg>--format</Arg>
        <Arg>combined</Arg>
    </Args>
</Preset>
