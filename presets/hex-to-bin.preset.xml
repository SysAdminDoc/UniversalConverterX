<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Intel HEX / SREC -> raw binary</Name>
    <Folder>Embedded</Folder>
    <InputTypes>
        <Extension>hex</Extension>
        <Extension>ihex</Extension>
        <Extension>srec</Extension>
        <Extension>s19</Extension>
        <Extension>s28</Extension>
        <Extension>s37</Extension>
        <Extension>mot</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>bin</OutputExtension>
    <Engine>hexkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>bin</Arg>
    </Args>
</Preset>
