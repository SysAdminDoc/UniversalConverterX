<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Video face enhance (CodeFormer)</Name>
    <Folder>AI/Video</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mkv</Extension>
        <Extension>mov</Extension>
        <Extension>m4v</Extension>
        <Extension>avi</Extension>
        <Extension>webm</Extension>
        <Extension>ts</Extension>
        <Extension>mts</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_face_enhanced</OutputFileNameTemplate>
    <OutputExtension>mp4</OutputExtension>
    <Engine>video-face-enhance</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>enhance</Arg>
        <Arg>--backend</Arg>
        <Arg>codeformer</Arg>
        <Arg>--w</Arg>
        <Arg>0.65</Arg>
        <Arg>--upscale</Arg>
        <Arg>1</Arg>
        <Arg>--face-upsample</Arg>
        <Arg>--crf</Arg>
        <Arg>18</Arg>
    </Args>
</Preset>
