<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>mbox -> Per-Message .eml Files</Name>
    <Folder>Documents/Email</Folder>
    <InputTypes>
        <Extension>mbox</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_split</OutputFileNameTemplate>
    <OutputExtension></OutputExtension>
    <Engine>mailbox</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>mbox-split</Arg>
    </Args>
</Preset>
