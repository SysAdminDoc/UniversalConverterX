<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Apple Keynote -> PPTX</Name>
    <Folder>Documents/Apple</Folder>
    <InputTypes>
        <Extension>key</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>pptx</OutputExtension>
    <Engine>applepro</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>pptx</Arg>
    </Args>
</Preset>
