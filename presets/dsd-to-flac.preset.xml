<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>DSD / APE / WV / TAK -> FLAC</Name>
    <Folder>Audio</Folder>
    <InputTypes>
        <Extension>dsf</Extension>
        <Extension>dff</Extension>
        <Extension>ape</Extension>
        <Extension>wv</Extension>
        <Extension>tak</Extension>
        <Extension>tta</Extension>
        <Extension>thd</Extension>
        <Extension>mlp</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>flac</OutputExtension>
    <Engine>audiopro</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>flac</Arg>
    </Args>
</Preset>
