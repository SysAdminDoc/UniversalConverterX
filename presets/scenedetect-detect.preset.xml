<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Video Scene Detection (PySceneDetect)</Name>
    <Folder>Video/Analysis</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mkv</Extension>
        <Extension>mov</Extension>
        <Extension>avi</Extension>
        <Extension>webm</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_scenes</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>scenedetect</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>detect</Arg>
    </Args>
</Preset>
