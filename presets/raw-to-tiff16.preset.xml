<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>RAW to 16-bit TIFF</Name>
    <Folder>Image/RAW</Folder>
    <InputTypes>
        <Extension>cr2</Extension>
        <Extension>cr3</Extension>
        <Extension>nef</Extension>
        <Extension>arw</Extension>
        <Extension>raf</Extension>
        <Extension>rw2</Extension>
        <Extension>orf</Extension>
        <Extension>dng</Extension>
        <Extension>pef</Extension>
        <Extension>srw</Extension>
        <Extension>x3f</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>tiff</OutputExtension>
    <Engine>rawphoto</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>tiff16</Arg>
        <Arg>--white-balance</Arg>
        <Arg>camera</Arg>
    </Args>
</Preset>
