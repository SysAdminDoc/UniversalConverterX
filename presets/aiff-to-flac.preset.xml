<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>AIFF / IFF / CAF -> FLAC</Name>
    <Folder>Audio</Folder>
    <InputTypes>
        <Extension>aiff</Extension>
        <Extension>aifc</Extension>
        <Extension>aif</Extension>
        <Extension>iff</Extension>
        <Extension>caf</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>flac</OutputExtension>
    <Engine>audiopro</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>flac</Arg>
    </Args>
</Preset>
