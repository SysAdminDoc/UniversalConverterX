<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>UltraHDR JPEG → AVIF with gain map</Name>
    <Folder>Image/HDR</Folder>
    <InputTypes>
        <Extension>jpg</Extension>
        <Extension>jpeg</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_gainmap</OutputFileNameTemplate>
    <OutputExtension>avif</OutputExtension>
    <Engine>gainmap</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>to-avif</Arg>
        <Arg>--quality</Arg>
        <Arg>90</Arg>
        <Arg>--gainmap-quality</Arg>
        <Arg>100</Arg>
        <Arg>--speed</Arg>
        <Arg>8</Arg>
    </Args>
</Preset>
