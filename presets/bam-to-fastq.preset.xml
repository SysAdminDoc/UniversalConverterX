<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>BAM / CRAM / SAM -> FASTQ</Name>
    <Folder>Bioinformatics</Folder>
    <InputTypes>
        <Extension>bam</Extension>
        <Extension>cram</Extension>
        <Extension>sam</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>fastq</OutputExtension>
    <Engine>biokit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>bam-to-fastq</Arg>
    </Args>
</Preset>
