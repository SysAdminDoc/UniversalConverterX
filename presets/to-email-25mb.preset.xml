<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>To Email (25 MB cap-safe)</Name>
    <Folder>Video</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mov</Extension>
        <Extension>mkv</Extension>
        <Extension>avi</Extension>
        <Extension>webm</Extension>
        <Extension>m4v</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_email_25mb</OutputFileNameTemplate>
    <OutputExtension>mp4</OutputExtension>
    <Engine>videocrush</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>--preset</Arg>
        <Arg>email-25mb</Arg>
        <Arg>--hwaccel</Arg>
        <Arg>none</Arg>
    </Args>
</Preset>
