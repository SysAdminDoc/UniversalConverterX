<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Certificate DER -> PEM</Name>
    <Folder>Security/TLS</Folder>
    <InputTypes>
        <Extension>der</Extension>
        <Extension>cer</Extension>
        <Extension>crt</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>pem</OutputExtension>
    <Engine>tlskit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>cert-convert</Arg>
        <Arg>--format</Arg>
        <Arg>pem</Arg>
    </Args>
</Preset>
