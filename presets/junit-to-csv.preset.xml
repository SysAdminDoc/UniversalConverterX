<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>JUnit Test Report -> CSV</Name>
    <Folder>DevOps/Tests</Folder>
    <InputTypes>
        <Extension>xml</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>testreports</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>junit-to-csv</Arg>
    </Args>
</Preset>
