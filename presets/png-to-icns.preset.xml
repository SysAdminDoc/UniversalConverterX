<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>PNG -> Apple .icns (multi-res)</Name>
    <Folder>Image</Folder>
    <InputTypes>
        <Extension>png</Extension>
        <Extension>jpg</Extension>
        <Extension>jpeg</Extension>
        <Extension>bmp</Extension>
        <Extension>tif</Extension>
        <Extension>tiff</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>icns</OutputExtension>
    <Engine>iconkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>to-icns</Arg>
    </Args>
</Preset>
