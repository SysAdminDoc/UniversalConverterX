<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Playlist -> XSPF (XML)</Name>
    <Folder>Audio/Playlist</Folder>
    <InputTypes>
        <Extension>m3u</Extension>
        <Extension>m3u8</Extension>
        <Extension>pls</Extension>
        <Extension>wpl</Extension>
        <Extension>asx</Extension>
        <Extension>b4s</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>xspf</OutputExtension>
    <Engine>playlist</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>xspf</Arg>
    </Args>
</Preset>
