<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Browser bookmarks -> Netscape HTML</Name>
    <Folder>Bookmarks</Folder>
    <InputTypes>
        <Extension>json</Extension>
        <Extension>plist</Extension>
        <Extension>bplist</Extension>
        <Extension>html</Extension>
        <Extension>htm</Extension>
        <Extension>adr</Extension>
        <Extension>csv</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_bookmarks</OutputFileNameTemplate>
    <OutputExtension>html</OutputExtension>
    <Engine>bookmark</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>html</Arg>
    </Args>
</Preset>
