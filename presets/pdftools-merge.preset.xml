<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>PDF Merge (Combine Multiple PDFs)</Name>
    <Folder>Documents/PDF</Folder>
    <InputTypes>
        <Extension>pdf</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/merged</OutputFileNameTemplate>
    <OutputExtension>pdf</OutputExtension>
    <Engine>pdftools</Engine>
    <InvocationMode>batch-single-output</InvocationMode>
    <Args>
        <Arg>merge</Arg>
    </Args>
</Preset>
