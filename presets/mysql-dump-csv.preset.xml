<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>MySQL Dump -> CSV per Table</Name>
    <Folder>Data/DBExport</Folder>
    <InputTypes>
        <Extension>sql</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>dbexport</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>mysql-dump-csv</Arg>
    </Args>
</Preset>
