<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Convert to AV1 (SVT-AV1 v2 fast)</Name>
    <Folder>Video</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mov</Extension>
        <Extension>mkv</Extension>
        <Extension>avi</Extension>
        <Extension>webm</Extension>
        <Extension>m4v</Extension>
        <Extension>ts</Extension>
        <Extension>flv</Extension>
        <Extension>wmv</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_av1</OutputFileNameTemplate>
    <OutputExtension>mkv</OutputExtension>
    <Engine>videocrush</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>--profile</Arg>
        <Arg>archive-av1-fast</Arg>
    </Args>
</Preset>
