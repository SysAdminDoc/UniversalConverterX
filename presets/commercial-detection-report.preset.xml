<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
  <Name>Commercial Detection — EDL + Chapters</Name>
  <Folder>Video/Analysis</Folder>
  <InputTypes>
    <Extension>ts</Extension>
    <Extension>m2ts</Extension>
    <Extension>mpg</Extension>
    <Extension>mpeg</Extension>
    <Extension>mp4</Extension>
    <Extension>mkv</Extension>
  </InputTypes>
  <OutputFileNameTemplate>{dir}/{stem}_commercials</OutputFileNameTemplate>
  <OutputExtension>json</OutputExtension>
  <Engine>comskip</Engine>
  <InvocationMode>per-file</InvocationMode>
  <Args>
    <Arg>analyze</Arg>
  </Args>
</Preset>
