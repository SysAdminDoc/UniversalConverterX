<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>E57 / PCD / XYZ to LAS</Name>
    <Folder>3D/Point Cloud</Folder>
    <InputTypes>
        <Extension>e57</Extension>
        <Extension>pcd</Extension>
        <Extension>xyz</Extension>
        <Extension>pts</Extension>
        <Extension>ply</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>las</OutputExtension>
    <Engine>pointcloud</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>las</Arg>
    </Args>
</Preset>
