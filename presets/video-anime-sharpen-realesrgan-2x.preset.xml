<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Video anime sharpen 2x (Real-ESRGAN)</Name>
    <Folder>AI/Video</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mkv</Extension>
        <Extension>mov</Extension>
        <Extension>m4v</Extension>
        <Extension>avi</Extension>
        <Extension>webm</Extension>
        <Extension>ts</Extension>
        <Extension>mts</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_anime_sharp2x</OutputFileNameTemplate>
    <OutputExtension>mp4</OutputExtension>
    <Engine>anime-upscale</Engine>
    <InvocationMode>per-file</InvocationMode>
    <Args>
        <Arg>video</Arg>
        <Arg>--scale</Arg>
        <Arg>2</Arg>
        <Arg>--model</Arg>
        <Arg>realesr-animevideov3</Arg>
        <Arg>--codec</Arg>
        <Arg>libx264</Arg>
        <Arg>--crf</Arg>
        <Arg>18</Arg>
    </Args>
</Preset>
