<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Generate SHA-256 sums</Name>
    <Folder>Hash</Folder>
    <InputTypes/>
    <OutputFileNameTemplate>{dir}/SHA256SUMS</OutputFileNameTemplate>
    <OutputExtension>txt</OutputExtension>
    <Engine>hashkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>generate</Arg>
        <Arg>--algo</Arg>
        <Arg>sha256</Arg>
    </Args>
</Preset>
