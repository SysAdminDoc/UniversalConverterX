<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>MusicXML -> LilyPond</Name>
    <Folder>Audio/Notation</Folder>
    <InputTypes>
        <Extension>musicxml</Extension>
        <Extension>xml</Extension>
        <Extension>mxl</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>ly</OutputExtension>
    <Engine>musicmore</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>musicxml-to-ly</Arg>
    </Args>
</Preset>
