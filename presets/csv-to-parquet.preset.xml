<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>CSV / TSV to Parquet</Name>
    <Folder>Data</Folder>
    <InputTypes>
        <Extension>csv</Extension>
        <Extension>tsv</Extension>
        <Extension>jsonl</Extension>
        <Extension>ndjson</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>parquet</OutputExtension>
    <Engine>datasci</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>parquet</Arg>
    </Args>
</Preset>
