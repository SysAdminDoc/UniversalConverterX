<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>BIP39 Mnemonic Check (Read-Only Validation)</Name>
    <Folder>Data/Crypto</Folder>
    <InputTypes>
        <Extension>txt</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}.bip39</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>wallet</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>bip39-check</Arg>
    </Args>
</Preset>
