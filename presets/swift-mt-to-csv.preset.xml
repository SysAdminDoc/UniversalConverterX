<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>SWIFT MT (Banking) -> Per-Field CSV</Name>
    <Folder>Documents/Enterprise</Folder>
    <InputTypes>
        <Extension>fin</Extension>
        <Extension>mt</Extension>
        <Extension>swift</Extension>
        <Extension>txt</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>csv</OutputExtension>
    <Engine>swift</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>mt-to-csv</Arg>
    </Args>
</Preset>
