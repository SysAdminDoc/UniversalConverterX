<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>mzML Mass Spectra -> JSON</Name>
    <Folder>Bio/MassSpec</Folder>
    <InputTypes>
        <Extension>mzml</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>proteomics</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>mzml-to-json</Arg>
    </Args>
</Preset>
