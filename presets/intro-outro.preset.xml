<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Add intro / outro to video</Name>
    <Folder>Video/Edit</Folder>
    <InputTypes>
        <Extension>mp4</Extension>
        <Extension>mkv</Extension>
        <Extension>mov</Extension>
        <Extension>m4v</Extension>
        <Extension>avi</Extension>
        <Extension>webm</Extension>
        <Extension>ts</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_with-intro</OutputFileNameTemplate>
    <OutputExtension>mp4</OutputExtension>
    <Engine>clipforge</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <RequiresExtraInput>true</RequiresExtraInput>
    <ExtraInputPrompt>Pick the intro clip (and optionally the outro afterwards) to attach to each primary video.</ExtraInputPrompt>
    <Args>
        <Arg>intro-outro</Arg>
    </Args>
</Preset>
