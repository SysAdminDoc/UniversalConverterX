<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>EDI X12 / EDIFACT -> JSON</Name>
    <Folder>Documents/Enterprise</Folder>
    <InputTypes>
        <Extension>edi</Extension>
        <Extension>x12</Extension>
        <Extension>edifact</Extension>
        <Extension>txt</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>edi</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>to-json</Arg>
    </Args>
</Preset>
