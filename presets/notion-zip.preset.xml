<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Notion Workspace .zip -> Markdown Vault</Name>
    <Folder>Documents/Notes</Folder>
    <InputTypes>
        <Extension>zip</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_vault</OutputFileNameTemplate>
    <OutputExtension></OutputExtension>
    <Engine>notetaking</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>notion-zip</Arg>
    </Args>
</Preset>
