<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>DICOM to PNG</Name>
    <Folder>Image/Medical</Folder>
    <InputTypes>
        <Extension>dcm</Extension>
        <Extension>dicom</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>png</OutputExtension>
    <Engine>dicomkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>to-image</Arg>
        <Arg>--format</Arg>
        <Arg>png</Arg>
    </Args>
</Preset>
