<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Spotify Export -> M3U</Name>
    <Folder>Audio/Playlists</Folder>
    <InputTypes>
        <Extension>json</Extension>
        <Extension>csv</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>m3u</OutputExtension>
    <Engine>playlistmore</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>spotify-to-m3u</Arg>
    </Args>
</Preset>
