<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>BIND zone file -> JSON</Name>
    <Folder>DevOps/DNS</Folder>
    <InputTypes>
        <Extension>zone</Extension>
        <Extension>db</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>dnskit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>parse</Arg>
        <Arg>--format</Arg>
        <Arg>json</Arg>
    </Args>
</Preset>
