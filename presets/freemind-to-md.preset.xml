<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Freemind Mind Map -> Markdown</Name>
    <Folder>Documents/Diagrams</Folder>
    <InputTypes>
        <Extension>mm</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>md</OutputExtension>
    <Engine>diagrammore</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>freemind-to-md</Arg>
    </Args>
</Preset>
