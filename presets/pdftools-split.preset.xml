<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>PDF Split (Per-Page Extract)</Name>
    <Folder>Documents/PDF</Folder>
    <InputTypes>
        <Extension>pdf</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_pages</OutputFileNameTemplate>
    <OutputExtension>pdf</OutputExtension>
    <Engine>pdftools</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>extract</Arg>
    </Args>
</Preset>
