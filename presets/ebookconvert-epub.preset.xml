<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>eBook -> EPUB (Calibre)</Name>
    <Folder>Documents/eBooks</Folder>
    <InputTypes>
        <Extension>mobi</Extension>
        <Extension>azw3</Extension>
        <Extension>pdf</Extension>
        <Extension>fb2</Extension>
        <Extension>lrf</Extension>
        <Extension>tpz</Extension>
        <Extension>prc</Extension>
        <Extension>rtf</Extension>
        <Extension>docx</Extension>
        <Extension>html</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>epub</OutputExtension>
    <Engine>ebookconvert</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--to</Arg>
        <Arg>epub</Arg>
    </Args>
</Preset>
