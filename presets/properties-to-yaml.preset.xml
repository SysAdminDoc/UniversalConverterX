<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Java .properties / INI -> YAML</Name>
    <Folder>DevOps/Config</Folder>
    <InputTypes>
        <Extension>properties</Extension>
        <Extension>ini</Extension>
        <Extension>cfg</Extension>
        <Extension>conf</Extension>
        <Extension>hocon</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>yaml</OutputExtension>
    <Engine>config</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>yaml</Arg>
    </Args>
</Preset>
