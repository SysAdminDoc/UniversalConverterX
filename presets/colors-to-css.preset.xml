<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Colors -> CSS Variables</Name>
    <Folder>Design/Color</Folder>
    <InputTypes>
        <Extension>txt</Extension>
        <Extension>json</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>css</OutputExtension>
    <Engine>colorfmt</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>to-css</Arg>
    </Args>
</Preset>
