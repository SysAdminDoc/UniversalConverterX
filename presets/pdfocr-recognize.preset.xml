<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Scanned PDF -> Searchable PDF (OCRmyPDF)</Name>
    <Folder>Documents/OCR</Folder>
    <InputTypes>
        <Extension>pdf</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}_ocr</OutputFileNameTemplate>
    <OutputExtension>pdf</OutputExtension>
    <Engine>pdfocr</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>recognize</Arg>
    </Args>
</Preset>
