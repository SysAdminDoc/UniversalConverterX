<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Apache Avro -> JSON</Name>
    <Folder>Data/Wire</Folder>
    <InputTypes>
        <Extension>avro</Extension>
        <Extension>ocf</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>datawire</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>avro-to-json</Arg>
    </Args>
</Preset>
