<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>IPFIX (NetFlow v10) -> JSON</Name>
    <Folder>Network/Flows</Folder>
    <InputTypes>
        <Extension>ipfix</Extension>
        <Extension>flow</Extension>
        <Extension>bin</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>json</OutputExtension>
    <Engine>netflowkit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>ipfix-to-json</Arg>
    </Args>
</Preset>
