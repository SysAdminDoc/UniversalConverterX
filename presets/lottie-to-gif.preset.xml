<?xml version="1.0" encoding="utf-8"?>
<Preset xmlns="https://universalconverterx.io/preset/v1">
    <Name>Lottie to GIF</Name>
    <Folder>Image</Folder>
    <InputTypes>
        <Extension>json</Extension>
        <Extension>tgs</Extension>
        <Extension>lottie</Extension>
    </InputTypes>
    <OutputFileNameTemplate>{dir}/{stem}</OutputFileNameTemplate>
    <OutputExtension>gif</OutputExtension>
    <Engine>lottiekit</Engine>
    <InvocationMode>batch-output-dir</InvocationMode>
    <Args>
        <Arg>convert</Arg>
        <Arg>--format</Arg>
        <Arg>gif</Arg>
    </Args>
</Preset>
