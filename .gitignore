bin/
obj/
.vs/
*.user
*.suo
*.cache
*.bak
packages/
*.nupkg
publish/
CLAUDE.md
CODEX_CHANGELOG.md
.claude/

# Sidecar runtime artifacts (binaries land in tools/ at build time, not in git)
tools/**/*.exe
tools/**/*.dll
tools/**/.venv/
tools/**/build/
tools/**/dist/
tools/**/spec/
tools/**/*.spec
tools/**/models/
tools/**/__pycache__/

# Track placeholder/.gitkeep readme inside model dirs so the dir survives
# fresh clones — the .rnnn weights themselves stay ignored.
!tools/**/models/.gitkeep

# Shared AI model cache — track the placeholder, not the model weights
tools/_models/*
!tools/_models/.gitkeep

# tools/build-all.ps1 build reports
artifacts/build-reports/
artifacts/python-dependencies/
artifacts/ui-smoke/
artifacts/gates/

# Installer-generated WiX fragments
installer/wix/PresetFiles.generated.wxs
installer/wix/ReleasePayload.generated.wxs
installer/output/

# Python bytecode cache
__pycache__/
*.pyc
.factory/

# Markdown files local-only (except README)
*.md
!README.md

# Markdown files local-only (except README)
*.md
!README.md

# AI config
AGENTS.md
.codex/
.ai/
PROJECT_CONTEXT.md
CONTINUATION_PROMPT.md
